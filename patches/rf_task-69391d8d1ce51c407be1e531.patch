diff --git a/pkg/writers/buffer/buffer.go b/pkg/writers/buffer/buffer.go
new file mode 100644
index 0000000..0abc445
--- /dev/null
+++ b/pkg/writers/buffer/buffer.go
@@ -0,0 +1,138 @@
+// Package buffer provides reusable byte buffers and pool metrics.
+package buffer
+
+import (
+	"bytes"
+	"fmt"
+	"github.com/trufflesecurity/trufflehog/v3/pkg/context"
+	"sync"
+	"time"
+)
+
+type bufferPoolMetrics struct{}
+
+func (bufferPoolMetrics) recordGrowth(growthAmount int) {
+	growCount.Inc()
+	growAmount.Add(float64(growthAmount))
+}
+
+func (bufferPoolMetrics) recordShrink(amount int) {
+	shrinkCount.Inc()
+	shrinkAmount.Add(float64(amount))
+}
+
+func (bufferPoolMetrics) recordCheckoutDuration(duration time.Duration) {
+	checkoutDuration.Observe(float64(duration.Microseconds()))
+	checkoutCount.Inc()
+	checkoutDurationTotal.Add(float64(duration.Microseconds()))
+}
+
+func (bufferPoolMetrics) recordBufferRetrival() {
+	activeBufferCount.Inc()
+	bufferCount.Inc()
+}
+
+func (bufferPoolMetrics) recordBufferReturn(bufCap, bufLen int64) {
+	activeBufferCount.Dec()
+	totalBufferSize.Add(float64(bufCap))
+	totalBufferLength.Add(float64(bufLen))
+}
+
+const defaultBufferSize = 1 << 12
+
+type PoolOpts func(pool *Pool)
+
+type Pool struct {
+	bufferSize uint32
+	*sync.Pool
+	metrics bufferPoolMetrics
+}
+
+func WithBufferSize(size uint32) PoolOpts {
+	return func(pool *Pool) { pool.bufferSize = size }
+}
+
+func NewBufferPool(opts ...PoolOpts) *Pool {
+	pool := &Pool{bufferSize: defaultBufferSize}
+	for _, opt := range opts {
+		opt(pool)
+	}
+	pool.Pool = &sync.Pool{New: func() any {
+		return &Buffer{Buffer: bytes.NewBuffer(make([]byte, 0, pool.bufferSize))}
+	}}
+	return pool
+}
+
+func (pool *Pool) Get(ctx context.Context) *Buffer {
+	buf, ok := pool.Pool.Get().(*Buffer)
+	if !ok || buf == nil || buf.Buffer == nil {
+		ctx.Logger().Error(fmt.Errorf("buffer pool returned unexpected type"), "using new buffer")
+		buf = &Buffer{Buffer: bytes.NewBuffer(make([]byte, 0, pool.bufferSize))}
+	}
+	buf.checkedOut = time.Now()
+	pool.metrics.recordBufferRetrival()
+	return buf
+}
+
+func (pool *Pool) Put(buf *Buffer) {
+	if buf == nil || buf.Buffer == nil {
+		return
+	}
+	pool.metrics.recordBufferReturn(int64(buf.Cap()), int64(buf.Len()))
+	pool.metrics.recordCheckoutDuration(time.Since(buf.checkedOut))
+	if buf.Cap() > 2*int(pool.bufferSize) {
+		pool.metrics.recordShrink(buf.Cap() - int(pool.bufferSize))
+		buf = &Buffer{Buffer: bytes.NewBuffer(make([]byte, 0, pool.bufferSize))}
+	} else {
+		buf.Reset()
+	}
+	pool.Pool.Put(buf)
+}
+
+type Buffer struct {
+	*bytes.Buffer
+	checkedOut time.Time
+}
+
+func NewBuffer() *Buffer {
+	return &Buffer{Buffer: bytes.NewBuffer(make([]byte, 0, defaultBufferSize))}
+}
+
+func (buf *Buffer) Grow(size int) {
+	if buf.Buffer == nil {
+		buf.Buffer = bytes.NewBuffer(make([]byte, 0, defaultBufferSize))
+	}
+	bufferPoolMetrics{}.recordGrowth(size)
+	buf.Buffer.Grow(size)
+}
+
+func (buf *Buffer) Write(ctx context.Context, data []byte) (int, error) {
+	if buf.Buffer == nil {
+		ctx.Logger().V(4).Info("initializing empty buffer")
+		buf.Buffer = bytes.NewBuffer(make([]byte, 0, defaultBufferSize))
+	}
+	if len(data) > buf.Cap()-buf.Len() {
+		buf.Grow(len(data))
+	}
+	return buf.Buffer.Write(data)
+}
+
+// ReadCloser returns a reader whose close callback runs at most once.
+func ReadCloser(data []byte, onClose func()) *readCloser {
+	return &readCloser{Reader: bytes.NewReader(data), onClose: onClose}
+}
+
+type readCloser struct {
+	*bytes.Reader
+	onClose func()
+	once    sync.Once
+}
+
+func (reader *readCloser) Close() error {
+	reader.once.Do(func() {
+		if reader.onClose != nil {
+			reader.onClose()
+		}
+	})
+	return nil
+}
