diff --git a/pkg/writers/buffer_writer/bufferwriter.go b/pkg/writers/buffer_writer/bufferwriter.go
new file mode 100644
index 0000000..b078e4c
--- /dev/null
+++ b/pkg/writers/buffer_writer/bufferwriter.go
@@ -0,0 +1,71 @@
+// Package bufferwriter implements an in-memory content writer.
+package bufferwriter
+
+import (
+	"fmt"
+	"github.com/trufflesecurity/trufflehog/v3/pkg/context"
+	"github.com/trufflesecurity/trufflehog/v3/pkg/writers/buffer"
+	"io"
+	"time"
+)
+
+type state uint8
+
+const (
+	writeOnly state = iota
+	readOnly
+)
+
+var sharedBufferPool = buffer.NewBufferPool()
+
+type BufferWriter struct {
+	state state
+	buf   *buffer.Buffer
+	size  int
+}
+
+func New(ctx context.Context) *BufferWriter {
+	return &BufferWriter{state: writeOnly, buf: sharedBufferPool.Get(ctx)}
+}
+
+func (writer *BufferWriter) Write(ctx context.Context, data []byte) (int, error) {
+	if writer.state != writeOnly {
+		return 0, fmt.Errorf("buffer is in read-only mode")
+	}
+	start := time.Now()
+	n, err := writer.buf.Write(ctx, data)
+	writer.size += n
+	totalWriteSize.Add(float64(n))
+	totalWriteDuration.Add(float64(time.Since(start).Microseconds()))
+	return n, err
+}
+
+func (writer *BufferWriter) ReadCloser() (io.ReadCloser, error) {
+	if writer.state != readOnly {
+		return nil, fmt.Errorf("buffer is in write-only mode")
+	}
+	if writer.buf == nil {
+		return nil, fmt.Errorf("buffer is nil")
+	}
+	buf := writer.buf
+	return buffer.ReadCloser(buf.Bytes(), func() {
+		if writer.buf == buf {
+			sharedBufferPool.Put(buf)
+			writer.buf = nil
+		}
+	}), nil
+}
+
+func (writer *BufferWriter) CloseForWriting() error {
+	writer.state = readOnly
+	return nil
+}
+
+func (writer *BufferWriter) String() (string, error) {
+	if writer.buf == nil {
+		return "", fmt.Errorf("buffer is nil")
+	}
+	return writer.buf.String(), nil
+}
+
+func (writer *BufferWriter) Len() int { return writer.size }
