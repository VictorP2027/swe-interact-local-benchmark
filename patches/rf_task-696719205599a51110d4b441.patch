diff --git a/lib/test_state.go b/lib/test_state.go
index dee70ea..24d33ad 100644
--- a/lib/test_state.go
+++ b/lib/test_state.go
@@ -2,6 +2,9 @@ package lib
 
 import (
 	"io"
+	"strings"
+	"sync"
+	"sync/atomic"
 
 	"github.com/sirupsen/logrus"
 	"go.k6.io/k6/event"
@@ -27,10 +30,140 @@ type TestPreInitState struct {
 type TestRunState struct {
 	*TestPreInitState
 
-	Options Options
-	Runner  Runner // TODO: rename to something better, see type comment
-	RunTags *metrics.TagSet
+	Options      Options
+	Runner       Runner // TODO: rename to something better, see type comment
+	RunTags      *metrics.TagSet
+	GroupSummary *GroupSummary
 
 	// TODO: add other properties that are computed or derived after init, e.g.
 	// thresholds?
 }
+
+// GroupSummary aggregates the group hierarchy and check results from metric tags.
+type GroupSummary struct {
+	logger    logrus.FieldLogger
+	group     *Group
+	groups    map[string]*Group
+	mutex     sync.Mutex
+	pending   [][]metrics.SampleContainer
+	wake      chan struct{}
+	stop      chan struct{}
+	done      chan struct{}
+	startOnce sync.Once
+	stopOnce  sync.Once
+	stopped   bool
+}
+
+// NewGroupSummary creates an internal output ready to aggregate metric samples.
+func NewGroupSummary(logger logrus.FieldLogger) *GroupSummary {
+	root, _ := NewGroup(RootGroupPath, nil)
+	return &GroupSummary{logger: logger, group: root, groups: map[string]*Group{RootGroupPath: root},
+		wake: make(chan struct{}, 1), stop: make(chan struct{}), done: make(chan struct{})}
+}
+
+// Description identifies this internal output.
+func (*GroupSummary) Description() string { return "Internal Group Summary" }
+
+// Group returns the root of the aggregated group hierarchy.
+func (summary *GroupSummary) Group() *Group { return summary.group }
+
+// Start starts the single aggregation worker.
+func (summary *GroupSummary) Start() error {
+	summary.startOnce.Do(func() {
+		go func() {
+			defer close(summary.done)
+			for {
+				select {
+				case <-summary.wake:
+					summary.flush()
+				case <-summary.stop:
+					summary.flush()
+					return
+				}
+			}
+		}()
+	})
+	return nil
+}
+
+// AddMetricSamples queues a batch without waiting for aggregation.
+func (summary *GroupSummary) AddMetricSamples(samples []metrics.SampleContainer) {
+	if len(samples) == 0 {
+		return
+	}
+	summary.mutex.Lock()
+	if !summary.stopped {
+		summary.pending = append(summary.pending, samples)
+	}
+	summary.mutex.Unlock()
+	select {
+	case summary.wake <- struct{}{}:
+	default:
+	}
+}
+
+// Stop waits for all accepted samples to be aggregated.
+func (summary *GroupSummary) Stop() error {
+	_ = summary.Start()
+	summary.stopOnce.Do(func() {
+		summary.mutex.Lock()
+		summary.stopped = true
+		summary.mutex.Unlock()
+		close(summary.stop)
+	})
+	<-summary.done
+	return nil
+}
+
+func (summary *GroupSummary) flush() {
+	summary.mutex.Lock()
+	pending := summary.pending
+	summary.pending = nil
+	summary.mutex.Unlock()
+	for _, batch := range pending {
+		for _, container := range batch {
+			for _, sample := range container.GetSamples() {
+				if sample.Tags == nil || sample.Metric == nil {
+					continue
+				}
+				groupPath, ok := sample.Tags.Get("group")
+				if !ok {
+					continue
+				}
+				group, exists := summary.groups[groupPath]
+				if !exists {
+					group = summary.group
+					for _, name := range strings.Split(strings.TrimPrefix(groupPath, GroupSeparator), GroupSeparator) {
+						var err error
+						group, err = group.Group(name)
+						if err != nil {
+							summary.logger.WithError(err).Warn("Could not aggregate group")
+							break
+						}
+					}
+					if group == nil {
+						continue
+					}
+					summary.groups[groupPath] = group
+				}
+				if sample.Metric.Name != "checks" {
+					continue
+				}
+				name, ok := sample.Tags.Get("check")
+				if !ok {
+					continue
+				}
+				check, err := group.Check(name)
+				if err != nil {
+					summary.logger.WithError(err).Warn("Could not aggregate check")
+					continue
+				}
+				if sample.Value != 0 {
+					atomic.AddInt64(&check.Passes, 1)
+				} else {
+					atomic.AddInt64(&check.Fails, 1)
+				}
+			}
+		}
+	}
+}
