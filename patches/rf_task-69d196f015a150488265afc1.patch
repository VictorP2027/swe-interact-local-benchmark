+/** Fetch or recalculate statistics with the SQL connection context. */
+dberr_t ha_innobase::statistics_init(dict_table_t *table, bool recalc)
+{
+  ut_ad(!table->stats_mutex_is_owner());
+  if (!recalc && table->stat_initialized())
+    return DB_SUCCESS;
+  if (srv_force_recovery >= SRV_FORCE_NO_UNDO_LOG_SCAN)
+    return dict_stats_update_transient(table);
+  if (!table->stats_is_persistent())
+    return dict_stats_update_transient(table);
+#ifdef WITH_WSREP
+  if (wsrep_thd_skip_locking(current_thd))
+    return dict_stats_update_transient(table);
+#endif
+  const dict_stats_schema_check schema= dict_stats_persistent_storage_check();
+  if (schema != SCHEMA_OK)
+  {
+    if (schema == SCHEMA_INVALID && !table->stats_error_printed && !opt_bootstrap)
+    {
+      ib::warn() << "Invalid persistent statistics storage for table " << table->name
+                 << ". Using transient statistics.";
+      table->stats_error_printed= true;
+    }
+    return dict_stats_update_transient(table);
+  }
+  if (!recalc)
+  {
+    const dberr_t err= dict_stats_fetch_from_ps(table);
+    if (err == DB_SUCCESS || err == DB_SUCCESS_LOCKED_REC)
+      return err;
+    if (err != DB_STATS_DO_NOT_EXIST || !table->stats_is_auto_recalc())
+    {
+      if (err != DB_STATS_DO_NOT_EXIST && !table->stats_error_printed && !opt_bootstrap)
+      {
+        ib::warn() << "Error fetching persistent statistics for table " << table->name
+                   << ": " << err << ". Using transient statistics.";
+        table->stats_error_printed= true;
+      }
+      return dict_stats_update_transient(table);
+    }
+  }
+  if (srv_read_only_mode)
+    return dict_stats_update_transient(table);
+  const dberr_t err= dict_stats_update_persistent(table);
+  return err == DB_SUCCESS ? dict_stats_save(table) : err;
+}
