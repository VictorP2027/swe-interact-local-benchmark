@@ -144,3 +100,84 @@ func (s Scanner) FromData(ctx context.Context, verify bool, data []byte) (result
 func (s Scanner) Type() detectorspb.DetectorType {
 	return detectorspb.DetectorType_Github
 }
+
+// HeaderInfo contains metadata returned with a verified GitHub user response.
+type HeaderInfo struct {
+	Scopes string
+	Expiry string
+}
+
+// VerifyGithub checks the configured GitHub API endpoints for a token.
+func (s Scanner) VerifyGithub(ctx context.Context, client *http.Client, token string) (bool, *UserRes, *HeaderInfo, error) {
+	var lastErr error
+	for _, endpoint := range s.Endpoints(s.DefaultEndpoint()) {
+		req, err := http.NewRequestWithContext(ctx, http.MethodGet, fmt.Sprintf("%s/user", endpoint), nil)
+		if err != nil {
+			continue
+		}
+		req.Header.Set("Content-Type", "application/json; charset=utf-8")
+		req.Header.Set("Authorization", fmt.Sprintf("token %s", token))
+		response, err := client.Do(req)
+		if err != nil {
+			lastErr = err
+			continue
+		}
+		if response.StatusCode < 200 || response.StatusCode >= 300 {
+			response.Body.Close()
+			continue
+		}
+		var userResponse UserRes
+		err = json.NewDecoder(response.Body).Decode(&userResponse)
+		response.Body.Close()
+		if err != nil {
+			continue
+		}
+		headers := &HeaderInfo{
+			Scopes: response.Header.Get("X-OAuth-Scopes"),
+			Expiry: response.Header.Get("github-authentication-token-expiration"),
+		}
+		return true, &userResponse, headers, nil
+	}
+	return false, nil, nil, lastErr
+}
+
+// SetUserResponse adds user metadata without disturbing existing result metadata.
+func SetUserResponse(userResponse *UserRes, result *detectors.Result) {
+	if userResponse == nil || result == nil {
+		return
+	}
+	if result.ExtraData == nil {
+		result.ExtraData = make(map[string]string)
+	}
+	result.ExtraData["username"] = userResponse.Login
+	result.ExtraData["url"] = userResponse.UserURL
+	result.ExtraData["account_type"] = userResponse.Type
+	if userResponse.SiteAdmin {
+		result.ExtraData["site_admin"] = "true"
+	}
+	if userResponse.Name != "" {
+		result.ExtraData["name"] = userResponse.Name
+	}
+	if userResponse.Company != "" {
+		result.ExtraData["company"] = userResponse.Company
+	}
+	if userResponse.LdapDN != "" {
+		result.ExtraData["ldap_dn"] = userResponse.LdapDN
+	}
+}
+
+// SetHeaderInfo adds the optional scope and expiration metadata.
+func SetHeaderInfo(headers *HeaderInfo, result *detectors.Result) {
+	if headers == nil || result == nil {
+		return
+	}
+	if result.ExtraData == nil {
+		result.ExtraData = make(map[string]string)
+	}
+	if headers.Scopes != "" {
+		result.ExtraData["scopes"] = headers.Scopes
+	}
+	if headers.Expiry != "" {
+		result.ExtraData["expires_at"] = headers.Expiry
+	}
+}
