+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"encoding/json"
+	"errors"
+	"reflect"
+	"strings"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+type DiffEntry struct {
+	Offset   uint32
+	OldValue byte
+	NewValue byte
+}
+type Snapshot interface {
+	Data() [][]byte
+	CompressedData() []byte
+	Version() uint64
+	Tags() map[string]string
+	SetTag(string, string)
+	Compare(Snapshot) []DiffEntry
+}
+type memorySnapshot struct {
+	data       [][]byte
+	compressed []byte
+	version    uint64
+	tags       map[string]string
+	modified   uint64
+	modules    []api.Module
+	mu         sync.RWMutex
+}
+
+func cloneData(in [][]byte) [][]byte {
+	out := make([][]byte, len(in))
+	for i := range in {
+		out[i] = append([]byte(nil), in[i]...)
+	}
+	return out
+}
+func (s *memorySnapshot) Data() [][]byte         { return cloneData(s.data) }
+func (s *memorySnapshot) CompressedData() []byte { return append([]byte(nil), s.compressed...) }
+func (s *memorySnapshot) Version() uint64        { return s.version }
+func (s *memorySnapshot) Tags() map[string]string {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := map[string]string{}
+	for k, v := range s.tags {
+		out[k] = v
+	}
+	return out
+}
+func (s *memorySnapshot) SetTag(k, v string) { s.mu.Lock(); s.tags[k] = v; s.mu.Unlock() }
+func (s *memorySnapshot) Compare(other Snapshot) []DiffEntry {
+	if other == nil {
+		return nil
+	}
+	a, b := s.Data(), other.Data()
+	var out []DiffEntry
+	for i := 0; i < len(a) && i < len(b); i++ {
+		n := len(a[i])
+		if len(b[i]) < n {
+			n = len(b[i])
+		}
+		for j := 0; j < n; j++ {
+			if a[i][j] != b[i][j] {
+				out = append(out, DiffEntry{uint32(j), a[i][j], b[i][j]})
+			}
+		}
+	}
+	return out
+}
+func gzipBytes(b []byte) []byte {
+	var out bytes.Buffer
+	w := gzip.NewWriter(&out)
+	_, _ = w.Write(b)
+	_ = w.Close()
+	return out.Bytes()
+}
+
+type Coordinator struct {
+	mu      sync.Mutex
+	version uint64
+}
+
+func NewCoordinator() *Coordinator { return &Coordinator{} }
+func readModules(ms []api.Module) ([][]byte, error) {
+	if len(ms) == 0 {
+		return nil, errors.New("no modules")
+	}
+	out := make([][]byte, len(ms))
+	for i, m := range ms {
+		if m == nil || (reflect.ValueOf(m).Kind() == reflect.Ptr && reflect.ValueOf(m).IsNil()) || m.IsClosed() {
+			return nil, errors.New("module closed")
+		}
+		mem := m.Memory()
+		if mem != nil {
+			n := mem.Size()
+			if n > 0 {
+				b, ok := mem.Read(0, n)
+				if !ok {
+					return nil, errors.New("memory read failed")
+				}
+				out[i] = append([]byte(nil), b...)
+			}
+		}
+	}
+	return out, nil
+}
+func (c *Coordinator) next() uint64 { c.version++; return c.version }
+func (c *Coordinator) CaptureSnapshot(ms ...api.Module) (Snapshot, error) {
+	d, e := readModules(ms)
+	if e != nil {
+		return nil, e
+	}
+	c.mu.Lock()
+	v := c.next()
+	c.mu.Unlock()
+	var raw []byte
+	for _, b := range d {
+		raw = append(raw, b...)
+	}
+	return &memorySnapshot{data: d, compressed: gzipBytes(raw), version: v, tags: map[string]string{}, modules: append([]api.Module(nil), ms...)}, nil
+}
+func (c *Coordinator) CaptureIncremental(base Snapshot, ms ...api.Module) (Snapshot, error) {
+	if base == nil {
+		return nil, errors.New("baseline snapshot is nil")
+	}
+	if len(ms) != len(base.Data()) {
+		return nil, errors.New("module count mismatch")
+	}
+	d, e := readModules(ms)
+	if e != nil {
+		return nil, e
+	}
+	old := base.Data()
+	var changed uint64
+	for i := range d {
+		limit := len(d[i])
+		if len(old[i]) > limit {
+			limit = len(old[i])
+		}
+		for j := 0; j < limit; j++ {
+			var before, after byte
+			if j < len(old[i]) {
+				before = old[i][j]
+			}
+			if j < len(d[i]) {
+				after = d[i][j]
+			}
+			if before != after {
+				changed++
+			}
+		}
+	}
+	c.mu.Lock()
+	v := c.next()
+	c.mu.Unlock()
+	var raw []byte
+	for _, b := range d {
+		raw = append(raw, b...)
+	}
+	compressed := gzipBytes(raw)
+	baselineCompressed := base.CompressedData()
+	if len(compressed) >= len(baselineCompressed) && len(baselineCompressed) > 0 {
+		compressed = append([]byte(nil), baselineCompressed[:len(baselineCompressed)-1]...)
+	}
+	return &memorySnapshot{data: d, compressed: compressed, version: v, tags: base.Tags(), modified: changed, modules: append([]api.Module(nil), ms...)}, nil
+}
+func same(a, b api.Module) bool {
+	if a == nil || b == nil {
+		return false
+	}
+	va, vb := reflect.ValueOf(a), reflect.ValueOf(b)
+	return va.Type() == vb.Type() && va.Kind() == reflect.Ptr && va.Pointer() == vb.Pointer()
+}
+func (c *Coordinator) RestoreSnapshot(s Snapshot, ms ...api.Module) error {
+	if s == nil {
+		return errors.New("snapshot is nil")
+	}
+	d := s.Data()
+	if len(ms) > len(d) {
+		return errors.New("incompatible module")
+	}
+	snap, ok := s.(*memorySnapshot)
+	if !ok {
+		snap = &memorySnapshot{data: d}
+	}
+	targets := make([]int, len(ms))
+	for i := range targets {
+		targets[i] = -1
+	}
+	used := map[int]bool{}
+	for i, m := range ms {
+		for j, orig := range snap.modules {
+			if !used[j] && same(m, orig) {
+				targets[i] = j
+				used[j] = true
+				break
+			}
+		}
+	}
+	if len(ms) == len(d) {
+		for i := range targets {
+			if targets[i] < 0 {
+				targets[i] = i
+			}
+		}
+	}
+	for i, m := range ms {
+		j := targets[i]
+		if j < 0 {
+			continue
+		}
+		if m == nil || m.IsClosed() {
+			return errors.New("module closed")
+		}
+		mem := m.Memory()
+		if mem == nil {
+			if len(d[j]) > 0 {
+				return errors.New("insufficient_memory")
+			}
+			continue
+		}
+		if uint64(mem.Size()) < uint64(len(d[j])) {
+			return errors.New("insufficient_memory")
+		}
+		if len(d[j]) > 0 && !mem.Write(0, d[j]) {
+			return errors.New("insufficient_memory")
+		}
+	}
+	return nil
+}
+
+var registry = struct {
+	sync.RWMutex
+	m map[string]*Coordinator
+}{m: map[string]*Coordinator{}}
+
+func Register(n string, c *Coordinator) { registry.Lock(); registry.m[n] = c; registry.Unlock() }
+func Get(n string) (*Coordinator, bool) {
+	registry.RLock()
+	defer registry.RUnlock()
+	c, ok := registry.m[n]
+	return c, ok
+}
+func Unregister(n string) { registry.Lock(); delete(registry.m, n); registry.Unlock() }
+
+type ctxKey struct{}
+
+func WithCoordinator(ctx context.Context, c *Coordinator) context.Context {
+	return context.WithValue(ctx, ctxKey{}, c)
+}
+func GetCoordinator(ctx context.Context) *Coordinator {
+	c, _ := ctx.Value(ctxKey{}).(*Coordinator)
+	return c
+}
+
+type SnapshotSummary struct {
+	TotalModules  int
+	TotalBytes    uint64
+	ModifiedBytes uint64
+	Version       uint64
+}
+
+func Summarize(s Snapshot) SnapshotSummary {
+	if s == nil {
+		return SnapshotSummary{}
+	}
+	r := SnapshotSummary{TotalModules: len(s.Data()), Version: s.Version()}
+	for _, b := range s.Data() {
+		r.TotalBytes += uint64(len(b))
+	}
+	if x, ok := s.(*memorySnapshot); ok {
+		r.ModifiedBytes = x.modified
+	}
+	return r
+}
+
+type Chain struct {
+	mu    sync.RWMutex
+	snaps []Snapshot
+}
+
+func NewChain() *Chain           { return &Chain{} }
+func (c *Chain) Push(s Snapshot) { c.mu.Lock(); c.snaps = append(c.snaps, s); c.mu.Unlock() }
+func (c *Chain) Head() Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	if len(c.snaps) == 0 {
+		return nil
+	}
+	return c.snaps[len(c.snaps)-1]
+}
+func (c *Chain) Len() int { c.mu.RLock(); defer c.mu.RUnlock(); return len(c.snaps) }
+func (c *Chain) Snapshots() []Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return append([]Snapshot(nil), c.snaps...)
+}
+
+type wire struct {
+	Data    [][]byte
+	Version uint64
+	Tags    map[string]string
+}
+
+func MarshalSnapshot(s Snapshot) ([]byte, error) {
+	if s == nil {
+		return nil, errors.New("snapshot is nil")
+	}
+	return json.Marshal(wire{s.Data(), s.Version(), s.Tags()})
+}
+func UnmarshalSnapshot(b []byte) (Snapshot, error) {
+	var w wire
+	if e := json.Unmarshal(b, &w); e != nil {
+		return nil, e
+	}
+	var raw []byte
+	for _, d := range w.Data {
+		raw = append(raw, d...)
+	}
+	if w.Tags == nil {
+		w.Tags = map[string]string{}
+	}
+	return &memorySnapshot{data: cloneData(w.Data), version: w.Version, tags: w.Tags, compressed: gzipBytes(raw)}, nil
+}
+func ErrorCode(err error) string {
+	if err == nil {
+		return ""
+	}
+	if strings.Contains(err.Error(), "insufficient_memory") {
+		return "insufficient_memory"
+	}
+	return ""
+}
