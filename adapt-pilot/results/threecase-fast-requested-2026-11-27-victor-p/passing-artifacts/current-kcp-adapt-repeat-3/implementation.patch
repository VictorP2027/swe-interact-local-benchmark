new file mode 100644
index 0000000..f6681c7
--- /dev/null
+++ b/mux.go
@@ -0,0 +1,453 @@
+package kcp
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type MuxSide uint8
+
+const (
+	MuxSideClient MuxSide = iota
+	MuxSideServer
+)
+
+type MuxConfig struct {
+	Side                                 MuxSide
+	MaxFrameSize, SendWindow, RecvWindow uint32
+}
+
+func DefaultMuxConfig() MuxConfig {
+	return MuxConfig{Side: MuxSideClient, MaxFrameSize: 32 * 1024, SendWindow: 256 * 1024, RecvWindow: 256 * 1024}
+}
+
+const (
+	MuxPriorityHigh uint8 = iota
+	MuxPriorityNormal
+	MuxPriorityLow
+)
+const (
+	muxOpen byte = iota + 1
+	muxData
+	muxClose
+	muxWindow
+)
+
+type muxFrame struct {
+	typ  byte
+	id   uint32
+	data []byte
+}
+type MuxSession struct {
+	conn    net.Conn
+	cfg     MuxConfig
+	mu      sync.Mutex
+	streams map[uint32]*MuxStream
+	next    uint32
+	accept  chan *MuxStream
+	done    chan struct{}
+	once    sync.Once
+	q       [3][]muxFrame
+	control []muxFrame
+	wake    chan struct{}
+}
+type MuxStream struct {
+	session                   *MuxSession
+	id                        uint32
+	priority                  uint8
+	mu                        sync.Mutex
+	changed                   chan struct{}
+	buf                       []byte
+	sendCredit                uint32
+	recvCredit                uint32
+	localClosed, remoteClosed bool
+	deadline                  time.Time
+	removed                   bool
+}
+
+func NewMuxSession(conn net.Conn, cfg *MuxConfig) (*MuxSession, error) {
+	if conn == nil {
+		return nil, errors.New("nil mux connection")
+	}
+	c := DefaultMuxConfig()
+	if cfg != nil {
+		c = *cfg
+		d := DefaultMuxConfig()
+		if c.MaxFrameSize == 0 {
+			c.MaxFrameSize = d.MaxFrameSize
+		}
+		if c.SendWindow == 0 {
+			c.SendWindow = d.SendWindow
+		}
+		if c.RecvWindow == 0 {
+			c.RecvWindow = d.RecvWindow
+		}
+	}
+	if c.Side != MuxSideClient && c.Side != MuxSideServer {
+		return nil, errors.New("invalid mux side")
+	}
+	s := &MuxSession{conn: conn, cfg: c, streams: make(map[uint32]*MuxStream), accept: make(chan *MuxStream, 128), done: make(chan struct{}), wake: make(chan struct{}, 1)}
+	if c.Side == MuxSideClient {
+		s.next = 1
+	} else {
+		s.next = 2
+	}
+	go s.readLoop()
+	go s.writeLoop()
+	return s, nil
+}
+func (s *MuxSession) signal() {
+	select {
+	case s.wake <- struct{}{}:
+	default:
+	}
+}
+func (s *MuxSession) enqueue(f muxFrame, control bool) {
+	s.mu.Lock()
+	if control {
+		s.control = append(s.control, f)
+	} else {
+		p := int(f.data[0])
+		_ = p
+	}
+	s.mu.Unlock()
+	s.signal()
+}
+func (s *MuxSession) queueData(f muxFrame, p uint8) {
+	s.mu.Lock()
+	if p > 2 {
+		p = 2
+	}
+	s.q[p] = append(s.q[p], f)
+	s.mu.Unlock()
+	s.signal()
+}
+func (s *MuxSession) queueControl(t byte, id uint32, n uint32) {
+	b := make([]byte, 4)
+	binary.BigEndian.PutUint32(b, n)
+	s.mu.Lock()
+	s.control = append(s.control, muxFrame{typ: t, id: id, data: b})
+	s.mu.Unlock()
+	s.signal()
+}
+func (s *MuxSession) OpenStream(priority uint8) (*MuxStream, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	select {
+	case <-s.done:
+		return nil, io.ErrClosedPipe
+	default:
+	}
+	id := s.next
+	s.next += 2
+	st := s.newStream(id, priority)
+	s.streams[id] = st
+	s.control = append(s.control, muxFrame{typ: muxOpen, id: id})
+	atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+	s.signal()
+	return st, nil
+}
+func (s *MuxSession) newStream(id uint32, p uint8) *MuxStream {
+	return &MuxStream{session: s, id: id, priority: p, changed: make(chan struct{}), sendCredit: s.cfg.SendWindow, recvCredit: s.cfg.RecvWindow}
+}
+func (s *MuxSession) AcceptStream() (*MuxStream, error) {
+	select {
+	case st := <-s.accept:
+		if st == nil {
+			return nil, io.ErrClosedPipe
+		}
+		return st, nil
+	case <-s.done:
+		return nil, io.ErrClosedPipe
+	}
+}
+func (s *MuxSession) NumStreams() int { s.mu.Lock(); defer s.mu.Unlock(); return len(s.streams) }
+func (s *MuxSession) Close() error {
+	s.once.Do(func() {
+		close(s.done)
+		s.mu.Lock()
+		for _, st := range s.streams {
+			st.mu.Lock()
+			st.notify()
+			st.mu.Unlock()
+		}
+		s.mu.Unlock()
+		s.signal()
+	})
+	return nil
+}
+func (st *MuxStream) notify()    { close(st.changed); st.changed = make(chan struct{}) }
+func (st *MuxStream) ID() uint32 { return st.id }
+func (st *MuxStream) Write(p []byte) (int, error) {
+	written := 0
+	for len(p) > 0 {
+		st.mu.Lock()
+		if st.localClosed || st.remoteClosed {
+			st.mu.Unlock()
+			if written > 0 {
+				return written, io.ErrClosedPipe
+			}
+			return 0, io.ErrClosedPipe
+		}
+		if st.session.isDone() {
+			st.mu.Unlock()
+			return written, io.ErrClosedPipe
+		}
+		if st.sendCredit == 0 {
+			ch := st.changed
+			st.mu.Unlock()
+			select {
+			case <-ch:
+				continue
+			case <-st.session.done:
+				return written, io.ErrClosedPipe
+			}
+		}
+		n := len(p)
+		if uint32(n) > st.sendCredit {
+			n = int(st.sendCredit)
+		}
+		if uint32(n) > st.session.cfg.MaxFrameSize {
+			n = int(st.session.cfg.MaxFrameSize)
+		}
+		st.sendCredit -= uint32(n)
+		st.mu.Unlock()
+		b := append([]byte(nil), p[:n]...)
+		st.session.queueData(muxFrame{typ: muxData, id: st.id, data: b}, st.priority)
+		written += n
+		p = p[n:]
+	}
+	return written, nil
+}
+func (s *MuxSession) isDone() bool {
+	select {
+	case <-s.done:
+		return true
+	default:
+		return false
+	}
+}
+func (st *MuxStream) Read(p []byte) (int, error) {
+	for {
+		st.mu.Lock()
+		if len(st.buf) > 0 {
+			n := copy(p, st.buf)
+			st.buf = st.buf[n:]
+			st.recvCredit += uint32(n)
+			st.mu.Unlock()
+			st.session.queueControl(muxWindow, st.id, uint32(n))
+			st.session.maybeRemove(st)
+			return n, nil
+		}
+		if st.remoteClosed {
+			st.mu.Unlock()
+			return 0, io.EOF
+		}
+		if st.session.isDone() {
+			st.mu.Unlock()
+			return 0, io.ErrClosedPipe
+		}
+		ch := st.changed
+		dl := st.deadline
+		st.mu.Unlock()
+		if dl.IsZero() {
+			select {
+			case <-ch:
+				continue
+			case <-st.session.done:
+				return 0, io.ErrClosedPipe
+			}
+		}
+		d := time.Until(dl)
+		if d <= 0 {
+			return 0, timeoutError{}
+		}
+		t := time.NewTimer(d)
+		select {
+		case <-ch:
+			if !t.Stop() {
+				<-t.C
+			}
+		case <-st.session.done:
+			if !t.Stop() {
+				<-t.C
+			}
+			return 0, io.ErrClosedPipe
+		case <-t.C:
+			return 0, timeoutError{}
+		}
+	}
+}
+func (st *MuxStream) Close() error {
+	st.mu.Lock()
+	if st.localClosed {
+		st.mu.Unlock()
+		return nil
+	}
+	st.localClosed = true
+	st.notify()
+	st.mu.Unlock()
+	st.session.queueControl(muxClose, st.id, 0)
+	st.session.maybeRemove(st)
+	return nil
+}
+func (st *MuxStream) SetReadDeadline(t time.Time) error {
+	st.mu.Lock()
+	st.deadline = t
+	st.notify()
+	st.mu.Unlock()
+	return nil
+}
+
+func (s *MuxSession) maybeRemove(st *MuxStream) {
+	st.mu.Lock()
+	done := st.localClosed && st.remoteClosed && len(st.buf) == 0 && !st.removed
+	if done {
+		st.removed = true
+	}
+	st.mu.Unlock()
+	if done {
+		s.mu.Lock()
+		delete(s.streams, st.id)
+		s.mu.Unlock()
+		atomic.AddUint64(&DefaultSnmp.MuxStreamsClosed, 1)
+	}
+}
+func (s *MuxSession) writeLoop() {
+	for {
+		var f muxFrame
+		s.mu.Lock()
+		if len(s.control) > 0 {
+			f = s.control[0]
+			s.control = s.control[1:]
+		} else {
+			found := false
+			for i := 0; i < 3; i++ {
+				if len(s.q[i]) > 0 {
+					f = s.q[i][0]
+					s.q[i] = s.q[i][1:]
+					found = true
+					break
+				}
+			}
+			if !found {
+				s.mu.Unlock()
+				select {
+				case <-s.wake:
+					continue
+				case <-s.done:
+					return
+				}
+			}
+		}
+		s.mu.Unlock()
+		if s.isDone() {
+			return
+		}
+		h := make([]byte, 9)
+		h[0] = f.typ
+		binary.BigEndian.PutUint32(h[1:5], f.id)
+		binary.BigEndian.PutUint32(h[5:9], uint32(len(f.data)))
+		if _, e := writeFull(s.conn, h); e != nil {
+			s.Close()
+			return
+		}
+		if len(f.data) > 0 {
+			if _, e := writeFull(s.conn, f.data); e != nil {
+				s.Close()
+				return
+			}
+		}
+		atomic.AddUint64(&DefaultSnmp.MuxFramesSent, 1)
+		if f.typ == muxData {
+			atomic.AddUint64(&DefaultSnmp.MuxBytesSent, uint64(len(f.data)))
+		}
+	}
+}
+func writeFull(w io.Writer, b []byte) (int, error) {
+	total := 0
+	for total < len(b) {
+		n, e := w.Write(b[total:])
+		total += n
+		if e != nil {
+			return total, e
+		}
+		if n == 0 {
+			return total, io.ErrShortWrite
+		}
+	}
+	return total, nil
+}
+func (s *MuxSession) readLoop() {
+	for {
+		h := make([]byte, 9)
+		if _, e := io.ReadFull(s.conn, h); e != nil {
+			s.Close()
+			return
+		}
+		t := h[0]
+		id := binary.BigEndian.Uint32(h[1:5])
+		n := binary.BigEndian.Uint32(h[5:])
+		if n > s.cfg.MaxFrameSize && t == muxData {
+			s.Close()
+			return
+		}
+		b := make([]byte, n)
+		if _, e := io.ReadFull(s.conn, b); e != nil {
+			s.Close()
+			return
+		}
+		atomic.AddUint64(&DefaultSnmp.MuxFramesReceived, 1)
+		if t == muxData {
+			atomic.AddUint64(&DefaultSnmp.MuxBytesReceived, uint64(n))
+		}
+		s.handle(t, id, b)
+	}
+}
+func (s *MuxSession) handle(t byte, id uint32, b []byte) {
+	s.mu.Lock()
+	st := s.streams[id]
+	if t == muxOpen && st == nil {
+		p := id % 2
+		if (s.cfg.Side == MuxSideServer && p == 1) || (s.cfg.Side == MuxSideClient && p == 0) {
+			st = s.newStream(id, MuxPriorityNormal)
+			s.streams[id] = st
+			atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+			select {
+			case s.accept <- st:
+			default:
+			}
+		}
+		s.mu.Unlock()
+		return
+	}
+	s.mu.Unlock()
+	if st == nil {
+		return
+	}
+	st.mu.Lock()
+	switch t {
+	case muxData:
+		if !st.remoteClosed {
+			st.buf = append(st.buf, b...)
+			st.notify()
+		}
+	case muxClose:
+		st.remoteClosed = true
+		st.notify()
+	case muxWindow:
+		if len(b) >= 4 {
+			st.sendCredit += binary.BigEndian.Uint32(b)
+			st.notify()
+		}
+	}
+	st.mu.Unlock()
+	if t == muxClose {
+		s.maybeRemove(st)
+	}
+}
