index 0000000..b7a9701
--- /dev/null
+++ b/mux.go
@@ -0,0 +1,420 @@
+package kcp
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type MuxSide uint8
+
+const (
+	MuxSideClient MuxSide = iota
+	MuxSideServer
+)
+const (
+	MuxPriorityHigh uint8 = iota
+	MuxPriorityNormal
+	MuxPriorityLow
+)
+
+type MuxConfig struct {
+	Side                                 MuxSide
+	MaxFrameSize, SendWindow, RecvWindow uint32
+}
+
+func DefaultMuxConfig() MuxConfig {
+	return MuxConfig{Side: MuxSideClient, MaxFrameSize: 32 * 1024, SendWindow: 256 * 1024, RecvWindow: 256 * 1024}
+}
+
+const (
+	muxOpen byte = iota + 1
+	muxData
+	muxClose
+	muxWindow
+)
+
+type muxFrame struct {
+	typ  byte
+	id   uint32
+	data []byte
+}
+type MuxSession struct {
+	conn       net.Conn
+	cfg        MuxConfig
+	mu         sync.Mutex
+	streams    map[uint32]*MuxStream
+	next       uint32
+	accepts    []*MuxStream
+	acceptWake chan struct{}
+	done       chan struct{}
+	closed     bool
+	closedFlag uint32
+	qmu        sync.Mutex
+	queues     [3][]muxFrame
+	qwake      chan struct{}
+}
+type MuxStream struct {
+	s                                  *MuxSession
+	id                                 uint32
+	priority                           uint8
+	mu                                 sync.Mutex
+	readBuf                            []byte
+	sendCredit                         uint32
+	recvUsed                           uint32
+	readWake                           chan struct{}
+	writeWake                          chan struct{}
+	localClosed, remoteClosed, removed bool
+	readDeadline                       time.Time
+}
+
+func NewMuxSession(conn net.Conn, cfg *MuxConfig) (*MuxSession, error) {
+	if conn == nil {
+		return nil, errors.New("nil mux connection")
+	}
+	c := DefaultMuxConfig()
+	if cfg != nil {
+		c = *cfg
+	}
+	if c.Side > MuxSideServer {
+		return nil, errors.New("invalid mux side")
+	}
+	if c.MaxFrameSize == 0 || c.SendWindow == 0 || c.RecvWindow == 0 {
+		return nil, errors.New("mux sizes must be positive")
+	}
+	n := uint32(1)
+	if c.Side == MuxSideServer {
+		n = 2
+	}
+	m := &MuxSession{conn: conn, cfg: c, streams: make(map[uint32]*MuxStream), next: n, acceptWake: make(chan struct{}), done: make(chan struct{}), qwake: make(chan struct{}, 1)}
+	go m.writer()
+	go m.reader()
+	return m, nil
+}
+func (m *MuxSession) signalAccept() { close(m.acceptWake); m.acceptWake = make(chan struct{}) }
+func (m *MuxSession) signalQ() {
+	select {
+	case m.qwake <- struct{}{}:
+	default:
+	}
+}
+func (m *MuxSession) enqueue(f muxFrame) {
+	m.qmu.Lock()
+	i := int(MuxPriorityNormal)
+	if f.typ != muxData {
+		i = 0
+	} else if f.id != 0 {
+		m.mu.Lock()
+		if st := m.streams[f.id]; st != nil {
+			i = int(st.priority)
+		}
+		m.mu.Unlock()
+	}
+	if i > 2 {
+		i = 2
+	}
+	m.queues[i] = append(m.queues[i], f)
+	m.qmu.Unlock()
+	m.signalQ()
+}
+func (m *MuxSession) pop() (muxFrame, bool) {
+	m.qmu.Lock()
+	defer m.qmu.Unlock()
+	for i := range m.queues {
+		if len(m.queues[i]) > 0 {
+			f := m.queues[i][0]
+			m.queues[i] = m.queues[i][1:]
+			return f, true
+		}
+	}
+	return muxFrame{}, false
+}
+func (m *MuxSession) writer() {
+	for {
+		f, ok := m.pop()
+		if !ok {
+			select {
+			case <-m.done:
+				return
+			case <-m.qwake:
+				continue
+			}
+		}
+		b := make([]byte, 9+len(f.data))
+		b[0] = f.typ
+		binary.BigEndian.PutUint32(b[1:5], f.id)
+		binary.BigEndian.PutUint32(b[5:9], uint32(len(f.data)))
+		copy(b[9:], f.data)
+		if e := writeMuxFrame(m.conn, b); e != nil {
+			m.fail()
+			return
+		}
+		atomic.AddUint64(&DefaultSnmp.MuxFramesSent, 1)
+		if f.typ == muxData {
+			atomic.AddUint64(&DefaultSnmp.MuxBytesSent, uint64(len(f.data)))
+		}
+	}
+}
+func (m *MuxSession) reader() {
+	h := make([]byte, 9)
+	for {
+		if _, e := io.ReadFull(m.conn, h); e != nil {
+			m.fail()
+			return
+		}
+		n := binary.BigEndian.Uint32(h[5:9])
+		if n > m.cfg.MaxFrameSize {
+			m.fail()
+			return
+		}
+		d := make([]byte, n)
+		if _, e := io.ReadFull(m.conn, d); e != nil {
+			m.fail()
+			return
+		}
+		atomic.AddUint64(&DefaultSnmp.MuxFramesReceived, 1)
+		m.handle(muxFrame{h[0], binary.BigEndian.Uint32(h[1:5]), d})
+	}
+}
+func (m *MuxSession) handle(f muxFrame) {
+	m.mu.Lock()
+	st := m.streams[f.id]
+	switch f.typ {
+	case muxOpen:
+		if st == nil {
+			st = &MuxStream{s: m, id: f.id, priority: MuxPriorityNormal, sendCredit: m.cfg.SendWindow, readWake: make(chan struct{}), writeWake: make(chan struct{})}
+			m.streams[f.id] = st
+			m.accepts = append(m.accepts, st)
+			m.signalAccept()
+			atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+		}
+	case muxData:
+		if st != nil {
+			st.mu.Lock()
+			if !st.remoteClosed && uint64(st.recvUsed)+uint64(len(f.data)) <= uint64(m.cfg.RecvWindow) {
+				st.readBuf = append(st.readBuf, f.data...)
+				st.recvUsed += uint32(len(f.data))
+				st.signalRead()
+			}
+			st.mu.Unlock()
+			atomic.AddUint64(&DefaultSnmp.MuxBytesReceived, uint64(len(f.data)))
+		}
+	case muxClose:
+		if st != nil {
+			st.mu.Lock()
+			st.remoteClosed = true
+			st.signalRead()
+			st.signalWrite()
+			st.mu.Unlock()
+			m.cleanupLocked(st)
+		}
+	case muxWindow:
+		if st != nil && len(f.data) == 4 {
+			st.mu.Lock()
+			st.sendCredit += binary.BigEndian.Uint32(f.data)
+			st.signalWrite()
+			st.mu.Unlock()
+		}
+	}
+	m.mu.Unlock()
+}
+func (m *MuxSession) fail() {
+	m.mu.Lock()
+	if !m.closed {
+		m.closed = true
+		atomic.StoreUint32(&m.closedFlag, 1)
+		close(m.done)
+		m.signalAccept()
+		for _, st := range m.streams {
+			st.mu.Lock()
+			st.signalRead()
+			st.signalWrite()
+			st.mu.Unlock()
+		}
+	}
+	m.mu.Unlock()
+}
+func (m *MuxSession) Close() error    { m.fail(); return m.conn.Close() }
+func (m *MuxSession) NumStreams() int { m.mu.Lock(); defer m.mu.Unlock(); return len(m.streams) }
+func (m *MuxSession) OpenStream(priority uint8) (*MuxStream, error) {
+	if priority > 2 {
+		priority = MuxPriorityLow
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed {
+		return nil, io.ErrClosedPipe
+	}
+	id := m.next
+	m.next += 2
+	st := &MuxStream{s: m, id: id, priority: priority, sendCredit: m.cfg.SendWindow, readWake: make(chan struct{}), writeWake: make(chan struct{})}
+	m.streams[id] = st
+	m.enqueue(muxFrame{typ: muxOpen, id: id})
+	atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+	return st, nil
+}
+func (m *MuxSession) AcceptStream() (*MuxStream, error) {
+	for {
+		m.mu.Lock()
+		if len(m.accepts) > 0 {
+			st := m.accepts[0]
+			m.accepts = m.accepts[1:]
+			m.mu.Unlock()
+			return st, nil
+		}
+		if m.closed {
+			m.mu.Unlock()
+			return nil, io.ErrClosedPipe
+		}
+		w := m.acceptWake
+		m.mu.Unlock()
+		select {
+		case <-m.done:
+			return nil, io.ErrClosedPipe
+		case <-w:
+		}
+	}
+}
+func (s *MuxStream) ID() uint32   { return s.id }
+func (s *MuxStream) signalRead()  { close(s.readWake); s.readWake = make(chan struct{}) }
+func (s *MuxStream) signalWrite() { close(s.writeWake); s.writeWake = make(chan struct{}) }
+func (s *MuxStream) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	for {
+		s.mu.Lock()
+		if len(s.readBuf) > 0 {
+			n := copy(p, s.readBuf)
+			s.readBuf = s.readBuf[n:]
+			s.recvUsed -= uint32(n)
+			shouldCleanup := s.localClosed && s.remoteClosed && len(s.readBuf) == n
+			s.mu.Unlock()
+			if shouldCleanup {
+				s.s.mu.Lock()
+				s.s.cleanupLocked(s)
+				s.s.mu.Unlock()
+			}
+			b := make([]byte, 4)
+			binary.BigEndian.PutUint32(b, uint32(n))
+			s.s.enqueue(muxFrame{typ: muxWindow, id: s.id, data: b})
+			return n, nil
+		}
+		if s.remoteClosed || s.s.isClosed() {
+			s.mu.Unlock()
+			return 0, io.ErrClosedPipe
+		}
+		w := s.readWake
+		d := s.readDeadline
+		s.mu.Unlock()
+		if d.IsZero() {
+			select {
+			case <-s.s.done:
+				return 0, io.ErrClosedPipe
+			case <-w:
+			}
+		} else {
+			t := time.NewTimer(time.Until(d))
+			select {
+			case <-s.s.done:
+				t.Stop()
+				return 0, io.ErrClosedPipe
+			case <-w:
+				t.Stop()
+			case <-t.C:
+				return 0, timeoutError{}
+			}
+		}
+	}
+}
+func (s *MuxStream) Write(p []byte) (int, error) {
+	total := 0
+	for len(p) > 0 {
+		s.mu.Lock()
+		if s.localClosed || s.remoteClosed || s.s.isClosed() {
+			s.mu.Unlock()
+			if total == 0 {
+				return 0, io.ErrClosedPipe
+			}
+			return total, io.ErrClosedPipe
+		}
+		if s.sendCredit == 0 {
+			w := s.writeWake
+			s.mu.Unlock()
+			select {
+			case <-s.s.done:
+				if total == 0 {
+					return 0, io.ErrClosedPipe
+				}
+				return total, io.ErrClosedPipe
+			case <-w:
+			}
+			continue
+		}
+		n := len(p)
+		if uint32(n) > s.sendCredit {
+			n = int(s.sendCredit)
+		}
+		if uint32(n) > s.s.cfg.MaxFrameSize {
+			n = int(s.s.cfg.MaxFrameSize)
+		}
+		b := append([]byte(nil), p[:n]...)
+		s.sendCredit -= uint32(n)
+		s.mu.Unlock()
+		s.s.enqueue(muxFrame{typ: muxData, id: s.id, data: b})
+		total += n
+		p = p[n:]
+	}
+	return total, nil
+}
+func (s *MuxStream) Close() error {
+	s.mu.Lock()
+	if s.localClosed {
+		s.mu.Unlock()
+		return nil
+	}
+	s.localClosed = true
+	s.signalWrite()
+	s.mu.Unlock()
+	s.s.enqueue(muxFrame{typ: muxClose, id: s.id})
+	s.s.mu.Lock()
+	s.s.cleanupLocked(s)
+	s.s.mu.Unlock()
+	return nil
+}
+func (m *MuxSession) isClosed() bool { return atomic.LoadUint32(&m.closedFlag) != 0 }
+func (m *MuxSession) cleanupLocked(s *MuxStream) {
+	s.mu.Lock()
+	done := s.localClosed && s.remoteClosed && len(s.readBuf) == 0 && !s.removed
+	if done {
+		s.removed = true
+		delete(m.streams, s.id)
+		atomic.AddUint64(&DefaultSnmp.MuxStreamsClosed, 1)
+	}
+	s.mu.Unlock()
+}
+func (s *MuxStream) SetReadDeadline(t time.Time) error {
+	s.mu.Lock()
+	s.readDeadline = t
+	s.signalRead()
+	s.mu.Unlock()
+	return nil
+}
+
+func writeMuxFrame(w io.Writer, b []byte) error {
+	for len(b) > 0 {
+		n, e := w.Write(b)
+		if e != nil {
+			return e
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+		b = b[n:]
+	}
+	return nil
+}
